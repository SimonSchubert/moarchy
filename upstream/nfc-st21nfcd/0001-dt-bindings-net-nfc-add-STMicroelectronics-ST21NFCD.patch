From 1e944895eff77448350efe7a6d18797e54e470f3 Mon Sep 17 00:00:00 2001
From: Tim auf der Landwehr <tadl-git@taufderl.de>
Date: Thu, 24 Sep 2026 12:07:02 +0200
Subject: [RFC PATCH 1/3] dt-bindings: net: nfc: add STMicroelectronics
 ST21NFCD

The ST21NFCD is an NFC controller that speaks plain NCI over I2C,
without the NDLC link layer described by st,st-nci. Add a binding
for it.

Signed-off-by: Tim auf der Landwehr <tadl-git@taufderl.de>
---
 .../bindings/net/nfc/st,st21nfcd.yaml         | 58 +++++++++++++++++++
 1 file changed, 58 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/net/nfc/st,st21nfcd.yaml

diff --git a/Documentation/devicetree/bindings/net/nfc/st,st21nfcd.yaml b/Documentation/devicetree/bindings/net/nfc/st,st21nfcd.yaml
new file mode 100644
index 000000000..c45769c35
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/nfc/st,st21nfcd.yaml
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/nfc/st,st21nfcd.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: STMicroelectronics ST21NFCD NFC controller
+
+maintainers:
+  - Tim auf der Landwehr <tadl-git@taufderl.de>
+
+description:
+  An NFC controller speaking plain NCI over I2C, without the NDLC link
+  layer used by the ST21NFCB and ST21NFCC.
+
+properties:
+  compatible:
+    const: st,st21nfcd
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  reset-gpios:
+    maxItems: 1
+    description: Active-low reset line.
+
+  clocks:
+    maxItems: 1
+    description: Reference clock, where the board feeds one to the controller.
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - reset-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        nfc@8 {
+            compatible = "st,st21nfcd";
+            reg = <0x08>;
+            interrupt-parent = <&gpio>;
+            interrupts = <9 IRQ_TYPE_LEVEL_HIGH>;
+            reset-gpios = <&gpio 6 GPIO_ACTIVE_LOW>;
+        };
+    };
-- 
