# moarchy -- top-level Sway config.
#
# Installed as /usr/share/moarchy/config/sway/config and passed to sway with
# -c by /etc/profile.d/zz-moarchy.sh. NOT /etc/sway/config: the sway
# package owns that path and two packages cannot own one file.
#
# Nothing is copied into $HOME for the session to come up. To change something,
# drop a .conf into ~/.config/sway/config.d/ -- the last include below, and the
# one place that wins over everything above it.
#
# Layered exactly the way upstream Omarchy layers config/hypr/hyprland.conf:
# shared defaults first, then the active theme, then device/user overrides that
# are free to override anything above them.

### Omarchy/moarchy defaults (do not edit these directly)
include /usr/share/moarchy/default/sway/looknfeel.conf
include /usr/share/moarchy/default/sway/input.conf
include /usr/share/moarchy/default/sway/bindings.conf
include /usr/share/moarchy/default/sway/autostart.conf

### Active theme (regenerated by `omarchy-theme-set` from the theme's colors.toml)
include ~/.local/state/omarchy/current/theme/sway.conf

### PinePhone hardware profile
include /usr/share/moarchy/default/sway/pinephone.conf

### Your own overrides -- anything set here wins
include ~/.config/sway/config.d/*.conf
