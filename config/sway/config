# mobileomarchy -- top-level Sway config.
#
# Layered exactly the way upstream Omarchy layers config/hypr/hyprland.conf:
# shared defaults first, then the active theme, then device/user overrides that
# are free to override anything above them.

### Omarchy/mobileomarchy defaults (do not edit these directly)
include ~/.local/share/mobileomarchy/default/sway/looknfeel.conf
include ~/.local/share/mobileomarchy/default/sway/input.conf
include ~/.local/share/mobileomarchy/default/sway/bindings.conf
include ~/.local/share/mobileomarchy/default/sway/autostart.conf

### Active theme (regenerated by `omarchy-theme-set` from the theme's colors.toml)
include ~/.config/omarchy/current/theme/sway.conf

### PinePhone hardware profile
include ~/.local/share/mobileomarchy/default/sway/pinephone.conf

### Your own overrides -- anything set here wins
include ~/.config/sway/config.d/*.conf
