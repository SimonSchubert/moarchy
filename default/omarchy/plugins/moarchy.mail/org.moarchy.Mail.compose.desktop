# What xdg-open runs for a mailto: link. Hidden from the appDrawer, for the
# editor's reason (org.moarchy.Editor.open.desktop): the appDrawer's entry
# toggles, and a toggle with a link in it hides a Mail that is already open
# instead of starting the message. `summon` shows, and Mail reads the bare
# mailto: URI the shell hands it where %u was.
#
# The appDrawer finds a plugin's window by `shell toggle <id>` in an entry's Exec,
# so this Exec cannot be the appDrawer's as well.
[Desktop Entry]
Type=Application
Name=Mail
Comment=Write an email in the shell's mail app
Exec=omarchy-shell shell summon moarchy.mail %u
Icon=org.moarchy.Mail
Terminal=false
NoDisplay=true
StartupNotify=false
MimeType=x-scheme-handler/mailto;
X-Moarchy-Plugin=moarchy.mail
