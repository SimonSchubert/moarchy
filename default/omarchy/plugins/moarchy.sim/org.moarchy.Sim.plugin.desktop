[Desktop Entry]
Type=Application
Name=SIM
GenericName=SIM Unlock
Comment=Enter the SIM PIN, with the attempts left in front of you
# A shell plugin is not a process you launch, it is a screen the shell already
# holds -- the same Exec every moarchy shell app uses.
Exec=omarchy-shell shell toggle moarchy.sim
Terminal=false
Categories=System;Settings;
Keywords=sim;pin;unlock;modem;cellular;mobile;
# Ownership marker. install/config.sh sweeps entries whose named plugin is no
# longer in the repo; without it a deleted plugin leaves a appDrawer icon that
# launches nothing.
X-Moarchy-Plugin=moarchy.sim
