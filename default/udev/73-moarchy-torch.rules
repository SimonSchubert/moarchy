# Make the flash LED's brightness writable by the session's group, which is
# what the controlCenter's Torch tile needs to exist at all (docs/control-center.md S10, S10a).
#
# feedbackd ships a rule for exactly this attribute -- 72-feedbackd.rules,
# matching */*:flash -- and it does not work on Arch: the rule runs
# /usr/libexec/fbd-ledctrl while the package installs the helper at
# /usr/lib/fbd-ledctrl. udev says so and carries on:
#
#   white:flash: Failed to find and pin callout binary "/usr/libexec/fbd-ledctrl"
#   white:flash: Failed to execute '/usr/libexec/fbd-ledctrl ...', ignoring
#
# so the attribute keeps root:root 0644 on every boot. Nothing else notices:
# the controlCenter probes with `[ -w ... ]` and correctly hides a control it cannot
# operate, which draws three tiles instead of four and reads exactly like a
# phone with no flash LED. Found on sargo, where the LED is real.
#
# Ours rather than a symlink into feedbackd's layout: a feedbackd upgrade that
# moves the helper again, or drops it, then changes nothing here.
#
# GROUP= and MODE= would be the obvious way to write this and do not work --
# udev applies those to the device node in /dev, and an LED has no node. The
# attribute is a sysfs file and has to be chgrp'd and chmod'd as one, which is
# what fbd-ledctrl itself does.
#
# The group is feedbackd rather than video because moarchy-firstboot already
# puts the user in it and feedbackd's own LED feedback wants the same access;
# the package depends on feedbackd so the group is there when this runs.
#
# *:torch is matched for the same reason feedbackd matches it: some devices
# name the same LED that way. The controlCenter only ever probes *:flash.
# brightness alone is enough for the Torch tile, which just turns the LED on.
# A camera app needs more: libmegapixels strobes the flash for the duration of
# an exposure through the V4L2 flash attributes, and stops at the first one it
# cannot open --
#
#   [libmegapixels] Could not open /sys/class/leds/white:flash/flash_strobe: Permission denied
#
# after which megapixels lights the whole screen white instead, which looks
# exactly like a phone whose flash is not wired up. Those three attributes only
# exist on LEDs the kernel registers as V4L2 flash devices, so each line tests
# for its attribute and exits 0 either way, rather than a narrower KERNEL==
# pattern that would need updating per device. Written out one per attribute
# because udev reads $ as the start of its own substitution, so a shell loop
# variable cannot survive here.
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="*:flash|*:torch", \
  RUN+="/bin/sh -c '[ -e %S%p/brightness ] && chgrp feedbackd %S%p/brightness && chmod g+w %S%p/brightness; exit 0'", \
  RUN+="/bin/sh -c '[ -e %S%p/flash_brightness ] && chgrp feedbackd %S%p/flash_brightness && chmod g+w %S%p/flash_brightness; exit 0'", \
  RUN+="/bin/sh -c '[ -e %S%p/flash_strobe ] && chgrp feedbackd %S%p/flash_strobe && chmod g+w %S%p/flash_strobe; exit 0'", \
  RUN+="/bin/sh -c '[ -e %S%p/flash_timeout ] && chgrp feedbackd %S%p/flash_timeout && chmod g+w %S%p/flash_timeout; exit 0'"
