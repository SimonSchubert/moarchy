# Full replacement for the packaged unit, not a drop-in.
#
# Upstream ships this for GNOME with Requisite=gnome-session-initialized.target,
# a target that never exists under sway -- so the daemon would sit enabled and
# fail instantly on every start with "Unit gnome-session-initialized.target not
# found". A drop-in cannot fix it: systemd reads the override, but an empty
# Requisite= does not clear the inherited list (verified on this device --
# `systemctl show` still reported the GNOME dependency). A unit of the same name
# in ~/.config/systemd/user does take precedence, so replace it outright.
#
# Without this, incoming SMS is never received: nothing is listening on D-Bus.
[Unit]
Description=SMS/MMS chat application (daemon mode)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
BusName=sm.puri.Chatty
ExecStart=/usr/bin/chatty --gapplication-service
Type=dbus
Restart=on-failure

[Install]
WantedBy=sway-session.target
