[Unit]
Description=moarchy per-user setup (app configs, initial theme, agent wrappers)
# Everything else moarchy ships is read from a system path. What is left is the
# handful of app configs -- foot, btop and four more -- that only ever read
# ~/.config, the default terminal, the initial theme, which writes user state by
# design, and the ~/.local/bin agent wrappers, which live where mise-managed
# tools live. (It said "alacritty, foot, btop" until 2026-09-08; alacritty is
# not installed any more, and the list was already longer than three.)
#
# ConditionPathExists below means this never runs twice, so a phone already in
# the field does not get the wrappers from a `pacman -Syu`. One command adds
# them, and it is idempotent, so running it on a phone that already has them
# costs nothing:
#   moarchy-agent seed
#
# The default terminal (docs/apps.md T2) is in the same position and has the
# same escape hatch. An upgraded phone drops two terminal packages and has no
# default terminal until this runs, which means xdg-terminal-exec hangs rather
# than failing. Guarded on absence, so it too costs nothing twice:
#   moarchy-user-setup --terminal
#
# Deliberately not "re-run the whole script": omarchy-theme-set in there is
# unconditional and would throw away a theme and wallpaper somebody chose.
ConditionPathExists=!%h/.local/state/moarchy/user-setup-done

[Service]
Type=oneshot
RemainAfterExit=yes
# A systemd user unit gets neither /etc/profile.d nor the sway session's
# environment, so the paths are named here as well as in the script.
Environment=OMARCHY_PATH=/usr/share/omarchy
Environment=MOARCHY_PATH=/usr/share/moarchy
Environment=PATH=/usr/lib/moarchy/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/lib/moarchy/bin/moarchy-user-setup

[Install]
WantedBy=default.target
