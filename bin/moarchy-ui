#!/bin/bash
# Read and write ~/.config/omarchy/ui.toml -- corners and control center control sizes.
#
# Colours stay in the staged theme (omarchy-theme-set / colors.toml). This
# file is the half that is a preference: how round cards are, how tall the
# control center's sliders and tiles are. The theme switcher, Settings, and an agent
# that edits the path all write the same keys; FileView picks the change up
# with no restart.
#
#   moarchy-ui                         print current "key=value" lines
#   moarchy-ui get corners             large | modest | square
#   moarchy-ui get corners-label       Large | Modest | Square
#   moarchy-ui get control center               roomy | compact
#   moarchy-ui get control center-label         Roomy | Compact
#   moarchy-ui get gesture-bottom      none | app-drawer | workspace-overview | control-center
#   moarchy-ui get gesture-right       the same four
#   moarchy-ui get gesture-summary     "App drawer · Overview"
#   moarchy-ui get gesture-hold        none | agent | a sheet | an app id
#   moarchy-ui get gesture-power       the same
#   moarchy-ui corners modest
#   moarchy-ui control center compact
#   moarchy-ui gesture-bottom workspace-overview
#   moarchy-ui gesture-hold org.gnome.Calls
#   moarchy-ui set sheet 16            numeric override (logical px)

set -euo pipefail

FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/ui.toml"

norm_corners() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    large|round|rounded|big) echo large ;;
    modest|small|little|soft) echo modest ;;
    square|none|off|flat|0) echo square ;;
    *) echo large ;;
  esac
}

norm_density() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    roomy|comfortable|large|big|huge) echo roomy ;;
    compact|small|dense|tight) echo compact ;;
    *) echo roomy ;;
  esac
}

# gestures.md Q1. Words, never plugin ids: Sheet.js is where an id is
# written and this script has no business knowing one. An unreadable value
# is the caller's default rather than `none`, so a typo cannot switch an
# edge off -- Ui.js normTarget() is the same rule on the QML side.
norm_target() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    none|off|nothing) echo none ;;
    app-drawer|moarchy.app-drawer) echo app-drawer ;;
    workspace-overview|moarchy.workspace-overview) echo workspace-overview ;;
    control-center|moarchy.control-center) echo control-center ;;
    *) echo "$2" ;;
  esac
}

# gestures.md Q10. The tap triggers take a wider vocabulary than an edge:
# `none`, `agent`, a sheet word, or any desktop entry id. An id cannot be
# whitelisted -- the set is every app on the phone -- so anything that is not
# one of the known words is passed through untouched, case and all. What a
# value *means* is `moarchy-trigger`'s to decide; this only stores it.
norm_tap() {
  local raw="$1" low
  low=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')
  case "$low" in
    "") printf '%s' "$2" ;;
    none|off|nothing) echo none ;;
    agent) echo agent ;;
    app-drawer|workspace-overview|control-center|themes) printf '%s' "$low" ;;
    *) printf '%s' "$raw" ;;
  esac
}

# The word a row shows. An id stays an id here: the name behind it is in a
# desktop entry that only the shell has read, and `moarchy-trigger label` is
# what asks it.
label_tap() {
  case "$1" in
    none) echo Nothing ;;
    agent) echo "Coding agent" ;;
    app-drawer|workspace-overview|control-center|themes) label_target "$1" ;;
    *) printf '%s' "$1" ;;
  esac
}

label_target() {
  case "$1" in
    none) echo Nothing ;;
    app-drawer) echo "App drawer" ;;
    workspace-overview) echo "Workspace overview" ;;
    control-center) echo "Control Center" ;;
    themes) echo Themes ;;
    *) echo Nothing ;;
  esac
}

label_corners() {
  case "$(norm_corners "$1")" in
    modest) echo Modest ;;
    square) echo Square ;;
    *) echo Large ;;
  esac
}

label_density() {
  case "$(norm_density "$1")" in
    compact) echo Compact ;;
    *) echo Roomy ;;
  esac
}

# Defaults match Ui.js fallback().
corners=large
control_center=roomy
gesture_bottom=app-drawer
gesture_right=workspace-overview
gesture_hold=agent
gesture_power=none
sheet=""
tile=""
card=""
control_center_tile=""
control_center_slider=""
control_center_round=""

read_file() {
  [[ -f $FILE ]] || return 0
  local key raw
  while IFS= read -r line || [[ -n $line ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -n $line && $line != [* ]] || continue
    key="${line%%=*}"
    raw="${line#*=}"
    key="${key%"${key##*[![:space:]]}"}"
    raw="${raw#"${raw%%[![:space:]]*}"}"
    raw="${raw%\"}"
    raw="${raw#\"}"
    raw="${raw%\'}"
    raw="${raw#\'}"
    case $key in
      corners) corners=$(norm_corners "$raw") ;;
      control_center|density) control_center=$(norm_density "$raw") ;;
      sheet) sheet=$raw ;;
      tile) tile=$raw ;;
      card) card=$raw ;;
      control_center_tile|controlCenterTile) control_center_tile=$raw ;;
      control_center_slider|controlCenterSlider) control_center_slider=$raw ;;
      control_center_round|controlCenterRound) control_center_round=$raw ;;
      gesture_bottom|gestureBottom) gesture_bottom=$(norm_target "$raw" appDrawer) ;;
      gesture_right|gestureRight) gesture_right=$(norm_target "$raw" workspaceOverview) ;;
      gesture_hold|gestureHold) gesture_hold=$(norm_tap "$raw" agent) ;;
      gesture_power|gesturePower) gesture_power=$(norm_tap "$raw" none) ;;
    esac
  done <"$FILE"
}

write_file() {
  mkdir -p "$(dirname "$FILE")"
  {
    cat <<'EOF'
# Phone chrome. Independent of the colour theme.
# Colours live in ~/.local/state/omarchy/current/theme/colors.toml
# and change with omarchy-theme-set. This file reshapes the UI.
#
# corners: large | modest | square
# control center:   roomy | compact
#
# Which sheet each swipeable edge raises:
#   gesture_bottom, gesture_right: none | app-drawer | workspace-overview | control-center
#   gesture_hold, gesture_power:   the same, plus agent or an app id
#
# Optional numbers (logical px) override the preset for that key:
#   sheet, tile, card, control_center_tile, control_center_slider, control_center_round

EOF
    printf 'corners = "%s"\n' "$corners"
    printf 'control_center = "%s"\n' "$control_center"
    printf 'gesture_bottom = "%s"\n' "$gesture_bottom"
    printf 'gesture_right = "%s"\n' "$gesture_right"
    printf 'gesture_hold = "%s"\n' "$gesture_hold"
    printf 'gesture_power = "%s"\n' "$gesture_power"
    if [[ -n $sheet ]]; then printf 'sheet = %s\n' "$sheet"; fi
    if [[ -n $tile ]]; then printf 'tile = %s\n' "$tile"; fi
    if [[ -n $card ]]; then printf 'card = %s\n' "$card"; fi
    if [[ -n $control_center_tile ]]; then printf 'control_center_tile = %s\n' "$control_center_tile"; fi
    if [[ -n $control_center_slider ]]; then printf 'control_center_slider = %s\n' "$control_center_slider"; fi
    if [[ -n $control_center_round ]]; then printf 'control_center_round = %s\n' "$control_center_round"; fi
  } >"$FILE"
}

usage() {
  echo "Usage: moarchy-ui [get KEY | corners VALUE | control-center VALUE |" >&2
  echo "                   gesture-bottom VALUE | gesture-right VALUE |" >&2
  echo "                   gesture-hold VALUE | gesture-power VALUE | set KEY NUMBER]" >&2
  echo "  KEY: corners, corners-label, control-center, control-center-label," >&2
  echo "       gesture-bottom, gesture-bottom-label, gesture-right," >&2
  echo "       gesture-right-label, gesture-summary, gesture-hold," >&2
  echo "       gesture-hold-label, gesture-power, gesture-power-label" >&2
  echo "  corners: large | modest | square" >&2
  echo "  control-center:  roomy | compact" >&2
  echo "  gesture: none | app-drawer | workspace-overview | control-center" >&2
  echo "  hold/power also take: agent, or a desktop entry id" >&2
  exit 1
}

read_file

if (($# == 0)); then
  printf 'corners=%s\n' "$corners"
  printf 'control_center=%s\n' "$control_center"
  printf 'gesture_bottom=%s\n' "$gesture_bottom"
  printf 'gesture_right=%s\n' "$gesture_right"
  printf 'gesture_hold=%s\n' "$gesture_hold"
  printf 'gesture_power=%s\n' "$gesture_power"
  if [[ -n $sheet ]]; then printf 'sheet=%s\n' "$sheet"; fi
  if [[ -n $tile ]]; then printf 'tile=%s\n' "$tile"; fi
  if [[ -n $card ]]; then printf 'card=%s\n' "$card"; fi
  if [[ -n $control_center_tile ]]; then printf 'control_center_tile=%s\n' "$control_center_tile"; fi
  if [[ -n $control_center_slider ]]; then printf 'control_center_slider=%s\n' "$control_center_slider"; fi
  if [[ -n $control_center_round ]]; then printf 'control_center_round=%s\n' "$control_center_round"; fi
  exit 0
fi

case "$1" in
get)
  [[ $# -eq 2 ]] || usage
  case "$2" in
    corners) echo "$corners" ;;
    corners-label) label_corners "$corners" ;;
    control-center|control_center|density) echo "$control_center" ;;
    control-center-label|density-label) label_density "$control_center" ;;
    gesture-bottom) echo "$gesture_bottom" ;;
    gesture-right) echo "$gesture_right" ;;
    gesture-bottom-label) label_target "$gesture_bottom" ;;
    gesture-hold) printf '%s\n' "$gesture_hold" ;;
    gesture-power) printf '%s\n' "$gesture_power" ;;
    gesture-hold-label) label_tap "$gesture_hold" ;;
    gesture-power-label) label_tap "$gesture_power" ;;
    gesture-right-label) label_target "$gesture_right" ;;
    # The detail line on the row that opens the pair (settings.md D5).
    gesture-summary)
      # A literal middle dot and not $'\u00b7': bash expands that against the
      # locale, and this runs from a shell with no LANG as often as not.
      printf '%s · %s\n' "$(label_target "$gesture_bottom")" \
                        "$(label_target "$gesture_right")" ;;
    sheet|tile|card|control_center_tile|control_center_slider|control_center_round)
      eval "val=\${$2}"
      echo "$val"
      ;;
    *) usage ;;
  esac
  ;;
corners)
  [[ $# -eq 2 ]] || usage
  corners=$(norm_corners "$2")
  # A preset retake drops numeric overrides for the radii it owns, otherwise
  # "square" with sheet=28 still on disk would not look square.
  sheet=""; tile=""; card=""
  write_file
  echo "$corners"
  ;;
control-center|control_center)
  [[ $# -eq 2 ]] || usage
  control_center=$(norm_density "$2")
  control_center_tile=""; control_center_slider=""; control_center_round=""
  write_file
  echo "$control_center"
  ;;
gesture-bottom)
  [[ $# -eq 2 ]] || usage
  # No companion overrides to drop: unlike `corners` and `control-center`, these two
  # presets own no numeric keys.
  gesture_bottom=$(norm_target "$2" "$gesture_bottom")
  write_file
  echo "$gesture_bottom"
  ;;
gesture-right)
  [[ $# -eq 2 ]] || usage
  gesture_right=$(norm_target "$2" "$gesture_right")
  write_file
  echo "$gesture_right"
  ;;
gesture-hold)
  [[ $# -eq 2 ]] || usage
  gesture_hold=$(norm_tap "$2" "$gesture_hold")
  write_file
  printf '%s\n' "$gesture_hold"
  ;;
gesture-power)
  [[ $# -eq 2 ]] || usage
  gesture_power=$(norm_tap "$2" "$gesture_power")
  write_file
  printf '%s\n' "$gesture_power"
  ;;
set)
  [[ $# -eq 3 ]] || usage
  case "$2" in
    sheet|tile|card|control_center_tile|control_center_slider|control_center_round)
      [[ $3 =~ ^[0-9]+([.][0-9]+)?$ ]] || usage
      eval "$2=\$3"
      write_file
      echo "$3"
      ;;
    *) usage ;;
  esac
  ;;
-h|--help|help) usage ;;
*) usage ;;
esac
