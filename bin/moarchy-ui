#!/usr/bin/env python3
# Read and write ~/.config/omarchy/ui.toml, the UI settings file (docs/home.md §G).
#
# The one writer of that file (HM27). The shell reads it through Ui.js and
# Toml.js and never writes it; Settings, the theme picker and an agent all come
# through here, or edit it by hand.
#
#   moarchy-ui                          the old "key=value" summary
#   moarchy-ui keys                     every key: section.key = value  (default)
#   moarchy-ui get <section>.<key>      one value, e.g. get home.opacity
#   moarchy-ui set <section>.<key> <v>  one value, checked against the packaged
#                                       file's documented keys (HM31)
#   moarchy-ui path                     the file this reads and writes
#
# and the verbs Settings and the theme switcher were written against, kept as
# they were:
#
#   moarchy-ui get corners | corners-label | control-center | control-center-label
#   moarchy-ui get gesture-bottom | gesture-right | gesture-hold | gesture-power
#                  (each also -label) | gesture-summary
#   moarchy-ui get sheet | tile | card | control_center_tile | ...   overrides
#   moarchy-ui corners modest           a preset, which drops its overrides
#   moarchy-ui control-center compact
#   moarchy-ui gesture-bottom workspace-overview
#   moarchy-ui gesture-hold org.gnome.Calls
#   moarchy-ui set sheet 16             a numeric override, logical px
#
# What the file looks like is the packaged /usr/share/moarchy/ui.toml, which is
# also the list of keys that exist: a key written there, set or commented out
# as `# key = default`, is a key this accepts, and nothing else is. One list,
# documented where a person reads it.
#
# A write edits the one line it was asked about and leaves every other line,
# comment and blank line where it was (HM31). A file from before the sections --
# flat `corners = "large"`, `gesture_bottom = ...` -- reads as it always did,
# and the first write moves each flat key into its section (HM29).

import json
import os
import re
import sys
import tomllib

HOME = os.environ.get("HOME", "")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
FILE = os.path.join(CONFIG, "omarchy", "ui.toml")


def packaged_path():
    here = os.path.dirname(os.path.realpath(__file__))
    for p in (os.environ.get("MOARCHY_UI_DEFAULTS", ""),
              os.path.join(os.environ.get("MOARCHY_PATH", "/usr/share/moarchy"), "ui.toml"),
              "/usr/share/moarchy/ui.toml",
              os.path.join(here, "..", "default", "omarchy", "ui.toml")):
        if p and os.path.isfile(p):
            return p
    return ""


SECTIONS = ["shape", "control-center", "gestures", "home"]

# HM29. The flat names a file from before the sections used, and where each
# lives now. Ui.js's `pick()` reads the same names; nothing else knows them.
LEGACY = {
    "corners": ("shape", "corners"),
    "sheet": ("shape", "sheet"),
    "tile": ("shape", "tile"),
    "card": ("shape", "card"),
    "control_center": ("control-center", "density"),
    "controlCenter": ("control-center", "density"),
    "density": ("control-center", "density"),
    "control_center_tile": ("control-center", "tile-height"),
    "controlCenterTile": ("control-center", "tile-height"),
    "control_center_slider": ("control-center", "slider-height"),
    "controlCenterSlider": ("control-center", "slider-height"),
    "control_center_round": ("control-center", "button-size"),
    "controlCenterRound": ("control-center", "button-size"),
    "gesture_bottom": ("gestures", "bottom"),
    "gestureBottom": ("gestures", "bottom"),
    "gesture_right": ("gestures", "right"),
    "gestureRight": ("gestures", "right"),
    "gesture_hold": ("gestures", "hold"),
    "gestureHold": ("gestures", "hold"),
    "gesture_power": ("gestures", "power"),
    "gesturePower": ("gestures", "power"),
}

# Which overrides a preset owns, so choosing the preset again clears them --
# otherwise "square" with sheet = 28 still on disk would not look square.
OWNED = {
    ("shape", "corners"): ["sheet", "tile", "card", "frame"],
    ("control-center", "density"): ["tile-height", "slider-height", "button-size"],
}

# ------------------------------------------------------------------ words
# Ui.js holds the same tables; scripts/test-ui.sh holds the two to each other.

def norm_corners(v):
    n = str(v or "").lower().strip()
    if n in ("large", "round", "rounded", "big"): return "large"
    if n in ("modest", "small", "little", "soft"): return "modest"
    if n in ("square", "none", "off", "flat", "0"): return "square"
    return "large"


def norm_density(v):
    n = str(v or "").lower().strip()
    if n in ("compact", "small", "dense", "tight"): return "compact"
    return "roomy"


TARGETS = ["none", "app-drawer", "app-drawer-minimal", "workspace-overview", "control-center"]
TARGET_LABELS = {"none": "Nothing", "app-drawer": "App drawer",
                 "app-drawer-minimal": "Minimal app drawer",
                 "workspace-overview": "Workspace overview",
                 "control-center": "Control Center", "themes": "Themes"}


# gestures.md Q1. Words, never plugin ids. An unreadable value is the caller's
# default rather than `none`, so a typo cannot switch an edge off.
def norm_target(v, fallback):
    n = str(v or "").lower().strip()
    if n in ("off", "nothing"): n = "none"
    if n.startswith("moarchy."): n = n[len("moarchy."):]
    return n if n in TARGETS else fallback


# Q10. The taps take any desktop id as well, so an unknown value passes
# through rather than falling back -- and desktop ids are case sensitive.
def norm_tap(v, fallback):
    raw = str(v or "").strip()
    n = raw.lower()
    if n == "": return fallback
    if n in ("none", "off", "nothing"): return "none"
    if n == "agent": return "agent"
    if n in TARGETS or n == "themes": return n
    return raw


def label_target(v):
    return TARGET_LABELS.get(v, v)


def label_tap(v):
    if v == "agent": return "Coding agent"
    return TARGET_LABELS.get(v, v)


# ------------------------------------------------------------------ schema

KEY_LINE = re.compile(r"^\s*([A-Za-z0-9_-]+)\s*=\s*(.*?)\s*$")
DOC_LINE = re.compile(r"^\s*#\s*([a-z][a-z0-9-]*)\s*=\s*(\S+)")
HEAD = re.compile(r"^\s*\[\s*([A-Za-z0-9_.-]+)\s*\]\s*(#.*)?$")


def schema():
    """{(section, key): default} from the packaged file: its set keys, and the
    optional ones it documents as `# key = default` inside a section."""
    p = packaged_path()
    if not p:
        die("the packaged ui.toml is missing, so there is no list of keys to check against", 3)
    with open(p, "rb") as f:
        data = tomllib.load(f)
    out = {}
    for sec, table in data.items():
        if isinstance(table, dict):
            for k, v in table.items():
                out[(sec, k)] = v
    sec = None
    for line in open(p, encoding="utf-8"):
        m = HEAD.match(line)
        if m:
            sec = m.group(1)
            continue
        d = DOC_LINE.match(line)
        if sec and d and (sec, d.group(1)) not in out:
            try:
                out[(sec, d.group(1))] = tomllib.loads("v = " + d.group(2))["v"]
            except tomllib.TOMLDecodeError:
                out[(sec, d.group(1))] = d.group(2)
    return out


# ------------------------------------------------------------------ reading

def lenient(text):
    """Toml.flat()'s read: what a hand-edited `corners = large` still means."""
    data, cur = {}, None
    for line in text.splitlines():
        line = re.sub(r"\s+#.*$", "", line).strip()
        if not line or line.startswith("#"):
            continue
        m = HEAD.match(line)
        if m:
            cur = data.setdefault(m.group(1), {})
            continue
        m = KEY_LINE.match(line)
        if not m:
            continue
        v = m.group(2)
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
            v = v[1:-1]
        (cur if cur is not None else data)[m.group(1)] = v
    return data


def read():
    try:
        text = open(FILE, encoding="utf-8").read()
    except FileNotFoundError:
        return {}
    try:
        return tomllib.loads(text)
    except tomllib.TOMLDecodeError:
        return lenient(text)


def value(data, sec, key, default=None):
    """The section's key, else the flat name it had before the sections."""
    t = data.get(sec)
    if isinstance(t, dict) and t.get(key) not in (None, ""):
        return t[key]
    for flat, where in LEGACY.items():
        if where == (sec, key) and data.get(flat) not in (None, "") and not isinstance(data.get(flat), dict):
            return data[flat]
    return default


def effective(data):
    s = schema()
    return {(sec, k): value(data, sec, k, d) for (sec, k), d in s.items()}


def fmt(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, float) and v.is_integer():
        return str(int(v))
    return str(v)


# ------------------------------------------------------------------ writing

def toml_value(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return fmt(v)
    return json.dumps(str(v), ensure_ascii=False)


def load_lines():
    try:
        return open(FILE, encoding="utf-8").read().splitlines()
    except FileNotFoundError:
        p = packaged_path()
        return [
            "# moarchy's UI settings. Every key is optional: one that is not here is",
            "# its default. The keys, their values and their defaults are documented in",
            "# " + (p if p.startswith("/usr") else "/usr/share/moarchy/ui.toml") + ", and `moarchy-ui keys` lists them.",
        ]


def sections_of(lines):
    """[(name, header_index, end_index)] with end exclusive; the top-level
    block before any header is ("", -1, first_header)."""
    heads = [(i, HEAD.match(l).group(1)) for i, l in enumerate(lines) if HEAD.match(l)]
    out = [("", -1, heads[0][0] if heads else len(lines))]
    for n, (i, name) in enumerate(heads):
        end = heads[n + 1][0] if n + 1 < len(heads) else len(lines)
        out.append((name, i, end))
    return out


def find_key(lines, sec, key):
    for name, h, end in sections_of(lines):
        if name != sec:
            continue
        for i in range(h + 1, end):
            m = KEY_LINE.match(lines[i])
            if m and not lines[i].lstrip().startswith("#") and m.group(1) == key:
                return i
    return -1


def set_line(lines, sec, key, v):
    i = find_key(lines, sec, key)
    rendered = key + " = " + toml_value(v)
    if i >= 0:
        # Keep a trailing comment the user wrote on that line.
        m = re.search(r"(\s+#.*)$", lines[i]) if '"' not in lines[i].split("#")[0][-1:] else None
        tail = ""
        if m and lines[i].count('"') % 2 == 0:
            tail = m.group(1)
        lines[i] = rendered + tail
        return
    secs = sections_of(lines)
    for name, h, end in secs:
        if name == sec:
            last = end
            while last - 1 > h and lines[last - 1].strip() == "":
                last -= 1
            lines.insert(last, rendered)
            return
    # A new section, in the order the packaged file has them.
    order = SECTIONS.index(sec) if sec in SECTIONS else len(SECTIONS)
    at = len(lines)
    for name, h, end in secs:
        if name in SECTIONS and SECTIONS.index(name) > order:
            at = h
            break
    block = ["[" + sec + "]", rendered, ""]
    if at > 0 and lines[at - 1].strip() != "":
        block.insert(0, "")
    lines[at:at] = block


def unset_line(lines, sec, key):
    i = find_key(lines, sec, key)
    if i >= 0:
        del lines[i]


def migrate(lines):
    """HM29. Flat keys above the first section move into their sections."""
    top = sections_of(lines)[0]
    moved = []
    for i in range(top[2] - 1, -1, -1):
        m = KEY_LINE.match(lines[i])
        if m and not lines[i].lstrip().startswith("#") and m.group(1) in LEGACY:
            try:
                v = tomllib.loads("v = " + m.group(2))["v"]
            except tomllib.TOMLDecodeError:
                v = m.group(2).strip("\"'")
            moved.append((LEGACY[m.group(1)], v))
            del lines[i]
    for (sec, key), v in reversed(moved):
        if find_key(lines, sec, key) < 0:
            set_line(lines, sec, key, v)


def write(changes, clears=()):
    lines = load_lines()
    migrate(lines)
    for sec, key in clears:
        unset_line(lines, sec, key)
    for (sec, key), v in changes:
        set_line(lines, sec, key, v)
    while lines and lines[-1].strip() == "":
        lines.pop()
    os.makedirs(os.path.dirname(FILE), exist_ok=True)
    with open(FILE, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")


# ------------------------------------------------------------------ checking

RANGES = {
    ("home", "columns"): (2, 12, int), ("home", "opacity"): (0, 1, float),
    ("home", "border"): (0, 8, float), ("home", "gaps-in"): (0, 24, float),
    ("home", "gaps-out"): (0, 48, float), ("home", "recent"): (0, 12, int),
}


def coerce(sec, key, raw, default):
    """A typed value for the key, or exit 2 saying what it takes."""
    if (sec, key) == ("shape", "corners"):
        return norm_corners(raw)
    if (sec, key) == ("control-center", "density"):
        return norm_density(raw)
    if sec == "gestures" and key in ("bottom", "right"):
        n = norm_target(raw, "")
        if not n:
            die(f"{sec}.{key} takes one of: {' | '.join(TARGETS)}", 2)
        return n
    if sec == "gestures":
        return norm_tap(raw, "none")
    if isinstance(default, bool):
        n = str(raw).lower().strip()
        if n in ("true", "yes", "on", "1"): return True
        if n in ("false", "no", "off", "0"): return False
        die(f"{sec}.{key} takes true or false", 2)
    if isinstance(default, (int, float)):
        if not re.fullmatch(r"[0-9]+(\.[0-9]+)?", str(raw).strip()):
            die(f"{sec}.{key} takes a number", 2)
        lo, hi, kind = RANGES.get((sec, key), (0, None, type(default)))
        v = float(raw)
        if (lo is not None and v < lo) or (hi is not None and v > hi):
            die(f"{sec}.{key} takes {lo} to {hi}", 2)
        if kind is int:
            if not v.is_integer():
                die(f"{sec}.{key} takes a whole number", 2)
            return int(v)
        return int(v) if v.is_integer() else v
    return str(raw)


def split_key(dotted):
    if "." not in dotted:
        return None
    sec, key = dotted.split(".", 1)
    return sec, key


def die(msg, code=1):
    print("moarchy-ui: " + msg, file=sys.stderr)
    sys.exit(code)


def usage():
    print("usage: moarchy-ui [keys | path | get KEY | set KEY VALUE |", file=sys.stderr)
    print("                   corners VALUE | control-center VALUE |", file=sys.stderr)
    print("                   gesture-bottom VALUE | gesture-right VALUE |", file=sys.stderr)
    print("                   gesture-hold VALUE | gesture-power VALUE]", file=sys.stderr)
    print("  KEY: <section>.<key> (see `moarchy-ui keys`), or one of corners,", file=sys.stderr)
    print("       control-center, gesture-bottom, gesture-right, gesture-hold,", file=sys.stderr)
    print("       gesture-power (each also -label), gesture-summary, sheet, tile,", file=sys.stderr)
    print("       card, control_center_tile, control_center_slider, control_center_round", file=sys.stderr)
    sys.exit(1)


# ------------------------------------------------------------------ the verbs

def main(argv):
    data = read()
    corners = norm_corners(value(data, "shape", "corners", "large"))
    density = norm_density(value(data, "control-center", "density", "roomy"))
    bottom = norm_target(value(data, "gestures", "bottom", ""), "app-drawer")
    right = norm_target(value(data, "gestures", "right", ""), "workspace-overview")
    hold = norm_tap(value(data, "gestures", "hold", ""), "agent")
    power = norm_tap(value(data, "gestures", "power", ""), "none")
    overrides = {
        "sheet": value(data, "shape", "sheet"), "tile": value(data, "shape", "tile"),
        "card": value(data, "shape", "card"),
        "control_center_tile": value(data, "control-center", "tile-height"),
        "control_center_slider": value(data, "control-center", "slider-height"),
        "control_center_round": value(data, "control-center", "button-size"),
    }
    override_at = {"sheet": ("shape", "sheet"), "tile": ("shape", "tile"), "card": ("shape", "card"),
                   "control_center_tile": ("control-center", "tile-height"),
                   "control_center_slider": ("control-center", "slider-height"),
                   "control_center_round": ("control-center", "button-size")}

    if not argv:
        print(f"corners={corners}")
        print(f"control_center={density}")
        print(f"gesture_bottom={bottom}")
        print(f"gesture_right={right}")
        print(f"gesture_hold={hold}")
        print(f"gesture_power={power}")
        for k, v in overrides.items():
            if v not in (None, ""):
                print(f"{k}={fmt(v)}")
        return

    verb, args = argv[0], argv[1:]

    if verb == "path" and not args:
        print(FILE)
        return

    if verb == "keys" and not args:
        for (sec, key), d in schema().items():
            v = value(data, sec, key, d)
            print(f"{sec}.{key} = {toml_value(v)}" + ("" if v == d else f"  (default {toml_value(d)})"))
        return

    if verb == "get" and len(args) == 1:
        k = args[0]
        simple = {
            "corners": corners, "corners-label": corners.capitalize(),
            "control-center": density, "control_center": density, "density": density,
            "control-center-label": density.capitalize(), "density-label": density.capitalize(),
            "gesture-bottom": bottom, "gesture-right": right,
            "gesture-hold": hold, "gesture-power": power,
            "gesture-bottom-label": label_target(bottom), "gesture-right-label": label_target(right),
            "gesture-hold-label": label_tap(hold), "gesture-power-label": label_tap(power),
            # settings.md D5. A literal middle dot.
            "gesture-summary": f"{label_target(bottom)} · {label_target(right)}",
        }
        if k in simple:
            print(simple[k])
            return
        if k in overrides:
            v = overrides[k]
            print("" if v in (None, "") else fmt(v))
            return
        sk = split_key(k)
        if sk:
            s = schema()
            if sk not in s:
                die(f"no key {k}; `moarchy-ui keys` lists them", 2)
            print(fmt(value(data, sk[0], sk[1], s[sk])))
            return
        usage()

    if verb == "corners" and len(args) == 1:
        v = norm_corners(args[0])
        write([(("shape", "corners"), v)], [("shape", k) for k in OWNED[("shape", "corners")]])
        print(v)
        return

    if verb in ("control-center", "control_center") and len(args) == 1:
        v = norm_density(args[0])
        write([(("control-center", "density"), v)],
              [("control-center", k) for k in OWNED[("control-center", "density")]])
        print(v)
        return

    if verb in ("gesture-bottom", "gesture-right") and len(args) == 1:
        cur = bottom if verb == "gesture-bottom" else right
        v = norm_target(args[0], cur)
        write([(("gestures", verb.split("-")[1]), v)])
        print(v)
        return

    if verb in ("gesture-hold", "gesture-power") and len(args) == 1:
        cur = hold if verb == "gesture-hold" else power
        v = norm_tap(args[0], cur)
        write([(("gestures", verb.split("-")[1]), v)])
        print(v)
        return

    if verb == "set" and len(args) == 2:
        k, raw = args
        if k in override_at:
            if not re.fullmatch(r"[0-9]+(\.[0-9]+)?", raw):
                usage()
            v = float(raw)
            v = int(v) if v.is_integer() else v
            write([(override_at[k], v)])
            print(fmt(v))
            return
        sk = split_key(k)
        if not sk:
            usage()
        s = schema()
        if sk not in s:
            near = sorted(key for (sec, key) in s if sec == sk[0])
            if near:
                die(f"no key {k}; [{sk[0]}] has: {', '.join(near)}", 2)
            die(f"no section [{sk[0]}]; the sections are: {', '.join(SECTIONS)}", 2)
        v = coerce(sk[0], sk[1], raw, s[sk])
        clears = [(sk[0], o) for o in OWNED.get(sk, [])]
        write([(sk, v)], clears)
        print(fmt(v))
        return

    if verb in ("-h", "--help", "help"):
        usage()
    usage()


if __name__ == "__main__":
    main(sys.argv[1:])
