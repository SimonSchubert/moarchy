#!/bin/bash
# Assert the phone UI is actually wired up, on the running session.
#
# Every regression this stack has hit was silent: the swipe still answered "ok"
# while nothing happened, the keyboard still drew while refusing to retract, the
# launcher still reported success with its binary missing from PATH. None of
# them showed up as an error anywhere, and all of them were found by hand.
#
# So each check here is one of those failures, turned into a question with a
# yes/no answer. Run it after touching autostart.conf, the plugin, or the shell.
#
# Read-only apart from hiding the on-screen keyboard, which the checks need in a
# known state and which the next text field will undo.
#
# Four opt-in suites take a flag, because each needs more than a read:
#
#   --gestures   drives real touch through /dev/uinput. Needs root and
#                python-evdev, and closes a window at the end.
#   --settings   walks the Settings stack over IPC, against docs/settings.md.
#                Flips three switches and restores them; launches nothing.
#   --surfaces   checks what the gesture strip is drawn over, against
#                docs/gestures.md I. Opens every overlay in turn and takes one
#                grim capture per sheet; I5 also needs the touch injector.
#   --windows    the window area and the launch splash, against docs/windows.md.
#                Opens a terminal and an app and closes both again, and turns
#                gaps on for a second. Takes about a minute: L6 is a 15s
#                timeout that has to be waited out.

set -uo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
[[ -n ${SWAYSOCK:-} ]] || SWAYSOCK=$(ls "$XDG_RUNTIME_DIR"/sway-ipc.* 2>/dev/null | head -1)
export SWAYSOCK

# Exported, not just set: omarchy-shell reads OMARCHY_PATH to find the running
# shell, and without it in the environment every IPC check below reports the
# plugin missing when it is loaded and fine.
export OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
export PATH="$HOME/.local/bin:$HOME/.local/share/mobileomarchy/bin:$OMARCHY_PATH/bin:$PATH"

pass=0
fail=0

ok()   { printf '  \033[32mPASS\033[0m  %s\n' "$1"; pass=$((pass + 1)); }
no()   { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; [[ -n ${2:-} ]] && printf '        %s\n' "$2"; fail=$((fail + 1)); }
head_() { printf '\n%s\n' "$1"; }

# --- the session is there at all -------------------------------------------
head_ "session"

if pgrep -x sway >/dev/null; then ok "sway is running"; else no "sway is not running"; fi

# An on-screen keyboard, not a *named* one. This asserted `squeekboard` by
# process name and went red the moment the keyboard was replaced -- reporting a
# working phone as broken, and naming the wrong thing as the cause. The
# invariant is the contract: something owns sm.puri.OSK0 and answers on it,
# which is what mobileomarchy-toggle-keyboard and the back gesture both drive.
#
# The same mistake in the other direction cost a peer session an afternoon: its
# suite confidently reported on squeekboard while a different implementation
# owned the name. Assert the interface, not the implementation.
if osk_owner=$(busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 \
                 sm.puri.OSK0 Visible 2>/dev/null) && [[ -n $osk_owner ]]; then
  ok "an on-screen keyboard owns sm.puri.OSK0 ($(pgrep -a -x 'squeekboard|moarchy-keyboar' 2>/dev/null | head -1 | cut -d" " -f2- || echo present))"
else
  no "nothing owns sm.puri.OSK0" "no on-screen keyboard is running, so typing is impossible"
fi
if pgrep -f 'quickshell' >/dev/null; then ok "the shell is running"; else no "the shell is not running"; fi
if pgrep -f one-app-per-workspace >/dev/null; then
  ok "one-app-per-workspace is running"
else
  no "one-app-per-workspace is not running" "new windows will tile at ~180px instead of taking a workspace"
fi

# lisgd bound the same bottom edge as the gesture plugin, so both fired on one
# swipe: the menu opened and the keyboard toggled at the same time.
if pgrep -x lisgd >/dev/null; then
  no "lisgd is running" "it double-binds the bottom edge against the gesture plugin; kill it"
else
  ok "lisgd is not running (no double-bound edge)"
fi

# --- the shell can reach the things it shells out to ------------------------
head_ "shell environment"

# A shell restarted without the session environment gets
# /usr/local/sbin:/usr/local/bin:/usr/bin, and then every omarchy-* call it
# makes fails with 127 while the gesture still answers "ok".
shell_pid=$(pgrep -f 'quickshell' | head -1)
if [[ -n $shell_pid ]] && shell_path=$(tr '\0' '\n' <"/proc/$shell_pid/environ" 2>/dev/null | sed -n 's/^PATH=//p'); then
  if [[ $shell_path == *"$OMARCHY_PATH/bin"* ]]; then
    ok "the shell's PATH carries the omarchy bins"
  else
    no "the shell's PATH is missing $OMARCHY_PATH/bin" \
       "restart it with: swaymsg exec mobileomarchy-restart-shell"
  fi
else
  no "cannot read the shell's environment"
fi

if [[ -x $OMARCHY_PATH/bin/omarchy-menu ]]; then
  ok "omarchy-menu exists where the plugin calls it"
else
  no "omarchy-menu is missing from $OMARCHY_PATH/bin"
fi

# --- the gesture plugin -----------------------------------------------------
head_ "gesture plugin"

if status=$(timeout 5 omarchy-shell gestures status 2>/dev/null) && [[ -n $status ]]; then
  ok "gestures IPC answers ($status)"
else
  no "gestures IPC does not answer" "the plugin is not loaded; check shell.json plugins[]"
fi

# Declared as a service the plugin was mounted twice and drew two stacked pills.
kinds=$(python3 - <<'PY' 2>/dev/null
import json, os
p = os.path.expanduser("~/.config/omarchy/plugins/mobileomarchy.gestures/manifest.json")
try:
    print(",".join(json.load(open(p)).get("kinds", [])))
except Exception:
    pass
PY
)
if [[ $kinds == "panel" ]]; then
  ok "the plugin is declared as a panel (mounted once)"
else
  no "the plugin declares kinds=[${kinds:-?}]" "a service-kind plugin is mounted twice and draws two pills"
fi

# --- the phone shell plugins ------------------------------------------------
head_ "phone shell"

# The single most important check in this file. A bar plugin that fails to load
# is nearly silent: the host logs one console.warn and falls back to
# omarchy.bar, so the phone still boots with a working -- if wrong -- bar. The
# only visible symptom is thirteen desktop widgets crammed into 360px, and the
# only diagnosis is the shell log, which is why mobileomarchy-restart-shell now
# keeps one. Asking "is a bar running" would pass in exactly that case, so ask
# which bar.
active_bar=$(timeout 5 omarchy-shell shell listPlugins 2>/dev/null | python3 -c '
import json, sys
try:
    for p in json.load(sys.stdin):
        if "bar" in (p.get("kinds") or []) and p.get("active"):
            print(p["id"]); break
except Exception:
    pass
' 2>/dev/null)
if [[ $active_bar == "mobileomarchy.bar" ]]; then
  ok "the phone bar is the active bar"
  # ...but "active" is the host's answer from shell.json, not proof the QML
  # compiled. A broken Bar.qml leaves that check green with the bar drawing
  # nothing, so ask the bar itself: an IPC answer can only come from an
  # instantiated component.
  bar_metrics=$(timeout 5 omarchy-shell bar metrics 2>/dev/null)
  bar_weight=$(sed -n 's/.*weight=\([0-9]*\).*/\1/p' <<<"$bar_metrics")
  if [[ -z $bar_metrics || $bar_metrics == *"not found"* ]]; then
    no "the bar plugin does not answer IPC" \
       "Bar.qml failed to load; the host has fallen back and the bar is drawing nothing"
  elif [[ -n $bar_weight ]] && (( bar_weight >= 500 )); then
    ok "the bar is loaded and drawing ($bar_metrics)"
  else
    no "the bar answers but its text weight is ${bar_weight:-?}" \
       "under 500 is the thin clock the DemiBold change was for"
  fi
else
  no "the active bar is ${active_bar:-none}" \
     "the shell fell back to omarchy.bar; grep 'failed to load' ~/.local/state/mobileomarchy/shell.log"
fi

# The two plugin kinds are enabled by different keys, and crossing them is a
# silent no-op: a bar plugin answers to shell.json's bar.id and never looks at
# plugins[], everything else is the other way round.
bar_id=$(python3 -c '
import json, os
try:
    print(json.load(open(os.path.expanduser("~/.config/omarchy/shell.json"))).get("bar", {}).get("id", ""))
except Exception:
    pass
' 2>/dev/null)
if [[ $bar_id == "mobileomarchy.bar" ]]; then
  ok "shell.json names the phone bar"
else
  no "shell.json bar.id is '${bar_id:-unset}'" \
     "omarchy-refresh-shell runs 'omarchy bar defaults', which drops bar.id entirely"
fi

# Same doubling trap as the gestures plugin, one level along: an overlay
# declared as a service gets two surfaces, and for the shade that means two
# grab strips fighting over the top edge.
for plugin in mobileomarchy.drawer mobileomarchy.recents mobileomarchy.shade \
              mobileomarchy.themes mobileomarchy.settings mobileomarchy.device; do
  k=$(python3 -c '
import json, os, sys
p = os.path.expanduser("~/.config/omarchy/plugins/%s/manifest.json" % sys.argv[1])
try:
    print(",".join(json.load(open(p)).get("kinds", [])))
except Exception:
    pass
' "$plugin" 2>/dev/null)
  if [[ $k == "overlay" ]]; then
    ok "$plugin is declared as an overlay"
  else
    no "$plugin declares kinds=[${k:-?}]" "expected overlay; a service-kind plugin is mounted twice"
  fi
done

for target in drawer recents shade themes settings device; do
  if st=$(timeout 5 omarchy-shell "$target" state 2>/dev/null) && [[ -n $st ]]; then
    ok "$target IPC answers ($st)"
  else
    no "$target IPC does not answer" "the plugin is missing from shell.json plugins[], or it failed to load"
  fi
done

# Two ways an icon silently becomes the wrong icon, both of which have happened
# here:
#
#   - `\uXXXX` in QML takes exactly four hex digits, so a codepoint above the
#     BMP written as an escape is truncated and the fifth digit is left behind
#     as a literal character. Checking that *something* covers the truncated
#     codepoint does not catch this -- Nerd Fonts cover the low private use
#     area too, so U+F0249 truncated to U+F024 still resolves, and still draws
#     the wrong glyph with a "9" after it. What does catch it is the invariant
#     these strings actually have: an icon literal is exactly one character.
#   - a font change, or a fresh install before fc-cache has run, drops the icon
#     range entirely and every glyph becomes a blank box. That one is a
#     coverage question, so ask fontconfig.
#
# Neither logs anything, hence both.
glyph_problem=$(python3 - "$HOME/.config/omarchy/plugins" <<'PY' 2>/dev/null
import glob, os, re, subprocess, sys

# The private use areas Nerd Fonts pack their icons into.
def is_icon(ch):
    return 0xE000 <= ord(ch) <= 0xF8FF or 0xF0000 <= ord(ch) <= 0xFFFFD

problems = []
codepoints = set()

for path in sorted(glob.glob(os.path.join(sys.argv[1], "mobileomarchy.*", "*.qml"))):
    name = os.path.basename(path)
    for n, line in enumerate(open(path, encoding="utf-8"), 1):
        for literal in re.findall(r'"([^"\\]*)"', line):
            icons = [c for c in literal if is_icon(c)]
            if not icons:
                continue
            codepoints.update(ord(c) for c in icons)
            if len(literal) != 1:
                problems.append("%s:%d %r" % (name, n, literal))

for cp in sorted(codepoints):
    out = subprocess.run(["fc-match", ":charset=%X" % cp],
                         capture_output=True, text=True).stdout
    if "Nerd Font" not in out and "omarchy" not in out:
        problems.append("no icon font covers U+%05X" % cp)

print("; ".join(problems))
PY
)
if [[ -z ${glyph_problem// /} ]]; then
  ok "every icon literal is a single glyph in an installed icon font"
else
  no "icon literals: $glyph_problem" \
     "a truncated \\uXXXX escape leaves the fifth hex digit in the string"
fi

# --- the drawer actually reserves its strip ---------------------------------
head_ "drawer geometry"

# The exclusive zone is the whole point: it is what keeps the drawer out from
# under the on-screen keyboard. Sway hands the rest to the workspace, so the
# space below the workspace is what the drawer reserved -- its ~20px zone plus
# the config's gap. Mounted twice, that figure doubles, which is what two
# stacked pills looked like from the outside.
#
# Hide the keyboard first: while it is up it reserves the bottom too, and the
# number means nothing.
busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 SetVisible b false >/dev/null 2>&1
sleep 1

read -r out_h top bottom < <(python3 - <<'PY' 2>/dev/null
import json, subprocess
def sway(kind):
    return json.loads(subprocess.run(["swaymsg", "-t", kind], capture_output=True, text=True).stdout)
out = next((o for o in sway("get_outputs") if o.get("active")), None)
ws = next((w for w in sway("get_workspaces") if w.get("focused")), None)
if out and ws:
    h, r = out["rect"]["height"], ws["rect"]
    print(h, r["y"], h - (r["y"] + r["height"]))
else:
    print(0, 0, 0)
PY
)
if (( ${out_h:-0} == 0 )); then
  no "cannot read output geometry"
else
  if (( top >= 20 && top <= 40 )); then
    ok "the bar reserves ${top}px at the top"
  else
    no "the bar reserves ${top}px at the top" "expected roughly 26"
  fi
  if (( bottom >= 15 && bottom <= 32 )); then
    ok "the drawer reserves ${bottom}px at the bottom"
  elif (( bottom > 32 )); then
    no "the drawer reserves ${bottom}px -- about double" \
       "the plugin is mounted more than once, or the keyboard did not retract"
  else
    no "the drawer reserves only ${bottom}px" \
       "the exclusive zone is missing; the keyboard will bury the drawer"
  fi
fi

# --- the on-screen keyboard -------------------------------------------------
head_ "on-screen keyboard"

if busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 Visible >/dev/null 2>&1; then
  ok "the keyboard owns sm.puri.OSK0"
else
  no "sm.puri.OSK0 is not on the bus" "squeekboard is not running, so \$mod+i does nothing"
fi

# Both gated squeekboard, which defaulted off outside GNOME/Phosh and would
# otherwise start, bind the input method, and silently never draw. Kept because
# they are cheap and a keyboard that needs them is still supported; a keyboard
# that does not need them is unaffected by their being set.
if [[ $(gsettings get org.gnome.desktop.a11y.applications screen-keyboard-enabled 2>/dev/null) == "true" ]]; then
  ok "screen-keyboard-enabled is true"
else
  no "screen-keyboard-enabled is false" "gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled true"
fi
if [[ $(gsettings get org.gnome.desktop.input-sources sources 2>/dev/null) == "@a(ss) []" ]]; then
  no "no input source is configured" "squeekboard logs 'No system layout present' and draws nothing"
else
  ok "an input source is configured"
fi

# --- real touch, opt-in ------------------------------------------------------
# Off by default because it needs root for /dev/uinput and it closes a window at
# the end. With it, every gesture is checked the way a thumb would drive it
# rather than through the IPC shortcut -- which is the only way the touch path
# itself is ever exercised.
if [[ ${1:-} == "--gestures" ]]; then
  head_ "gestures (synthetic touch)"

  # Every check below names the acceptance criterion it proves, from
  # docs/gestures.md. That file is the contract; this is the part of it a
  # machine can check. An AC with no check here is visible by its absence --
  # which matters, because the last version of this suite passed 37/37 on
  # behaviour that was wrong: the tests had been written to match the code
  # rather than the spec, so green meant nothing.

  # Without this, `foot` below silently fails to map and every check that
  # needs a window on screen fails for a reason that has nothing to do with
  # gestures -- the shell reports focus=none and reads like a broken plugin.
  # A session shell inherits it; an ssh session does not.
  : "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
  export XDG_RUNTIME_DIR
  export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-$(basename "$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9] 2>/dev/null | head -1)" 2>/dev/null)}"

  touch_bin="$HOME/.local/share/mobileomarchy/bin/mobileomarchy-touch"
  ws() { swaymsg -t get_workspaces | python3 -c 'import json,sys; print(([w["name"] for w in json.load(sys.stdin) if w["focused"]] or [""])[0])'; }
  # Sway's own layout string for the focused workspace -- "V[foot]" with a
  # window on it, empty without. Read here through swaymsg, never through the
  # shell, so the check is independent of the thing under test.
  ws_rep() { swaymsg -t get_workspaces | python3 -c 'import json,sys; print(([w.get("representation") or "" for w in json.load(sys.stdin) if w["focused"]] or [""])[0])'; }
  scratch() { pgrep -fc "foot --app-id=moa-selftest" || true; }
  # The app Sway currently has focused, or empty. Read from the tree rather
  # than from the shell, so a check never confirms itself.
  focused_app() { swaymsg -t get_tree | python3 -c '
import json,sys
found = []
def walk(n):
    if n.get("focused") and n.get("app_id"): found.append(n["app_id"])
    for k in ("nodes", "floating_nodes"):
        for c in n.get(k, []): walk(c)
walk(json.load(sys.stdin))
print(found[0] if found else "")'; }
  cards() { timeout 8 omarchy-shell recents list 2>/dev/null | grep -c . || true; }

  # Right after a full-screen surface maps on this GPU the shell can be busy
  # for long enough that omarchy-shell gives up and prints nothing. An empty
  # answer is not "closed" -- it is "ask again".
  shell_state() {
    local target=$1 out
    for _ in 1 2 3; do
      if out=$(timeout 8 omarchy-shell "$target" state 2>/dev/null) && [[ -n $out ]]; then
        echo "$out"; return
      fi
      sleep 1
    done
    echo "unknown"
  }

  # Panel pixels; the output is scaled 2, so every figure is twice the logical
  # travel the plugin sees. Against a 324 logical pullTravel:
  #   60  panel =  30 logical =  9%  -> under the 15% recents commit
  #   300 panel = 150 logical = 46%  -> recents (tops out at 40%)
  #   560 panel = 280 logical = 86%  -> home (commits at 75%)
  # All dragged over 2000ms, ~0.08 logical px/ms, an order of magnitude under
  # the 0.6 fling threshold -- so these test the distance bands, which is the
  # whole point of the bands being distance-only.
  STRIP_Y=1420

  ac() { printf '  \033[90m%-4s\033[0m ' "$1"; }
  okac()  { ac "$1"; shift; ok "$@"; }
  noac()  { ac "$1"; shift; no "$@"; }

  if [[ ! -x $touch_bin ]]; then
    no "mobileomarchy-touch is missing" "cannot drive touch without it"
  elif ! sudo -n true 2>/dev/null; then
    no "passwordless sudo is unavailable" "/dev/uinput is root-only, so touch cannot be synthesised"
  else
    # Powering the panel back on is not enough: mobileomarchy-screen turns the
    # touch input off with it, so after an idle blank every synthetic swipe
    # lands nowhere and the whole suite fails for a reason that has nothing to
    # do with gestures.
    swaymsg "output * power on" >/dev/null 2>&1
    swaymsg "input type:touch events enabled" >/dev/null 2>&1

    # Start from a bare screen. Anything left open changes what the strip's
    # up-drag *means* -- with the shade down it correctly means "put that away"
    # (A8), so the recents drag never latches and A1/A3 reports 0 samples. That
    # is the gesture behaving exactly as specified, failing a check that assumed
    # nothing was on screen. A suite that inherits the last session's state is
    # measuring the last session.
    for overlay in shade drawer recents themes settings; do
      timeout 8 omarchy-shell "$overlay" close >/dev/null 2>&1
    done
    sleep 2

    for _ in 1 2; do
      setsid foot --app-id=moa-selftest -e sh -c 'while :; do sleep 300; done' >/dev/null 2>&1 </dev/null &
      sleep 4
    done
    start_ws=$(ws)

    # --- B. strip, sideways ------------------------------------------------
    sudo -n "$touch_bin" swipe 550 $STRIP_Y 120 $STRIP_Y 250 >/dev/null 2>&1
    sleep 2
    if [[ $(ws) != "$start_ws" ]]; then
      okac B1 "swipe left changes workspace"
    else
      noac B1 "swipe left did nothing"
    fi

    sudo -n "$touch_bin" swipe 120 $STRIP_Y 550 $STRIP_Y 250 >/dev/null 2>&1
    sleep 2
    if [[ $(ws) == "$start_ws" ]]; then
      okac B1 "swipe right changes it back"
    else
      noac B1 "swipe right did not return to $start_ws"
    fi

    # --- C. no hold-to-close ----------------------------------------------
    before=$(scratch)
    sudo -n "$touch_bin" hold 360 $STRIP_Y 2000 >/dev/null 2>&1
    sleep 3
    if [[ $(scratch) == "$before" ]]; then
      okac C1 "a 2s hold on the strip closes nothing"
    else
      noac C1 "holding on the strip closed a window" \
              "hold-to-close was removed; nothing on the strip may close a window"
    fi

    # --- A. strip, up ------------------------------------------------------
    timeout 8 omarchy-shell recents close >/dev/null 2>&1; sleep 2
    sudo -n "$touch_bin" swipe 360 $STRIP_Y 360 1360 900 >/dev/null 2>&1
    sleep 3
    if [[ $(shell_state recents) == "closed" ]]; then
      okac A2 "a short drag springs back"
    else
      noac A2 "a 9% drag left recents $(shell_state recents)"
    fi

    sudo -n "$touch_bin" swipe 360 $STRIP_Y 360 1120 2000 >/dev/null 2>&1
    sleep 3
    samples=$(timeout 8 omarchy-shell recents dragTrace 2>/dev/null | wc -w)
    if [[ $(shell_state recents) == "open" ]] && (( samples >= 8 )); then
      okac A1/A3 "the recents band opens the carousel ($samples samples)"
    else
      noac A1/A3 "the recents drag left $samples samples and state $(shell_state recents)" \
                 "under 8 means it jumped to open rather than following the drag"
    fi

    # A5 is the correction this whole rewrite exists for: the strip must never
    # bring the drawer up, in any state.
    if [[ $(shell_state drawer) == "closed" ]]; then
      okac A5 "the strip did not open the drawer"
    else
      noac A5 "an up-swipe from the strip opened the drawer" \
              "the strip is recents-then-home only; the drawer is a home-screen gesture"
    fi

    # --- E. the carousel ---------------------------------------------------
    before=$(cards)
    sudo -n "$touch_bin" swipe 360 704 360 300 400 >/dev/null 2>&1
    sleep 3
    after=$(cards)
    if (( after == before - 1 )); then
      okac E3 "flicking a card up closes that app ($before -> $after)"
    else
      noac E3 "the card count went $before -> $after" \
              "expected one fewer; a horizontal steal by the pager leaves it unchanged"
    fi

    sudo -n "$touch_bin" tap 360 704 >/dev/null 2>&1
    sleep 3
    if [[ $(shell_state recents) == "closed" ]] && [[ -n $(ws_rep) ]]; then
      okac E2 "tapping a card focuses that app"
    else
      noac E2 "recents is $(shell_state recents), workspace holds '$(ws_rep)'"
    fi

    # --- A4/F. home --------------------------------------------------------
    timeout 8 omarchy-shell recents close >/dev/null 2>&1; sleep 2
    before=$(cards)
    sudo -n "$touch_bin" swipe 360 $STRIP_Y 360 860 2000 >/dev/null 2>&1
    sleep 3
    if [[ -z $(ws_rep) ]] && [[ $(shell_state recents) == "closed" ]]; then
      okac A4 "the home band lands on a blank workspace"
    else
      noac A4 "the home drag left workspace $(ws) holding '$(ws_rep)'"
    fi
    # F2 says going home never *closes* anything, so that is what is asserted.
    # Requiring the count to be unchanged also fails when something unrelated
    # launches mid-run -- a leftover app finishing its start-up was enough --
    # and that is not what this criterion is about.
    after=$(cards)
    if (( after >= before )); then
      okac F2 "going home closed nothing ($before apps still open)"
    else
      noac F2 "the app count dropped going home: $before -> $after"
    fi

    # --- D. the home screen ------------------------------------------------
    # The drag that used to be tested on the strip. It has to work here now,
    # and only here. Panel y 700 is the middle of the wallpaper.
    sudo -n "$touch_bin" swipe 360 700 360 200 2000 >/dev/null 2>&1
    sleep 3
    samples=$(timeout 8 omarchy-shell drawer dragTrace 2>/dev/null | wc -w)
    if [[ $(shell_state drawer) == "open" ]] && (( samples >= 8 )); then
      okac D1 "dragging up on the workspace opens the drawer ($samples samples)"
    else
      noac D1 "the workspace drag left $samples samples and state $(shell_state drawer)" \
              "the drawer is opened by dragging the home screen itself, not the strip"
    fi

    # --- A7. the strip clears what is covering the screen ------------------
    # The drawer is up from D1. An up-flick from the strip has to put it away
    # -- and, with A5, must never be able to bring it back.
    sudo -n "$touch_bin" swipe 360 $STRIP_Y 360 1160 600 >/dev/null 2>&1
    sleep 3
    if [[ $(shell_state drawer) == "closed" ]]; then
      okac A7 "an up-flick from the strip puts the drawer away"
    else
      noac A7 "the drawer is $(shell_state drawer) after an up-flick"
    fi
    # Put it back for the G3 check below.
    sudo -n "$touch_bin" swipe 360 700 360 200 2000 >/dev/null 2>&1
    sleep 3

    # --- H7. swipe a notification away ------------------------------------
    # The only per-card dismissal there is, now that the close button is gone,
    # so a swipe that does not land means a notification that cannot be
    # dismissed at all. Posted rather than waited for: a suite that needs a
    # real notification to arrive on its own tests nothing most of the time.
    notify-send "moa-selftest" "swipe me away" >/dev/null 2>&1
    sleep 3
    timeout 8 omarchy-shell shade open >/dev/null 2>&1
    sleep 3
    before_n=$(timeout 8 omarchy-shell shade notifications 2>/dev/null | grep -c . || true)
    if (( before_n == 0 )); then
      no "no notification to swipe, so H7 cannot be tested" \
         "notify-send produced nothing the shade could see"
    else
      # Sideways across a card. The list is at the top, so the first card sits
      # just under the header.
      # y=770 is the first card's middle with one notification posted. Below
      # the last card the sheet ends and the scrim begins, and a swipe there
      # reads as a tap on the scrim and closes the shade -- which looks like
      # the swipe having some wild side effect rather than having missed.
      sudo -n "$touch_bin" swipe 200 770 660 770 400 >/dev/null 2>&1
      sleep 3
      after_n=$(timeout 8 omarchy-shell shade notifications 2>/dev/null | grep -c . || true)
      if (( after_n == before_n - 1 )); then
        okac H7 "swiping a notification card dismisses it ($before_n -> $after_n)"
      else
        noac H7 "the notification count went $before_n -> $after_n" \
                "with no close button, a swipe that does not land leaves it undismissable"
      fi
    fi
    timeout 8 omarchy-shell shade close >/dev/null 2>&1
    sleep 2

    # --- G. back -----------------------------------------------------------
    # With the drawer up, back closes the overlay and leaves the apps alone.
    before=$(cards)
    sudo -n "$touch_bin" swipe 4 700 200 700 300 >/dev/null 2>&1
    sleep 3
    if [[ $(shell_state drawer) == "closed" ]] && (( $(cards) == before )); then
      okac G3 "back closes the overlay and leaves the apps alone"
    else
      noac G3 "drawer is $(shell_state drawer), apps went $before -> $(cards)"
    fi

    # G2 before G4, because back is a priority order and the keyboard outranks
    # the app. Forced rather than observed: whether foot has raised squeekboard
    # is not something this suite should be at the mercy of, and an unforced
    # run of this check is what made G4 look broken when it was obeying G2.
    osk() { busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 SetVisible b "$1" >/dev/null 2>&1; }
    osk_visible() { busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 Visible 2>/dev/null; }

    swaymsg '[app_id=moa-selftest] focus' >/dev/null 2>&1
    sleep 2
    osk true; sleep 2
    before=$(cards)
    if [[ $(osk_visible) == *true* ]]; then
      sudo -n "$touch_bin" swipe 4 700 200 700 300 >/dev/null 2>&1
      sleep 3
      if [[ $(osk_visible) != *true* ]] && (( $(cards) == before )); then
        okac G2 "back dismisses the keyboard and leaves the app open"
      else
        noac G2 "keyboard is $(osk_visible), apps went $before -> $(cards)" \
                "the keyboard outranks the app; back must not close one to hide the other"
      fi
    else
      no "the on-screen keyboard would not come up" "cannot test the back priority order without it"
    fi

    # And with nothing above it, back asks the app to close.
    #
    # Focus first, keyboard down second, and that order matters: focusing a
    # terminal makes it advertise a text field and squeekboard comes straight
    # back up. Dismissing the keyboard before focusing left it up again by the
    # time the swipe landed, so back correctly took the G2 branch and this
    # check failed on behaviour that was right.
    swaymsg '[app_id=moa-selftest] focus' >/dev/null 2>&1
    sleep 2
    osk false; sleep 2
    before=$(cards)
    # G4 needs a focused window, and that precondition can fail on its own.
    # Sway can end up with the workspace focused and no window inside it
    # focused -- `[app_id=...] focus` then reports success and changes
    # nothing. Back is right to do nothing there (G5: no app, nothing to
    # close), so without this the check blames the gesture for a seat state it
    # did not cause.
    if [[ -z $(focused_app) ]]; then
      no "no window is focused, so G4 cannot be tested" \
         "Sway reports the workspace focused but no window in it; see build-log 6g"
    else
      sudo -n "$touch_bin" swipe 4 700 200 700 300 >/dev/null 2>&1
      sleep 3
      if (( $(cards) == before - 1 )); then
        okac G4 "back closes the focused app ($before -> $(cards))"
      else
        noac G4 "the app count went $before -> $(cards)" \
                "a left-edge swipe on an app has to close it"
      fi
    fi

    # A short drag from the edge must not.
    osk false; sleep 1
    swaymsg '[app_id=moa-selftest] focus' >/dev/null 2>&1
    sleep 2
    before=$(cards)
    sudo -n "$touch_bin" swipe 4 700 30 700 300 >/dev/null 2>&1
    sleep 3
    if (( $(cards) == before )); then
      okac G6 "brushing the edge closes nothing"
    else
      noac G6 "a 13-logical-px drag from the edge closed an app"
    fi
  fi
  pkill -f "foot --app-id=moa-selftest" 2>/dev/null

  # An AC with no check here is a gap, and a gap nobody can see is the same as
  # a gap nobody fixed. These are the ones this suite does not prove:
  #
  #   A6      carousel open, drag up again -> home
  #   A8      shade down, up-flick puts it away
  #   A9      no apps open at all -> nothing. Needs every window on the device
  #           closed, including the user's, so it is not run here.
  #   B2      a curved thumb swipe still resolves
  #   D2/D3   drawer springs back; a drag on an app does nothing
  #   D4      sideways/down on the home screen do nothing
  #   E1/E4   card order and paging -- both visual
  #   E5/E6   dismiss returns you; last card goes home
  #   E7/G5   absences, and a close-request that only a prompting app shows
  #   F1      home picks the lowest free workspace
  #   G7/G8/G9 constants, not behaviour
  printf '  \033[90m%-4s\033[0m   \033[90mnot covered: A6 A8 A9 B2 D2 D3 D4 E1 E4 E5 E6 E7 F1 G5 G7 G8 G9\033[0m\n' ""
fi

# ---------------------------------------------------------------------------
# --settings: the Settings stack, against docs/settings.md
# ---------------------------------------------------------------------------
# Every check cites an AC id, so an AC with no check is visible at the end.
# Read-only except for three switch flips, each restored; nothing here reboots,
# logs out or installs -- the rows that would are exercised through dryRun,
# which records the command line instead of running it.
if [[ ${1:-} == "--settings" ]]; then
  head_ "settings"

  s() { timeout 5 omarchy-shell settings "$@" 2>/dev/null; }

  if ! st=$(s state) || [[ -z $st ]]; then
    no "I1 settings IPC does not answer" \
       "the plugin is missing from shell.json plugins[], or it failed to load"
    printf '\n%d passed, %d failed\n' "$pass" "$fail"
    exit 1
  fi
  ok "I1 settings IPC answers ($st)"

  # --- A. getting in and out ------------------------------------------------
  s close >/dev/null; sleep 1
  s open  >/dev/null; sleep 2
  [[ $(s state) == open && $(s page) == root ]] \
    && ok "A1 the gear opens Settings at the root" \
    || no "A1 open did not land on root" "page=$(s page) state=$(s state)"

  others=""
  for p in shade drawer recents themes; do
    [[ $(timeout 5 omarchy-shell "$p" state 2>/dev/null) == open ]] && others="$others $p"
  done
  [[ -z $others ]] && ok "A2 no other full-screen surface is up" \
                   || no "A2 still open:$others" "open() must hide the others"

  [[ $(s openAt nope) == "unknown page: nope" ]] \
    && ok "A4 an unknown page id is refused" \
    || no "A4 an unknown page id was not refused" "it silently landed somewhere"

  s openAt appearance.bar >/dev/null; sleep 2
  [[ $(s page) == appearance.bar ]] \
    && ok "A4 Settings opens directly at a page" \
    || no "A4 openAt did not land" "page=$(s page)"

  s close >/dev/null; sleep 1; s open >/dev/null; sleep 2
  [[ $(s page) == root ]] \
    && ok "A6 reopening lands on the root, not where it was left" \
    || no "A6 reopened at $(s page)" "the stack must reset on open"

  # --- B. the stack and back ------------------------------------------------
  before=$(s stack | wc -l)
  s goto appearance >/dev/null; sleep 1
  after=$(s stack | wc -l)
  [[ $(s page) == appearance && $after -eq $((before + 1)) ]] \
    && ok "B1 a nav row pushes exactly one page" \
    || no "B1 stack went $before -> $after" "page=$(s page)"

  s goto appearance >/dev/null; sleep 1
  [[ $(s stack | wc -l) -eq $after ]] \
    && ok "B6 pushing the page already on top is a no-op" \
    || no "B6 the stack grew on a repeat push" "it can grow without bound"

  s goto appearance.bar >/dev/null; sleep 1
  [[ $(s back) == appearance ]] && [[ $(s back) == root ]] \
    && ok "B2 back pops one page at a time" \
    || no "B2 back did not walk the stack" "landed on $(s page)"

  [[ $(s back) == closed ]] \
    && ok "B2 back at the root closes Settings" \
    || no "B2 back at the root did not close" "state=$(s state)"

  # The gesture layer must not close the app underneath. It asks the overlay
  # first, and only closes the surface when the overlay says it is done.
  wins() { swaymsg -t get_tree 2>/dev/null | jq '[recurse(.nodes[]?,.floating_nodes[]?)|select(.app_id)]|length'; }
  s open >/dev/null; sleep 2; s goto appearance >/dev/null; sleep 1
  w0=$(wins)

  # Put the keyboard down first, and allow more than one gesture. performBack
  # takes the keyboard branch whenever its probe has not answered yet -- that is
  # deliberate, because hiding the keyboard is the reversible outcome and acting
  # on a stale answer once closed an app while the keyboard was plainly up. The
  # cost is that the first back after a shell restart is consumed by the probe,
  # so a single-shot assertion here fails on timing rather than on behaviour.
  busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 \
         SetVisible b false >/dev/null 2>&1
  sleep 2
  for _ in 1 2 3; do
    [[ $(s page) == root ]] && break
    timeout 5 omarchy-shell gestures back >/dev/null 2>&1
    sleep 2
  done
  w1=$(wins)

  if [[ $(s page) == root && $(s state) == open && $w0 == "$w1" ]]; then
    ok "B3 the back gesture pops a page, stays open, and closes no app"
  else
    no "B3 back over Settings did the wrong thing" \
       "page=$(s page) state=$(s state) windows $w0 -> $w1; expected page=root state=open"
  fi

  # --- B8. a page whose rows are all hidden is unreachable -----------------
  s openAt apps.default >/dev/null; sleep 2
  vis=$(s rows | awk -F'\t' '$4=="1"' | wc -l)
  (( vis > 0 )) \
    && ok "B8 Default apps has $vis visible row(s)" \
    || no "B8 every row on apps.default is hidden" "its parent row should hide too"

  # --- C. switches ----------------------------------------------------------
  s openAt appearance.bar >/dev/null; sleep 2
  live=$(s value show)
  flag_now() { omarchy-toggle-enabled bar-off && echo off || echo on; }
  [[ $live == "$(flag_now)" ]] \
    && ok "C1/C2 the bar switch reads the flag, inverted correctly" \
    || no "C1/C2 switch says '$live', flag says '$(flag_now)'" \
          "bar-off is negative polarity: the file existing means the bar is OFF"

  # C4 is the one that used to take the whole shell down.
  pid_before=$(pgrep -x quickshell | head -1)
  s set show off >/dev/null; sleep 3
  pid_after=$(pgrep -x quickshell | head -1)
  if [[ -n $pid_after && $pid_before == "$pid_after" ]]; then
    ok "C4 hiding the status bar does not restart the shell"
  else
    no "C4 the shell restarted or died on a bar toggle" \
       "quickshell $pid_before -> ${pid_after:-gone}; toggle-bar must not pkill it"
  fi
  [[ $(s value show) == off ]] \
    && ok "C3 the switch re-reads itself after a write" \
    || no "C3 the switch did not follow its own write" "value=$(s value show)"
  s set show on >/dev/null; sleep 3          # restore
  [[ $(s value show) == on ]] && ok "C3 the bar came back" \
                             || no "C3 the bar did not come back" "value=$(s value show)"

  # --- D. choices -----------------------------------------------------------
  s openAt net.dns >/dev/null; sleep 2
  ticked=$(s rows | awk -F'\t' '$5=="1"' | wc -l)
  current=$(omarchy-dns 2>/dev/null)
  if (( ticked == 1 )); then
    ok "D1 exactly one DNS row is ticked ($current)"
  elif (( ticked == 0 )) && ! printf 'DHCP\nCloudflare\nGoogle\nCustom\n' | grep -qx "$current"; then
    ok "D2 the reader says '$current', which no row declares, so nothing is ticked"
  else
    no "D1/D2 $ticked rows ticked, omarchy-dns says '$current'" \
       "one row must tick, or none when the reader names something unlisted"
  fi

  s openAt net >/dev/null; sleep 2
  [[ $(s rows | awk -F'\t' '$1=="dns"{print $6}') == "$current" ]] \
    && ok "D5 the parent row shows the current value" \
    || no "D5 the DNS row's detail is not the current value" "expected $current"

  # --- E. bridged launches --------------------------------------------------
  plug_pages="$HOME/.config/omarchy/plugins/mobileomarchy.settings/Pages.js"

  s dryRun 1 >/dev/null
  s openAt tools >/dev/null; sleep 2
  s activate screensaver >/dev/null; sleep 1
  [[ $(s lastLaunch) == "omarchy-launch-screensaver force" ]] \
    && ok "E1 a bridged row records its command and runs nothing" \
    || no "E1 lastLaunch was '$(s lastLaunch)'" "expected: omarchy-launch-screensaver force"
  s dryRun 0 >/dev/null

  missing=""
  for shim in omarchy-launch-floating-terminal-with-presentation \
              omarchy-launch-config-editor omarchy-launch-webapp; do
    p=$(command -v "$shim" 2>/dev/null)
    [[ $p == "$HOME/.local/share/mobileomarchy/bin/"* ]] || missing="$missing $shim"
  done
  [[ -z $missing ]] \
    && ok "E4 the bridge shims shadow upstream" \
    || no "E4 upstream wins for:$missing" "our bin/ must come first on PATH"

  # E3. Every command any row names, resolved under the shell's own PATH. A row
  # whose command is missing does not fail loudly: a switch reads "off" from the
  # 127, a choice page ticks nothing, and an action opens a terminal that closes
  # immediately. Parsed out of the model rather than listed here, so a row added
  # later is checked without anyone remembering to add it.
  unresolved=$(python3 - "$plug_pages" <<'CMDS'
import re, sys, shutil
src = open(sys.argv[1], encoding="utf-8").read()
words = set()
for field in ("run", "write", "read", "on", "off", "detailCmd", "reader", "list", "text"):
    for m in re.finditer(field + r': "((?:[^"\\]|\\.)*)"', src):
        expr = m.group(1)
        for part in re.split(r'[;|]|&&|\|\|', expr):
            part = part.strip()
            if not part or part[0] in "[!(":
                continue
            w = re.split(r'\s+', part)[0]
            if re.fullmatch(r'[a-z][a-z0-9._-]*', w):
                words.add(w)
print(" ".join(sorted(w for w in words if not shutil.which(w))))
CMDS
)
  [[ -z $unresolved ]] \
    && ok "E3 every command the model names resolves on PATH" \
    || no "E3 commands that do not resolve: $unresolved" \
          "those rows will read as off, tick nothing, or open and close"

  # I5. A shell whose PATH lost our bin runs every row's command as 127,
  # and every switch then reads "off" from an error rather than from a state.
  shell_pid=$(pgrep -x quickshell | head -1)
  shell_path=$(tr '\0' '\n' < "/proc/$shell_pid/environ" 2>/dev/null | sed -n 's/^PATH=//p')
  case ":$shell_path:" in
    *":$HOME/.local/share/mobileomarchy/bin:"*) ok "I5 the shell's PATH carries our bin" ;;
    *) no "I5 the shell's PATH is missing $HOME/.local/share/mobileomarchy/bin" \
          "every bridged row would open nothing" ;;
  esac

  # --- G. coverage parity ---------------------------------------------------
  cov=$(s coverage)
  menu="$OMARCHY_PATH/default/omarchy/omarchy-menu.jsonc"

  # python3, not sed+jq. The trailing comma this file is allowed to carry sits
  # on the line *before* its closing brace, so a line-based strip leaves it and
  # jq refuses the whole document -- which would have read as "upstream has no
  # entries" and quietly passed every comparison below.
  upstream=$(python3 - "$menu" <<'JSONC'
import json, re, sys
raw = open(sys.argv[1]).read()
raw = re.sub(r'^\s*//[^\n]*$', '', raw, flags=re.M)
raw = re.sub(r',(\s*[}\]])', r'\1', raw)
print("\n".join(sorted(json.loads(raw).keys())))
JSONC
)
  if [[ -z $upstream ]]; then
    no "the upstream menu file could not be parsed" "expected at $menu"
  fi
  covered=$(cut -f1 <<<"$cov" | sort)

  n_dup=$(cut -f1 <<<"$cov" | sort | uniq -d | wc -l)
  (( n_dup == 0 )) \
    && ok "G2 no upstream id is claimed twice" \
    || no "G2 $n_dup id(s) claimed by more than one row" "$(cut -f1 <<<"$cov" | sort | uniq -d | tr '\n' ' ')"

  stray=$(comm -23 <(echo "$covered") <(echo "$upstream"))
  [[ -z $stray ]] \
    && ok "G1 every id claimed exists upstream" \
    || no "G1 claimed but not in omarchy-menu.jsonc" "$(tr '\n' ' ' <<<"$stray")"

  classes=$(cut -f2 <<<"$cov" | sort -u | tr '\n' ' ')
  [[ $classes == "Bridged Native Shade " ]] \
    && ok "G3 every class is one of the three renderable words" \
    || no "G3 classes are: $classes" "Unsupported must never reach a row"

  # G6. The doc is the record; the code is the truth. They must agree.
  # Defaulted, not assumed: this script runs under `set -u`, so a bare
  # $MOBILEOMARCHY_PATH would abort the whole suite rather than fail one check,
  # and it is not exported by the session -- only PATH carries it.
  doc="${MOBILEOMARCHY_PATH:-$HOME/.local/share/mobileomarchy}/docs/menu-coverage.md"
  if [[ -f $doc ]]; then
    doc_nb=$(python3 - "$doc" <<'DOCTBL'
import re, sys
out = []
for line in open(sys.argv[1]):
    m = re.match(r'^\| `([^`]+)` \| [^|]* \| (Native|Bridged|Shade) \|', line)
    if m:
        out.append(m.group(1) + "\t" + m.group(2))
print("\n".join(sorted(out)))
DOCTBL
)
    code_nb=$(cut -f1,2 <<<"$cov" | sort)
    if diff -q <(echo "$doc_nb") <(echo "$code_nb") >/dev/null; then
      ok "G6 docs/menu-coverage.md and Pages.js agree ($(wc -l <<<"$code_nb") ids)"
    else
      no "G6 the doc and the code disagree" \
         "$(diff <(echo "$doc_nb") <(echo "$code_nb") | head -4 | tr '\n' ' ')"
    fi
  else
    no "G6 docs/menu-coverage.md not found" "expected at $doc"
  fi

  # G5/H2. Everything upstream ships is accounted for: rendered, or recorded as
  # a shade control, or classified Unsupported in the doc and therefore absent.
  n_up=$(wc -l <<<"$upstream")
  n_cov=$(wc -l <<<"$covered")
  # Anchored to an entry row -- a bare '| Unsupported |' also matches the
  # totals table at the top of the doc, which counted 179 of 178.
  n_unsup=$(grep -cE '^\| `[^`]+` \|.*\| Unsupported \|' "$doc" 2>/dev/null || echo 0)
  (( n_cov + n_unsup == n_up )) \
    && ok "G5 all $n_up upstream entries are accounted for ($n_cov live, $n_unsup dropped)" \
    || no "G5 $n_cov live + $n_unsup dropped != $n_up upstream" "something is unclassified"

  # G7. The split the design committed to. A drift here is not a failure on its
  # own -- rows move -- but it should be a deliberate edit to the doc, not a
  # surprise.
  totals=$(cut -f2 <<<"$cov" | sort | uniq -c | awk '{printf "%s=%s ", $2, $1}')
  [[ $totals == "Bridged=74 Native=66 Shade=1 " ]] \
    && ok "G7 the class totals are the ones committed to ($totals)" \
    || no "G7 the class totals moved: $totals" \
          "expected Bridged=74 Native=66 Shade=1; update docs/settings.md if deliberate"

  grep -q '^trigger.toggle.notifications	Shade' <<<"$cov" \
    && ok "H2 the shade-owned toggle is recorded, not rendered" \
    || no "H2 trigger.toggle.notifications is not recorded as Shade" ""

  # --- I. robustness --------------------------------------------------------
  plug="$HOME/.config/omarchy/plugins/mobileomarchy.settings"

  # I2. The existing icon check catches a *truncated* glyph. It cannot catch a
  # glyph that is gone: every icon in omarchy-menu.jsonc below U+FFFF is three
  # bytes of UTF-8, and 55 of them were silently eaten writing Pages.js through
  # a shell heredoc. An empty string is a legal QML literal and renders as a row
  # with no icon and a label that sits where the icon should have been -- which
  # looks like a deliberate design, not a defect. Choice rows carry no glyph by
  # design; everything else must have exactly one character.
  noicon=$(python3 - "$plug/Pages.js" <<'ICONS'
import re, sys
# Line-based on purpose. A row object can span several lines and can contain a
# nested `covers: { ... }`, so a brace-matching regex silently skips exactly the
# rows that have coverage -- it found 6 of 55 when tested against a simulated
# loss. Every glyph literal is on one line, and a choice row carries no glyph
# key at all, so any `glyph: ""` is a fault and so is any glyph of length != 1.
bad = []
for n, line in enumerate(open(sys.argv[1], encoding="utf-8"), 1):
    m = re.search(r'glyph: "([^"]*)"', line)
    if not m:
        continue
    if len(m.group(1)) != 1:
        rid = re.search(r'id: "([^"]+)"', line)
        bad.append(f"{rid.group(1) if rid else 'line' + str(n)}={m.group(1)!r}")
print(" ".join(bad))
ICONS
)
  [[ -z $noicon ]] \
    && ok "I2 every non-choice row carries exactly one icon character" \
    || no "I2 rows with a missing or truncated glyph: $noicon" \
          "a 3-byte glyph does not survive a shell heredoc; write Pages.js with a file write"

  bad=$(grep -nE '(readonly +)?property[^:]*\bon[A-Z]' "$plug"/*.qml "$plug"/*.js 2>/dev/null)
  [[ -z $bad ]] \
    && ok "I3 no property is named on<Uppercase>" \
    || no "I3 a property uses the reserved on<Uppercase> prefix" \
          "it reads back undefined, and undefined as a color is black: $bad"

  s close >/dev/null

  printf '  \033[90m%-4s\033[0m   \033[90mnot covered: A3 A5 B4 B5 B7 C5 C6 C7 C8 D3 D4 D6 E2 E5 E6 E7 E8 F1 F2 F3 F4 F5 F6 F7 G4 H1 I4\033[0m\n' ""
  # A3/B4  need a real finger or the touch injector
  # A5     needs every reader stubbed slow
  # C5-C8  need a blank, a bar repaint, a systemd unit and an sshd flip
  # D3/D6  Zed and the font provider are absent on a base install
  # E2     static: Pages.js against omarchy-menu.jsonc, not a runtime question
  # F3-F7  need PATH stubs that count forks
  # I2/I4  static greps, run at build time
fi

# --- surfaces: what the strip is drawn over -------------------------------
# docs/gestures.md section I. Opt-in because it opens every overlay in turn and
# writes a capture, and because I5 needs the touch injector and therefore root.
if [[ ${1:-} == "--surfaces" ]]; then
  head_ "surfaces (docs/gestures.md I)"

  # One field out of one `geometry` line. Layer surfaces are invisible to sway's
  # IPC -- `swaymsg -t get_tree` does not list them -- so the surface reporting
  # its own configure is the only measurement available. `h` is the compositor's
  # number; `margin` is only our own property read back.
  g() { omarchy-shell "$1" geometry 2>/dev/null | tr ' ' '\n' | sed -n "s/^$2=//p"; }

  # Read from the compositor, never from the thing under test.
  ws_rect() {
    swaymsg -t get_workspaces | python3 -c 'import json,sys
r = [w["rect"] for w in json.load(sys.stdin) if w["focused"]][0]
print(r["x"], r["y"], r["width"], r["height"])'
  }

  open_()  { omarchy-shell "$1" open  >/dev/null 2>&1; sleep 2; }
  close_() { omarchy-shell "$1" close >/dev/null 2>&1; sleep 1; }

  sheets="drawer settings themes"

  # I2. mobileomarchy.device is the control: same layer, same zero exclusive
  # zone, no margin. The difference between its height and a sheet's is the
  # margin and nothing else.
  #
  # Deliberately NOT asserted against the workspace rect, which has the bar's
  # and the strip's exclusive zones taken out of it while an Ignore surface
  # takes the whole output -- that would fail on arithmetic rather than on
  # behaviour. (It carried a `gaps inner 3` inset as well until docs/windows.md
  # W1; the zones remain, so the reason to avoid it does too.)
  open_ device; control=$(g device h); close_ device
  if [[ -z $control ]]; then
    no "I2 the device control did not report a geometry" \
       "without it every height below is unanchored"
  else
    for s in $sheets; do
      open_ "$s"; h=$(g "$s" h); strip=$(g "$s" strip); close_ "$s"
      want=$(( control + strip ))
      if [[ $h == "$want" ]]; then
        ok "I2 $s is one strip taller than the control ($control + $strip)"
      else
        no "I2 $s is ${h:-?}, wanted $want" \
           "equal to the control ($control) means the negative margin was ignored"
      fi
    done
  fi

  # I4. Content may pass under the pill mid-scroll; none may come to rest there.
  for s in $sheets; do
    open_ "$s"; gap=$(g "$s" gap); strip=$(g "$s" strip); close_ "$s"
    if [[ -n $gap && -n $strip ]] && (( gap >= strip )); then
      ok "I4 $s rests its last row clear of the pill (gap $gap >= $strip)"
    else
      no "I4 $s rests content under the pill (gap ${gap:-?} < ${strip:-?})" \
         "a row that stops under the pill cannot be tapped"
    fi
  done

  # I3. Extending a surface reserves nothing.
  before=$(ws_rect)
  for s in $sheets; do open_ "$s"; close_ "$s"; done
  after=$(ws_rect)
  [[ $before == "$after" ]] \
    && ok "I3 the workspace rect is unchanged by opening every sheet" \
    || no "I3 the workspace rect moved: [$before] -> [$after]" \
          "a sheet started reserving space; the keyboard will fight it"

  # I1. The pixel check, and the one that catches "correct but invisible".
  #
  # Relative, never against a known colour: compare the last row against one a
  # strip above it. That says "the sheet reaches the bottom edge" without
  # resolving what Color.menu.background is for the installed theme, and without
  # assuming the strip is 20 -- Style.space rounds a *scaled* value.
  if ! command -v magick >/dev/null; then
    no "I1 imagemagick is missing" "the pixel check cannot run"
  else
    for s in $sheets; do
      # Open versus closed, NOT against a pixel higher up the same capture.
      # That was the first version and it is unsound: the reference lands on
      # whatever the sheet is drawing there, so on Settings it hit a row card
      # and the check compared card-against-sheet and failed a surface that was
      # in fact reaching the edge. What I1 actually asks is "is this band the
      # sheet, or is it still what is behind" -- which is a question about the
      # difference between the two states, and nothing else.
      shut=$(mktemp -t moa-shut-XXXX).png
      shot=$(mktemp -t moa-shot-XXXX).png
      close_ "$s"
      if grim "$shut" 2>/dev/null; then
        open_ "$s"
        if grim "$shot" 2>/dev/null; then
          lw=$(g "$s" screen | cut -dx -f1)
          pw=$(magick identify -format '%w' "$shot")
          ph=$(magick identify -format '%h' "$shot")
          scale=$(( pw / lw ))
          # x well left of the centred 96-logical pill, y in the last row.
          x=$(( 40 * scale )); y=$(( ph - 2 ))
          was=$(magick "$shut" -format "%[hex:p{$x,$y}]" info:)
          now=$(magick "$shot" -format "%[hex:p{$x,$y}]" info:)
          [[ $was != "$now" ]] \
            && ok "I1 $s paints the bottom row ($was -> $now)" \
            || no "I1 $s leaves the bottom row untouched ($now)" \
                  "the band under the pill is still showing what is behind"
        else
          no "I1 grim captured nothing for $s (open)" "a blanked screen has no frames"
        fi
      else
        no "I1 grim captured nothing for $s (closed)" "a blanked screen has no frames"
      fi
      rm -f "$shut" "$shot"
      close_ "$s"
    done
  fi

  # I5. The drawer must still reflow above the keyboard -- the whole reason its
  # exclusive zone is zero. Needs a tap on the search field, so it needs the
  # injector and root.
  touch_bin="$HOME/.local/share/mobileomarchy/bin/mobileomarchy-touch"
  if [[ -x $touch_bin ]] && sudo -n true 2>/dev/null; then
    open_ drawer
    h_down=$(g drawer h); gap_down=$(g drawer gap)
    # The search pill: below the 26px handle strip, centred.
    lw=$(g drawer screen | cut -dx -f1); scale=$(( 720 / lw ))
    # Two taps, because the injector creates its uinput device on first use and
    # events sent before the compositor has bound it land nowhere.
    osk_up() { [[ $(busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 \
                      sm.puri.OSK0 Visible 2>/dev/null) == "b true" ]]; }
    for _ in 1 2; do
      sudo -n "$touch_bin" tap $(( 180 * scale )) $(( 74 * scale )) >/dev/null 2>&1
      sleep 3
      osk_up && break
    done
    h_up=$(g drawer h); gap_up=$(g drawer gap)
    if ! osk_up; then
      # An environment that will not raise the keyboard cannot answer I5, and
      # reporting that as an I5 failure teaches you to ignore I5.
      #
      # Measured, and worth knowing before chasing it: a session that has been
      # opening and closing overlays for a while stops re-activating the search
      # field's text input entirely -- the tap lands, the injector is fine (the
      # same one still drives every gesture check), and the keyboard simply
      # never rises. `mobileomarchy-restart-shell` clears it every time. So a
      # skip here usually means the session is stale, not that I5 is broken.
      printf '  \033[90m%-4s\033[0m   \033[90mI5 skipped: the keyboard would not come up\033[0m\n' ""
    elif [[ -n $h_up && -n $h_down ]] && (( h_up < h_down )) && [[ $gap_up == "$gap_down" ]]; then
      ok "I5 the drawer reflows above the keyboard ($h_down -> $h_up, gap $gap_up held)"
    else
      no "I5 the drawer did not reflow (h $h_down -> ${h_up:-?}, gap $gap_down -> ${gap_up:-?})" \
         "an unchanged height means the keyboard is now covering the grid"
    fi
    close_ drawer
  else
    printf '  \033[90m%-4s\033[0m   \033[90mI5 skipped: needs the touch injector and passwordless sudo\033[0m\n' ""
  fi

  printf '  \033[90m%-4s\033[0m   \033[90mnot covered: I6 I7\033[0m\n' ""
  # I6  the pill over a sheet is A7 in --gestures, which already covers it for
  #     the drawer; settings/themes and the keyboard case want a finger.
  # I7  static, over every colors.toml -- a contrast sum, not a device question.
fi

# ---------------------------------------------------------------------------
# --windows: the window area and the launch splash, against docs/windows.md
#
# Opt-in, because it launches real apps and closes them again, and because W4
# turns gaps on for a second on a screen someone may be using.
# ---------------------------------------------------------------------------
if [[ ${1:-} == "--windows" ]]; then
  head_ "windows (docs/windows.md)"

  w_ok() { printf '  \033[90m%-4s\033[0m ' "$1"; shift; ok "$@"; }
  w_no() { printf '  \033[90m%-4s\033[0m ' "$1"; shift; no "$@"; }
  w_skip() { printf '  \033[90m%-4s   %s\033[0m\n' "$1" "$2"; }

  ws_rect() { swaymsg -t get_workspaces | python3 -c 'import json,sys
r=[w["rect"] for w in json.load(sys.stdin) if w["focused"]]
print("%d %d %d %d" % (r[0]["x"], r[0]["y"], r[0]["width"], r[0]["height"]) if r else "")'; }

  out_rect() { swaymsg -t get_outputs | python3 -c 'import json,sys
o=[o["rect"] for o in json.load(sys.stdin) if o.get("active")]
print("%d %d %d %d" % (o[0]["x"], o[0]["y"], o[0]["width"], o[0]["height"]) if o else "")'; }

  # The focused *view*, from sway rather than from the shell, so a check never
  # confirms the thing it is checking.
  focused_rect() { swaymsg -t get_tree | python3 -c '
import json, sys
found = []
def walk(n):
    if n.get("focused") and n.get("pid"): found.append(n["rect"])
    for k in ("nodes", "floating_nodes"):
        for c in n.get(k, []): walk(c)
walk(json.load(sys.stdin))
print("%d %d %d %d" % (found[0]["x"], found[0]["y"], found[0]["width"], found[0]["height"]) if found else "")'; }

  focused_app() { swaymsg -t get_tree | python3 -c '
import json, sys
found = []
def walk(n):
    if n.get("focused") and n.get("app_id"): found.append(n["app_id"])
    for k in ("nodes", "floating_nodes"):
        for c in n.get(k, []): walk(c)
walk(json.load(sys.stdin))
print(found[0] if found else "")'; }

  # Every view con_id on the tree. Diffing this across a launch names the one
  # window this suite created, so the cleanup kills that and nothing else --
  # other sessions have windows on this phone too.
  con_ids() { swaymsg -t get_tree | python3 -c '
import json, sys
out = []
def walk(n):
    if n.get("pid"): out.append(str(n["id"]))
    for k in ("nodes", "floating_nodes"):
        for c in n.get(k, []): walk(c)
walk(json.load(sys.stdin))
print(" ".join(out))'; }

  # Right after a surface maps this GPU can keep the shell busy long enough
  # that omarchy-shell gives up and prints nothing. Empty is "ask again", not
  # "closed" -- the same trap the gesture suite hit.
  splash_state() {
    local out
    for _ in 1 2 3; do
      if out=$(timeout 8 omarchy-shell splash state 2>/dev/null) && [[ -n $out ]]; then
        echo "$out"; return
      fi
      sleep 1
    done
    echo "unknown"
  }

  # --- W1, W2: the window area ---------------------------------------------
  if ! grep -q '^gaps inner 0' "$HOME/.local/share/mobileomarchy/default/sway/pinephone.conf" 2>/dev/null; then
    w_no W2 "pinephone.conf does not set gaps inner 0" \
            "the installed config still insets every app"
  else
    w_ok W2 "pinephone.conf sets gaps inner 0"
  fi

  before_ids=$(con_ids)
  swaymsg exec -- foot --app-id=moa-windows >/dev/null 2>&1
  for _ in $(seq 25); do [[ $(focused_app) == "moa-windows" ]] && break; sleep 1; done

  if [[ $(focused_app) != "moa-windows" ]]; then
    w_no W1 "no window came up" "W1 and W4 cannot be measured without one"
  else
    wr=$(ws_rect); fr=$(focused_rect); orr=$(out_rect)
    read -r wx wy ww wh <<<"$wr"
    read -r _ox _oy ow _oh <<<"$orr"

    # Two halves, and the first one is not optional. `swaymsg -t get_workspaces`
    # reports the workspace rect with the gaps ALREADY SUBTRACTED, so
    # window == workspace is true at gaps 3 exactly as it is at gaps 0 -- this
    # check passed a deliberate `gaps inner all set 3` before the width test was
    # added, which is the whole reason it is here.
    #
    # Width is what catches it: the bar and the strip are full-width surfaces
    # and reserve nothing at the sides, so a workspace narrower than its output
    # is gaps and can be nothing else.
    if [[ -z $wr || -z $fr || -z $orr ]]; then
      w_no W1 "could not read the geometry (window [$fr] workspace [$wr] output [$orr])" \
              "nothing below can be measured"
    elif (( wx != 0 || ww != ow )); then
      w_no W1 "the workspace is ${ww}px of a ${ow}px output, offset ${wx}" \
              "that inset is gaps: wallpaper is showing down both sides of the app"
    elif [[ $fr != "$wr" ]]; then
      w_no W1 "window [$fr], workspace [$wr]" \
              "the window is inset inside its workspace -- a border is taking space"
    else
      w_ok W1 "a lone window fills the width of the output and its workspace ($fr)"
    fi

    # --- W4: the toggle ----------------------------------------------------
    # Inverted from the desktop original, so the FIRST press must add gaps. A
    # toggle that starts by removing what is already gone would pass a
    # "restored" check while having done nothing at all, which is why both
    # halves are asserted -- and why this refuses to run against a session that
    # already has gaps, where there is no zero to add to.
    #
    # Measured as workspace-width-against-output, the same quantity W1 uses,
    # and NOT as the window rect before and after. The window rect carries
    # every exclusive zone on the screen: an earlier version of this check
    # compared absolute rects and went red because the on-screen keyboard came
    # up between two of its reads, which has nothing to do with gaps. Width is
    # untouched by the bar, the strip and the keyboard alike.
    ws_width() { ws_rect | cut -d' ' -f3; }
    ws_x()     { ws_rect | cut -d' ' -f1; }

    if (( wx != 0 )); then
      w_skip W4 "W4 skipped: this session already has gaps (x=$wx), so there is no zero to add to"
    else
      mobileomarchy-window-gaps-toggle >/dev/null 2>&1; sleep 1
      on_x=$(ws_x); on_w=$(ws_width)
      mobileomarchy-window-gaps-toggle >/dev/null 2>&1; sleep 1
      off_x=$(ws_x); off_w=$(ws_width)
      if [[ $on_x == "3" && $on_w == "$(( ow - 6 ))" && $off_x == "0" && $off_w == "$ow" ]]; then
        w_ok W4 "the gaps toggle adds 3 and takes it back (${ow} -> ${on_w} -> ${off_w})"
      elif [[ $on_x == "0" ]]; then
        w_no W4 "the first press changed nothing (workspace still at x=0, ${on_w}px)" \
                "it is still the desktop script: press one removes gaps that are already gone"
      else
        w_no W4 "on [x=$on_x w=$on_w] wanted [x=3 w=$(( ow - 6 ))], off [x=$off_x w=$off_w] wanted [x=0 w=$ow]" \
                "the toggle left the workspace somewhere neither state describes"
      fi
    fi
  fi

  # Kill only what this suite made.
  for id in $(con_ids); do
    [[ " $before_ids " == *" $id "* ]] || swaymsg "[con_id=$id] kill" >/dev/null 2>&1
  done
  sleep 1

  # --- L1, L2, L6, L7: a launch that never arrives -------------------------
  #
  # A desktop id with no application behind it. gtk-launch fails, no toplevel
  # ever appears, and the splash is therefore guaranteed to be up while the
  # next three checks read it -- which a real app is not, because an app that
  # maps in 400ms would fail L1 for being fast. It is also exactly the state L6
  # is about.
  if [[ $(timeout 8 omarchy-shell splash state 2>/dev/null) == "" ]]; then
    w_no L1 "the splash plugin does not answer IPC" \
            "mobileomarchy.splash is not loaded, so nothing below can be read"
  else
    timeout 8 omarchy-shell drawer launch moa-selftest-no-such-app >/dev/null 2>&1
    sleep 1
    st=$(splash_state)
    if [[ $st == "open" ]]; then
      w_ok L1 "the splash is up one second after the launch, not two"
    else
      w_no L1 "the splash reads $st a second after a launch" \
              "either it never showed, or the 2s upstream delay is still in AppLibrary"
    fi

    # The pixels, not the source. A source that resolves to a file Qt cannot
    # decode leaves exactly the blank square L7 is about, and `icon` alone
    # would report it as fine.
    drawn=$(timeout 8 omarchy-shell splash drawn 2>/dev/null)
    case $drawn in
      icon*)     w_ok L7 "an unresolvable app still gets a splash (${drawn##*/})" ;;
      fallback)  w_ok L7 "an unresolvable app falls back to the outline" ;;
      *)         w_no L7 "the splash is drawing ${drawn:-nothing}" \
                        "the surface is up with no pixels on it" ;;
    esac

    geom=$(timeout 8 omarchy-shell splash geometry 2>/dev/null)
    sw=$(ws_rect | cut -d' ' -f3)
    gw=$(echo "$geom" | sed -n 's/.*w=\([0-9]*\).*/\1/p')
    if [[ -n $gw && -n $sw ]] && (( gw > 0 && gw * 2 < sw )); then
      w_ok L2 "the surface is the icon, not the screen (${gw} of ${sw}px)"
    else
      w_no L2 "splash surface w=${gw:-?} against a ${sw:-?}px screen" \
              "a full-screen splash can swallow the pill and the back edge (L3)"
    fi

    # Read off the window, not restated here: sway draws a fullscreen view
    # above the top layer, so on Top the splash is invisible behind exactly the
    # apps pinephone.conf fullscreens.
    layer=$(echo "$geom" | sed -n 's/.*layer=\([a-z?]*\).*/\1/p')
    if [[ $layer == "overlay" ]]; then
      w_ok L2a "the surface is on the overlay layer, in front of fullscreen apps"
    else
      w_no L2a "the splash surface is on layer ${layer:-?}" \
               "anything but overlay is hidden by the first fullscreen window it meets"
    fi

    # --- L6: it gives up ---------------------------------------------------
    # Upstream's 15s timeout, which the port patch must leave alone. Polled
    # rather than slept through, so the elapsed time is evidence rather than
    # the absence of a failure.
    t0=$(date +%s); elapsed=""
    for _ in $(seq 25); do
      [[ $(splash_state) == "closed" ]] && { elapsed=$(( $(date +%s) - t0 )); break; }
      sleep 1
    done
    if [[ -n $elapsed ]] && (( elapsed >= 10 && elapsed <= 20 )); then
      w_ok L6 "it gives up after ${elapsed}s and clears the wallpaper"
    elif [[ -n $elapsed ]]; then
      w_no L6 "it gave up after ${elapsed}s, not the 15 upstream sets" \
              "the port patch changed launchTimeout as well as launchDelay"
    else
      w_no L6 "still up 25s after a launch that will never arrive" \
              "launchTimeout is gone: a failed launch now covers the screen until the next one"
    fi
  fi

  # --- L1, L4: a real app --------------------------------------------------
  entries=$(timeout 8 omarchy-shell drawer entries 2>/dev/null)
  target=""
  for cand in foot Alacritty org.gnome.Console org.gnome.Nautilus org.gnome.TextEditor; do
    grep -qx "$cand" <<<"$entries" && { target=$cand; break; }
  done

  if [[ -z $target ]]; then
    w_skip L4 "L1/L4 skipped: none of the expected apps is in the drawer's list"
  else
    before_ids=$(con_ids)
    saw_open=""; saw_icon=""
    timeout 8 omarchy-shell drawer launch "$target" >/dev/null 2>&1
    for _ in $(seq 30); do
      if [[ -z $saw_open && $(splash_state) == "open" ]]; then
        saw_open=1
        saw_icon=$(timeout 8 omarchy-shell splash icon 2>/dev/null)
      fi
      [[ $(con_ids) != "$before_ids" ]] && break
      sleep 1
    done

    if [[ $(con_ids) == "$before_ids" ]]; then
      w_no L4 "$target never opened a window" "L4 has nothing to have closed the splash"
    else
      sleep 2
      st=$(splash_state)
      if [[ $st == "closed" ]]; then
        w_ok L4 "the splash goes when $target's window appears"
      else
        w_no L4 "the splash reads $st with the window up" \
                "it will now sit on the app until the 15s timeout"
      fi
      if [[ -n $saw_open ]]; then
        w_ok L1 "$target's launch showed a splash (${saw_icon##*/})"
      else
        w_skip L1 "L1 unproven for $target: it mapped before the first poll"
      fi
    fi

    for id in $(con_ids); do
      [[ " $before_ids " == *" $id "* ]] || swaymsg "[con_id=$id] kill" >/dev/null 2>&1
    done
    sleep 1
  fi

  # --- L5: a .desktop that summons a plugin --------------------------------
  if ! grep -qx "mobileomarchy.device" <<<"$entries"; then
    w_skip L5 "L5 skipped: mobileomarchy.device is not in the drawer's list"
  else
    timeout 8 omarchy-shell drawer launch mobileomarchy.device >/dev/null 2>&1
    for _ in $(seq 10); do
      [[ $(timeout 8 omarchy-shell device state 2>/dev/null) == "open" ]] && break
      sleep 1
    done
    st=$(splash_state)
    dev=$(timeout 8 omarchy-shell device state 2>/dev/null)
    if [[ $dev != "open" ]]; then
      w_no L5 "the Device screen did not open (state ${dev:-?})" \
              "without it there is no plugin summon for L5 to be about"
    elif [[ $st == "closed" ]]; then
      w_ok L5 "a plugin summon takes the splash down without a toplevel"
    else
      w_no L5 "the splash reads $st over the Device screen" \
              "no window will ever appear for it, so it stays for the full 15s"
    fi
    timeout 8 omarchy-shell device close >/dev/null 2>&1
  fi

  printf '  \033[90m%-4s\033[0m   \033[90mnot covered: W3 L3 L8\033[0m\n' ""
  # W3  needs two windows on one workspace, which one-app-per-workspace exists
  #     to prevent; arranging it means turning that off first.
  # L3  the mask. The surface size is asserted (L2) and that is the half that
  #     can be read without a finger; proving touch passes through the square
  #     itself needs the injector and root, like I5.
  # L8  an animation. A screenshot cannot tell a pulse from a still frame.
fi

printf '\n%d passed, %d failed\n' "$pass" "$fail"
(( fail == 0 ))
