#!/bin/bash
# Read and write ~/.config/omarchy/widgets.toml -- which widgets a surface
# shows, and in what order (docs/widgets.md §D).
#
#   moarchy-widgets list control-center      id on|off available=N, one per line
#   moarchy-widgets rows control-center      the Settings page, as JSON rows
#   moarchy-widgets summary control-center   "5 of 6 shown"
#   moarchy-widgets show control-center volume
#   moarchy-widgets hide control-center media
#   moarchy-widgets set  control-center "connectivity, -media, volume"
#   moarchy-widgets up   control-center volume
#   moarchy-widgets down control-center volume
#   moarchy-widgets reset control-center     forget the key; back to the catalogue
#
# W21: the only writer. Nothing else touches this file -- which is the whole
# reason it is not in ui.toml, where `moarchy-ui write_file` rewrites from a
# fixed set of variables and would drop a key it does not know (W17).
#
# The *catalogue* is not here. The shell resolved the arrangement and the shell
# is running, since it is the thing asking; a second list of widgets in bash
# would be the drift `gestures.md` A8 already records about overlay ids. So
# every read goes through the host's own IPC verb, and a write is that answer
# with one thing moved.
set -uo pipefail

FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/widgets.toml"

# The plugin glyph moarchy-plugins already uses, for the one row that is not a
# widget. A literal above U+FFFF, written the way that script writes it -- a
# QML-style \uXXXX escape takes four hex digits and would draw the wrong
# picture (moarchy.settings/Pages.js).
NONE_GLYPH=$'\U000f0431'

usage() {
  echo "usage: moarchy-widgets {list|rows|summary|reset} SURFACE" >&2
  echo "       moarchy-widgets {show|hide|up|down} SURFACE ITEM" >&2
  echo "       moarchy-widgets set SURFACE \"a, -b, c\"" >&2
  exit 2
}

# The surfaces that arrange something, and the IPC verb that reports each one.
# Both live on the control center: its own widgets, and the toggles inside one
# of them. The surface name is what `widgets.toml` keys on and what Settings
# passes, so this table is the only place the two vocabularies meet.
verb_for() {
  case "$1" in
    control-center) printf "control-center widgets" ;;
    quick-toggles)  printf "control-center toggles" ;;
    *)              printf "%s widgets" "$1" ;;
  esac
}

# The host id is the IPC target: the control center answers to `control-center`
# and a second host will answer to its own id. Ours, never upstream's -- a
# copied nudge command hits the plugin we replaced (ipc-targets-are-not-plugin-ids).
ask() {
  omarchy-shell "$1" "$2" 2>/dev/null
}

# A surface's items, one per line, for validating a `set`.
known() {
  listing "$1" | awk '$1 != "" { print $1 }'
}

# The arrangement as the shell resolved it: "id on|off available=N" per line.
listing() {
  # shellcheck disable=SC2046 -- two words, deliberately
  ask $(verb_for "$1")
}

key_for() { printf '%s' "${1//-/_}"; }

# This host's line as the file spells it, one token per line, or nothing.
file_order() {
  local key
  key=$(key_for "$1")
  [[ -f $FILE ]] || return 0
  awk -v key="$key" '
    $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      sub(/^[^=]*=[[:space:]]*/, ""); gsub(/^"|"$|^\x27|\x27$/, "")
      n = split($0, parts, ",")
      for (i = 1; i <= n; i++) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", parts[i])
        if (parts[i] != "") print parts[i]
      }
      exit
    }' "$FILE"
}

# The ids in order as the *shell* resolved them, with a leading "-" on the ones
# that are off.
shell_order() {
  listing "$1" | awk '$1 != "" { printf "%s%s\n", ($2 == "off" ? "-" : ""), $1 }'
}

# What a write starts from.
#
# The file first, and that is not a preference. The shell re-reads widgets.toml
# through a watch, so for a moment after a write its answer is the arrangement
# from *before* it -- and two taps in a row on the same Settings page are well
# inside that moment. Read back from the shell, the second tap would compute
# from the pre-write order and undo the first (settings-guards-are-async is the
# same lag, measured on the other side of it).
#
# The shell is still what says which widgets there *are*, so anything it
# reports that the file does not name is appended here in the order it gave
# them -- which is the same rule resolve() applies on the QML side (W19), so
# the two cannot disagree about what the file means.
ordered() {
  local host="$1" mine appended bare
  mine=$(file_order "$host")
  if [[ -z $mine ]]; then
    shell_order "$host"
    return
  fi
  printf '%s\n' "$mine"
  while IFS= read -r token || [[ -n $token ]]; do
    [[ -n $token ]] || continue
    bare=${token#-}
    if ! printf '%s\n' "$mine" | sed 's/^-//' | grep -qxF "$bare"; then
      printf '%s\n' "$token"
    fi
  done < <(shell_order "$host")
}

# Never write an empty arrangement. Empty here is a shell that is not running or
# a host that is not loaded, not a surface with no widgets on it, and a write
# would turn "I could not read it" into "the user turned everything off"
# (empty-list-means-unreadable).
# In the caller and NOT inside a `$(...)` helper, which is how this was first
# written and where it did nothing: an `exit 1` in a command substitution ends
# the subshell, the caller reads an empty string and carries on, and the file
# came out holding `control_center = ""`. The guard printed its refusal and the
# write happened underneath it.
ORDER=""
read_order() {
  ORDER=$(ordered "$1")
  if [[ -z $ORDER ]]; then
    echo "moarchy-widgets: $1 reported no widgets; refusing to write" >&2
    return 1
  fi
  return 0
}

# Replace this host's line and leave every other line of the file exactly as it
# was -- comments, other hosts, hand-written spacing.
write_key() {
  local host="$1" value="$2" key
  # The last line of defence, whatever computed the value: an empty
  # arrangement is never what a tap asked for.
  if [[ -z ${value// /} ]]; then
    echo "moarchy-widgets: refusing to write an empty arrangement for $host" >&2
    return 1
  fi
  key=$(key_for "$host")
  mkdir -p "$(dirname "$FILE")"
  if [[ ! -f $FILE ]]; then
    cat >"$FILE" <<'HEADER'
# Which widgets each surface draws, and in what order.
#
# One key per host. A leading - keeps a widget in the order and turns it off.
# A widget this file does not name is appended in catalogue order, so an
# upgrade that adds one does not need this file edited.
#
# Written by `moarchy-widgets` and by Settings > Appearance > Control Center.
# Editing it by hand is fine; the shell picks the change up with no restart.

HEADER
  fi
  if grep -q "^[[:space:]]*${key}[[:space:]]*=" "$FILE"; then
    # A temp file beside the target, never in place: an interrupted rewrite of
    # the arrangement would read as an arrangement.
    local tmp
    tmp=$(mktemp "${FILE}.XXXXXX")
    awk -v key="$key" -v val="$value" '
      $0 ~ "^[[:space:]]*" key "[[:space:]]*=" { print key " = \"" val "\""; next }
      { print }' "$FILE" >"$tmp" && mv "$tmp" "$FILE"
  else
    printf '%s = "%s"\n' "$key" "$value" >>"$FILE"
  fi
}

join_order() {
  paste -sd, - | sed 's/,/, /g'
}

set_state() {
  local host="$1" id="$2" want="$3"
  read_order "$host" || return 1
  printf '%s\n' "$ORDER" \
    | awk -v id="$id" -v want="$want" '
        { bare = $0; sub(/^-/, "", bare)
          if (bare == id) print (want == "on" ? bare : "-" bare)
          else print }' \
    | join_order | { read -r line; write_key "$host" "$line"; }
}

move() {
  local host="$1" id="$2" dir="$3"
  read_order "$host" || return 1
  printf '%s\n' "$ORDER" \
    | awk -v id="$id" -v dir="$dir" '
        { a[NR] = $0; bare = $0; sub(/^-/, "", bare); if (bare == id) at = NR }
        END {
          n = NR
          if (at == 0) { for (i = 1; i <= n; i++) print a[i]; exit }
          to = (dir == "up") ? at - 1 : at + 1
          if (to < 1 || to > n) { for (i = 1; i <= n; i++) print a[i]; exit }
          t = a[at]; a[at] = a[to]; a[to] = t
          for (i = 1; i <= n; i++) print a[i]
        }' \
    | join_order | { read -r line; write_key "$host" "$line"; }
}

case "${1:-}" in
  list)
    [[ $# -eq 2 ]] || usage
    listing "$2"
    ;;
  rows)
    [[ $# -eq 2 ]] || usage
    # W24. One row per widget: a tap toggles it, the two chevrons move it.
    # `state` rides along on the row rather than each row carrying a `read` for
    # the guard batch to run -- one listing answers for all of them, where a
    # read apiece is a fork apiece on a 1.15GHz A53 (moarchy-plugins says the
    # same about forty plugins).
    #
    # W25. The second line says what the row *is*, including the case a switch
    # cannot show: on, but with nothing to draw.
    ask "$2" widgetRows | jq --arg host "$2" --arg none "$NONE_GLYPH" '
      if type != "array" or length == 0
      then [{ id: "none", type: "info", glyph: $none, label: "No widgets",
              detail: "The surface reported none" }]
      else map({
        id:     ("w-" + .id),
        type:   "arrange",
        glyph:  .glyph,
        label:  .name,
        detail: (if .on | not then "Hidden"
                 elif .available then "Shown"
                 else "Nothing to show" end),
        state:  .on,
        on:     ("moarchy-widgets show " + ($host | @sh) + " " + (.id | @sh)),
        off:    ("moarchy-widgets hide " + ($host | @sh) + " " + (.id | @sh)),
        up:     ("moarchy-widgets up "   + ($host | @sh) + " " + (.id | @sh)),
        down:   ("moarchy-widgets down " + ($host | @sh) + " " + (.id | @sh))
      })
      end'
    ;;
  summary)
    [[ $# -eq 2 ]] || usage
    listing "$2" | awk '$1 != "" { n++; if ($2 == "on") on++ }
                        END { if (n) printf "%d of %d shown\n", on, n }'
    ;;
  show|hide)
    [[ $# -eq 3 ]] || usage
    set_state "$2" "$3" "$([[ $1 == show ]] && echo on || echo off)" || exit 1
    ;;
  up|down)
    [[ $# -eq 3 ]] || usage
    move "$2" "$3" "$1" || exit 1
    ;;
  set)
    # W39. One write for a whole order, because a drag that ends four places
    # down is one decision and not four -- four `up` calls would each race the
    # file watch and each leave a frame of a different arrangement on screen.
    [[ $# -eq 3 ]] || usage
    surface=$2
    valid=$(known "$surface")
    if [[ -z $valid ]]; then
      echo "moarchy-widgets: $surface reported no items; refusing to write" >&2
      exit 1
    fi
    # Every token has to name something this surface actually has. A `set` is
    # the one verb that can write an arrangement nobody derived from a listing,
    # so it is the one that has to check -- resolve() would drop an unknown id
    # silently (W20) and the order would come back short with no complaint.
    out=""
    # `|| [[ -n $token ]]`, and it is load-bearing. The last item of the order
    # has no newline after it, so `read` hands it back and *then* reports
    # end-of-input -- and a plain `while read` throws that iteration away. The
    # order came out one short every time, and because the dropped token was
    # never read it was never checked either: `set control-center
    # "connectivity, nonesuch"` reported success and wrote "connectivity".
    while IFS= read -r token || [[ -n $token ]]; do
      [[ -n $token ]] || continue
      bare=${token#-}
      if ! printf "%s\n" "$valid" | grep -qxF "$bare"; then
        echo "moarchy-widgets: $surface has no item \"$bare\"" >&2
        exit 1
      fi
      out+="${out:+, }$token"
    done < <(printf "%s" "$3" | tr "," "\n" | sed "s/^[[:space:]]*//;s/[[:space:]]*$//")
    write_key "$surface" "$out" || exit 1
    ;;
  reset)
    [[ $# -eq 2 ]] || usage
    # W18. Drop the key rather than write the catalogue's order out: absent is
    # the shipping arrangement, and a file that spells it out would freeze it
    # against the next widget that is added (W19).
    key=$(key_for "$2")
    if [[ -f $FILE ]]; then
      tmp=$(mktemp "${FILE}.XXXXXX")
      grep -v "^[[:space:]]*${key}[[:space:]]*=" "$FILE" >"$tmp"
      mv "$tmp" "$FILE"
    fi
    ;;
  *)
    usage
    ;;
esac
