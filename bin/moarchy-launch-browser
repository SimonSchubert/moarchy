#!/bin/bash
# Omarchy's omarchy-launch-browser expects a configured desktop browser.
# Chromium is in mobileomarchy-extras.packages, not the base set.
for b in "$BROWSER" chromium firefox epiphany; do
  [[ -n $b ]] && command -v "$b" >/dev/null && exec "$b" "$@"
done
notify-send "No browser installed" "sudo pacman -S chromium" 2>/dev/null
exit 1
