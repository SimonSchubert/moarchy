#!/bin/bash
# Sway override of omarchy-brightness-display.
#
# Upstream reaches for `hyprctl dispatch dpms` on off/on and probes for Apple
# displays. Here the screen is the PinePhone's own panel, so DPMS goes through
# swaymsg and the Apple path is dropped. The non-uniform step heuristic below
# 5% is kept verbatim -- it matters more on a phone, not less.

step="${1:-+5%}"

device="$(ls -1 /sys/class/backlight 2>/dev/null | head -n1)"
[[ -n $device ]] || exit 0

# Both through moarchy-screen (docs/refactor.md D1, D2). These two branches
# talked to swaymsg directly, which meant `on` lit the panel while the power
# button had the screen locked -- the one state the lock exists to hold. Our
# own bindings only ever pass +5%/5%-, so it was upstream Omarchy's callers of
# `off`/`on` that could reach it: exactly what a shim is here to catch.
#
# `blank`, not `lock`: "turn the display off" is not "lock the phone", and
# pairing blank with wake keeps `off` then `on` behaving the way its caller
# expects while still refusing to undo a real lock.
if [[ $step == "off" ]]; then
  moarchy-screen blank >/dev/null 2>&1
  exit 0
elif [[ $step == "on" ]]; then
  moarchy-screen wake >/dev/null 2>&1
  exit 0
fi

current=$(brightnessctl -d "$device" -m | cut -d',' -f4 | tr -d '%')

if [[ $step == "+5%" ]]; then
  if ((current < 5)); then ((target = current + 1)); else ((target = current + 5)); fi
  ((target > 100)) && target=100
  step="$target%"
elif [[ $step == "5%-" ]]; then
  if ((current <= 5)); then ((target = current - 1)); else ((target = current - 5)); fi
  ((target < 1)) && target=1
  step="$target%"
fi

brightnessctl -d "$device" set "$step" >/dev/null

# 4.x has no swayosd: the quickshell shell draws the OSD, and upstream feeds it
# through omarchy-osd. Best-effort -- a shell that is not up is not an error.
omarchy-osd -i brightness -p "$(brightnessctl -d "$device" -m | cut -d',' -f4 | tr -d '%')" \
  >/dev/null 2>&1 || true
