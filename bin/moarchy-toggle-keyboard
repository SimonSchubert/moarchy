#!/bin/bash
# Put the on-screen keyboard up or down.
#
# One of the two ways it moves at all. moarchy-keyboard does not raise itself:
# text focus writes nothing (its SPEC.md AC 50), so the keyboard comes up when
# the restore handle is tapped, when a text field is tapped, or when something
# drives this bus name, and goes down only the same way as the back gesture.
# Opening a surface or switching apps writes nothing.
#
# Driven over DBus, not by signal. moarchy-keyboard owns `sm.puri.OSK0` -- the
# same interface Phosh drives, kept deliberately so this script and anything
# else on that bus name still work -- and exposes a readable `Visible`
# property, so the toggle can ask before it acts instead of guessing.
#
# It used to send SIGRTMIN to wvkbd, and before that drove squeekboard on this
# same bus name. See moarchy-meta's depends for why each was replaced.
#
# Caveat unchanged: this cannot type into swaylock. Under ext-session-lock the
# compositor draws only the locker's own surface and every layer-shell client is
# hidden, the keyboard included. That is why bin/moarchy-system-lock
# blanks instead of locking when no hardware keyboard is attached.

set -euo pipefail

osk() {
  local verb=$1
  shift
  busctl --user "$verb" sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 "$@"
}

if ! visible=$(osk get-property Visible 2>/dev/null); then
  echo "${0##*/}: no on-screen keyboard on the bus (is moarchy-keyboard running?)" >&2
  exit 1
fi

# `busctl get-property` prints the variant as e.g. `b true`.
if [[ $visible == *true* ]]; then
  osk call SetVisible b false
else
  osk call SetVisible b true
fi
