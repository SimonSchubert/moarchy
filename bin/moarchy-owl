#!/usr/bin/env python3
# The OWL widget store, from the command line (docs/owl.md §B).
#
#   moarchy-owl catalog [--refresh]    the store's widgets as JSON, each with
#                                      what is installed of it
#   moarchy-owl show <id>              one, with the packages it needs that
#                                      are not installed
#   moarchy-owl install <id> [page]    download, check, record, add to home
#   moarchy-owl update <id> [--yes]    the same over an installed one; --yes
#                                      when what it runs or needs changed
#   moarchy-owl remove <id>            the file, the record and its tiles
#   moarchy-owl installed              what was installed, as recorded
#
# The one writer of ~/.config/omarchy/widgets/.market.json and of the .owl files
# it installs (OW15), as moarchy-home is of home.toml. Omalauncher's Market.kt
# is the model: a reviewed catalogue, a SHA-256 checked before anything is
# written, and what the user approved remembered, so an update that runs other
# commands asks again.
#
# MOARCHY_OWL_STORE points at another store (scripts/test-owl.sh serves one from
# a folder); MOARCHY_OWL_PACMAN replaces `sudo pacman` for the same reason.

import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.request

HOME = os.environ.get("HOME", "")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
CACHE_HOME = os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache")
WIDGETS = os.path.join(CONFIG, "omarchy", "widgets")
RECORD = os.path.join(WIDGETS, ".market.json")
CACHE = os.path.join(CACHE_HOME, "moarchy", "owl", "index.json")
STORE = os.environ.get("MOARCHY_OWL_STORE", "https://simonschubert.github.io/omarchy-widgets/")
if not STORE.endswith("/"):
    STORE += "/"
STALE = 60 * 60       # OW8: the catalogue is used for an hour
# The highest OWL language version the runtime runs (Owl.js LEVEL). An entry
# above it says so instead of installing (OW10).
RUNTIME_LEVEL = int(os.environ.get("MOARCHY_OWL_LEVEL", "13"))

ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]*/[A-Za-z0-9][A-Za-z0-9_-]*$")


def die(msg, code=1):
    print("moarchy-owl: " + msg, file=sys.stderr)
    sys.exit(code)


def fetch(path):
    req = urllib.request.Request(STORE + path, headers={"User-Agent": "moarchy-owl"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.read()


def write_atomic(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "wb") as f:
        f.write(data)
    os.replace(tmp, path)


def catalogue(refresh=False):
    """OW8. The store's widgets, from the cache while it is fresh; offline, the
    cache however old. Returns (widgets, age in seconds, offline)."""
    age = time.time() - os.path.getmtime(CACHE) if os.path.isfile(CACHE) else None
    if refresh or age is None or age > STALE:
        try:
            data = fetch("index.json")
            json.loads(data)
            write_atomic(CACHE, data)
            age = 0
        except Exception as e:  # network, HTTP, a half-written body
            if age is None:
                die(f"could not reach the store ({e})", 4)
            return load_cache(), age, True
    return load_cache(), age, False


def load_cache():
    with open(CACHE, encoding="utf-8") as f:
        return json.load(f).get("widgets", [])


def records():
    if not os.path.isfile(RECORD):
        return {}
    with open(RECORD, encoding="utf-8") as f:
        return json.load(f)


def save_records(r):
    write_atomic(RECORD, (json.dumps(r, indent=1, sort_keys=True) + "\n").encode())


def widget_id(entry_id):
    """The widget id a tile names (OW2): author-name, which no catalogue id
    shares with another."""
    return entry_id.replace("/", "-")


def file_for(entry_id):
    return os.path.join(WIDGETS, widget_id(entry_id) + ".owl")


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def compare_versions(a, b):
    def parts(v):
        return [int(p) if p.isdigit() else p for p in re.split(r"[.-]", str(v))]
    pa, pb = parts(a), parts(b)
    for x, y in zip(pa, pb):
        if x == y:
            continue
        if isinstance(x, int) and isinstance(y, int):
            return -1 if x < y else 1
        return -1 if str(x) < str(y) else 1
    return (len(pa) > len(pb)) - (len(pa) < len(pb))


def state_of(entry, recs):
    """What is installed of one entry: the parts OW9 and OW10 show."""
    rec = recs.get(entry["id"])
    path = file_for(entry["id"])
    present = rec is not None and os.path.isfile(path)
    edited = False
    if present:
        with open(path, "rb") as f:
            edited = sha256(f.read()) != rec.get("sha256")
    return {
        "widget": widget_id(entry["id"]),
        "installed": rec["version"] if present else None,
        "update": present and compare_versions(entry.get("version", "0"), rec["version"]) > 0,
        "changed": present and (entry.get("commands", []) != rec.get("commands", [])
                                or entry.get("requires", {}) != rec.get("requires", {})),
        "edited": edited,
        "supported": int(entry.get("owl", 1)) <= RUNTIME_LEVEL,
    }


def find(entry_id, widgets):
    if not ID.match(entry_id):
        die(f"'{entry_id}' is not a store id (author/name)", 2)
    for w in widgets:
        if w.get("id") == entry_id:
            return w
    die(f"no {entry_id} in the store", 1)


def packages(entry):
    return list((entry.get("requires") or {}).get("pacman", []))


def missing_packages(pkgs):
    """pacman -T prints what of them is not installed; nothing when all are."""
    if not pkgs:
        return []
    try:
        out = subprocess.run(["pacman", "-T"] + pkgs, capture_output=True, text=True).stdout
    except FileNotFoundError:
        return pkgs
    return [p for p in out.split() if p]


def install_packages(pkgs):
    if not pkgs:
        return True
    cmd = os.environ.get("MOARCHY_OWL_PACMAN", "sudo -n pacman").split()
    r = subprocess.run(cmd + ["-S", "--needed", "--noconfirm"] + pkgs)
    return r.returncode == 0


def home_page():
    """OW11: the page home shows, if it is a page of tiles; else page 1."""
    try:
        out = subprocess.run(["omarchy-shell", "home", "page"], capture_output=True,
                             text=True, timeout=5).stdout.strip()
        n = int(out)
        return n if n >= 1 else 1
    except (ValueError, FileNotFoundError, subprocess.TimeoutExpired):
        return 1


def page_with_room(page, size):
    """OW11 step 5: the page home says has room for it, from `page` on. Only the
    shell knows the grid's size; with no shell to ask, the page asked for."""
    try:
        out = subprocess.run(["omarchy-shell", "home", "room", str(page), str(size[0]), str(size[1])],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        return int(out) if int(out) >= 1 else page
    except (ValueError, FileNotFoundError, subprocess.TimeoutExpired):
        return page


def home_cli():
    here = os.path.dirname(os.path.realpath(__file__))
    beside = os.path.join(here, "moarchy-home")
    return beside if os.path.isfile(beside) else "moarchy-home"


def put(entry, recs):
    """OW11 steps 1-3: download, check, write, record. Returns the warnings."""
    try:
        data = fetch(entry["path"])
    except Exception as e:
        die(f"{entry['id']}: could not download it ({e}); nothing installed", 4)
    if sha256(data) != entry.get("sha256"):
        die(f"{entry['id']}: the download is not the reviewed file (SHA-256 differs); nothing installed", 5)
    write_atomic(file_for(entry["id"]), data)
    recs[entry["id"]] = {
        "id": entry["id"], "file": os.path.basename(file_for(entry["id"])),
        "version": entry.get("version", "0"), "commands": entry.get("commands", []),
        "requires": entry.get("requires", {}), "sha256": entry["sha256"],
    }
    save_records(recs)
    need = missing_packages(packages(entry))
    if need and not install_packages(need):
        return [f"could not install {' '.join(need)}; the widget may not work until they are"]
    return []


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__ or "", end="")
        print("usage: moarchy-owl {catalog [--refresh] | show ID | install ID [page] | update ID [--yes]"
              " | remove ID | installed}", file=sys.stderr)
        sys.exit(1 if not argv else 0)
    verb, args = argv[0], argv[1:]

    if verb == "catalog" and args in ([], ["--refresh"]):
        widgets, age, offline = catalogue(refresh=bool(args))
        recs = records()
        out = [dict(w, **state_of(w, recs)) for w in widgets]
        print(json.dumps({"store": STORE, "age": None if age is None else int(age),
                          "offline": offline, "widgets": out}))
        return

    if verb == "show" and len(args) == 1:
        widgets, _, _ = catalogue()
        w = find(args[0], widgets)
        print(json.dumps(dict(w, **state_of(w, records()), missing=missing_packages(packages(w)))))
        return

    if verb == "install" and 1 <= len(args) <= 2:
        widgets, _, _ = catalogue()
        w = find(args[0], widgets)
        recs = records()
        st = state_of(w, recs)
        if st["installed"]:
            die(f"{w['id']} is installed (v{st['installed']}); `moarchy-owl update {w['id']}`", 1)
        if not st["supported"]:
            die(f"{w['id']} needs owl {w.get('owl')}; this runtime runs up to {RUNTIME_LEVEL}", 6)
        if len(args) == 2 and not args[1].isdigit():
            die("the page is a number, 1 the first page of tiles", 2)
        page = int(args[1]) if len(args) == 2 else home_page()
        size = w.get("size") or [3, 2]
        page = page_with_room(page, size)
        warnings = put(w, recs)
        subprocess.run([home_cli(), "add", widget_id(w["id"]), str(page), str(size[0]), str(size[1])],
                       stdout=subprocess.DEVNULL, check=True)
        for line in warnings:
            print("moarchy-owl: " + line, file=sys.stderr)
        print(f"{widget_id(w['id'])} on page {page}")
        return

    if verb == "update" and 1 <= len(args) <= 2 and (len(args) == 1 or args[1] == "--yes"):
        widgets, _, _ = catalogue()
        w = find(args[0], widgets)
        recs = records()
        st = state_of(w, recs)
        if not st["installed"]:
            die(f"{w['id']} is not installed", 1)
        if not st["supported"]:
            die(f"{w['id']} {w.get('version')} needs owl {w.get('owl')}; this runtime runs up to {RUNTIME_LEVEL}", 6)
        # OW12, OW13: what was approved, or the user's own changes, are not
        # replaced without saying yes to it.
        if (st["changed"] or st["edited"]) and len(args) == 1:
            why = []
            if st["changed"]:
                why.append("its commands or packages changed since the version you approved")
            if st["edited"]:
                why.append("your changes to it go")
            die("; ".join(why) + f"; `moarchy-owl update {w['id']} --yes` to go ahead", 3)
        warnings = put(w, recs)
        for line in warnings:
            print("moarchy-owl: " + line, file=sys.stderr)
        print(f"{w['id']} {st['installed']} -> {w.get('version')}")
        return

    if verb == "remove" and len(args) == 1:
        if not ID.match(args[0]):
            die(f"'{args[0]}' is not a store id (author/name)", 2)
        recs = records()
        path = file_for(args[0])
        if args[0] not in recs and not os.path.isfile(path):
            die(f"{args[0]} is not installed", 1)
        subprocess.run([home_cli(), "remove", widget_id(args[0])],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if os.path.isfile(path):
            os.remove(path)
        recs.pop(args[0], None)
        save_records(recs)
        print(f"removed {args[0]}")
        return

    if verb == "installed" and not args:
        print(json.dumps(list(records().values())))
        return

    die("usage: moarchy-owl {catalog [--refresh] | show ID | install ID [page] | update ID [--yes]"
        " | remove ID | installed}", 1)


if __name__ == "__main__":
    main(sys.argv[1:])
