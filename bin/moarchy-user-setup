#!/bin/bash
# What is left after everything that can live in a system path does
# (docs/structure.md P8). Runs once per user, from a systemd user unit.
#
# The list is short on purpose. sway reads /etc/sway/config, the shell reads its
# defaults from /usr/share/omarchy/config/omarchy/shell.json and its plugins
# from /usr/share/moarchy/plugins, the Sway theme template ships into
# /usr/share/omarchy/default/themed, fontconfig reads /etc/fonts/conf.d. None of
# that is copied anywhere, which is why upgrading the package upgrades the
# phone.
#
# These are the exceptions: three app configs that only ever read ~/.config, and
# the initial theme, which writes user state by design.
set -uo pipefail

STAMP="$HOME/.local/state/moarchy/user-setup-done"

# Exported, not just set. omarchy-theme-set is a child process and reads
# OMARCHY_PATH from the environment; without the export it looked for themes
# under an unset path and answered "Theme 'tokyo-night' does not exist" while
# /usr/share/omarchy/themes/tokyo-night sat right there.
#
# And it has to be set at all, because nothing else sets it here. This runs
# from a systemd user unit, which inherits neither /etc/profile.d (that is
# login shells) nor the sway session's environment (that starts later).
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export PATH="/usr/lib/moarchy/bin:/usr/bin:$PATH"

say() { printf '==> %s\n' "$*"; }

# omarchy-theme-set-templates globs "$HOME/.config/omarchy/themed"/*.tpl ahead
# of the system directory. Create it empty so that glob has a directory to fail
# to match in rather than a missing path.
mkdir -p "$HOME/.config/omarchy/themed" \
         "$HOME/.local/state/omarchy/current" \
         "$HOME/.config/sway/config.d" \
         "$HOME/.local/state/moarchy"

# Upstream's app configs. Copied only when absent -- this runs once, and a user
# who has edited their foot config should not lose it to a reinstall.
#
# `omarchy` is deliberately NOT in this list. ~/.config/omarchy/shell.json
# OVERRIDES the packaged defaults, so copying upstream's there would mask the
# bar id and plugin list that moarchy sets system-side, and the phone would come
# up with the desktop bar and no phone UI.
for d in alacritty foot btop wiremix lazygit tmux imv; do
  src="$OMARCHY_PATH/config/$d"
  [[ -d $src ]] || continue
  [[ -e $HOME/.config/$d ]] && continue
  cp -r "$src" "$HOME/.config/$d"
  say "config $d"
done
[[ -f $OMARCHY_PATH/config/starship.toml && ! -e $HOME/.config/starship.toml ]] &&
  cp "$OMARCHY_PATH/config/starship.toml" "$HOME/.config/starship.toml"

# The terminal keeps Regular while the rest of the UI is lifted to SemiBold by
# /etc/fonts/conf.d/50-moarchy-weight.conf -- pages of semibold `ls` output are
# not an improvement.
#
# `style=Regular` rather than `weight=regular`, and the difference matters: the
# fontconfig rule tests `weight eq regular`, so asking for weight=regular is
# asking to be rewritten, while style=Regular sidesteps it.
if [[ -f $HOME/.config/foot/foot.ini ]] && ! grep -q "style=Regular" "$HOME/.config/foot/foot.ini"; then
  sed -i "s/^font=JetBrainsMono Nerd Font:/font=JetBrainsMono Nerd Font:style=Regular:/" \
    "$HOME/.config/foot/foot.ini"
fi

# A terminal here is 47x41 characters at font size 9, and btop refuses to draw below
# 60 columns whatever shown_boxes says. Trimming the boxes still helps in a
# split; moarchy-launch-tui is what actually makes it fit, by dropping the font
# size.
if [[ -f $HOME/.config/btop/btop.conf ]]; then
  sed -i 's/^shown_boxes = .*/shown_boxes = "cpu mem"/' "$HOME/.config/btop/btop.conf"
fi

# The starting theme, which also generates
# ~/.local/state/omarchy/current/theme/sway.conf -- the file /etc/sway/config
# includes. Without it sway starts with no theme colours at all.
# Not `2>/dev/null`: if this fails the reason is the only thing that will say
# why the phone has no colours.
if ! omarchy-theme-set tokyo-night; then
  echo "!! theme apply failed -- not stamping, so this runs again next login" >&2
  echo "   fix it by hand with: omarchy-theme-set tokyo-night" >&2
  exit 1
fi

# The starting background. Left to itself omarchy-theme-set takes whichever
# file sorts first in the theme's backgrounds directory -- 0-winding-road on
# tokyo-night -- so the phone's wallpaper is decided by a filename prefix
# upstream is free to renumber. Name the one we want instead.
#
# Linked through current/theme rather than /usr/share/omarchy/themes: that is
# the path omarchy-theme-bg-next builds its list from and compares the symlink
# against, and a link to the packaged file matches no entry in that list, so
# the first swipe to the next background would jump back to the first one.
BACKGROUND="$HOME/.local/state/omarchy/current/theme/backgrounds/1-quattro.jpg"
if [[ -f $BACKGROUND ]]; then
  ln -nsf "$BACKGROUND" "$HOME/.local/state/omarchy/current/background"
else
  # Not fatal: the theme applied, and theme-set already left a background
  # symlink of its own choosing. Only the choice is lost, so say so and stamp.
  echo "!! no $(basename "$BACKGROUND") in the theme -- keeping the default background" >&2
fi

# Stamped only on success. Stamping a failed run is how a phone ends up with no
# theme for good: sway includes the generated sway.conf and moarchy-keyboard
# reads the generated colors.toml, and neither is retried once the stamp exists.
date -Iseconds >"$STAMP"
say "done"
