#!/bin/bash
# What is left after everything that can live in a system path does
# (docs/structure.md P8). Runs once per user, from a systemd user unit.
#
# The list is short on purpose. sway reads /etc/sway/config, the shell reads its
# defaults from /usr/share/omarchy/config/omarchy/shell.json and its plugins
# from /usr/share/moarchy/plugins, the Sway theme template ships into
# /usr/share/omarchy/default/themed, fontconfig reads /etc/fonts/conf.d. None of
# that is copied anywhere, which is why upgrading the package upgrades the
# phone.
#
# These are the exceptions: three app configs that only ever read ~/.config, the
# initial theme, which writes user state by design, and the coding-agent
# wrappers, which are files in ~/.local/bin because that is where mise-managed
# tools live.
set -uo pipefail

STAMP="$HOME/.local/state/moarchy/user-setup-done"

# Exported, not just set. omarchy-theme-set is a child process and reads
# OMARCHY_PATH from the environment; without the export it looked for themes
# under an unset path and answered "Theme 'tokyo-night' does not exist" while
# /usr/share/omarchy/themes/tokyo-night sat right there.
#
# And it has to be set at all, because nothing else sets it here. This runs
# from a systemd user unit, which inherits neither /etc/profile.d (that is
# login shells) nor the sway session's environment (that starts later).
export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export PATH="/usr/lib/moarchy/bin:/usr/bin:$PATH"

say() { printf '==> %s\n' "$*"; }

# In a function, and not for tidiness. This script runs ONCE -- the unit carries
# ConditionPathExists on the stamp -- so a phone already in the field upgrades to
# a moarchy that has dropped two terminals and still has no default terminal set.
# `moarchy-user-setup --terminal` runs just this much, which is the same escape
# hatch the unit already documents for `moarchy-agent seed`, and it is guarded on
# absence so running it twice costs nothing.
#
# Not "re-run the whole script": omarchy-theme-set below is unconditional, so
# that would throw away a theme and a wallpaper somebody chose.
setup_terminal() {
  # ~/.config is created by the mkdir -p below, which the --terminal path never
  # reaches -- so it is ensured here rather than assumed.
  mkdir -p "$HOME/.config"

  # foot is the default terminal, and this file is what makes that true anywhere
  # outside our own scripts (docs/apps.md T2). Everything that opens a terminal
  # through XDG -- xdg-terminal-exec, upstream's omarchy-launch-* wrappers,
  # `Terminal=true` desktop entries -- resolves it here.
  #
  # Without it xdg-terminal-exec HANGS rather than failing, which is what made
  # $mod+Return look like a dead keybinding for months. It is also what let
  # qmlkonsole win the default simply by being a TerminalEmulator that claimed it,
  # which is the whole reason omarchy-launch-about answers `Unknown option
  # 'render'` and bin/moarchy-about exists.
  #
  # Written by hand rather than by calling `omarchy-default-terminal foot`, for
  # the same reason as the configs above: that command also fires
  # omarchy-notification-send, and this runs from a systemd user unit before there
  # is a shell to notify. The format is upstream's, so its reader still parses it.
  #
  # Only when absent. A user who picked a different terminal in Settings keeps it.
  if [[ ! -e $HOME/.config/xdg-terminals.list ]]; then
    cat >"$HOME/.config/xdg-terminals.list" <<'TERMLIST'
# Terminal emulator preference order for xdg-terminal-exec
# The first found and valid terminal will be used
foot.desktop
TERMLIST
    say "default terminal foot"
  fi

  # footclient and foot-server are NOT masked here, and that is a finding rather
  # than an omission. They are the other two TerminalEmulator entries the foot
  # package ships, neither of them NoDisplay, so removing alacritty and qmlkonsole
  # looked like it would leave three terminal tiles behind -- and upstream Omarchy
  # already hides both, by id, in /usr/share/omarchy/default/omarchy/launcher.hides
  # (`btop` is in there too). AppLibrary reads that file into
  # configuredHiddenEntryIds and filters on it beside the NoDisplay scan.
  #
  # A NoDisplay copy in ~/.local/share/applications does work -- it makes
  # hidden-entries.sh report both ids -- and it changes nothing, because they were
  # already filtered. It was written, measured against the drawer, and deleted.
  #
  # Worth knowing how nearly it went the other way: the first A/B test moved the
  # masks out and re-queried, and the drawer still hid both, which reads as "the
  # masks are not what does it". It was a stale cache. desktopHiddenEntryIds is
  # only recomputed on appsChanged, and REMOVING a NoDisplay file changes nothing
  # in DesktopEntries.applications -- so no rescan fired, and the shell answered
  # with the list it had built while the masks existed. The test that settled it
  # forced a rescan by adding a visible entry, then cloned footclient's exact
  # content under a new id: the clone appeared, so the filter was on the id.
}

# Before anything else, so the escape hatch does not depend on the rest of the
# script -- and before the stamp is consulted, because a phone that needs this
# is by definition one that is already stamped.
if [[ ${1:-} == --terminal ]]; then
  setup_terminal
  exit 0
fi

# omarchy-theme-set-templates globs "$HOME/.config/omarchy/themed"/*.tpl ahead
# of the system directory. Create it empty so that glob has a directory to fail
# to match in rather than a missing path.
#
# ~/.local/share/applications is here for a subtler reason than the rest, and it
# is the one directory that has to exist before the SHELL starts rather than
# before this script ends. Quickshell's DesktopEntries watches it, and a watch
# cannot be placed on a directory that is not there -- so a shell that came up
# first never noticed the directory being created and showed no user .desktop
# file for the life of the session. Measured on the device 2026-09-07: the agent
# tile written at 18:47 was invisible to a shell started at 18:40 and appeared
# within three seconds of a restart, after which a second entry showed up live.
mkdir -p "$HOME/.config/omarchy/themed" \
         "$HOME/.local/state/omarchy/current" \
         "$HOME/.config/sway/config.d" \
         "$HOME/.local/share/applications" \
         "$HOME/.local/state/moarchy"

# Upstream's app configs. Copied only when absent -- this runs once, and a user
# who has edited their foot config should not lose it to a reinstall.
#
# `omarchy` is deliberately NOT in this list. ~/.config/omarchy/shell.json
# OVERRIDES the packaged defaults, so copying upstream's there would mask the
# bar id and plugin list that moarchy sets system-side, and the phone would come
# up with the desktop bar and no phone UI.
for d in foot btop wiremix lazygit tmux imv; do
  src="$OMARCHY_PATH/config/$d"
  [[ -d $src ]] || continue
  [[ -e $HOME/.config/$d ]] && continue
  cp -r "$src" "$HOME/.config/$d"
  say "config $d"
done
[[ -f $OMARCHY_PATH/config/starship.toml && ! -e $HOME/.config/starship.toml ]] &&
  cp "$OMARCHY_PATH/config/starship.toml" "$HOME/.config/starship.toml"

# The terminal keeps Regular while the rest of the UI is lifted to SemiBold by
# /etc/fonts/conf.d/50-moarchy-weight.conf -- pages of semibold `ls` output are
# not an improvement.
#
# `style=Regular` rather than `weight=regular`, and the difference matters: the
# fontconfig rule tests `weight eq regular`, so asking for weight=regular is
# asking to be rewritten, while style=Regular sidesteps it.
if [[ -f $HOME/.config/foot/foot.ini ]] && ! grep -q "style=Regular" "$HOME/.config/foot/foot.ini"; then
  sed -i "s/^font=JetBrainsMono Nerd Font:/font=JetBrainsMono Nerd Font:style=Regular:/" \
    "$HOME/.config/foot/foot.ini"
fi

# A terminal here is 47x41 characters at font size 9, and btop refuses to draw below
# 60 columns whatever shown_boxes says. Trimming the boxes still helps in a
# split; moarchy-launch-tui is what actually makes it fit, by dropping the font
# size.
if [[ -f $HOME/.config/btop/btop.conf ]]; then
  sed -i 's/^shown_boxes = .*/shown_boxes = "cpu mem"/' "$HOME/.config/btop/btop.conf"
fi

setup_terminal

# The coding agents: nine wrappers and one drawer tile, and not one download.
#
# `seed` writes a five-line ~/.local/bin/<name> per agent through
# omarchy-mise-install, each of which runs `mise use -g <package>` on ITS first
# invocation -- so this costs no network here and no disk until someone
# actually opens one. Upstream does the same for thirteen tools in
# install/user/mise.sh. All nine rather than the one that used to be here,
# because the cost of the other eight is eight small files: what a wrapper buys
# is that `claude` typed into the terminal works, that
# `omarchy-cmd-present claude` is true, and that upstream's keybinding launcher
# -- which gives up on `omarchy-cmd-missing` before it ever reaches mise -- has
# something to find.
#
# The tile is one file however many agents there are (see moarchy-agent): a
# 64-entry grid does not want nine icons for a thing nobody runs nine of, so
# moarchy-agent.desktop carries whichever agent was picked last and is rewritten
# rather than added to. At first boot nothing has been picked -- Omarchy writes
# no default -- so what it carries is the SETUP tile, which opens the page that
# lists all nine. It named Grok until 2026-09-08, which is the one agent this
# script used to install, and which told a user who wanted Claude that their
# phone had come with the wrong agent.
#
# ~/.local/bin is on PATH for the shell already: /etc/profile.d/omarchy.sh
# sources upstream's env-bootstrap, which appends it, and sway starts from the
# login shell, so quickshell inherits it.
#
# Not fatal, and deliberately not an exit. Settings > Apps & defaults > Default
# apps > AI agent installs any of the nine with or without this -- those rows
# carry no presence guard and run omarchy-default-agent, which asks mise
# directly. What is lost is the tile and the names on PATH. The theme below is
# what decides whether the phone has colours at all.
if ! moarchy-agent seed; then
  echo "!! could not seed the coding agents -- Settings > Apps > AI agent still installs one" >&2
fi

# The starting theme, which also generates
# ~/.local/state/omarchy/current/theme/sway.conf -- the file /etc/sway/config
# includes. Without it sway starts with no theme colours at all.
# Not `2>/dev/null`: if this fails the reason is the only thing that will say
# why the phone has no colours.
if ! omarchy-theme-set tokyo-night; then
  echo "!! theme apply failed -- not stamping, so this runs again next login" >&2
  echo "   fix it by hand with: omarchy-theme-set tokyo-night" >&2
  exit 1
fi

# The starting background. Left to itself omarchy-theme-set takes whichever
# file sorts first in the theme's backgrounds directory -- 0-winding-road on
# tokyo-night -- so the phone's wallpaper is decided by a filename prefix
# upstream is free to renumber. Name the one we want instead.
#
# Linked through current/theme rather than /usr/share/omarchy/themes: that is
# the path omarchy-theme-bg-next builds its list from and compares the symlink
# against, and a link to the packaged file matches no entry in that list, so
# the first swipe to the next background would jump back to the first one.
BACKGROUND="$HOME/.local/state/omarchy/current/theme/backgrounds/1-quattro.jpg"
if [[ -f $BACKGROUND ]]; then
  ln -nsf "$BACKGROUND" "$HOME/.local/state/omarchy/current/background"
else
  # Not fatal: the theme applied, and theme-set already left a background
  # symlink of its own choosing. Only the choice is lost, so say so and stamp.
  echo "!! no $(basename "$BACKGROUND") in the theme -- keeping the default background" >&2
fi

# Stamped only on success. Stamping a failed run is how a phone ends up with no
# theme for good: sway includes the generated sway.conf and moarchy-keyboard
# reads the generated colors.toml, and neither is retried once the stamp exists.
date -Iseconds >"$STAMP"
say "done"
