#!/bin/bash
# Assert the phone UI is actually wired up, on the running session.
#
# Every regression this stack has hit was silent: the swipe still answered "ok"
# while nothing happened, the keyboard still drew while refusing to retract, the
# launcher still reported success with its binary missing from PATH. None of
# them showed up as an error anywhere, and all of them were found by hand.
#
# So each check here is one of those failures, turned into a question with a
# yes/no answer. Run it after touching autostart.conf, the plugin, or the shell.
#
# Read-only apart from hiding the on-screen keyboard, which the checks need in a
# known state and which the next text field will undo.
#
# Four opt-in suites take a flag, because each needs more than a read:
#
#   --gestures   drives real touch through /dev/uinput. Needs root and
#                python-evdev, and closes a window at the end. Section L
#                creates a launcher of its own under
#                ~/.local/share/applications and removes it again through the
#                drawer -- no package moves, and nothing you installed is
#                touched, but a launcher really does get deleted, because a
#                check that only ever plans would pass against a Remove button
#                wired to nothing.
#   --settings   walks the Settings stack over IPC, against docs/settings.md.
#                Flips three switches and restores them; launches nothing.
#                Section J sets reminders and clears them, so any that were
#                pending are gone afterwards -- a transient timer cannot be put
#                back with the time it had left.
#   --surfaces   checks what the gesture strip is drawn over, against
#                docs/gestures.md I. Opens every overlay in turn and takes one
#                grim capture per sheet; I5 also needs the touch injector.
#   --windows    the window area and the launch splash, against docs/windows.md.
#                Opens a terminal and an app and closes both again, and turns
#                gaps on for a second. Takes about a minute: L6 is a 15s
#                timeout that has to be waited out.

set -uo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
[[ -n ${SWAYSOCK:-} ]] || SWAYSOCK=$(ls "$XDG_RUNTIME_DIR"/sway-ipc.* 2>/dev/null | head -1)
export SWAYSOCK

# Exported, not just set: omarchy-shell reads OMARCHY_PATH to find the running
# shell, and without it in the environment every IPC check below reports the
# plugin missing when it is loaded and fine.
export OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"

# --- where moarchy's own files are ------------------------------------------
#
# moarchy installed itself into ~/.local/share/moarchy when it was an installer.
# It is a package now: scripts in /usr/lib/moarchy/bin (not /usr/bin -- 19 names
# collide with upstream Omarchy's, and two packages cannot own one path), the
# rest under /usr/share/moarchy. The old root does not exist on a packaged
# phone.
#
# Every check that reads a moarchy file goes through these two. Seven of them
# were still spelling the installer's path, and none said so out loud: a `grep`
# against a file that is not there, a `command -v` compared to a prefix nothing
# can match, a PATH entry silently adding a directory that does not exist. W2
# reported "pinephone.conf does not set gaps inner 0" about a config that sets
# it on line 21.
#
# Overridable so the failing branch of each can be run on purpose.
MOARCHY_ROOT="${MOARCHY_ROOT:-${MOARCHY_PATH:-/usr/share/moarchy}}"
MOARCHY_BIN="${MOARCHY_BIN:-/usr/lib/moarchy/bin}"

export PATH="$HOME/.local/bin:$MOARCHY_BIN:$OMARCHY_PATH/bin:$PATH"

pass=0
fail=0

ok()   { printf '  \033[32mPASS\033[0m  %s\n' "$1"; pass=$((pass + 1)); }
no()   { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; [[ -n ${2:-} ]] && printf '        %s\n' "$2"; fail=$((fail + 1)); }
# Counted as neither: a check whose subject is not on this image at all. The
# opt-in suites have had w_skip for this; the default suite needed it once
# something outside the package set -- the store -- became worth asserting.
skip_() { printf '  \033[90mSKIP  %s\033[0m\n' "$1"; }
head_() { printf '\n%s\n' "$1"; }

# --- where a plugin's files are ---------------------------------------------
#
# Two directories hold plugins, and until now every check below read only the
# second one. The shell's PluginRegistry scans /usr/share/moarchy/plugins first
# and ~/.config/omarchy/plugins second, keyed by id so the later write wins:
# the packaged copy is what runs unless a user copy overrides it.
#
# moarchy ships its plugins as a package now, so an empty ~/.config is the
# normal state and not a broken one. Reading only there turned that into six
# failures for the manifest checks -- and, worse, into a PASS for the icon
# check, which found no literals to complain about because it had opened no
# files. Eight overrides were deleted on 2026-09-07 and the directory is empty;
# that is the state these checks now have to be correct in.
#
# Resolved per plugin rather than per directory, because an override is one
# plugin and not a set: with moarchy.settings overridden and the rest packaged,
# neither directory is the answer on its own.
#
# Overridable only so the failing branches can be run. A check that has never
# been seen to fail is a claim, not a check, and pointing these at empty
# directories is the only way to watch these ones fail on purpose.
SYSTEM_PLUGINS="${SYSTEM_PLUGINS:-/usr/share/moarchy/plugins}"
USER_PLUGINS="${USER_PLUGINS:-$HOME/.config/omarchy/plugins}"

# plugin_dir <id> -- the directory the shell would load that plugin from.
# Prints the packaged path when neither has it, so a caller's own "is it there"
# test names the place it should have been.
plugin_dir() {
  if [[ -d $USER_PLUGINS/$1 ]]; then printf '%s\n' "$USER_PLUGINS/$1"
  else printf '%s\n' "$SYSTEM_PLUGINS/$1"; fi
}

# --- the session is there at all -------------------------------------------
head_ "session"

if pgrep -x sway >/dev/null; then ok "sway is running"; else no "sway is not running"; fi

# An on-screen keyboard, not a *named* one. This asserted `squeekboard` by
# process name and went red the moment the keyboard was replaced -- reporting a
# working phone as broken, and naming the wrong thing as the cause. The
# invariant is the contract: something owns sm.puri.OSK0 and answers on it,
# which is what moarchy-toggle-keyboard and the back gesture both drive.
#
# The same mistake in the other direction cost a peer session an afternoon: its
# suite confidently reported on squeekboard while a different implementation
# owned the name. Assert the interface, not the implementation.
if osk_owner=$(busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 \
                 sm.puri.OSK0 Visible 2>/dev/null) && [[ -n $osk_owner ]]; then
  ok "an on-screen keyboard owns sm.puri.OSK0 ($(pgrep -a -x 'squeekboard|moarchy-keyboar' 2>/dev/null | head -1 | cut -d" " -f2- || echo present))"
else
  no "nothing owns sm.puri.OSK0" "no on-screen keyboard is running, so typing is impossible"
fi
if pgrep -f 'quickshell' >/dev/null; then ok "the shell is running"; else no "the shell is not running"; fi
if pgrep -f one-app-per-workspace >/dev/null; then
  ok "one-app-per-workspace is running"
else
  no "one-app-per-workspace is not running" "new windows will tile at ~180px instead of taking a workspace"
fi

# A check that lisgd is not running lived here. lisgd bound the same bottom edge
# as the gesture plugin, so both fired on one swipe -- but the package is gone
# with bin/moarchy-gestures (docs/refactor.md A1-A3), and a check for a daemon
# nothing can install is a check that passes for the wrong reason.

# --- the shell can reach the things it shells out to ------------------------
head_ "shell environment"

# A shell restarted without the session environment gets
# /usr/local/sbin:/usr/local/bin:/usr/bin, and then every omarchy-* call it
# makes fails with 127 while the gesture still answers "ok".
shell_pid=$(pgrep -f 'quickshell' | head -1)
if [[ -n $shell_pid ]] && shell_path=$(tr '\0' '\n' <"/proc/$shell_pid/environ" 2>/dev/null | sed -n 's/^PATH=//p'); then
  if [[ $shell_path == *"$OMARCHY_PATH/bin"* ]]; then
    ok "the shell's PATH carries the omarchy bins"
  else
    no "the shell's PATH is missing $OMARCHY_PATH/bin" \
       "restart it with: swaymsg exec moarchy-restart-shell"
  fi
else
  no "cannot read the shell's environment"
fi

# The package databases, because Settings has thirty-odd rows that are a pacman
# call and every one of them fails together. The image caches its databases from
# a file:// repo with SigLevel = Never and then configures the real one with
# SigLevel = Required, so a flashed phone shipped a moarchy.db with no signature
# beside it -- and pacman refuses the whole transaction over one database it
# cannot verify, so even `pacman -Sp vim` out of [extra] failed. One
# `pacman -Sy` repairs it; image/configure.sh now does that at build time.
_repo=$(awk -F'[][]' '/^\[.*\]/ && $2 != "options" { print $2 }' /etc/pacman.conf \
        | grep -x moarchy || true)
if [[ -n $_repo ]]; then
  if [[ -f /var/lib/pacman/sync/moarchy.db && ! -f /var/lib/pacman/sync/moarchy.db.sig ]]; then
    no "the moarchy database has no signature beside it" \
       "SigLevel = Required refuses it, and every pacman row in Settings fails: sudo pacman -Sy"
  elif pacman -Sp --print-format '%n' pacman >/dev/null 2>&1; then
    ok "pacman can resolve a package, so the install rows have something to run"
  else
    no "pacman cannot resolve a package" \
       "$(pacman -Sp --print-format '%n' pacman 2>&1 | head -1)"
  fi
fi

if [[ -x $OMARCHY_PATH/bin/omarchy-menu ]]; then
  ok "omarchy-menu exists where the plugin calls it"
else
  no "omarchy-menu is missing from $OMARCHY_PATH/bin"
fi

# The same question for the store's terminal launcher, which is a harder one to
# notice going wrong. A name that resolves to nothing does not raise anything
# there: terminal_command() returns "", can_open() says no, and the Open button
# is *hidden* -- which is also what the store correctly does for a package that
# owns no single binary, so the screen looks right either way. That is how
# `mobileomarchy-launch-tui` survived the rename, with every TUI in the
# catalogue silently losing its Open button.
#
# Read out of the installed file rather than restated, so this asks about the
# store on the image and not about the string in a checkout.
store_py=$(pacman -Qlq moarchy-store-git 2>/dev/null | grep -m1 '/launcher\.py$')
if [[ -z $store_py || ! -r $store_py ]]; then
  skip_ "the store is not installed; nothing to ask about its TUI launcher"
else
  tui=$(sed -n 's/^TUI_LAUNCHER = "\(.*\)"$/\1/p' "$store_py" | head -1)
  # Absolute or bare: `which` answers for both, and which of the two the store
  # uses is its business, not this check's.
  if [[ -z $tui ]]; then
    no "cannot read TUI_LAUNCHER out of $store_py" \
       "it stopped being a plain string literal, and this check now proves nothing"
  elif command -v "$tui" >/dev/null 2>&1; then
    ok "the store's terminal launcher exists where it calls it ($tui)"
  else
    no "the store calls '$tui', which is not here" \
       "Open does not fail for terminal apps -- it disappears, and nothing says why"
  fi
fi

# shade S6/S6b/S6c. The two pickers, from both ends: the shade's long press and
# the matching Settings row have to name one thing, and the two pairs no longer
# name the same *kind* of thing.
#
# The parity half is not pedantry -- the two were written apart and drifted
# apart, and neither fails loudly when it is wrong: an action row opens a
# terminal that closes again, which reads as the TUI having quit.
#
# This check used to read one command out of each side, and stopped being true
# twice. First when S6b turned the Wi-Fi picker into a screen, which left the
# command-parity half reading the *Bluetooth* tile and comparing bluetui
# against a row that named no command at all. Then when S6c did the same to
# Bluetooth, at which point neither side names a command and the sed for
# `floating-terminal-with-presentation` matches nothing anywhere.
#
# So both are plugin ids now, and both are read the same way by the same loop
# -- which is the actual fix for a check that drifted twice: there is no longer
# a Wi-Fi shape and a Bluetooth shape to fall out of step.
#
# The shade side is read off the function that opens the screen rather than off
# a `summon(` line, because both tiles go through one openScreen(id) and the
# literal id is on the function, not on the summon.
shade_qml="$(plugin_dir moarchy.shade)/Shade.qml"
pages_js="$(plugin_dir moarchy.settings)/Pages.js"
if [[ ! -f $shade_qml || ! -f $pages_js ]]; then
  no "no plugin to read the pickers out of ($shade_qml, $pages_js)" \
     "neither the package nor an override has these; S6b and S6c prove nothing"
else
  # S6b, S6c. Read as ids, because a dotted plugin id is exactly what the old
  # `[a-z0-9-]*` could not match.
  #
  #   id | AC | the shade's opener | the Settings row's label | wanted
  while IFS='|' read -r kind ac opener label want; do
    [[ -n $kind ]] || continue
    shade_id=$(sed -n "/function $opener(/s/.*openScreen(\"\([a-z.]*\)\").*/\1/p" "$shade_qml" | head -1)
    row_id=$(sed -n "/label: \"$label\"/,/}/s/.*summon \(moarchy\.[a-z]*\).*/\1/p" "$pages_js" | head -1)
    if [[ -z $shade_id || -z $row_id ]]; then
      no "cannot read the $kind picker out of the shade (${shade_id:-none}) or Settings (${row_id:-none})" \
         "one of the two stopped naming a plugin the way this check reads it"
    elif [[ $shade_id != "$row_id" ]]; then
      no "the shade summons '$shade_id' and Settings summons '$row_id'" \
         "$ac: one picker behind both entry points"
    elif [[ $shade_id != "$want" ]]; then
      no "the $kind picker is '$shade_id', not $want" \
         "$ac: the picker is a screen with tap targets, not a terminal"
    elif [[ ! -d $(plugin_dir "$want") ]]; then
      no "the $kind picker names $want, which is not installed" \
         "$ac: both ends agree on a plugin that is not there, so the press does nothing"
    else
      ok "the $kind picker is $want from both the shade and Settings"
    fi
  done <<'ROWS'
Wi-Fi|S6b|openWifi|Wi-Fi networks|moarchy.wifi
Bluetooth|S6c|openBluetooth|Bluetooth devices|moarchy.bluetooth
ROWS
fi

# --- the coding agent tile (docs/settings.md P) ------------------------------
head_ "coding agent"

# Everything below that writes runs against a throwaway HOME. moarchy-agent
# reaches ~/.local/share/applications and ~/.local/bin through $HOME and nothing
# else, so a temporary one exercises the real code paths and leaves the phone's
# own tile, wrappers and chosen agent untouched. A selftest that rewrites the
# drawer to prove the drawer is written is not a check, it is a side effect.
agent_home=$(mktemp -d) || agent_home=""
agent_bin=$(command -v moarchy-agent)
agent_icons="$MOARCHY_ROOT/agents"

if [[ -z $agent_bin ]]; then
  no "moarchy-agent is not on PATH" "the drawer tile and the nine wrappers both come from it"
elif [[ -z $agent_home ]]; then
  no "cannot make a scratch HOME to exercise moarchy-agent in"
else
  ag() { env HOME="$agent_home" MOARCHY_PATH="$MOARCHY_ROOT" "$agent_bin" "$@"; }
  entry="$agent_home/.local/share/applications/moarchy-agent.desktop"
  field() { sed -n "s/^$1=//p" "$entry" | head -1; }

  # P5. One list, four copies, and none of them checked against another: all
  # four are checked against upstream's, which is the only one that can change
  # under us. `omarchy:args=` is a comment upstream maintains beside the case
  # statement -- it is how `omarchy default agent` prints its own usage -- so it
  # is a machine-readable list rather than a scrape of shell.
  p5_bad=$(python3 - "$agent_bin" "$(command -v omarchy-default-agent)" \
                    "$(plugin_dir moarchy.settings)/Pages.js" "$agent_icons" <<'P5PY'
import os, re, subprocess, sys

agent_bin, upstream, pages, icons = sys.argv[1:5]
bad = []

def names(label, got):
    if not got:
        bad.append(f"{label} is empty")
    return sorted(got)

ours = names("moarchy-agent list",
             subprocess.run([agent_bin, "list"], capture_output=True, text=True)
                       .stdout.split())

# [pi|omp|opencode|...] on the omarchy:args line.
theirs = []
if upstream and os.path.exists(upstream):
    for line in open(upstream, encoding="utf-8", errors="replace"):
        m = re.match(r"#\s*omarchy:args=\[([^\]]+)\]\s*$", line.strip())
        if m:
            theirs = [n.strip() for n in m.group(1).split("|")]
            break
    if not theirs:
        bad.append("no `omarchy:args=[...]` line in omarchy-default-agent; "
                   "upstream changed shape and this check now proves nothing")
else:
    bad.append("omarchy-default-agent is not installed")
theirs = names("omarchy-default-agent's args", theirs)

# The choice rows on the agent page, by id, between its declaration and the
# `]},` that closes it -- the same span F8 reads.
rows = []
if os.path.exists(pages):
    lines = open(pages, encoding="utf-8").read().splitlines()
    start = next((i for i, l in enumerate(lines)
                  if l.startswith('"apps.default.agent": {')), None)
    if start is None:
        bad.append("no apps.default.agent page in Pages.js")
    else:
        end = next(i for i in range(start, len(lines)) if lines[i].startswith("]},"))
        for l in lines[start:end]:
            m = re.search(r'id:\s*"([^"]+)",\s*type:\s*"choice"', l)
            if m:
                rows.append(m.group(1))
else:
    bad.append(f"no Pages.js at {pages}")
rows = names("the rows on apps.default.agent", rows)

all_svgs = ([f[:-4] for f in os.listdir(icons) if f.endswith(".svg")]
            if os.path.isdir(icons) else [])
# setup.svg is the tile drawn before any agent is picked (P10) -- the one file
# in that directory that is not an agent. Set ASIDE rather than ignored: it is
# asserted present first, so excusing it from the comparison cannot hide it
# going missing, which would silently drop a fresh phone back to `system-run`.
if "setup" not in all_svgs:
    bad.append("no setup.svg in %s; a phone with nothing picked draws system-run"
               % icons)
svgs = names("the shipped icons", [n for n in all_svgs if n != "setup"])

for label, got in (("moarchy-agent list", ours),
                   ("apps.default.agent rows", rows),
                   ("%s/*.svg" % icons, svgs)):
    if theirs and got != theirs:
        missing = [n for n in theirs if n not in got]
        extra   = [n for n in got if n not in theirs]
        bad.append("%s differs from upstream's%s%s" % (
            label,
            " (missing " + ", ".join(missing) + ")" if missing else "",
            " (extra " + ", ".join(extra) + ")" if extra else ""))

print("; ".join(bad))
P5PY
)
  if [[ -z $p5_bad ]]; then
    ok "P5 one agent list: moarchy-agent, Pages.js and the icons all match upstream's"
  else
    no "P5 $p5_bad" "an agent upstream adds must fail here, not arrive with no icon"
  fi

  # P3. Nothing chosen, so the tile is the setup tile -- twice, because an
  # absent defaults file and a corrupt one are different code paths and both
  # have to land here rather than on a tile named after junk.
  ag entry >/dev/null 2>&1
  p3_absent=$(field X-Moarchy-Agent)
  mkdir -p "$agent_home/.config/omarchy/defaults"
  printf 'half-written-garbage\n' >"$agent_home/.config/omarchy/defaults/agent"
  ag entry >/dev/null 2>&1
  p3_junk=$(field X-Moarchy-Agent)
  rm -f "$agent_home/.config/omarchy/defaults/agent"
  ag entry >/dev/null 2>&1
  if [[ $p3_absent == none && $p3_junk == none && $(field Name) == "AI Agent" ]]; then
    ok "P3 with nothing picked the tile offers the picker, not an agent"
  else
    no "P3 the tile on a fresh HOME is absent=$p3_absent junk=$p3_junk name=$(field Name)" \
       "naming one agent arbitrarily tells a user who wants another that the phone came wrong"
  fi

  # P10. And that tile opens the picker rather than installing anything.
  p10_exec=$(field Exec)
  if [[ $p10_exec == "omarchy-shell settings openAt apps.default.agent" ]]; then
    ok "P10 the setup tile opens the AI agent page"
  else
    no "P10 the setup tile runs '$p10_exec'" \
       "it must reach the page that lists all nine, not install one of them"
  fi

  # P11. And it is findable by the name of the agent someone actually wants,
  # which is the drawer search that returned nothing at all before.
  p11_missing=""
  p11_keywords=$(field Keywords)
  while read -r a; do
    [[ $p11_keywords == *"$a;"* ]] || p11_missing="$p11_missing $a"
  done < <("$agent_bin" list)
  if [[ -z $p11_missing ]]; then
    ok "P11 the setup tile is findable by every agent name"
  else
    no "P11 the setup tile's Keywords omit:$p11_missing" \
       "a new user typing 'claude' into the drawer finds nothing"
  fi

  # P4. A file path, not a theme name, and one that is actually there.
  icon=$(field Icon)
  if [[ $icon == /* && -f $icon ]]; then
    ok "P4 the tile's icon is a file that exists ($(basename "$icon"))"
  elif [[ $icon == /* ]]; then
    no "P4 the tile names $icon, which is not there" "the drawer draws an empty slot and says nothing"
  else
    no "P4 the tile's icon is the theme name '$icon'" \
       "no agent has one in Adwaita, breeze or hicolor; see docs/settings.md P4"
  fi

  # P1 and P2. Two agents opened in turn leave one tile, and it is the second.
  # `entry` and not `open`, because `open` ends in `exec omarchy-default-agent`
  # and would install an agent and hold a terminal; the tile is written by the
  # same function either way.
  ag entry claude >/dev/null 2>&1
  ag entry opencode >/dev/null 2>&1
  tiles=""
  for f in "$agent_home/.local/share/applications"/moarchy-agent*.desktop; do
    [[ -e $f ]] && tiles="$tiles$(basename "$f") "
  done
  if [[ $tiles == "moarchy-agent.desktop " ]]; then
    ok "P1 two agents in turn leave one tile"
  else
    no "P1 the drawer has: $tiles" "one tile per agent is nine icons in a 64-entry grid"
  fi

  if [[ $(field Name) == "OpenCode" && $(field Exec) == "moarchy-agent open opencode" \
        && $(field Icon) == */opencode.svg && $(field X-Moarchy-Agent) == opencode ]]; then
    ok "P2 the tile's name, icon and Exec all move to the agent picked last"
  else
    no "P2 the tile disagrees with itself" \
       "Name=$(field Name) Exec=$(field Exec) Icon=$(field Icon) agent=$(field X-Moarchy-Agent)"
  fi

  # P8. The per-agent files the old scheme wrote, on a phone upgraded rather
  # than reflashed.
  : >"$agent_home/.local/share/applications/moarchy-agent-grok.desktop"
  ag entry claude >/dev/null 2>&1
  if [[ ! -e $agent_home/.local/share/applications/moarchy-agent-grok.desktop ]]; then
    ok "P8 writing the tile clears the per-agent entries an upgrade leaves behind"
  else
    no "P8 moarchy-agent-grok.desktop survived" "an upgraded phone keeps two agent icons for good"
  fi

  # P9. A default set behind moarchy-agent's back, and the one-command repair.
  mkdir -p "$agent_home/.config/omarchy/defaults"
  echo codex >"$agent_home/.config/omarchy/defaults/agent"
  ag entry >/dev/null 2>&1
  if [[ $(field X-Moarchy-Agent) == codex ]]; then
    ok "P9 'moarchy-agent entry' with no argument re-reads the chosen agent"
  else
    no "P9 the tile still names $(field X-Moarchy-Agent) after the default moved to codex" \
       "omarchy-default-agent typed by hand has no other repair"
  fi

  # P7. A binary somebody put there by hand. omarchy-mise-install clobbers
  # unconditionally, and seeding nine names into a directory the user writes to
  # is exactly where a real install would disappear.
  mkdir -p "$agent_home/.local/bin"
  printf '#!/bin/sh\necho mine\n' >"$agent_home/.local/bin/claude"
  chmod +x "$agent_home/.local/bin/claude"
  before=$(cat "$agent_home/.local/bin/claude")
  ag shim claude >/dev/null 2>&1
  if [[ $(cat "$agent_home/.local/bin/claude") == "$before" ]]; then
    ok "P7 a wrapper does not overwrite a binary that was already there"
  else
    no "P7 ~/.local/bin/claude was replaced" "a real install vanishes on the next seed"
  fi

  rm -rf "$agent_home"
fi

# P6. The real HOME, read-only: all nine names on PATH, each of them a wrapper
# and not a download. This is the one check that asks about the phone rather
# than a scratch directory, because "is it on PATH" is only a question about
# this phone's PATH.
if [[ -n $agent_bin ]]; then
  p6_missing=""
  p6_real=""
  while read -r a; do
    if ! resolved=$(command -v "$a" 2>/dev/null); then
      p6_missing="$p6_missing $a"
    elif ! grep -q mise "$resolved" 2>/dev/null; then
      # Not a failure: a real install is a better answer than a wrapper. Named
      # so the count below is not read as nine wrappers when it is eight.
      p6_real="$p6_real $a"
    fi
  done < <("$agent_bin" list)
  if [[ -z $p6_missing ]]; then
    ok "P6 all nine agent names are on PATH${p6_real:+ (installed outright:$p6_real)}"
  else
    no "P6 not on PATH:$p6_missing" \
       "a phone flashed before this shipped never re-runs user-setup: moarchy-agent seed"
  fi
fi

# --- the gesture plugin -----------------------------------------------------
head_ "gesture plugin"

if status=$(timeout 5 omarchy-shell gestures status 2>/dev/null) && [[ -n $status ]]; then
  ok "gestures IPC answers ($status)"
else
  no "gestures IPC does not answer" "the plugin is not loaded; check shell.json plugins[]"
fi

# docs/refactor.md C3. "The lowest workspace number sway does not have" is
# implemented twice -- in the gestures plugin for the home swipe, and in
# bin/moarchy-one-app-per-workspace for a new window -- and they cannot be one
# implementation, because the gesture cannot fork swaymsg mid-drag. So they are
# held against each other instead.
#
# They had drifted both ways before this check existed: the QML capped at 10 and
# returned an occupied workspace once 1..10 were taken, and the Python keyed on
# int(name) so a workspace named "3:web" read as free while sway called it 3.
# Neither is visible from one side alone, which is why this compares rather than
# asserting a number.
#
# `--free` calls the daemon's own function rather than restating the rule here:
# a check that reimplements what it is checking passes against itself.
free_qml=$(sed -n 's/.* free=\([0-9]*\).*/\1/p' <<<"${status:-}")
free_py=$(timeout 8 moarchy-one-app-per-workspace --free 2>/dev/null)
if [[ -z $free_qml || -z $free_py ]]; then
  no "cannot compare the two free-workspace implementations" \
     "gestures status carries no free= field, or --free did not answer"
elif [[ $free_qml == "$free_py" ]]; then
  ok "both free-workspace implementations answer $free_qml"
else
  no "free-workspace implementations disagree (gestures=$free_qml, one-app=$free_py)" \
     "home and a new window will pick different workspaces; they are a matched pair"
fi

# Declared as a service the plugin was mounted twice and drew two stacked pills.
kinds=$(python3 - "$(plugin_dir moarchy.gestures)" <<'PY' 2>/dev/null
import json, os, sys
p = os.path.join(sys.argv[1], "manifest.json")
try:
    print(",".join(json.load(open(p)).get("kinds", [])))
except Exception:
    pass
PY
)
if [[ $kinds == "panel" ]]; then
  ok "the plugin is declared as a panel (mounted once)"
else
  no "the plugin declares kinds=[${kinds:-?}]" "a service-kind plugin is mounted twice and draws two pills"
fi

# --- the phone shell plugins ------------------------------------------------
head_ "phone shell"

# The single most important check in this file. A bar plugin that fails to load
# is nearly silent: the host logs one console.warn and falls back to
# omarchy.bar, so the phone still boots with a working -- if wrong -- bar. The
# only visible symptom is thirteen desktop widgets crammed into 360px, and the
# only diagnosis is the shell log, which is why moarchy-restart-shell now
# keeps one. Asking "is a bar running" would pass in exactly that case, so ask
# which bar.
active_bar=$(timeout 5 omarchy-shell shell listPlugins 2>/dev/null | python3 -c '
import json, sys
try:
    for p in json.load(sys.stdin):
        if "bar" in (p.get("kinds") or []) and p.get("active"):
            print(p["id"]); break
except Exception:
    pass
' 2>/dev/null)
if [[ $active_bar == "moarchy.bar" ]]; then
  ok "the phone bar is the active bar"
  # ...but "active" is the host's answer from shell.json, not proof the QML
  # compiled. A broken Bar.qml leaves that check green with the bar drawing
  # nothing, so ask the bar itself: an IPC answer can only come from an
  # instantiated component.
  bar_metrics=$(timeout 5 omarchy-shell bar metrics 2>/dev/null)
  bar_weight=$(sed -n 's/.*weight=\([0-9]*\).*/\1/p' <<<"$bar_metrics")
  if [[ -z $bar_metrics || $bar_metrics == *"not found"* ]]; then
    no "the bar plugin does not answer IPC" \
       "Bar.qml failed to load; the host has fallen back and the bar is drawing nothing"
  elif [[ -n $bar_weight ]] && (( bar_weight >= 500 )); then
    ok "the bar is loaded and drawing ($bar_metrics)"
  else
    no "the bar answers but its text weight is ${bar_weight:-?}" \
       "under 500 is the thin clock the DemiBold change was for"
  fi
else
  no "the active bar is ${active_bar:-none}" \
     "the shell fell back to omarchy.bar; grep 'failed to load' ~/.local/state/moarchy/shell.log"
fi

# The two plugin kinds are enabled by different keys, and crossing them is a
# silent no-op: a bar plugin answers to shell.json's bar.id and never looks at
# plugins[], everything else is the other way round.
bar_id=$(python3 -c '
import json, os
try:
    print(json.load(open(os.path.expanduser("~/.config/omarchy/shell.json"))).get("bar", {}).get("id", ""))
except Exception:
    pass
' 2>/dev/null)
if [[ $bar_id == "moarchy.bar" ]]; then
  ok "shell.json names the phone bar"
else
  no "shell.json bar.id is '${bar_id:-unset}'" \
     "omarchy-refresh-shell runs 'omarchy bar defaults', which drops bar.id entirely"
fi

# Same doubling trap as the gestures plugin, one level along: an overlay
# declared as a service gets two surfaces, and for the shade that means two
# grab strips fighting over the top edge.
for plugin in moarchy.drawer moarchy.recents moarchy.shade \
              moarchy.themes moarchy.settings moarchy.device moarchy.wifi \
              moarchy.bluetooth; do
  k=$(python3 -c '
import json, os, sys
p = os.path.join(sys.argv[1], "manifest.json")
try:
    print(",".join(json.load(open(p)).get("kinds", [])))
except Exception:
    pass
' "$(plugin_dir "$plugin")" 2>/dev/null)
  if [[ $k == "overlay" ]]; then
    ok "$plugin is declared as an overlay"
  else
    no "$plugin declares kinds=[${k:-?}]" "expected overlay; a service-kind plugin is mounted twice"
  fi
done

for target in drawer recents shade themes settings device; do
  if st=$(timeout 5 omarchy-shell "$target" state 2>/dev/null) && [[ -n $st ]]; then
    ok "$target IPC answers ($st)"
  else
    no "$target IPC does not answer" "the plugin is missing from shell.json plugins[], or it failed to load"
  fi
done

# Two ways an icon silently becomes the wrong icon, both of which have happened
# here:
#
#   - `\uXXXX` in QML takes exactly four hex digits, so a codepoint above the
#     BMP written as an escape is truncated and the fifth digit is left behind
#     as a literal character. Checking that *something* covers the truncated
#     codepoint does not catch this -- Nerd Fonts cover the low private use
#     area too, so U+F0249 truncated to U+F024 still resolves, and still draws
#     the wrong glyph with a "9" after it. What does catch it is the invariant
#     these strings actually have: an icon literal is exactly one character.
#   - a font change, or a fresh install before fc-cache has run, drops the icon
#     range entirely and every glyph becomes a blank box. That one is a
#     coverage question, so ask fontconfig.
#
# Neither logs anything, hence both.
#
# It reports how many files it read, and that is not decoration. This check
# passed on 2026-09-07 against a directory that had just been emptied: no
# files, so no literals, so no problems, so "every icon literal is fine". A
# check that can pass while measuring nothing is not a check, and the count is
# what makes that visible on the green line rather than only on the red one.
glyph_out=$(python3 - "$SYSTEM_PLUGINS" "$USER_PLUGINS" <<'PY' 2>/dev/null
import glob, os, re, subprocess, sys

# The private use areas Nerd Fonts pack their icons into.
def is_icon(ch):
    return 0xE000 <= ord(ch) <= 0xF8FF or 0xF0000 <= ord(ch) <= 0xFFFFD

problems = []
codepoints = set()

# The same resolution the shell and plugin_dir do: both roots, later wins, so
# an overridden plugin is read once -- from the copy that actually loads.
dirs = {}
for root in sys.argv[1:]:
    for d in sorted(glob.glob(os.path.join(root, "moarchy.*"))):
        if os.path.isdir(d):
            dirs[os.path.basename(d)] = d

files = []
for _, d in sorted(dirs.items()):
    files.extend(sorted(glob.glob(os.path.join(d, "*.qml"))))

for path in files:
    name = os.path.basename(path)
    for n, line in enumerate(open(path, encoding="utf-8"), 1):
        for literal in re.findall(r'"([^"\\]*)"', line):
            icons = [c for c in literal if is_icon(c)]
            if not icons:
                continue
            codepoints.update(ord(c) for c in icons)
            if len(literal) != 1:
                problems.append("%s:%d %r" % (name, n, literal))

for cp in sorted(codepoints):
    out = subprocess.run(["fc-match", ":charset=%X" % cp],
                         capture_output=True, text=True).stdout
    if "Nerd Font" not in out and "omarchy" not in out:
        problems.append("no icon font covers U+%05X" % cp)

print("%d|%s" % (len(files), "; ".join(problems)))
PY
)
glyph_n=${glyph_out%%|*}
glyph_problem=${glyph_out#*|}
if [[ -z $glyph_out || -z $glyph_n || $glyph_n == 0 ]]; then
  no "no plugin QML to check under $SYSTEM_PLUGINS or $USER_PLUGINS" \
     "with nothing to read, this check reports every icon fine"
elif [[ -z ${glyph_problem// /} ]]; then
  ok "every icon literal is a single glyph in an installed icon font ($glyph_n files)"
else
  no "icon literals: $glyph_problem" \
     "a truncated \\uXXXX escape leaves the fifth hex digit in the string"
fi

# --- the drawer actually reserves its strip ---------------------------------
head_ "drawer geometry"

# The exclusive zone is the whole point: it is what keeps the drawer out from
# under the on-screen keyboard. Sway hands the rest to the workspace, so the
# space below the workspace is what the drawer reserved -- its ~20px zone plus
# the config's gap. Mounted twice, that figure doubles, which is what two
# stacked pills looked like from the outside.
#
# Hide the keyboard first: while it is up it reserves the bottom too, and the
# number means nothing.
busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 SetVisible b false >/dev/null 2>&1
sleep 1

read -r out_h top bottom < <(python3 - <<'PY' 2>/dev/null
import json, subprocess
def sway(kind):
    return json.loads(subprocess.run(["swaymsg", "-t", kind], capture_output=True, text=True).stdout)
out = next((o for o in sway("get_outputs") if o.get("active")), None)
ws = next((w for w in sway("get_workspaces") if w.get("focused")), None)
if out and ws:
    h, r = out["rect"]["height"], ws["rect"]
    print(h, r["y"], h - (r["y"] + r["height"]))
else:
    print(0, 0, 0)
PY
)
if (( ${out_h:-0} == 0 )); then
  no "cannot read output geometry"
else
  if (( top >= 20 && top <= 40 )); then
    ok "the bar reserves ${top}px at the top"
  else
    no "the bar reserves ${top}px at the top" "expected roughly 26"
  fi
  if (( bottom >= 15 && bottom <= 32 )); then
    ok "the drawer reserves ${bottom}px at the bottom"
  elif (( bottom > 32 )); then
    no "the drawer reserves ${bottom}px -- about double" \
       "the plugin is mounted more than once, or the keyboard did not retract"
  else
    no "the drawer reserves only ${bottom}px" \
       "the exclusive zone is missing; the keyboard will bury the drawer"
  fi
fi

# --- the on-screen keyboard -------------------------------------------------
head_ "on-screen keyboard"

if busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 Visible >/dev/null 2>&1; then
  ok "the keyboard owns sm.puri.OSK0"
else
  no "sm.puri.OSK0 is not on the bus" "squeekboard is not running, so \$mod+i does nothing"
fi

# Both gated squeekboard, which defaulted off outside GNOME/Phosh and would
# otherwise start, bind the input method, and silently never draw. Kept because
# they are cheap and a keyboard that needs them is still supported; a keyboard
# that does not need them is unaffected by their being set.
if [[ $(gsettings get org.gnome.desktop.a11y.applications screen-keyboard-enabled 2>/dev/null) == "true" ]]; then
  ok "screen-keyboard-enabled is true"
else
  no "screen-keyboard-enabled is false" "gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled true"
fi
if [[ $(gsettings get org.gnome.desktop.input-sources sources 2>/dev/null) == "@a(ss) []" ]]; then
  no "no input source is configured" "squeekboard logs 'No system layout present' and draws nothing"
else
  ok "an input source is configured"
fi

# --- the terminal -----------------------------------------------------------
# docs/apps.md T1-T3, T6. The phone carried three terminals until 2026-09-08 and
# now carries one, and each of these is a way that could be half-true: the
# package set can drop a name while the device keeps it, the default can be
# unset in a way that HANGS rather than fails, and foot's own extra .desktop
# files can put the tiles back after both packages are gone.
#
# T3 is the one nothing here implements -- upstream's launcher.hides hides
# footclient and foot-server by id -- which is exactly why it is asserted
# against the running drawer rather than against a file we write.
head_ "terminal"

# T1. Read-only, and the point of asking on the device rather than trusting the
# PKGBUILD: a `pacman -Rns` never ran on a phone that was upgraded rather than
# reflashed, so moarchy-meta losing the name does not remove the package.
if pacman -Qq foot >/dev/null 2>&1; then
  ok "T1 foot is installed"
else
  no "T1 foot is NOT installed" "it is the terminal moarchy-launch-tui execs by name -- nothing that opens a TUI works"
fi
t_extra=$(pacman -Qq alacritty qmlkonsole 2>/dev/null | tr '\n' ' ')
if [[ -z ${t_extra// /} ]]; then
  ok "T1 alacritty and qmlkonsole are gone"
else
  no "T1 still installed: ${t_extra}" \
     "moarchy-meta dropped them but this phone was upgraded, not reflashed: sudo pacman -Rns ${t_extra}"
fi

# T2. The FILE, not the reader. `omarchy-default-terminal` resolves through
# xdg-terminal-exec, and with no list anywhere xdg-terminal-exec hangs rather
# than answering -- so a reader-based check would hang exactly when it failed.
t_list="${XDG_CONFIG_HOME:-$HOME/.config}/xdg-terminals.list"
if [[ ! -s $t_list ]]; then
  no "T2 no xdg-terminals.list" \
     "xdg-terminal-exec HANGS with no list, so \$mod+Return and moarchy-launch-files hang too"
elif grep -qx 'foot.desktop' "$t_list"; then
  ok "T2 foot is the default terminal"
else
  no "T2 the default terminal is $(grep -v '^#' "$t_list" | grep -m1 .), not foot" \
     "if that terminal is not installed, everything XDG opens a terminal for fails"
fi

# T3. One terminal in the DRAWER, which T1 does not cover: foot ships
# foot.desktop, footclient.desktop and foot-server.desktop, all three
# TerminalEmulator and none NoDisplay, so removing two packages left three tiles.
#
# Asked of the shell rather than of the filesystem, because the masking only
# counts if DesktopEntries honours the user directory -- which is the assumption
# the whole approach rests on and the one worth measuring.
t_entries=$(timeout 8 omarchy-shell drawer entries 2>/dev/null)
if [[ -z $t_entries ]]; then
  no "T3 the drawer listed no entries at all" "the shell is not answering -- this proves nothing either way"
else
  t_seen=""
  for t_e in footclient foot-server Alacritty org.kde.qmlkonsole; do
    grep -qx "$t_e" <<<"$t_entries" && t_seen+="$t_e "
  done
  if [[ -n $t_seen ]]; then
    no "T3 the drawer still shows: ${t_seen}" \
       "footclient/foot-server come from launcher.hides, alacritty/qmlkonsole from pacman -- check which two are listed"
  elif grep -qx foot <<<"$t_entries"; then
    ok "T3 the drawer shows one terminal ($(grep -c . <<<"$t_entries") entries)"
  else
    no "T3 the drawer shows no terminal at all" "foot.desktop is missing, or it got masked along with the other two"
  fi
fi

# T6. The opposite of a missing-file check: a config for a terminal that is not
# installed is the bug, and it is the kind that survives forever because nothing
# ever reads it to notice.
if [[ -e $HOME/.config/alacritty ]]; then
  no "T6 ~/.config/alacritty exists for an uninstalled terminal" "harmless, but it means moarchy-user-setup still seeds it"
else
  ok "T6 no config seeded for an uninstalled terminal"
fi

# --- real touch, opt-in ------------------------------------------------------
# Off by default because it needs root for /dev/uinput and it closes a window at
# the end. With it, every gesture is checked the way a thumb would drive it
# rather than through the IPC shortcut -- which is the only way the touch path
# itself is ever exercised.
if [[ ${1:-} == "--gestures" ]]; then
  head_ "gestures (synthetic touch)"

  # Is the plugin half of a check actually on this shell?
  #
  # A check and the IPC it calls live in different files with different owners,
  # and nothing makes them travel together: a suite committed ahead of its
  # plugin half leaves main failing a check for a reason nowhere near what the
  # check is about. That happened -- H2 landed calling `shade dragTrace` while
  # dragTrace was still uncommitted in Shade.qml, and the K block landed calling
  # `settings running`/`hide`/`resume` from an uncommitted Settings.qml.
  #
  # Probe with a read-only function only. `omarchy-shell` answers an absent one
  # with "Function not found.", so this costs one round trip and never fires a
  # verb with a side effect.
  ipc_present() {
    local out
    out=$(timeout 5 omarchy-shell "$1" "$2" 2>&1) || true
    [[ $out != *"Function not found"* && $out != *"Target not found"* ]]
  }

  # Post a notification, from the tool this image actually has.
  #
  # `notify-send` is not on it -- libnotify is not installed and nothing pulls
  # it in, which section 6p of the build log recorded about a different caller
  # for the same reason. So every check that wanted a notification was posting
  # into a `command not found`, swallowing it, and then reporting the empty
  # history as the very failure it was hunting: H7 could not have passed on a
  # stock image, and would have blamed the swipe.
  #
  # `omarchy-notification-send` is upstream's own and is on PATH here. -t, so a
  # posted notification expires into the history rather than sitting as a live
  # popup -- the history is what the shade lists and what these checks count.
  # notify-send stays as the fallback for an image that does have it.
  post_note() {
    if command -v omarchy-notification-send >/dev/null 2>&1; then
      omarchy-notification-send -t 2500 "$1" "$2" >/dev/null 2>&1
    else
      notify-send -t 2500 "$1" "$2" >/dev/null 2>&1
    fi
  }

  # Every check below names the acceptance criterion it proves, from
  # docs/gestures.md. That file is the contract; this is the part of it a
  # machine can check. An AC with no check here is visible by its absence --
  # which matters, because the last version of this suite passed 37/37 on
  # behaviour that was wrong: the tests had been written to match the code
  # rather than the spec, so green meant nothing.

  # Without this, `foot` below silently fails to map and every check that
  # needs a window on screen fails for a reason that has nothing to do with
  # gestures -- the shell reports focus=none and reads like a broken plugin.
  # A session shell inherits it; an ssh session does not.
  : "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
  export XDG_RUNTIME_DIR
  export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-$(basename "$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9] 2>/dev/null | head -1)" 2>/dev/null)}"

  touch_bin="$MOARCHY_BIN/moarchy-touch"
  ws() { swaymsg -t get_workspaces | python3 -c 'import json,sys; print(([w["name"] for w in json.load(sys.stdin) if w["focused"]] or [""])[0])'; }
  # Sway's own layout string for the focused workspace -- "V[foot]" with a
  # window on it, empty without. Read here through swaymsg, never through the
  # shell, so the check is independent of the thing under test.
  ws_rep() { swaymsg -t get_workspaces | python3 -c 'import json,sys; print(([w.get("representation") or "" for w in json.load(sys.stdin) if w["focused"]] or [""])[0])'; }
  scratch() { pgrep -fc "foot --app-id=moa-selftest" || true; }
  # The app Sway currently has focused, or empty. Read from the tree rather
  # than from the shell, so a check never confirms itself.
  focused_app() { swaymsg -t get_tree | python3 -c '
import json,sys
found = []
def walk(n):
    if n.get("focused") and n.get("app_id"): found.append(n["app_id"])
    for k in ("nodes", "floating_nodes"):
        for c in n.get(k, []): walk(c)
walk(json.load(sys.stdin))
print(found[0] if found else "")'; }
  cards() { timeout 8 omarchy-shell recents list 2>/dev/null | grep -c . || true; }

  # Right after a full-screen surface maps on this GPU the shell can be busy
  # for long enough that omarchy-shell gives up and prints nothing. An empty
  # answer is not "closed" -- it is "ask again".
  shell_state() {
    local target=$1 out
    for _ in 1 2 3; do
      if out=$(timeout 8 omarchy-shell "$target" state 2>/dev/null) && [[ -n $out ]]; then
        echo "$out"; return
      fi
      sleep 1
    done
    echo "unknown"
  }

  # Panel pixels; the output is scaled 2, so every figure is twice the logical
  # travel the plugin sees. Against a 324 logical pullTravel:
  #   60  panel =  30 logical =  9%  -> under the 15% recents commit
  #   300 panel = 150 logical = 46%  -> recents (tops out at 40%)
  #   560 panel = 280 logical = 86%  -> home (commits at 75%)
  # All dragged over 2000ms, ~0.08 logical px/ms, an order of magnitude under
  # the 0.6 fling threshold -- so these test the distance bands, which is the
  # whole point of the bands being distance-only.
  STRIP_Y=1420

  ac() { printf '  \033[90m%-4s\033[0m ' "$1"; }
  okac()  { ac "$1"; shift; ok "$@"; }
  noac()  { ac "$1"; shift; no "$@"; }

  # --- G10. the back edge stops short of the bottom -------------------------
  # Deliberately above the uinput gate: this is a geometry read and needs
  # neither root nor a finger. It also cannot be driven by one -- a tap below
  # the cut and a tap on a dead edge are indistinguishable from the outside,
  # which is exactly how the keyboard's left column stayed swallowed.
  geom=$(timeout 8 omarchy-shell gestures geometry 2>/dev/null)
  gv() { tr ' ' '\n' <<<"$geom" | sed -n "s/^$1=//p"; }
  bh=$(gv h); bi=$(gv inset); bs=$(gv strip); bp=$(gv panel); bscr=$(gv screen)
  if [[ -z $bh || -z $bscr ]]; then
    noac G10 "gestures geometry did not answer" "is the shell running with moarchy.gestures loaded?"
  elif (( bi != bs + bp )); then
    noac G10 "inset $bi is not strip $bs plus panel $bp"
  elif (( bh == bscr - bi )); then
    okac G10 "the back edge stops $bi short of the bottom (h $bh of $bscr)"
  else
    noac G10 "the back edge is ${bh}px tall, wanted $(( bscr - bi ))" \
             "a full-height band swallows the keyboard's leftmost key column"
  fi

  # Does the injector actually RUN? `-x` says only that the file has the bit
  # set. Every call below sends stderr to /dev/null -- it has to, or the noise
  # buries the results -- so an injector that cannot start turns into a dozen
  # "the tile does not respond" failures pointing at the UI instead of one line
  # naming the cause. Found on the phone 2026-09-07: `python-evdev` was absent
  # and every touch check read as a broken surface.
  #
  # Probed with a verb it does not have, which exercises the imports and the
  # argument parsing and stops before /dev/uinput is opened or anything is
  # pressed. A working injector answers `usage: ...`; a broken one answers with
  # whatever stopped it.
  touch_why=$("$touch_bin" selftest-probe 2>&1 || true)
  if [[ ! -x $touch_bin ]]; then
    no "moarchy-touch is missing" "cannot drive touch without it"
  elif ! sudo -n true 2>/dev/null; then
    no "passwordless sudo is unavailable" "/dev/uinput is root-only, so touch cannot be synthesised"
  elif [[ $touch_why != usage:* ]]; then
    no "moarchy-touch cannot run: ${touch_why:-it produced no output}" \
       "python-evdev is an optdepend of moarchy-meta -- 'not needed to run the phone,\
 only to test it' -- so a flashed image does not have it: pacman -S python-evdev"
  else
    # Powering the panel back on is not enough: moarchy-screen turns the
    # touch input off with it, so after an idle blank every synthetic swipe
    # lands nowhere and the whole suite fails for a reason that has nothing to
    # do with gestures.
    #
    # `unlock` rather than the two swaymsg lines this used to run
    # (docs/refactor.md D1). It does both of them and clears the lock flag as
    # well, which those two did not -- so the rig could end up with a lit panel
    # and a flag still saying locked, and the next `wake` would refuse.
    moarchy-screen unlock >/dev/null 2>&1

    # Start from a bare screen. Anything left open changes what the strip's
    # up-drag *means* -- with the shade down it correctly means "put that away"
    # (A8), so the recents drag never latches and A1/A3 reports 0 samples. That
    # is the gesture behaving exactly as specified, failing a check that assumed
    # nothing was on screen. A suite that inherits the last session's state is
    # measuring the last session.
    for overlay in shade drawer recents themes settings; do
      timeout 8 omarchy-shell "$overlay" close >/dev/null 2>&1
    done
    sleep 2

    for _ in 1 2; do
      setsid foot --app-id=moa-selftest -e sh -c 'while :; do sleep 300; done' >/dev/null 2>&1 </dev/null &
      sleep 4
    done
    start_ws=$(ws)

    # --- B. strip, sideways ------------------------------------------------
    sudo -n "$touch_bin" swipe 550 $STRIP_Y 120 $STRIP_Y 250 >/dev/null 2>&1
    sleep 2
    if [[ $(ws) != "$start_ws" ]]; then
      okac B1 "swipe left changes workspace"
    else
      noac B1 "swipe left did nothing"
    fi

    sudo -n "$touch_bin" swipe 120 $STRIP_Y 550 $STRIP_Y 250 >/dev/null 2>&1
    sleep 2
    if [[ $(ws) == "$start_ws" ]]; then
      okac B1 "swipe right changes it back"
    else
      noac B1 "swipe right did not return to $start_ws"
    fi

    # B3. The shade, and not Settings, drives this one. Settings is on a
    # workspace of its own (K13) and would leave on the switch alone, so it
    # cannot show whether the *sheets* are put away -- which is the half of B3
    # that has no other mechanism behind it. Both halves are asserted: a swipe
    # that closed the shade and stopped there is the other way to be wrong.
    timeout 8 omarchy-shell shade open >/dev/null 2>&1
    sleep 2
    b3_ws=$(ws)
    sudo -n "$touch_bin" swipe 550 $STRIP_Y 120 $STRIP_Y 250 >/dev/null 2>&1
    sleep 2
    if [[ $(shell_state shade) == "closed" && $(ws) != "$b3_ws" ]]; then
      okac B3 "a sideways swipe puts the shade away and still switches"
    else
      noac B3 "shade=$(shell_state shade), workspace=$(ws) (was $b3_ws)" \
              "a sheet left standing over the new workspace makes the switch invisible"
    fi
    timeout 8 omarchy-shell shade close >/dev/null 2>&1
    sleep 1

    # --- C. no hold-to-close ----------------------------------------------
    before=$(scratch)
    sudo -n "$touch_bin" hold 360 $STRIP_Y 2000 >/dev/null 2>&1
    sleep 3
    if [[ $(scratch) == "$before" ]]; then
      okac C1 "a 2s hold on the strip closes nothing"
    else
      noac C1 "holding on the strip closed a window" \
              "hold-to-close was removed; nothing on the strip may close a window"
    fi

    # --- A. strip, up ------------------------------------------------------
    timeout 8 omarchy-shell recents close >/dev/null 2>&1; sleep 2
    sudo -n "$touch_bin" swipe 360 $STRIP_Y 360 1360 900 >/dev/null 2>&1
    sleep 3
    if [[ $(shell_state recents) == "closed" ]]; then
      okac A2 "a short drag springs back"
    else
      noac A2 "a 9% drag left recents $(shell_state recents)"
    fi

    sudo -n "$touch_bin" swipe 360 $STRIP_Y 360 1120 2000 >/dev/null 2>&1
    sleep 3
    samples=$(timeout 8 omarchy-shell recents dragTrace 2>/dev/null | wc -w)
    if [[ $(shell_state recents) == "open" ]] && (( samples >= 8 )); then
      okac A1/A3 "the recents band opens the carousel ($samples samples)"
    else
      noac A1/A3 "the recents drag left $samples samples and state $(shell_state recents)" \
                 "under 8 means it jumped to open rather than following the drag"
    fi

    # A5 is the correction this whole rewrite exists for: the strip must never
    # bring the drawer up, in any state.
    if [[ $(shell_state drawer) == "closed" ]]; then
      okac A5 "the strip did not open the drawer"
    else
      noac A5 "an up-swipe from the strip opened the drawer" \
              "the strip is recents-then-home only; the drawer is a home-screen gesture"
    fi

    # --- E. the carousel ---------------------------------------------------
    before=$(cards)
    sudo -n "$touch_bin" swipe 360 704 360 300 400 >/dev/null 2>&1
    sleep 3
    after=$(cards)
    if (( after == before - 1 )); then
      okac E3 "flicking a card up closes that app ($before -> $after)"
    else
      noac E3 "the card count went $before -> $after" \
              "expected one fewer; a horizontal steal by the pager leaves it unchanged"
    fi

    sudo -n "$touch_bin" tap 360 704 >/dev/null 2>&1
    sleep 3
    if [[ $(shell_state recents) == "closed" ]] && [[ -n $(ws_rep) ]]; then
      okac E2 "tapping a card focuses that app"
    else
      noac E2 "recents is $(shell_state recents), workspace holds '$(ws_rep)'"
    fi

    # --- A4/F. home --------------------------------------------------------
    timeout 8 omarchy-shell recents close >/dev/null 2>&1; sleep 2
    before=$(cards)
    sudo -n "$touch_bin" swipe 360 $STRIP_Y 360 860 2000 >/dev/null 2>&1
    sleep 3
    home_landed=0
    if [[ -z $(ws_rep) ]] && [[ $(shell_state recents) == "closed" ]]; then
      okac A4 "the home band lands on a blank workspace"
      home_landed=1
    else
      noac A4 "the home drag left workspace $(ws) holding '$(ws_rep)'"
    fi
    # F2 says going home never *closes* anything, so that is what is asserted.
    # Requiring the count to be unchanged also fails when something unrelated
    # launches mid-run -- a leftover app finishing its start-up was enough --
    # and that is not what this criterion is about.
    after=$(cards)
    if (( after >= before )); then
      okac F2 "going home closed nothing ($before apps still open)"
    else
      noac F2 "the app count dropped going home: $before -> $after"
    fi

    # F4. Read off the gesture A4 just performed rather than driving another
    # one: the retire is the tail of that same drag. A 200ms animation cannot
    # be sampled over IPC at ~300ms a call, so this reads the per-frame record
    # the release left behind, the way A1 reads dragTrace.
    # Gated on A4 landing. A drag that never reached the home band never raised
    # homeHint, so its trace opens `100:0` -- which is exactly what a snap looks
    # like, and reading it as one turns an unrelated A4 failure into a second
    # red line pointing at the wrong thing.
    retire=$(timeout 8 omarchy-shell recents retireTrace 2>/dev/null)
    f4_first_hint=${retire%% *}; f4_first_hint=${f4_first_hint##*:}
    f4_decay=$(printf '%s' "$retire" | tr ' ' '\n' | cut -d: -f2 | sort -un | grep -c .)
    if (( home_landed == 0 )); then
      printf '  \033[90m%-4s\033[0m   \033[90mF4 skipped: the drag did not reach the home band, so there is no retire to measure\033[0m\n' ""
    elif [[ -z $retire ]]; then
      printf '  \033[90m%-4s\033[0m   \033[90mF4 skipped: the drag left no retire trace\033[0m\n' ""
    elif [[ ${f4_first_hint:-0} -gt 0 ]] && (( f4_decay >= 3 )); then
      okac F4 "the carousel retires from the home band without flashing (${f4_first_hint} -> 0 over $f4_decay steps)"
    else
      noac F4 "retire trace: $retire" \
              "homeHint at 0 in the first frame means it snapped while progress was still up, and the scrim flashed to full"
    fi

    # --- D. the home screen ------------------------------------------------
    # The drag that used to be tested on the strip. It has to work here now,
    # and only here.
    #
    # Panel y 1370, not 700: the drag is 1:1 with the finger against the
    # drawer's own height (D2a), so it starts near the bottom edge the way the
    # gesture is actually made. 700 was chosen when a mid-screen drag was worth
    # 77% of the sheet; at 1:1 the same drag is worth 35%, which is the commit
    # threshold itself -- a test balanced on the exact boundary it is checking.
    #
    # 1370 and not lower: Style.space scales, so the gesture strip is 30 logical
    # px, i.e. panel 1380 and below. A swipe starting there is a strip swipe and
    # never reaches the home surface at all.
    sudo -n "$touch_bin" swipe 360 1370 360 370 2000 >/dev/null 2>&1
    sleep 3
    samples=$(timeout 8 omarchy-shell drawer dragTrace 2>/dev/null | wc -w)
    if [[ $(shell_state drawer) == "open" ]] && (( samples >= 8 )); then
      okac D1 "dragging up on the workspace opens the drawer ($samples samples)"
    else
      noac D1 "the workspace drag left $samples samples and state $(shell_state drawer)" \
              "the drawer is opened by dragging the home screen itself, not the strip"
    fi

    # D2a. 500 logical px of finger against a 720px sheet is 69%, and the
    # assertion is the ratio rather than the endpoint: "it opened" is satisfied
    # by a drag worth twice what it should be, which is the bug this criterion
    # was written for.
    last=$(timeout 8 omarchy-shell drawer dragTrace 2>/dev/null | awk '{print $NF}')
    if [[ -n $last ]] && (( last >= 58 && last <= 80 )); then
      okac D2a "the open drag is 1:1 with the finger (500px -> $last%)"
    else
      noac D2a "500 logical px of drag left the sheet at ${last:-no}%" \
               "expected 69% give or take; the close drag is 1:1 and the open one has to match"
    fi

    # --- A7. the strip clears what is covering the screen ------------------
    # The drawer is up from D1. An up-flick from the strip has to put it away
    # -- and, with A5, must never be able to bring it back.
    sudo -n "$touch_bin" swipe 360 $STRIP_Y 360 1160 600 >/dev/null 2>&1
    sleep 3
    if [[ $(shell_state drawer) == "closed" ]]; then
      okac A7 "an up-flick from the strip puts the drawer away"
    else
      noac A7 "the drawer is $(shell_state drawer) after an up-flick"
    fi
    # Put it back for the G3 check below.
    sudo -n "$touch_bin" swipe 360 700 360 200 2000 >/dev/null 2>&1
    sleep 3

    # --- H2. the shade follows the finger shut -----------------------------
    # Started on the scrim, deliberately. The sheet is as tall as its content
    # and stops at 90% of the usable height (S21, S22), so the band of scrim
    # below it runs from ~70 logical px with the shade full to several hundred
    # with it near empty -- and that band is where a thumb starts an up-swipe.
    #
    # y=650 logical is inside it at either extreme, and 250 of travel commits a
    # close against any sheet (1 - 250/630 = 0.60, under closeFraction 0.75).
    # The margin that is *not* generous is saturation: samples stop accruing
    # once progress hits 0, which needs travel >= the sheet's height, and the
    # shortest possible sheet -- no audio sink, no media, no notifications -- is
    # ~272 against 250. Removing a row from the shade's chrome moves that.
    #
    # The band used to answer `clicked` and nothing else, so the drag moved
    # nothing and the release dismissed the shade outright.
    #
    # The sample count is the whole assertion. `state` reaches `closed` just as
    # fast when the shade jumps shut, and the 220ms fall after release looks
    # like an animation whether or not anything followed the finger, so a check
    # that watched either would have passed throughout the bug.
    if ! ipc_present shade dragTrace; then
      printf '  \033[90m%-4s\033[0m   \033[90mH2 skipped: this shell has no `shade dragTrace`, so the drag leaves no record to read\033[0m\n' ""
    else
    timeout 8 omarchy-shell shade open >/dev/null 2>&1
    sleep 2
    sudo -n "$touch_bin" swipe 360 1300 360 800 1500 >/dev/null 2>&1
    sleep 3
    samples=$(timeout 8 omarchy-shell shade dragTrace 2>/dev/null | wc -w)
    if [[ $(shell_state shade) == "closed" ]] && (( samples >= 8 )); then
      okac H2 "dragging up on the scrim follows the finger shut ($samples samples)"
    else
      noac H2 "the scrim drag left $samples samples and state $(shell_state shade)" \
              "0 samples means it was dismissed by a tap that travelled, not dragged shut"
    fi
    timeout 8 omarchy-shell shade close >/dev/null 2>&1
    fi
    sleep 2

    # --- S6, S6a, S6c. hold a wide tile to open its picker -----------------
    # docs/shade.md rather than gestures.md -- the ids are S -- but it lives
    # here because it is the one part of the shade's contract that needs a real
    # finger held still, and the injector is already up.
    #
    # dryRun throughout. Without it this suite would open two terminals over
    # the session, and the tap half would switch the radio off on a phone that
    # is being reached over that radio.
    #
    # Panel pixels, measured off a capture of the open sheet: the wide tiles are
    # the second row down, one either side of the midline. Not derived from the
    # QML, because Style.space scales -- Style.space(62) is not 62 anything.
    WIFI_X=188; BT_X=531; TILE_Y=185

    timeout 8 omarchy-shell shade dryRun 1 >/dev/null 2>&1

    # The marker is the *other* tile's picker, so "it already said moarchy.wifi"
    # cannot be mistaken for a hold that landed. Twice, because the injector
    # builds a fresh uinput device per call and the first events after one
    # appears can land nowhere.
    hold_picker() {   # x, wanted command, marker IPC
      local x=$1 want=$2 mark=$3 i
      for i in 1 2; do
        timeout 8 omarchy-shell shade "$mark" >/dev/null 2>&1
        timeout 8 omarchy-shell shade open >/dev/null 2>&1
        sleep 2
        sudo -n "$touch_bin" hold "$x" "$TILE_Y" 900 >/dev/null 2>&1
        sleep 2
        # Both tiles summon a plugin now, so lastLaunch is the bare id with no
        # command in front of it. Kept as a substring match rather than an
        # equality one so that a tile which goes back to spawning something
        # still reports which thing, instead of just "no".
        [[ $(timeout 8 omarchy-shell shade lastLaunch 2>/dev/null) == *"$want" ]] && return 0
      done
      return 1
    }

    if ! hold_picker $WIFI_X moarchy.wifi btHold; then
      noac S6 "a 900ms press on the Wi-Fi tile launched '$(timeout 8 omarchy-shell shade lastLaunch)'" \
              "the hold never fired, so the tile still only toggles"
    elif [[ $(shell_state shade) != "closed" ]]; then
      noac S6 "the picker opened but the shade is $(shell_state shade)" \
              "the Wi-Fi screen comes up behind the sheet"
    elif [[ $(shell_state wifi) != "open" ]]; then
      noac S6 "the tile recorded the picker but moarchy.wifi is $(shell_state wifi)" \
              "the summon was recorded and did not land, which is the failure a\
 launch-only check cannot see"
    else
      okac S6 "a long press on the Wi-Fi tile opens the network picker"
      timeout 8 omarchy-shell wifi close >/dev/null 2>&1
    fi

    # S6c, checked exactly the way S6 checks Wi-Fi -- the point of the pair is
    # that they behave alike, so anything the Wi-Fi half asserts and this half
    # does not is a way for them to drift apart unnoticed. The recorded summon
    # is not enough on its own: it can land nowhere and still be recorded.
    if ! hold_picker $BT_X moarchy.bluetooth wifiHold; then
      noac S6c "a 900ms press on the Bluetooth tile launched '$(timeout 8 omarchy-shell shade lastLaunch)'" \
               "the two wide tiles are supposed to behave alike"
    elif [[ $(shell_state shade) != "closed" ]]; then
      noac S6c "the picker opened but the shade is $(shell_state shade)" \
               "the Bluetooth screen comes up behind the sheet"
    elif [[ $(shell_state bluetooth) != "open" ]]; then
      noac S6c "the tile recorded the picker but moarchy.bluetooth is $(shell_state bluetooth)" \
               "the summon was recorded and did not land"
    else
      okac S6c "a long press on the Bluetooth tile opens the device picker"
      # S6d-2 while we are here: the scan is the thing that costs battery, and
      # it has to stop when the screen goes away.
      scan_open=$(timeout 8 omarchy-shell bluetooth scanning 2>/dev/null)
      timeout 8 omarchy-shell bluetooth close >/dev/null 2>&1
      sleep 3
      scan_shut=$(timeout 8 omarchy-shell bluetooth scanning 2>/dev/null)
      if [[ $scan_open == "on" && $scan_shut == "off" ]]; then
        okac S6d-2 "discovery runs only while the Bluetooth screen is up"
      else
        noac S6d-2 "discovery was '$scan_open' open and '$scan_shut' shut" \
                   "a scan left running costs radio and battery for a list nobody is reading"
      fi
    fi

    # The other half of S6: the hold must not also fire the tap it interrupted,
    # and a plain tap has to still be a toggle. Marked with the picker, so a tap
    # that lands nowhere fails here instead of passing on a stale value.
    #
    # S6a is asserted against what the tile is reading rather than against a
    # fixed answer: the picker is what a tap means too, but only on a stranded
    # tile -- Wi-Fi on, nothing connected, nothing saved in range -- and the
    # phone cannot be put in that state from here, because here is the far end
    # of that radio. What this catches is the decision disagreeing with the
    # state: a picker that has swallowed the toggle, or never opens at all.
    timeout 8 omarchy-shell shade wifiHold >/dev/null 2>&1
    timeout 8 omarchy-shell shade open >/dev/null 2>&1
    sleep 2
    sudo -n "$touch_bin" tap $WIFI_X $TILE_Y >/dev/null 2>&1
    sleep 2
    tapped=$(timeout 8 omarchy-shell shade lastAction 2>/dev/null)
    reading=$(timeout 8 omarchy-shell shade wifi 2>/dev/null)
    case $reading in *stranded*) want=picker ;; *) want=toggle ;; esac
    if [[ $tapped == "$want" ]]; then
      okac S6a "a tap on the Wi-Fi tile is a $want ($reading)"
    else
      noac S6a "a tap decided '$tapped' on a tile reading '$reading'" \
               "expected $want"
    fi

    timeout 8 omarchy-shell shade close >/dev/null 2>&1
    timeout 8 omarchy-shell shade dryRun 0 >/dev/null 2>&1
    sleep 2

    # --- H7. swipe a notification away ------------------------------------
    # The only per-card dismissal there is, now that the close button is gone,
    # so a swipe that does not land means a notification that cannot be
    # dismissed at all. Posted rather than waited for: a suite that needs a
    # real notification to arrive on its own tests nothing most of the time.
    post_note "moa-selftest" "swipe me away"
    sleep 3
    timeout 8 omarchy-shell shade open >/dev/null 2>&1
    sleep 3
    before_n=$(timeout 8 omarchy-shell shade notifications 2>/dev/null | grep -c . || true)
    if (( before_n == 0 )); then
      no "no notification to swipe, so H7 cannot be tested" \
         "posting a notification produced nothing the shade could see"
    else
      # Sideways across a card. The list is at the top, so the first card sits
      # just under the header.
      # y=770 is the first card's middle with one notification posted. Below
      # the last card the sheet ends and the scrim begins, and a *sideways*
      # swipe there still reads as a tap on the scrim and closes the shade --
      # which looks like the swipe having some wild side effect rather than
      # having missed. (An upward drag there is now the close gesture, H2.)
      sudo -n "$touch_bin" swipe 200 770 660 770 400 >/dev/null 2>&1
      sleep 3
      after_n=$(timeout 8 omarchy-shell shade notifications 2>/dev/null | grep -c . || true)
      if (( after_n == before_n - 1 )); then
        okac H7 "swiping a notification card dismisses it ($before_n -> $after_n)"
      else
        noac H7 "the notification count went $before_n -> $after_n" \
                "with no close button, a swipe that does not land leaves it undismissable"
      fi
    fi
    timeout 8 omarchy-shell shade close >/dev/null 2>&1
    sleep 2

    # --- S21/S22. the sheet is as tall as what is in it -------------------
    # The shade used to be a fixed 90% of the usable height whatever it held,
    # so an empty one was two thirds blank space below the sliders. It is its
    # content's height now, capped at that same 90%.
    #
    # The second assertion is the one a capture could never make, and it is why
    # the IPC exists: past the cap the overflow has to land in a *scrolling
    # list* rather than off the bottom of the sheet. The sheet clips now, so
    # both failures look identical from outside -- a sheet that ends at the cap.
    if ! ipc_present shade sheet; then
      printf '  \033[90m%-4s\033[0m   \033[90mS21 skipped: this shell has no `shade sheet`\033[0m\n' ""
    else
      # key=value on one line, the form the carousel's preview already uses.
      sf() { timeout 8 omarchy-shell shade sheet 2>/dev/null | tr ' ' '\n' | sed -n "s/^$1=//p"; }

      # Reopened after each post, and that is not padding.
      #
      # `historyRows` is filled by refresh(), which runs on open() and nowhere
      # else, so a notification that arrives while the shade is already down
      # does not join the list until it is next opened -- the sheet cannot grow
      # under a shade you are looking at. That predates the sheet being its
      # content's height (the list has always been read on open) and it is what
      # a user sees, so it is what this check drives. A version of this check
      # that posted without reopening measured the refresh, not the height.
      #
      # The sleeps are the history's own lag: a notification is written to disk
      # when its toast expires, several seconds after it is posted, so a reopen
      # that is too quick reads the directory as it was before.
      reopen() {
        timeout 8 omarchy-shell shade close >/dev/null 2>&1
        sleep 1
        timeout 8 omarchy-shell shade open >/dev/null 2>&1
        sleep 3
      }

      timeout 8 omarchy-shell shade clear >/dev/null 2>&1
      reopen
      s_empty=$(sf height); s_cap=$(sf max)
      post_note "moa-selftest" "grow the sheet"
      sleep 8
      reopen
      s_one=$(sf height)
      if [[ -z $s_empty || -z $s_cap || -z $s_one ]]; then
        noac S21 "shade sheet answered nothing readable (empty=$s_empty one=$s_one cap=$s_cap)" \
                 "the function is present but produced no key=value line"
      elif (( s_one > s_empty && s_one < s_cap )); then
        okac S21 "the sheet is as tall as its content ($s_empty -> $s_one, cap $s_cap)"
      else
        noac S21 "the sheet went $s_empty -> $s_one against a cap of $s_cap" \
                 "a sheet that does not grow with a notification is the fixed 90% this replaced"
      fi

      for i in 1 2 3 4 5 6 7 8; do
        post_note "moa-selftest" "fill the sheet $i"
        sleep 1
      done
      sleep 8
      reopen
      s_h=$(sf height); s_scrolls=$(sf scrolls)
      s_content=$(sf content); s_list=$(sf list); s_listmax=$(sf listmax)
      if [[ -z $s_h || -z $s_scrolls || -z $s_content || -z $s_list ]]; then
        noac S22 "shade sheet answered nothing readable at the cap" \
                 "the function is present but produced no key=value line"
      elif (( s_h == s_cap && s_scrolls == 1 && s_content > s_list )); then
        okac S22 "at the cap the overflow scrolls ($s_content of content in $s_list)"
      else
        noac S22 "height=$s_h cap=$s_cap scrolls=$s_scrolls content=$s_content list=$s_list" \
                 "content past the cap must land in a scrolling list, never off the sheet"
      fi
      # A listmax at or near zero means the chrome alone no longer fits the cap
      # -- the sheet clips, so that is otherwise silent. Reported, not asserted:
      # it is a property of the theme's spacing scale, not of this change.
      [[ -n $s_listmax ]] && (( s_listmax < 40 )) \
        && printf '        \033[90mlistmax=%s: the chrome nearly fills the cap on this theme\033[0m\n' "$s_listmax"

      timeout 8 omarchy-shell shade clear >/dev/null 2>&1
    fi
    timeout 8 omarchy-shell shade close >/dev/null 2>&1
    sleep 2

    # --- G. back -----------------------------------------------------------
    # With the drawer up, back closes the overlay and leaves the apps alone.
    before=$(cards)
    sudo -n "$touch_bin" swipe 4 700 200 700 300 >/dev/null 2>&1
    sleep 3
    if [[ $(shell_state drawer) == "closed" ]] && (( $(cards) == before )); then
      okac G3 "back closes the overlay and leaves the apps alone"
    else
      noac G3 "drawer is $(shell_state drawer), apps went $before -> $(cards)"
    fi

    # G2 before G4, because back is a priority order and the keyboard outranks
    # the app. Forced rather than observed: whether foot has raised squeekboard
    # is not something this suite should be at the mercy of, and an unforced
    # run of this check is what made G4 look broken when it was obeying G2.
    osk() { busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 SetVisible b "$1" >/dev/null 2>&1; }
    osk_visible() { busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 Visible 2>/dev/null; }

    swaymsg '[app_id=moa-selftest] focus' >/dev/null 2>&1
    sleep 2
    osk true; sleep 2
    before=$(cards)
    if [[ $(osk_visible) == *true* ]]; then
      sudo -n "$touch_bin" swipe 4 700 200 700 300 >/dev/null 2>&1
      sleep 3
      if [[ $(osk_visible) != *true* ]] && (( $(cards) == before )); then
        okac G2 "back dismisses the keyboard and leaves the app open"
      else
        noac G2 "keyboard is $(osk_visible), apps went $before -> $(cards)" \
                "the keyboard outranks the app; back must not close one to hide the other"
      fi
    else
      no "the on-screen keyboard would not come up" "cannot test the back priority order without it"
    fi

    # And with nothing above it, back asks the app to close.
    #
    # Focus first, keyboard down second, and that order matters: focusing a
    # terminal makes it advertise a text field and squeekboard comes straight
    # back up. Dismissing the keyboard before focusing left it up again by the
    # time the swipe landed, so back correctly took the G2 branch and this
    # check failed on behaviour that was right.
    swaymsg '[app_id=moa-selftest] focus' >/dev/null 2>&1
    sleep 2
    osk false; sleep 2
    before=$(cards)
    # G4 needs a focused window, and that precondition can fail on its own.
    # Sway can end up with the workspace focused and no window inside it
    # focused -- `[app_id=...] focus` then reports success and changes
    # nothing. Back is right to do nothing there (G5: no app, nothing to
    # close), so without this the check blames the gesture for a seat state it
    # did not cause.
    if [[ -z $(focused_app) ]]; then
      no "no window is focused, so G4 cannot be tested" \
         "Sway reports the workspace focused but no window in it; see build-log 6g"
    else
      sudo -n "$touch_bin" swipe 4 700 200 700 300 >/dev/null 2>&1
      sleep 3
      if (( $(cards) == before - 1 )); then
        okac G4 "back closes the focused app ($before -> $(cards))"
      else
        noac G4 "the app count went $before -> $(cards)" \
                "a left-edge swipe on an app has to close it"
      fi
    fi

    # A short drag from the edge must not.
    osk false; sleep 1
    swaymsg '[app_id=moa-selftest] focus' >/dev/null 2>&1
    sleep 2
    before=$(cards)
    sudo -n "$touch_bin" swipe 4 700 30 700 300 >/dev/null 2>&1
    sleep 3
    if (( $(cards) == before )); then
      okac G6 "brushing the edge closes nothing"
    else
      noac G6 "a 13-logical-px drag from the edge closed an app"
    fi

    # --- F3. going home puts the keyboard away -----------------------------
    # Its own window, not whatever happens to be on the phone. Taking
    # `[app_id=".*"] focus` meant this ran against other sessions' windows when
    # there were any and skipped entirely when G4 had closed the last one: two
    # runs, one FAIL and one SKIP, and neither was a verdict on the fix.
    #
    # Driven through the IPC rather than a real swipe. The bug is in what
    # `run("home")` does once it is reached, not in reaching it, and a strip
    # swipe with the keyboard up is its own open question -- measured at 1 home
    # in 5 attempts, at 86% travel against a 75% commit. Routing this through
    # that would make an unrelated flake read as the keyboard fix regressing.
    setsid foot --app-id=moa-selftest -e sh -c 'while :; do sleep 300; done' >/dev/null 2>&1 </dev/null &
    sleep 4
    swaymsg '[app_id=moa-selftest] focus' >/dev/null 2>&1
    sleep 1
    osk true; sleep 2
    if [[ $(osk_visible) == *true* ]]; then
      timeout 8 omarchy-shell gestures swipe home >/dev/null 2>&1
      # Sampled over 3s, not read once. A single late reading cannot tell
      # "never went down" from "went down and something raised it again", and
      # on a shared phone another session mapping a window with a text input
      # does exactly that. Verified by hand at the mechanism: forced up, then
      # home, then b false at 8 of 8 samples over 4s.
      f3_up=0
      for _ in 1 2 3 4 5 6; do
        sleep 0.5
        [[ $(osk_visible) == *true* ]] && f3_up=$((f3_up + 1))
      done
      if (( f3_up == 0 )); then
        okac F3 "going home puts the keyboard away and it stays away (6 samples)"
      else
        noac F3 "the keyboard was up in $f3_up of 6 samples after going home" \
                "a home screen has nothing to type into; the keyboard leaves with the app"
      fi
    else
      no "the on-screen keyboard would not come up" "cannot test F3 without it"
    fi
    osk false

    # --- J. the app you are leaving ---------------------------------------
    # Last in the section on purpose. It is the only check here that has to
    # sample a drag while it runs rather than read the state it left, so it
    # holds the carousel open for several seconds; run earlier, that timing and
    # the scroll position it leaves behind perturb E3 and D1, which assume they
    # follow A1/A3 directly.
    #
    # moarchy-touch spends ~3s building its uinput device before the
    # first event lands -- the same settle every other swipe in this file pays
    # inside its `sleep` -- so the poll starts after that and not at t=0.
    # Sampled before it, every field reads as its resting value, which looks
    # exactly like a preview that never armed.
    #
    # And a window of its own on *this* workspace. The preview is a picture of
    # the app you are leaving, and there is deliberately nothing to picture on
    # a home screen (J10), so the gesture refuses to arm there -- correctly.
    # Inheriting the previous check's workspace meant inheriting an empty one:
    # G4 closes the focused app and F3 above ends by going home, so this read
    # `armed=0` and reported a working preview as broken.
    timeout 8 omarchy-shell recents close >/dev/null 2>&1; sleep 2
    setsid foot --app-id=moa-selftest -e sh -c 'while :; do sleep 300; done' >/dev/null 2>&1 </dev/null &
    sleep 4
    swaymsg '[app_id=moa-selftest] focus' >/dev/null 2>&1
    sleep 2

    if [[ -z $(ws_rep) ]]; then
      printf '  \033[90m%-4s\033[0m   \033[90mJ1/J3 skipped: no window on the focused workspace to preview\033[0m\n' ""
    else
    preview_log=""
    sudo -n "$touch_bin" swipe 360 $STRIP_Y 360 1120 4000 >/dev/null 2>&1 &
    swipe_pid=$!
    sleep 3.2
    for _ in 1 2 3 4 5 6 7; do
      preview_log+="$(timeout 5 omarchy-shell recents preview 2>/dev/null)"$'\n'
    done
    wait $swipe_pid 2>/dev/null
    sleep 2

    j_verdict=$(printf '%s' "$preview_log" | python3 -c '
import sys

armed = []
landed = None
for line in sys.stdin:
    f = dict(p.split("=", 1) for p in line.split() if "=" in p)
    if "landed" not in f:
        continue
    if landed is None:
        landed = int(f["landed"])
    if f.get("armed") == "true" and f.get("content") == "true":
        armed.append((int(f["progress"]), int(f["track"]), int(f["scale"])))

# J1, half one: at least one frame between full size and the card. Without it
# "shrinks" is satisfied by something that jumps straight to the card.
mid = sum(1 for _, _, sc in armed if landed < sc < 100)

# J1, half two: it tracks the drag rather than easing toward it. The first
# armed sample is exempt -- J4 is the catch-up from full size to wherever the
# finger got to while the capture was in flight, and during it the two
# deliberately disagree.
lag = sum(1 for pr, tr, _ in armed[1:] if abs(tr - pr) > 2)

# J3: where it comes to rest. Read from the samples at the carousel stop, not
# from the state after the gesture -- by then the preview has disarmed and
# every field is back to its resting value.
at_stop = [sc for pr, _, sc in armed if pr >= 100]
landed_ok = bool(at_stop) and all(sc == landed for sc in at_stop)

print("armed=%d mid=%d lag=%d stop=%d landed_ok=%s landed=%s"
      % (len(armed), mid, lag, len(at_stop), landed_ok, landed))
')
    j_armed=${j_verdict#armed=}; j_armed=${j_armed%% *}
    j_mid=${j_verdict#*mid=}; j_mid=${j_mid%% *}
    j_lag=${j_verdict#*lag=}; j_lag=${j_lag%% *}
    j_stop=${j_verdict#*stop=}; j_stop=${j_stop%% *}
    j_landed_ok=${j_verdict#*landed_ok=}; j_landed_ok=${j_landed_ok%% *}

    if (( j_armed == 0 )); then
      noac J1 "the preview never armed during the drag ($j_verdict)" \
              "J8 says the gesture still works without a capture, but then J1 is untested"
    elif (( j_mid > 0 )) && (( j_lag == 0 )); then
      okac J1 "the app preview shrinks with the drag ($j_mid mid-shrink samples, none lagging)"
    else
      noac J1 "preview samples: $j_verdict" \
              "mid=0 means it jumped rather than shrank; lag>0 means it trailed the finger"
    fi

    if (( j_stop == 0 )); then
      noac J3 "the drag never reached the carousel stop ($j_verdict)" \
              "J3 is about where the preview lands, so a drag that stops short cannot test it"
    elif [[ $j_landed_ok == True ]]; then
      okac J3 "the preview lands on the leading card's slot ($j_verdict)"
    else
      noac J3 "the preview did not settle on the card slot ($j_verdict)" \
              "at the carousel stop its scale must equal the fit into card 0"
    fi

    timeout 8 omarchy-shell recents close >/dev/null 2>&1; sleep 1
    fi

    # --- K. Settings is an app ---------------------------------------------
    # After everything else in this section, and that is not tidiness. Every
    # count-based check above reads `recents list` and compares numbers, and a
    # Settings left running adds a line to it -- so run earlier, these would
    # make E3 and F2 fail as though a window had gone missing. This block
    # closes Settings on the way in for the same reason, because the --settings
    # section is not guaranteed to have gone first.
    #
    # K3 and K4 are driven with a finger and the rest over IPC, deliberately.
    # What was wrong is what the *strip* decides, so that half has to arrive
    # the way a thumb does; what Settings remembers is not a gesture question
    # and a swipe would only make it slower to ask.
    if ! ipc_present settings running; then
      printf '  \033[90m%-4s\033[0m   \033[90mK skipped: this shell has no `settings running`, so Settings-as-an-app is not present to test\033[0m\n' ""
    else
    timeout 8 omarchy-shell settings close >/dev/null 2>&1; sleep 1
    setsid foot --app-id=moa-selftest -e sh -c 'while :; do sleep 300; done' >/dev/null 2>&1 </dev/null &
    sleep 4
    swaymsg '[app_id=moa-selftest] focus' >/dev/null 2>&1
    sleep 1

    # `|| true`: grep exits 1 when it counts nothing, which under `set -e`
    # would end the run at the one moment the answer is legitimately zero.
    settings_card() {
      timeout 8 omarchy-shell recents list 2>/dev/null \
        | grep -c '^moarchy\.settings' || true
    }
    settings_running() { timeout 8 omarchy-shell settings running 2>/dev/null; }

    # K1. Both halves, because `running` outliving `state` is the whole idea
    # and a card bound to `state` instead would pass here and fail K4.
    k_ws_before=$(ws)
    timeout 8 omarchy-shell settings open >/dev/null 2>&1
    sleep 3
    if [[ $(settings_running) == running && $(settings_card) == 1 ]]; then
      okac K1 "a running Settings has a card in the carousel"
    else
      noac K1 "settings running=$(settings_running), cards named settings=$(settings_card)" \
              "the card exists for as long as Settings is running, and that is longer than it is on screen"
    fi

    # K13. The workspace of its own, asserted as all three things at once,
    # because each one alone is satisfied by something that is not this: a
    # *different* workspace is what a plain switch onto the other app gives, an
    # *empty* one is what a Settings that took nothing at all gives whenever it
    # was summoned from a home screen, and `shellws` alone is a number the
    # service recorded and may never have dispatched.
    k13_claim=$(sed -n 's/.* shellws=\(-\{0,1\}[0-9]\{1,\}\).*/\1/p' \
                <<<"$(timeout 8 omarchy-shell gestures status 2>/dev/null)")
    if [[ $(ws) != "$k_ws_before" && -z $(ws_rep) && $k13_claim == "$(ws)" ]]; then
      okac K13 "Settings took a free workspace of its own (${k13_claim})"
    else
      noac K13 "workspace=$(ws) (was $k_ws_before), representation='$(ws_rep)', claimed=${k13_claim:-none}" \
               "a layer surface has no workspace until one is taken for it, and B1 needs it to have one"
    fi

    # K14. Driven with swaymsg rather than a finger, and that is the point of
    # the criterion: ANY workspace change takes the screen with it. The swipe
    # would pass this whether or not K14 held, because B3 hides the surface a
    # beat before dispatching for its own ordering reason.
    swaymsg workspace next_on_output >/dev/null 2>&1
    sleep 2
    if [[ $(shell_state settings) == "closed" && $(settings_card) == 1 ]]; then
      okac K14 "leaving the workspace hides Settings and leaves its card"
    else
      noac K14 "settings=$(shell_state settings), settings cards=$(settings_card)" \
               "hidden, not closed -- a workspace switch is not a close (K4, K6)"
    fi

    # Back on screen for K3, which needs Settings drawn over an app. Opened
    # rather than resumed: which page it lands on is not what K3 asks about,
    # and a closed Settings opens at the root either way (`settings.md` A6).
    timeout 8 omarchy-shell settings open >/dev/null 2>&1
    sleep 3

    # K3. The swipe that was wrong. With an app running *and* Settings on
    # screen this used to raise the carousel over the top of Settings and
    # leave it there, so the assertion is the leading card and not that the
    # carousel opened -- "it opened" was true throughout the bug.
    sudo -n "$touch_bin" swipe 360 $STRIP_Y 360 1120 2000 >/dev/null 2>&1
    sleep 3
    lead=$(timeout 8 omarchy-shell recents list 2>/dev/null | head -1 | awk '{print $1}')
    if [[ $(shell_state recents) == "open" && $lead == "moarchy.settings" ]]; then
      okac K3 "the strip raises the carousel with Settings leading"
    else
      noac K3 "recents=$(shell_state recents), leading card='${lead:-none}'" \
              "the strip does to Settings what it does to an app, and Settings is what you just left"
    fi

    # K8. Dismissing the carousel leaves Settings exactly where it was, because
    # the carousel covered it rather than hiding it. Worth a check rather than
    # an assumption: the obvious way to implement K3 is to hide Settings as the
    # carousel opens, and that passes K3 and K4 and fails only here.
    timeout 8 omarchy-shell recents close >/dev/null 2>&1
    sleep 2
    if [[ $(shell_state settings) == "open" ]]; then
      okac K8 "dismissing the carousel puts you back on Settings"
    else
      noac K8 "settings=$(shell_state settings) after dismissing the carousel" \
              "E5 says a dismissal returns you to what was on screen, and that was Settings"
    fi

    # K4. Carried into the home band. Hidden and closed differ only in what is
    # left behind, so the card is asserted alongside the state -- `state`
    # alone is equally satisfied by a Settings that was closed outright, which
    # is the other way to get this wrong.
    sudo -n "$touch_bin" swipe 360 $STRIP_Y 360 860 2000 >/dev/null 2>&1
    sleep 3
    if [[ $(shell_state settings) == "closed" && -z $(ws_rep) && $(settings_card) == 1 ]]; then
      okac K4 "the home band hides Settings and leaves its card"
    else
      noac K4 "settings=$(shell_state settings), workspace='$(ws_rep)', settings cards=$(settings_card)" \
              "hidden, not closed -- the card is how you get back to it"
    fi

    # K5. Both directions, because either alone is satisfied by an
    # implementation that always does one of them: resuming a hidden Settings
    # keeps the page, reopening a closed one does not (settings.md A6).
    timeout 8 omarchy-shell settings openAt appearance.bar >/dev/null 2>&1; sleep 2
    timeout 8 omarchy-shell settings hide >/dev/null 2>&1; sleep 1
    timeout 8 omarchy-shell settings resume >/dev/null 2>&1; sleep 2
    resumed=$(timeout 8 omarchy-shell settings page 2>/dev/null)
    timeout 8 omarchy-shell settings close >/dev/null 2>&1; sleep 1
    timeout 8 omarchy-shell settings open >/dev/null 2>&1; sleep 2
    reopened=$(timeout 8 omarchy-shell settings page 2>/dev/null)
    if [[ $resumed == "appearance.bar" && $reopened == "root" ]]; then
      okac K5 "a hidden Settings resumes its page and a closed one reopens at the root"
    else
      noac K5 "resumed='$resumed', reopened='$reopened'" \
              "expected appearance.bar then root"
    fi

    # K6. `settings close` is the IPC spelling of both gestures that end
    # Settings -- flicking the card away and back on the root page -- so it is
    # what this drives. The card leaving is the half that is new; putting the
    # surface away is what closing already did.
    timeout 8 omarchy-shell settings close >/dev/null 2>&1
    sleep 2
    if [[ $(settings_running) == stopped && $(settings_card) == 0 ]]; then
      okac K6 "closing Settings takes its card out of the carousel"
    else
      noac K6 "settings running=$(settings_running), settings cards=$(settings_card)" \
              "closing resets the stack and drops the card; only hiding keeps them"
    fi

    timeout 8 omarchy-shell recents close >/dev/null 2>&1; sleep 1
    fi
  fi
  # Closed through the compositor rather than by `pkill -f`. The pkill was not
  # self-matching here -- this script's own command line does not contain the
  # pattern, so it reached only the windows it meant to, and runs over ssh
  # printed their full summary. What `-f` does carry is a hazard one keystroke
  # away: type the same pattern into an ssh command and *that* argv does contain
  # it, the match includes the shell running it, and the session dies mid-run.
  # Asking a window to close by app_id cannot reach anything but a window, and
  # it is what the rest of this file does to windows anyway.

  # --- L. long-press on an app ----------------------------------------------
  #
  # The gesture is real touch; everything it opens is text inside a QML item
  # that nothing outside the shell can read, and a grim capture can show that
  # *a* card is up without saying which entry it is about. So L1 and L3 are
  # driven through the injector and read back over IPC, and the rest is IPC on
  # both ends.
  #
  # Nothing here removes a package. L9 needs something to actually leave, so it
  # creates a launcher of its own and removes that -- a check that only ever
  # plans is a check that would pass against a Remove button wired to nothing.
  if ! ipc_present drawer detail; then
    printf '  \033[90m%-4s\033[0m   \033[90mL skipped: the drawer has no `detail` -- this suite is ahead of the plugin\033[0m\n' ""
  else
    dr() { timeout 10 omarchy-shell drawer "$@" 2>/dev/null; }
    l_reset() { dr detailClose >/dev/null; dr close >/dev/null; sleep 1
                dr open >/dev/null; sleep 2; }
    # Wait for a plan rather than sleeping a fixed time: it is a pacman
    # transaction on a 1.15GHz A53, and a check that guessed the duration would
    # read "pending" as "cannot remove" on a busy phone.
    l_settle() { local i; for i in 1 2 3 4 5 6 7 8; do
                   [[ $(dr canRemove) != pending ]] && return; sleep 2; done; }
    l_field() { dr detail | sed -n "s/^$1\t//p"; }

    # Where cell 0 is, in panel pixels. Three frames meet here and each is read
    # from whatever owns it: the cell rect from the shell (surface space), the
    # bar's height from sway (it is the surface's top), and the scale from the
    # output. Nothing is written down -- Style.space(86) is a *scaled* number
    # and the row pitch moves with the theme.
    l_bar=$(swaymsg -t get_workspaces | jq -r '.[]|select(.focused)|.rect.y')
    l_scale=$(swaymsg -t get_outputs | jq -r '.[]|select(.active)|.scale' | cut -d. -f1)
    l_reset
    l_cell=$(dr cellTarget 0)
    l_id=$(tr ' ' '\n' <<<"$l_cell" | sed -n 's/^id=//p')
    l_rect=$(tr ' ' '\n' <<<"$l_cell" | sed -n 's/^rect=//p')
    l_size=$(tr ' ' '\n' <<<"$l_cell" | sed -n 's/^size=//p')

    if [[ -z $l_id || -z $l_rect || -z ${l_bar:-} ]]; then
      noac L1 "cellTarget answered '$l_cell'" \
              "with the drawer open it must name a cell; nothing else can aim the hold"
    else
      l_cx=$(( (${l_rect%%,*} + ${l_size%%x*} / 2) * l_scale ))
      l_cy=$(( (${l_rect#*,} + ${l_size#*x} / 2 + l_bar) * l_scale ))

      # L1/L2 together, and they have to be one check: L2 is about what the
      # same touch did NOT do, so a separate run would be asserting a different
      # gesture.
      l_cards=$(cards)
      sudo -n "$touch_bin" hold "$l_cx" "$l_cy" 900 >/dev/null 2>&1
      sleep 4
      l_held=$(l_field id)
      if [[ $l_held == "$l_id" ]]; then
        okac L1 "a 900ms hold on $l_id opens its card"
      else
        noac L1 "the hold left detail='${l_held:-empty}', wanted $l_id" \
                "the timer never fired, or travel cancelled it -- check dragSlop against the injector's jitter"
      fi
      if [[ $(cards) -eq $l_cards ]]; then
        okac L2 "the hold did not also launch it ($l_cards cards either side)"
      else
        noac L2 "cards went $l_cards -> $(cards)" \
                "the click Qt delivers after the release is still reaching launch()"
      fi

      # L3. Down from the same cell, past the slop: a close drag, and no card.
      l_reset
      sudo -n "$touch_bin" swipe "$l_cx" "$l_cy" "$l_cx" $(( l_cy + 1000 )) 1200 >/dev/null 2>&1
      sleep 3
      l_samples=$(dr dragTrace | wc -w)
      if [[ $(shell_state drawer) == "closed" ]] && [[ -z $(l_field id) ]] \
         && (( l_samples >= 8 )); then
        okac L3 "a drag from a cell closes the drawer and opens no card ($l_samples samples)"
      else
        noac L3 "state $(shell_state drawer), detail '$(l_field id)', $l_samples samples" \
                "travel must cancel the hold, and the hold must not eat the drag"
      fi
    fi

    # L6. A packaged entry says which package, which version and how big.
    l_reset
    dr hold org.gnome.clocks >/dev/null; sleep 3
    l_pkg=$(l_field info.package); l_ver=$(l_field info.version); l_sz=$(l_field info.size)
    if [[ -n $l_pkg && -n $l_ver && -n $l_sz ]]; then
      okac L6 "the card names its origin ($l_pkg $l_ver, $l_sz)"
    else
      noac L6 "package='$l_pkg' version='$l_ver' size='$l_sz'" \
              "moarchy-app-remove info is missing, or is not on the shell's PATH"
    fi

    # L7 and L13. Uninstall shows a plan, and says when the set exception fired.
    echo "$(dr uninstall)" >/dev/null; l_settle
    l_count=$(l_field plan.count); l_set=$(l_field plan.set)
    if [[ $(dr canRemove) == yes && -n $l_count ]]; then
      okac L7 "Uninstall shows a plan first (removes $l_count, $(l_field plan.size))"
    else
      noac L7 "canRemove=$(dr canRemove) count='$l_count'" \
              "Uninstall must ask pacman before it offers Remove"
    fi
    if [[ $l_set == 1 ]]; then
      okac L13 "the plan says the set will bring it back"
    else
      noac L13 "plan.set='$l_set' for a package moarchy-meta declares" \
               "the --assume-installed branch did not fire, or moarchy-meta no longer declares it"
    fi

    # L11. The shell will not uninstall itself. moarchy owns three launchers --
    # Wi-Fi, Bluetooth and Device -- so there is always one of these to ask.
    l_reset
    dr hold moarchy.wifi >/dev/null; sleep 3
    if [[ $(l_field info.protected) == 1 && $(dr uninstall) == protected \
          && $(dr canRemove) == no ]]; then
      okac L11 "moarchy's own launcher offers no Uninstall"
    else
      noac L11 "protected='$(l_field info.protected)' uninstall='$(dr uninstall)' canRemove='$(dr canRemove)'" \
               "a moarchy* package must be refused before pacman is even asked"
    fi

    # L5. Back walks out of the card the way it walks out of Settings (G3):
    # the plan steps back to the detail, the detail closes the card, and only
    # then does the drawer go. Nothing else in this suite calls the drawer's
    # goBack(), and until it existed a back gesture over an open card closed the
    # whole drawer and lost the card with it.
    l_reset
    dr hold org.gnome.clocks >/dev/null; sleep 3
    dr uninstall >/dev/null; l_settle
    l_s1=$(l_field stage)
    timeout 10 omarchy-shell gestures back >/dev/null 2>&1; sleep 2
    l_s2=$(l_field stage)
    timeout 10 omarchy-shell gestures back >/dev/null 2>&1; sleep 2
    l_s3="$(l_field id)/$(shell_state drawer)"
    timeout 10 omarchy-shell gestures back >/dev/null 2>&1; sleep 2
    if [[ $l_s1 == plan && $l_s2 == info && $l_s3 == "/open" \
          && $(shell_state drawer) == closed ]]; then
      okac L5 "back steps plan -> card -> drawer, one at a time"
    else
      noac L5 "stages '$l_s1' -> '$l_s2' -> '$l_s3' -> $(shell_state drawer)" \
              "each back must consume one level; the drawer is the last of them"
    fi

    # L12, at the script rather than through a card: nothing the drawer lists
    # has a dependent outside the set, so the blocked branch has no entry to
    # reach it with. Asked of a package that does have one, found rather than
    # named -- which package that is depends on what is installed.
    l_dep=$(LC_ALL=C pacman -Qi $(pacman -Qqo /usr/share/applications/*.desktop 2>/dev/null | sort -u) 2>/dev/null |
            awk -F": " '/^Name/{n=$2} /^Required By/{if ($2 !~ /^(None|moarchy-meta *)$/) print n}' | head -1)
    if [[ -z $l_dep ]]; then
      printf '  \033[90m%-4s\033[0m   \033[90mL12 skipped: nothing with a .desktop has a dependent outside the set\033[0m\n' ""
    else
      l_file=$(pacman -Qlq "$l_dep" | grep '/applications/.*\.desktop$' | head -1)
      l_blocked=$(moarchy-app-remove plan "$(basename "$l_file" .desktop)" 2>&1 | sed -n 's/^blocked\t//p')
      if [[ -n $l_blocked ]]; then
        okac L12 "$l_dep is refused: ${l_blocked:0:48}"
      else
        noac L12 "$l_dep planned cleanly despite a dependent outside moarchy-meta" \
                 "the blocker parse is wrong, or --assume-installed fired when it should not have"
      fi
    fi

    # L12's other half: the rule only protects what the metadata declares, and
    # foot is the case that proved it. This fails on a phone still holding
    # moarchy 0.2.0-1, which is the point -- that is a device whose drawer will
    # offer to remove its own terminal.
    l_foot=$(moarchy-app-remove plan foot 2>&1 | sed -n 's/^blocked\t//p')
    if [[ -n $l_foot ]]; then
      okac L12a "the terminal is refused: ${l_foot:0:48}"
    else
      noac L12a "foot plans cleanly" \
                "moarchy must declare foot (pkgbuilds/moarchy 0.2.0-2); until it does, the drawer will remove it"
    fi

    # L9 and L10, with something that is really removed. A launcher of this
    # suite's own, so no package moves and nothing the user installed is at
    # risk -- and the whole path runs: plan, Remove, the script, the
    # notification, and the grid noticing.
    l_disp="$HOME/.local/share/applications/moarchy-selftest-disposable.desktop"
    printf '[Desktop Entry]\nType=Application\nName=Selftest Disposable\nExec=true\nIcon=application-x-executable\n' > "$l_disp"
    update-desktop-database "${l_disp%/*}" >/dev/null 2>&1
    sleep 4
    l_reset
    if ! dr entries | grep -qx "moarchy-selftest-disposable"; then
      noac L10 "the disposable launcher never appeared in the grid" \
               "the desktop-entry watcher did not pick it up; L9 cannot be run"
      rm -f "$l_disp"
    else
      dr hold moarchy-selftest-disposable >/dev/null; sleep 3
      dr uninstall >/dev/null; l_settle
      l_conf=$(dr removeConfirm)
      sleep 6
      l_gone=$([[ -f $l_disp ]] && echo no || echo yes)
      if [[ $l_conf == ok && $l_gone == yes && -z $(l_field id) ]]; then
        okac L9 "Remove removed it, with no terminal, and closed the card"
      else
        noac L9 "removeConfirm='$l_conf' file gone=$l_gone card='$(l_field id)'" \
                "the Remove button did not reach moarchy-app-remove"
      fi
      sleep 4
      if dr entries | grep -qx "moarchy-selftest-disposable"; then
        noac L10 "the grid still lists it" \
                 "appsChanged() is not reaching appRows, or the entry cache is stale"
      else
        okac L10 "the grid dropped it without a reopen"
      fi
      rm -f "$l_disp"
      update-desktop-database "${l_disp%/*}" >/dev/null 2>&1
    fi

    dr detailClose >/dev/null; dr close >/dev/null
  fi

  swaymsg '[app_id=moa-selftest] kill' >/dev/null 2>&1

  # An AC with no check here is a gap, and a gap nobody can see is the same as
  # a gap nobody fixed. These are the ones this suite does not prove:
  #
  #   A6      carousel open, drag up again -> home
  #   A8      shade down, up-flick puts it away
  #   A9      no apps open at all -> nothing. Needs every window on the device
  #           closed, including the user's, so it is not run here.
  #   B2      a curved thumb swipe still resolves
  #   D2/D3   drawer springs back; a drag on an app does nothing
  #   D4      sideways/down on the home screen do nothing
  #   E1/E4   card order and paging -- both visual
  #   E5/E6   dismiss returns you; last card goes home
  #   E7/G5   absences, and a close-request that only a prompting app shows
  #   F1      home picks the lowest free workspace
  #   G7/G8/G9 constants, not behaviour
  #   G10a    the dead column outside the band -- it is D3 restated, and D3
  #           is already here for the same reason
  #   K2/K7   the card's three lines, and the last card going home -- visual,
  #           and E6 already drives the same code for a window
  #   K4a     needs Settings over a *bare* home screen with an app elsewhere,
  #           which is a workspace layout this suite does not build
  #   K9      needs a tap on a named card, and nothing addresses one by name
  #   K10     the shrink out of Settings; J1 drives the same path from a window
  #   K11/K12 an absence, and a bridged launch that must not run for real here
  #   L4      a scroll that cancels the hold. It needs a grid that scrolls AND
  #           a thumb that stops on a cell; the cancel arrives through
  #           onCanceled when the Flickable steals the grab, which is the same
  #           path H6 already relies on for every press veil on this sheet.
  #   L5a     the card keeps the grid's SCROLL POSITION. The back ladder and
  #           the drawer staying open are checked as L5; the scroll offset
  #           itself is not readable over IPC.
  printf '  \033[90m%-4s\033[0m   \033[90mnot covered: A6 A8 A9 B2 D2 D3 D4 E1 E4 E5 E6 E7 F1 G5 G7 G8 G9 G10a J2 J4 J5 J6 J7 J8 J9 J10 K2 K4a K7 K9 K10 K11 K12 L4 L5a\033[0m\n' ""
fi

# ---------------------------------------------------------------------------
# --settings: the Settings stack, against docs/settings.md
# ---------------------------------------------------------------------------
# Every check cites an AC id, so an AC with no check is visible at the end.
# Read-only except for three switch flips, each restored; nothing here reboots,
# logs out or installs -- the rows that would are exercised through dryRun,
# which records the command line instead of running it.
if [[ ${1:-} == "--settings" ]]; then
  head_ "settings"

  s() { timeout 5 omarchy-shell settings "$@" 2>/dev/null; }

  if ! st=$(s state) || [[ -z $st ]]; then
    no "I1 settings IPC does not answer" \
       "the plugin is missing from shell.json plugins[], or it failed to load"
    printf '\n%d passed, %d failed\n' "$pass" "$fail"
    exit 1
  fi
  ok "I1 settings IPC answers ($st)"

  # --- A. getting in and out ------------------------------------------------
  s close >/dev/null; sleep 1
  s open  >/dev/null; sleep 2
  [[ $(s state) == open && $(s page) == root ]] \
    && ok "A1 the gear opens Settings at the root" \
    || no "A1 open did not land on root" "page=$(s page) state=$(s state)"

  others=""
  for p in shade drawer recents themes; do
    [[ $(timeout 5 omarchy-shell "$p" state 2>/dev/null) == open ]] && others="$others $p"
  done
  [[ -z $others ]] && ok "A2 no other full-screen surface is up" \
                   || no "A2 still open:$others" "open() must hide the others"

  [[ $(s openAt nope) == "unknown page: nope" ]] \
    && ok "A4 an unknown page id is refused" \
    || no "A4 an unknown page id was not refused" "it silently landed somewhere"

  s openAt appearance.bar >/dev/null; sleep 2
  [[ $(s page) == appearance.bar ]] \
    && ok "A4 Settings opens directly at a page" \
    || no "A4 openAt did not land" "page=$(s page)"

  s close >/dev/null; sleep 1; s open >/dev/null; sleep 2
  [[ $(s page) == root ]] \
    && ok "A6 reopening lands on the root, not where it was left" \
    || no "A6 reopened at $(s page)" "the stack must reset on open"

  # --- B. the stack and back ------------------------------------------------
  before=$(s stack | wc -l)
  s goto appearance >/dev/null; sleep 1
  after=$(s stack | wc -l)
  [[ $(s page) == appearance && $after -eq $((before + 1)) ]] \
    && ok "B1 a nav row pushes exactly one page" \
    || no "B1 stack went $before -> $after" "page=$(s page)"

  s goto appearance >/dev/null; sleep 1
  [[ $(s stack | wc -l) -eq $after ]] \
    && ok "B6 pushing the page already on top is a no-op" \
    || no "B6 the stack grew on a repeat push" "it can grow without bound"

  s goto appearance.bar >/dev/null; sleep 1
  [[ $(s back) == appearance ]] && [[ $(s back) == root ]] \
    && ok "B2 back pops one page at a time" \
    || no "B2 back did not walk the stack" "landed on $(s page)"

  [[ $(s back) == closed ]] \
    && ok "B2 back at the root closes Settings" \
    || no "B2 back at the root did not close" "state=$(s state)"

  # The gesture layer must not close the app underneath. It asks the overlay
  # first, and only closes the surface when the overlay says it is done.
  wins() { swaymsg -t get_tree 2>/dev/null | jq '[recurse(.nodes[]?,.floating_nodes[]?)|select(.app_id)]|length'; }
  s open >/dev/null; sleep 2; s goto appearance >/dev/null; sleep 1
  w0=$(wins)

  # Put the keyboard down first, and allow more than one gesture. performBack
  # takes the keyboard branch whenever its probe has not answered yet -- that is
  # deliberate, because hiding the keyboard is the reversible outcome and acting
  # on a stale answer once closed an app while the keyboard was plainly up. The
  # cost is that the first back after a shell restart is consumed by the probe,
  # so a single-shot assertion here fails on timing rather than on behaviour.
  busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 \
         SetVisible b false >/dev/null 2>&1
  sleep 2
  for _ in 1 2 3; do
    [[ $(s page) == root ]] && break
    timeout 5 omarchy-shell gestures back >/dev/null 2>&1
    sleep 2
  done
  w1=$(wins)

  if [[ $(s page) == root && $(s state) == open && $w0 == "$w1" ]]; then
    ok "B3 the back gesture pops a page, stays open, and closes no app"
  else
    no "B3 back over Settings did the wrong thing" \
       "page=$(s page) state=$(s state) windows $w0 -> $w1; expected page=root state=open"
  fi

  # --- B8. a page whose rows are all hidden is unreachable -----------------
  s openAt apps.default >/dev/null; sleep 2
  vis=$(s rows | awk -F'\t' '$4=="1"' | wc -l)
  (( vis > 0 )) \
    && ok "B8 Default apps has $vis visible row(s)" \
    || no "B8 every row on apps.default is hidden" "its parent row should hide too"

  # --- F8. and the row that opens it hides with it ---------------------------
  # B8 above says a page of hidden rows is unreachable. F8 is the other half,
  # and the page it was written for has stopped being an instance of it: AI
  # agent's nine rows guarded on nine agents none of which shipped, so the row
  # carried the disjunction of those nine guards -- and that hid the only screen
  # that can install one. Both guards are gone (docs/settings.md D8, F8).
  #
  # So the check is static, and it has to be. A runtime read cannot tell an
  # absent guard from a guard that happens to pass, and with ~/.local/bin/grok
  # written by moarchy-user-setup it always passes -- the old check would go
  # green on the guard's return, which is the one thing it is now here to catch.
  f8_bad=$(python3 - "$(plugin_dir moarchy.settings)/Pages.js" <<'F8PY'
import sys

lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
bad = []

# The page: from its declaration to the `]},` that closes it.
start = next((i for i, l in enumerate(lines)
              if l.startswith('"apps.default.agent": {')), None)
if start is None:
    bad.append("no apps.default.agent page in Pages.js")
else:
    end = next(i for i in range(start, len(lines)) if lines[i].startswith("]},"))
    guarded = [i + 1 for i in range(start, end) if "when:" in lines[i]]
    if guarded:
        bad.append("apps.default.agent is guarded again at line(s) "
                   + ", ".join(map(str, guarded)))

# The nav row: line-based, because `covers: { ... }` closes a brace of its own
# and a non-greedy match for the row's end stops inside it.
nav = next((i for i, l in enumerate(lines)
            if 'id: "agent", type: "nav"' in l), None)
if nav is None:
    bad.append("no agent nav row in Pages.js")
else:
    tail = next(i for i in range(nav, len(lines))
                if '"setup.default.agent"' in lines[i])
    if any("when:" in l for l in lines[nav:tail + 1]):
        bad.append("the agent nav row is guarded again")

print("; ".join(bad))
F8PY
)
  [[ -z $f8_bad ]] \
    && ok "F8 the AI agent page and the row that opens it carry no presence guard" \
    || no "F8 $f8_bad" \
          "guarding an installer on what it installs hides the only screen that could install it"

  # --- B9. opening *at* a page does not paint the last page's rows -----------
  # push() and pop() clear the read state through afterPageChange(); open() did
  # not, so an openAt onto a provider page showed whatever the previous provider
  # page had built. Reminders first, because it is the provider page that was
  # showing up under other headers.
  s openAt tools.reminders >/dev/null; sleep 2
  s close >/dev/null; sleep 1
  s openAt appearance.font >/dev/null; sleep 2
  b9_rows=$(s rows | awk -F'\t' '{print $1}' | tr '\n' ' ')
  if [[ $b9_rows == *none* ]]; then
    no "B9 openAt appearance.font painted the reminders page's rows" \
       "rows: $b9_rows -- open() must clear dynamicRows/dynamicLoaded"
  else
    ok "B9 openAt onto a provider page reads that page's own provider"
  fi

  # --- D7. a provider page ticks its current value ---------------------------
  # The rows are paths, so the reader has to answer a path. It answered a
  # prettified name, matched nothing, and the page showed every wallpaper with
  # none of them current -- D2 correct, and useless.
  s openAt appearance.background >/dev/null; sleep 2
  bg_checked=$(s rows | awk -F'\t' '$5=="1"' | wc -l)
  [[ $bg_checked -eq 1 ]] \
    && ok "D7 the wallpaper page ticks exactly one row" \
    || no "D7 the wallpaper page ticks $bg_checked rows" \
          "the reader answers $(s value); the rows carry paths"

  # The other half: a reader may name something the provider's list omits, and
  # the font in use is exactly that -- fc-match falls back to a family
  # fc-list :spacing=100 does not report.
  s openAt appearance.font >/dev/null; sleep 2
  want_font=$(omarchy-font-current)
  s rows | awk -F'\t' -v f="$want_font" '$3==f' | grep -q . \
    && ok "D7 the font page lists the font actually in use ($want_font)" \
    || no "D7 the font page does not list $want_font" \
          "omarchy-font-list omits it, so the page must carry the current value"

  # --- I6. a detail line is one value ---------------------------------------
  # omarchy-network-status answers four tab-separated fields. Unsplit, they all
  # landed in the detail *and* shifted every column of this very TSV after it.
  i6_bad=""
  for pg in net root appearance apps.default system.time tools; do
    s openAt "$pg" >/dev/null; sleep 1.5
    while IFS= read -r line; do
      [[ $(awk -F'\t' '{print NF}' <<<"$line") -gt 7 ]] && i6_bad="$i6_bad $pg/$(cut -f1 <<<"$line")"
    done < <(s rows)
  done
  [[ -z $i6_bad ]] \
    && ok "I6 every detail line is a single value" \
    || no "I6 a detail carries tabs:$i6_bad" \
          "a detailCmd that prints a record puts the whole record in the row"

  # --- E9. a bridged command that resolves and still does nothing ------------
  # E3 checks the first word is on PATH. These two were, and neither worked:
  # omarchy-version reads `pacman -Q omarchy` on an image that installs
  # omarchy-config, and omarchy-theme-bg-install ends in nautilus.
  if ver=$(omarchy-version 2>/dev/null) && [[ -n $ver ]]; then
    ok "E9 omarchy-version answers on this image ($ver)"
  else
    no "E9 omarchy-version prints nothing" \
       "About phone's headline row is blank; the image installs omarchy-config"
  fi
  bg_install=$(command -v omarchy-theme-bg-install 2>/dev/null || true)
  [[ $bg_install == "$MOARCHY_BIN"/* ]] \
    && ok "E9 omarchy-theme-bg-install is shimmed, not upstream's nautilus" \
    || no "E9 omarchy-theme-bg-install resolves to ${bg_install:-nothing}" \
          "upstream's ends in nautilus, which is not in the base set"

  # --- C. switches ----------------------------------------------------------
  s openAt appearance.bar >/dev/null; sleep 2
  live=$(s value battery)
  flag_now() { omarchy-toggle-enabled battery-percentage-off && echo off || echo on; }
  [[ $live == "$(flag_now)" ]] \
    && ok "C1/C2 the battery switch reads the flag, inverted correctly" \
    || no "C1/C2 switch says '$live', flag says '$(flag_now)'" \
          "battery-percentage-off is negative polarity: the file existing means the percentage is OFF"

  # C4. The half nobody was checking. Both of this page's switches wrote their
  # flag and then told `omarchy.bar` -- upstream's plugin id, not the bar this
  # phone loads -- to re-read it, behind a `-q` that turns "Target not found"
  # into exit 0. Every check that read the flag or the row was green while the
  # screen never changed, which is why this one asks the bar what it is drawing.
  s set battery off >/dev/null; sleep 3
  pct_off=$(timeout 5 omarchy-shell bar metrics 2>/dev/null | sed -n 's/.*pct=\([a-z]*\).*/\1/p')
  [[ $(s value battery) == off ]] \
    && ok "C3 the switch re-reads itself after a write" \
    || no "C3 the switch did not follow its own write" "value=$(s value battery)"
  s set battery on >/dev/null; sleep 3       # restore
  pct_on=$(timeout 5 omarchy-shell bar metrics 2>/dev/null | sed -n 's/.*pct=\([a-z]*\).*/\1/p')
  [[ $(s value battery) == on ]] && ok "C3 the percentage came back" \
                                || no "C3 the switch did not come back" "value=$(s value battery)"
  if [[ $pct_off == off && $pct_on == on ]]; then
    ok "C4 the switch reaches the bar, not just the flag"
  else
    no "C4 the bar drew pct=${pct_off:-?} with the switch off and pct=${pct_on:-?} with it on" \
       "the write must name a target the shell answers to: omarchy-shell -q bar syncFlags"
  fi

  # C4, the other path. The bar watches the toggles directory as well, so a flag
  # flipped by anything at all lands without an IPC call -- which is what keeps
  # this working if the nudge is ever misnamed again.
  omarchy-toggle battery-percentage-off on; sleep 3
  pct_watch=$(timeout 5 omarchy-shell bar metrics 2>/dev/null | sed -n 's/.*pct=\([a-z]*\).*/\1/p')
  omarchy-toggle battery-percentage-off off; sleep 3
  [[ $pct_watch == off ]] \
    && ok "C4 the toggles-directory watch applies a flag nobody announced" \
    || no "C4 a flag flipped by omarchy-toggle alone left the bar at pct=${pct_watch:-?}" \
          "the FileView on the toggles dir is the path that does not depend on the caller"

  # C4a. The Show status bar row and everything behind it. Three absences, and
  # each one on its own would leave the feature half alive: the row could come
  # back, the bar could go on reading a flag no UI writes, or the keybinding
  # could hide a bar with no switch to bring it back.
  barqml="$(plugin_dir moarchy.bar)/Bar.qml"
  c4a=""
  s rows | awk -F'\t' '$1=="show"' | grep -q . && c4a="$c4a a 'show' row"
  if [[ -f $barqml ]]; then
    # Comments stripped first, the way D8 does it below: this file explains at
    # length why the flag is not read any more, and a check that counted its own
    # explanation would fail on the sentence describing the absence.
    grep -vE '^[[:space:]]*//' "$barqml" | grep -q 'bar-off' \
      && c4a="$c4a a bar-off read in Bar.qml"
  else
    c4a="$c4a no Bar.qml at $barqml"
  fi
  command -v moarchy-toggle-bar >/dev/null 2>&1 && c4a="$c4a moarchy-toggle-bar on PATH"
  [[ -z $c4a ]] \
    && ok "C4a nothing hides the status bar: no row, no flag read, no command" \
    || no "C4a the bar is still hideable --$c4a" \
          "it never worked and the shade owns the top edge either way; settings.md C4a"

  # C6. Both halves of the transparency switch have to stay gone: the row that
  # wrote the flag, and the bar function that shelled out to `omarchy-bar`. That
  # command ends in a config reload, and the reload leaves upstream's omarchy.bar
  # drawing in place of ours until the shell is restarted -- so the switch cost
  # the phone its status bar every time it was tapped.
  #
  # Asserted, not exercised: calling toggleBarTransparency to watch it answer
  # "no-bar" would take the bar down on the way past if the function ever came
  # back. The file test is the point -- a grep that cannot find the file would
  # otherwise pass while measuring nothing.
  barqml="$(plugin_dir moarchy.bar)/Bar.qml"
  trow=$(s rows | awk -F'\t' '$1=="transparent"' | wc -l)
  if [[ ! -f $barqml ]]; then
    no "C6 $barqml is not there" "the bar plugin is not installed; C6 proves nothing"
  elif (( trow == 0 )) && ! grep -q "function toggleTransparency" "$barqml"; then
    ok "C6 no transparency row, and no toggleTransparency for the IPC to find"
  else
    no "C6 transparency is reachable again (rows=$trow)" \
       "omarchy-bar's config reload hands the screen back to upstream's bar"
  fi

  # --- D. choices -----------------------------------------------------------
  s openAt net.dns >/dev/null; sleep 2
  ticked=$(s rows | awk -F'\t' '$5=="1"' | wc -l)
  current=$(omarchy-dns 2>/dev/null)
  if (( ticked == 1 )); then
    ok "D1 exactly one DNS row is ticked ($current)"
  elif (( ticked == 0 )) && ! printf 'DHCP\nCloudflare\nGoogle\nCustom\n' | grep -qx "$current"; then
    ok "D2 the reader says '$current', which no row declares, so nothing is ticked"
  else
    no "D1/D2 $ticked rows ticked, omarchy-dns says '$current'" \
       "one row must tick, or none when the reader names something unlisted"
  fi

  s openAt net >/dev/null; sleep 2
  [[ $(s rows | awk -F'\t' '$1=="dns"{print $6}') == "$current" ]] \
    && ok "D5 the parent row shows the current value" \
    || no "D5 the DNS row's detail is not the current value" "expected $current"

  # --- D8. a choice whose write opens a terminal hides Settings first --------
  # Static, and for a harder reason than F8's: proving it at runtime means
  # activating an agent row for real, and that installs an agent. `hides` is a
  # row property rather than a page one, so the check is both halves -- every
  # agent row carries it, and no other choice row in the model does, because a
  # choice that writes a file has nothing to uncover and should stay on screen.
  d8_bad=$(python3 - "$(plugin_dir moarchy.settings)/Pages.js" <<'D8PY'
import re, sys

lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
bad = []

start = next((i for i, l in enumerate(lines)
              if l.startswith('"apps.default.agent": {')), None)
if start is None:
    bad.append("no apps.default.agent page in Pages.js")
    end = -1
else:
    end = next(i for i in range(start, len(lines)) if lines[i].startswith("]},"))
    missing = [re.search(r'id: "([^"]+)"', l).group(1)
               for l in lines[start:end]
               if 'type: "choice"' in l and "hides:" not in l]
    if missing:
        bad.append("agent rows with no hides: " + " ".join(missing))

stray = [re.search(r'id: "([^"]+)"', l).group(1)
         for i, l in enumerate(lines)
         if 'type: "choice"' in l and "hides:" in l and not (start <= i < end)]
if stray:
    bad.append("hides on a choice row off the agent page: " + " ".join(stray))

print("; ".join(bad))
D8PY
)
  [[ -z $d8_bad ]] \
    && ok "D8 every agent row hides Settings before its write, and no other choice does" \
    || no "D8 $d8_bad" \
          "a terminal mapped under a full-screen layer surface looks like a tap that did nothing"

  # --- E. bridged launches --------------------------------------------------
  plug_pages="$(plugin_dir moarchy.settings)/Pages.js"

  # `emoji`, not `screensaver`: that row was dropped on 2026-09-07 because
  # omarchy-launch-screensaver opens with `omarchy-cmd-missing ttfx && exit 1`
  # and ttfx has no aarch64 build. `activate` on a row that is not there does
  # nothing at all, so lastLaunch kept whatever block C left in it and E1 failed
  # reading a command block C had run -- a deleted row and a broken activate with
  # the same symptom. Hence the existence test first: it separates the two, and
  # without it this check reports on the wrong one.
  s dryRun 1 >/dev/null
  s openAt tools >/dev/null; sleep 2
  if ! s rows | awk -F'\t' '$1=="emoji"' | grep -q .; then
    no "E1 there is no 'emoji' row on the tools page" \
       "the row moved or was dropped; activate would record nothing and E1 would blame the bridge"
  else
    s activate emoji >/dev/null; sleep 1
    [[ $(s lastLaunch) == "omarchy-menu-emoji" ]] \
      && ok "E1 a bridged row records its command and runs nothing" \
      || no "E1 lastLaunch was '$(s lastLaunch)'" "expected: omarchy-menu-emoji"
  fi
  s dryRun 0 >/dev/null

  missing=""
  for shim in omarchy-launch-floating-terminal-with-presentation \
              omarchy-launch-config-editor omarchy-launch-webapp; do
    p=$(command -v "$shim" 2>/dev/null)
    [[ $p == "$MOARCHY_BIN/"* ]] || missing="$missing $shim"
  done
  [[ -z $missing ]] \
    && ok "E4 the bridge shims shadow upstream" \
    || no "E4 upstream wins for:$missing" "our bin/ must come first on PATH"

  # E3. Every command any row names, resolved under the shell's own PATH. A row
  # whose command is missing does not fail loudly: a switch reads "off" from the
  # 127, a choice page ticks nothing, and an action opens a terminal that closes
  # immediately. Parsed out of the model rather than listed here, so a row added
  # later is checked without anyone remembering to add it.
  unresolved=$(python3 - "$plug_pages" <<'CMDS'
import re, sys, shutil
src = open(sys.argv[1], encoding="utf-8").read()
words = set()
for field in ("run", "write", "read", "on", "off", "detailCmd", "reader", "list", "json", "text"):
    for m in re.finditer(field + r': "((?:[^"\\]|\\.)*)"', src):
        expr = m.group(1)
        for part in re.split(r'[;|]|&&|\|\|', expr):
            part = part.strip()
            if not part or part[0] in "[!(":
                continue
            w = re.split(r'\s+', part)[0]
            if re.fullmatch(r'[a-z][a-z0-9._-]*', w):
                words.add(w)
print(" ".join(sorted(w for w in words if not shutil.which(w))))
CMDS
)
  [[ -z $unresolved ]] \
    && ok "E3 every command the model names resolves on PATH" \
    || no "E3 commands that do not resolve: $unresolved" \
          "those rows will read as off, tick nothing, or open and close"

  # I5. A shell whose PATH lost our bin runs every row's command as 127,
  # and every switch then reads "off" from an error rather than from a state.
  shell_pid=$(pgrep -x quickshell | head -1)
  shell_path=$(tr '\0' '\n' < "/proc/$shell_pid/environ" 2>/dev/null | sed -n 's/^PATH=//p')
  case ":$shell_path:" in
    *":$MOARCHY_BIN:"*) ok "I5 the shell's PATH carries our bin" ;;
    *) no "I5 the shell's PATH is missing $MOARCHY_BIN" \
          "every bridged row would open nothing" ;;
  esac

  # --- G. coverage parity ---------------------------------------------------
  cov=$(s coverage)
  menu="$OMARCHY_PATH/default/omarchy/omarchy-menu.jsonc"

  # python3, not sed+jq. The trailing comma this file is allowed to carry sits
  # on the line *before* its closing brace, so a line-based strip leaves it and
  # jq refuses the whole document -- which would have read as "upstream has no
  # entries" and quietly passed every comparison below.
  upstream=$(python3 - "$menu" <<'JSONC'
import json, re, sys
raw = open(sys.argv[1]).read()
raw = re.sub(r'^\s*//[^\n]*$', '', raw, flags=re.M)
raw = re.sub(r',(\s*[}\]])', r'\1', raw)
print("\n".join(sorted(json.loads(raw).keys())))
JSONC
)
  if [[ -z $upstream ]]; then
    no "the upstream menu file could not be parsed" "expected at $menu"
  fi
  covered=$(cut -f1 <<<"$cov" | sort)

  n_dup=$(cut -f1 <<<"$cov" | sort | uniq -d | wc -l)
  (( n_dup == 0 )) \
    && ok "G2 no upstream id is claimed twice" \
    || no "G2 $n_dup id(s) claimed by more than one row" "$(cut -f1 <<<"$cov" | sort | uniq -d | tr '\n' ' ')"

  stray=$(comm -23 <(echo "$covered") <(echo "$upstream"))
  [[ -z $stray ]] \
    && ok "G1 every id claimed exists upstream" \
    || no "G1 claimed but not in omarchy-menu.jsonc" "$(tr '\n' ' ' <<<"$stray")"

  classes=$(cut -f2 <<<"$cov" | sort -u | tr '\n' ' ')
  [[ $classes == "Bridged Native Shade " ]] \
    && ok "G3 every class is one of the three renderable words" \
    || no "G3 classes are: $classes" "Unsupported must never reach a row"

  # G6. The doc is the record; the code is the truth. They must agree.
  # Defaulted, not assumed: this script runs under `set -u`, so a bare
  # $MOARCHY_PATH would abort the whole suite rather than fail one check,
  # and it is not exported by the session -- only PATH carries it.
  doc="$MOARCHY_ROOT/docs/menu-coverage.md"
  if [[ -f $doc ]]; then
    doc_nb=$(python3 - "$doc" <<'DOCTBL'
import re, sys
out = []
for line in open(sys.argv[1]):
    m = re.match(r'^\| `([^`]+)` \| [^|]* \| (Native|Bridged|Shade) \|', line)
    if m:
        out.append(m.group(1) + "\t" + m.group(2))
print("\n".join(sorted(out)))
DOCTBL
)
    code_nb=$(cut -f1,2 <<<"$cov" | sort)
    if diff -q <(echo "$doc_nb") <(echo "$code_nb") >/dev/null; then
      ok "G6 docs/menu-coverage.md and Pages.js agree ($(wc -l <<<"$code_nb") ids)"
    else
      no "G6 the doc and the code disagree" \
         "$(diff <(echo "$doc_nb") <(echo "$code_nb") | head -4 | tr '\n' ' ')"
    fi
  else
    # Not a failure of the phone: the moarchy package ships bin/, default/ and
    # config/ and no docs at all, so on a device this file is never there. G6
    # is a repo invariant -- doc against code -- and it runs where the repo is,
    # with MOARCHY_ROOT pointed at a checkout. Reported as absent rather than
    # as broken, so the red lines stay ones somebody can act on.
    skip_ "G6 skipped: no docs/ in the moarchy package, so $doc cannot exist here"
  fi

  # G5/H2. Everything upstream ships is accounted for: rendered, or recorded as
  # a shade control, or classified Unsupported in the doc and therefore absent.
  n_up=$(wc -l <<<"$upstream")
  n_cov=$(wc -l <<<"$covered")
  # Anchored to an entry row -- a bare '| Unsupported |' also matches the
  # totals table at the top of the doc, which counted 179 of 178.
  # And skipped off a checkout for the same reason G6 is: the Unsupported half of
  # the answer lives only in the doc, so on a device this counted 137 + 0 against
  # 320 and was red every run. A check that cannot pass where it runs teaches
  # people to read past red.
  if [[ -f $doc ]]; then
    n_unsup=$(grep -cE '^\| `[^`]+` \|.*\| Unsupported \|' "$doc" 2>/dev/null || echo 0)
    (( n_cov + n_unsup == n_up )) \
      && ok "G5 all $n_up upstream entries are accounted for ($n_cov live, $n_unsup dropped)" \
      || no "G5 $n_cov live + $n_unsup dropped != $n_up upstream" "something is unclassified"
  else
    skip_ "G5 skipped: the Unsupported entries live in $doc, which is not packaged"
  fi

  # G7. The split the design committed to. A drift here is not a failure on its
  # own -- rows move -- but it should be a deliberate edit to the doc, not a
  # surprise.
  totals=$(cut -f2 <<<"$cov" | sort | uniq -c | awk '{printf "%s=%s ", $2, $1}')
  # 74/65 until 2026-09-07, and wrong from `1b01e5c` onward: that commit dropped
  # three bridged rows and left this number where it was, so G7 was red about a
  # constant rather than about coverage. 68/68 after the three trigger.reminder.*
  # ids became Native (docs/settings.md J), then 64/72 as update.timezone, the two
  # setup.plugin toggles and about followed them (L, M, N), then 58/70 when the
  # eight branding ids left for Unsupported, then 58/69 when trigger.toggle.top-bar
  # followed them: the Show status bar row is gone (docs/settings.md C4a).
  [[ $totals == "Bridged=58 Native=69 Shade=1 " ]] \
    && ok "G7 the class totals are the ones committed to ($totals)" \
    || no "G7 the class totals moved: $totals" \
          "expected Bridged=58 Native=69 Shade=1; update docs/settings.md if deliberate"

  grep -q '^trigger.toggle.notifications	Shade' <<<"$cov" \
    && ok "H2 the shade-owned toggle is recorded, not rendered" \
    || no "H2 trigger.toggle.notifications is not recorded as Shade" ""

  # --- I. robustness --------------------------------------------------------
  plug="$(plugin_dir moarchy.settings)"

  # I2. The existing icon check catches a *truncated* glyph. It cannot catch a
  # glyph that is gone: every icon in omarchy-menu.jsonc below U+FFFF is three
  # bytes of UTF-8, and 55 of them were silently eaten writing Pages.js through
  # a shell heredoc. An empty string is a legal QML literal and renders as a row
  # with no icon and a label that sits where the icon should have been -- which
  # looks like a deliberate design, not a defect. Choice rows carry no glyph by
  # design; everything else must have exactly one character.
  noicon=$(python3 - "$plug/Pages.js" <<'ICONS'
import re, sys
# Line-based on purpose. A row object can span several lines and can contain a
# nested `covers: { ... }`, so a brace-matching regex silently skips exactly the
# rows that have coverage -- it found 6 of 55 when tested against a simulated
# loss. Every glyph literal is on one line, and a choice row carries no glyph
# key at all, so any `glyph: ""` is a fault and so is any glyph of length != 1.
bad = []
for n, line in enumerate(open(sys.argv[1], encoding="utf-8"), 1):
    m = re.search(r'glyph: "([^"]*)"', line)
    if not m:
        continue
    if len(m.group(1)) != 1:
        rid = re.search(r'id: "([^"]+)"', line)
        bad.append(f"{rid.group(1) if rid else 'line' + str(n)}={m.group(1)!r}")
print(" ".join(bad))
ICONS
)
  [[ -z $noicon ]] \
    && ok "I2 every non-choice row carries exactly one icon character" \
    || no "I2 rows with a missing or truncated glyph: $noicon" \
          "a 3-byte glyph does not survive a shell heredoc; write Pages.js with a file write"

  bad=$(grep -nE '(readonly +)?property[^:]*\bon[A-Z]' "$plug"/*.qml "$plug"/*.js 2>/dev/null)
  [[ -z $bad ]] \
    && ok "I3 no property is named on<Uppercase>" \
    || no "I3 a property uses the reserved on<Uppercase> prefix" \
          "it reads back undefined, and undefined as a color is black: $bad"


  # --- J. reminders ---------------------------------------------------------
  #
  # The one destructive block in this suite: it sets reminders and clears them,
  # so anything pending is gone when it finishes. There is no way to put a
  # transient systemd timer back with the time it had left, so the choice was
  # between saying so and not testing the screen at all.
  if ! command -v moarchy-reminders >/dev/null 2>&1; then
    no "J moarchy-reminders is not on PATH" \
       "every row on the Reminders page names it; check $MOARCHY_BIN"
  else
    # `grep -c .`, not `wc -l`: an empty string is one line to wc, so an empty
    # list would count as one reminder and J2 would pass on the wrong evidence.
    rrows()   { s rows | awk -F'\t' '$1 ~ /^r-/'; }
    n_rrows() { rrows | grep -c . ; }
    # -1 for an unreadable answer, never 0. `jq -r .count` on empty input
    # prints nothing and exits 0, and bash reads "" as 0 inside `[[ -eq ]]` --
    # so with omarchy-reminder missing, "no rows and no timers" would agree
    # with itself and every count check below would pass while measuring
    # nothing. -1 cannot equal a row count, so it fails out loud instead.
    n_timers() {
      local n
      n=$(omarchy-reminder show --json 2>/dev/null | jq -r .count 2>/dev/null)
      [[ $n =~ ^[0-9]+$ ]] || n=-1
      echo "$n"
    }

    # Notifications posted since a marker file was touched.
    #
    # Three shapes were tried before this one, and the first two could not
    # fail. `omarchy-shell shade notifications` answered zero lines on a phone
    # whose store held ten. A count of the store does not move, because it is
    # capped. And the newest name does not reliably move either -- the store
    # prunes, and an entry newer than the ones kept was observed disappearing
    # from it. `find -newer` asks the only question that matters, and survives
    # both the cap and the pruning.
    notes_dir="$HOME/.local/state/omarchy/notifications/history"
    marker=$(mktemp)
    notes_since() { find "$notes_dir" -name '*.json' -newer "$marker" 2>/dev/null | grep -c . ; }

    # Ten seconds, and it is not padding. The store is written when a toast
    # leaves the screen, not when it is posted: measured on the device, a
    # notification sent at t=0 first appears in the history between t=4s and
    # t=6s. At the three seconds this had, the control saw nothing and J1
    # skipped itself every run.
    notes_settle=10

    # The control. Clearing announces itself, so a detector that sees nothing
    # here is blind, and its silence over the page open below means nothing.
    touch "$marker"; sleep 1
    omarchy-reminder clear >/dev/null 2>&1
    sleep $notes_settle
    notes_control=$(notes_since)

    touch "$marker"; sleep 1
    s openAt tools.reminders >/dev/null; sleep $notes_settle
    notes_opened=$(notes_since)

    # J2. Empty says so.
    if [[ $(n_rrows) -eq 0 ]] && s rows | awk -F'\t' '$2=="info"' | grep -q .; then
      ok "J2 an empty Reminders page says there are none"
    else
      no "J2 the empty page has $(n_rrows) reminder row(s) and no info row" \
         "$(s rows | tr '\t' ' ' | tr '\n' '|')"
    fi

    # J1. Opening the list announced nothing -- upstream's `show` is a
    # notification and nothing else, which is the half of this that was broken.
    #
    # The clear above is the control. It posts "All reminders have been
    # cleared", so if `newest_note` did not move across it then this detector
    # is blind and its silence afterwards means nothing. Say so instead of
    # passing on it.
    if (( notes_control == 0 )); then
      skip_ "J1 skipped: the store recorded nothing for a clear, so silence proves nothing"
    elif (( notes_opened == 0 )); then
      ok "J1 opening Reminders posts no notification"
    else
      no "J1 opening Reminders posted $notes_opened notification(s)" \
         "the page is the list; it must not announce itself"
    fi
    rm -f "$marker"

    # J5. Nothing to clear, so no Clear all.
    [[ $(s guards | awk -F'\t' '$1=="clear"{print $2}') == 0 ]] \
      && ok "J5 Clear all is hidden when there is nothing to clear" \
      || no "J5 Clear all is offered with no reminders set" "it would be a no-op"

    # Set a field and prove it took, with one retry.
    #
    # `s` is `timeout 5 omarchy-shell`, and on a loaded phone a call does get
    # dropped: one lost `set message` made J9 read the previous row's command
    # and J10 read the previous run's message, two failures that looked like
    # bugs in rows that were fine. A check whose precondition silently did not
    # happen is worse than one that did not run.
    set_field() {
      local id=$1 want=$2
      s set "$id" "$want" >/dev/null
      [[ $(s value "$id") == "$want" ]] && return 0
      s set "$id" "$want" >/dev/null
      [[ $(s value "$id") == "$want" ]]
    }

    # Same for a row: `activate` answers ok, hidden, not ready or unknown row,
    # and only the first means the command was recorded. The answer is kept in
    # a variable rather than re-read in the failure message, which would
    # activate the row a second time to find out why the first one did not.
    activate_answer=""
    activated() { activate_answer=$(s activate "$1"); [[ $activate_answer == "ok" ]]; }

    # dryRun for the next three, so a check interrupted halfway does not leave
    # the phone holding timers nobody asked for -- and read back, because when
    # this call is the one that gets dropped the run does the opposite of what
    # it says: the rows really fire, `back: true` pops the page, and the next
    # `activate` answers "unknown row". That was a red J9 that had nothing to do
    # with J9.
    s goto tools.reminders.new >/dev/null; sleep 2
    set_dry() {
      s dryRun "$1" >/dev/null
      [[ $(s dryRunState) == "$1" ]] && return 0
      s dryRun "$1" >/dev/null
      [[ $(s dryRunState) == "$1" ]]
    }
    if ! set_dry 1; then
      no "J7/J8/J9 dry run would not turn on" \
         "dryRunState=[$(s dryRunState)]; the three checks below would have set real timers"
    else
      # J8. As the page arrives, before anything is typed. The empty state is
      # reached by entering the screen rather than by writing "" into the field:
      # that is the state a user actually meets, and it does not rest on the IPC
      # being able to carry an empty argument.
      before=$(s lastLaunch)
      answer=$(s activate custom)
      enabled=$(s rows | awk -F'\t' '$1=="custom"{print $7}')
      if [[ $answer == "not ready" && $enabled == 0 && $(s lastLaunch) == "$before" ]]; then
        ok "J8 Set reminder is inert and dimmed until a duration is typed"
      else
        no "J8 activate answered '$answer' with enabled=$enabled" \
           "an empty duration must not be submittable"
      fi

      # J7/J9. What the rows would run, without running it.
      if ! set_field message 'Check the oven' || ! set_field minutes 25; then
        no "J7/J9 the fields would not take a value over IPC" \
           "message=[$(s value message)] minutes=[$(s value minutes)]; nothing below was measured"
      else
        if ! activated custom; then
          no "J7 activate custom answered '$activate_answer'" "with both fields set it must run"
        else
          [[ $(s lastLaunch) == "moarchy-reminders set '25' 'Check the oven'" ]] \
            && ok "J7 the custom row carries both fields" \
            || no "J7 the custom row would run: $(s lastLaunch)" \
                  "expected moarchy-reminders set '25' 'Check the oven'"
        fi

        if ! activated m15; then
          no "J9 activate m15 answered '$activate_answer'" "the preset row must be reachable"
        else
          [[ $(s lastLaunch) == "moarchy-reminders set 15 'Check the oven'" ]] \
            && ok "J9 a preset carries the typed message" \
            || no "J9 the 15-minute row would run: $(s lastLaunch)" \
                  "expected moarchy-reminders set 15 'Check the oven'"
        fi
      fi

    fi

    set_dry 0 || s dryRun 0 >/dev/null

    # J3/J6/J10. Actually set one, from the fields.
    if ! set_field message 'Selftest tea' || ! set_field minutes 9; then
      no "J3/J10 the fields would not take a value over IPC" \
         "message=[$(s value message)] minutes=[$(s value minutes)]"
    fi
    s activate custom >/dev/null; sleep 3
    page=$(s page)
    if [[ $page == tools.reminders && $(n_rrows) -eq 1 && $(s state) == open ]]; then
      ok "J3 a reminder set on the Set screen is on the list, with Settings still up"
    else
      no "J3 landed on $page with $(n_rrows) row(s), state=$(s state)" \
         "expected tools.reminders, 1 row, open"
    fi

    [[ $(s rows | awk -F'\t' '$1 ~ /^r-/{print $3}') == "Selftest tea" ]] \
      && ok "J10 a reminder with a message is listed by its message" \
      || no "J10 the row is labelled '$(s rows | awk -F'\t' '$1 ~ /^r-/{print $3}')'" \
            "expected the message that was typed"

    # J1. The page and the timers agree.
    [[ $(n_rrows) -eq $(n_timers) ]] \
      && ok "J1 the page lists exactly the live timers ($(n_timers))" \
      || no "J1 the page shows $(n_rrows) row(s) against $(n_timers) timer(s)" \
            "the list is read from omarchy-reminder, not remembered"

    # J12. The fields did not survive the screen.
    s goto tools.reminders.new >/dev/null; sleep 2
    [[ -z $(s value message) && -z $(s value minutes) ]] \
      && ok "J12 the fields start empty on every visit" \
      || no "J12 the fields came back holding '$(s value message)' / '$(s value minutes)'" \
            "yesterday's message must not reach today's timer"
    s back >/dev/null; sleep 2

    # J13. A reminder set from outside shows up on a refresh.
    omarchy-reminder 11 >/dev/null 2>&1
    s refresh >/dev/null; sleep 2
    [[ $(n_rrows) -eq 2 ]] \
      && ok "J13 a reminder set from a terminal appears on refresh" \
      || no "J13 the page shows $(n_rrows) row(s) after one was set outside" \
            "the list must be read, not remembered"

    # J10 again, the other half: no message means the duration.
    s rows | awk -F'\t' '$1 ~ /^r-/{print $3}' | grep -q '^11-min reminder$' \
      && ok "J10 a reminder with no message is listed by its duration" \
      || no "J10 no row is labelled '11-min reminder'" \
            "$(s rows | awk -F'\t' '$1 ~ /^r-/{print $3}' | tr '\n' '|')"

    # J4. Cancelling one asks first, and the question can be declined.
    rid=$(s rows | awk -F'\t' '$1 ~ /^r-/{print $1; exit}')
    s activate "$rid" >/dev/null
    if [[ -n $(s confirmText) && $(n_timers) -eq 2 ]]; then
      ok "J4 cancelling one reminder asks before it acts"
    else
      no "J4 confirmText='$(s confirmText)' with $(n_timers) timer(s) left" \
         "the question must be asked and the timer must survive it"
    fi
    s back >/dev/null; sleep 1
    [[ -z $(s confirmText) && $(n_timers) -eq 2 ]] \
      && ok "J4 declining leaves the timer running" \
      || no "J4 declining left confirmText='$(s confirmText)', $(n_timers) timer(s)" \
            "back must dismiss the sheet and change nothing"

    s activate "$rid" >/dev/null
    s confirm >/dev/null; sleep 3
    if [[ $(n_timers) -eq 1 && $(n_rrows) -eq 1 && $(s state) == open ]]; then
      ok "J4 confirming cancels exactly that reminder"
    else
      no "J4 $(n_timers) timer(s) and $(n_rrows) row(s) left, state=$(s state)" \
         "one reminder should be gone and Settings should still be up"
    fi

    # J5/J6. Clear all appears, asks, empties, and leaves the screen up.
    [[ $(s guards | awk -F'\t' '$1=="clear"{print $2}') == 1 ]] \
      && ok "J5 Clear all is offered once there is something to clear" \
      || no "J5 Clear all is hidden with $(n_timers) reminder(s) set" "its guard is wrong"

    launch_before=$(s lastLaunch)
    s activate clear >/dev/null
    if [[ -n $(s confirmText) && $(s lastLaunch) == "$launch_before" ]]; then
      ok "J5 Clear all asks first, and runs nothing until it is answered"
    else
      no "J5 confirmText='$(s confirmText)', lastLaunch='$(s lastLaunch)'" \
         "arming the question must not also run the command"
    fi
    s confirm >/dev/null; sleep 3
    if [[ $(n_timers) -eq 0 && $(n_rrows) -eq 0 && $(s state) == open ]]; then
      ok "J5 Clear all empties the list and leaves Settings up"
    else
      no "J5 $(n_timers) timer(s), $(n_rrows) row(s), state=$(s state)" \
         "expected none, none, open"
    fi

    # J6. Nothing on these pages went through a terminal or a vendored picker.
    case $(s lastLaunch) in
    omarchy-launch-*|*omarchy.reminders*)
      no "J6 a reminder row launched '$(s lastLaunch)'" \
         "these pages run their commands in place" ;;
    *)
      ok "J6 no reminder row opened a terminal or a vendored picker" ;;
    esac
  fi

  s close >/dev/null

  # --- K. audio devices -----------------------------------------------------
  # The row these replace was `wiremix` in a terminal, which drew a truncated tab
  # strip and nothing else. Every check here is about the page being a page.

  # K1. Routing, not volume: the shade owns the slider (H1).
  sound_rows=$(s openAt sound >/dev/null; sleep 2; s rows)
  if grep -q '^output	' <<<"$sound_rows" && grep -q '^input	' <<<"$sound_rows"; then
    ok "K1 Sound carries an output row and an input row"
  else
    no "K1 Sound has no device rows" "rows: $(cut -f1 <<<"$sound_rows" | tr '\n' ' ')"
  fi
  if awk -F'\t' 'tolower($3) ~ /^(volume|mixer|audio devices &)/' <<<"$sound_rows" | grep -q .; then
    no "K1 Sound offers a volume control" "the shade owns volume, brightness and the radios"
  else
    ok "K1 no volume control is repeated in Settings"
  fi

  # K2. The list is PipeWire's, and the one in use is ticked.
  s goto sound.output >/dev/null; sleep 2
  want_sink=$(pactl get-default-sink 2>/dev/null)
  n_sinks=$(pactl list short sinks 2>/dev/null | grep -c .)
  n_rows=$(s rows | grep -c .)
  sink_checked=$(s rows | awk -F'\t' '$5=="1"' | wc -l)
  # `value` takes a row id -- Quickshell's typed IPC has no optional arguments --
  # and on a choice row it answers the page's reader, which is what is wanted.
  sink_row=$(s rows | awk -F'\t' '$2=="choice"{print $1; exit}')
  sink_says=$(s value "${sink_row:-none}")
  if [[ $n_rows -eq $n_sinks && $sink_checked -eq 1 && $sink_says == "$want_sink" ]]; then
    ok "K2 the output page lists $n_sinks sink(s) and ticks the one in use"
  else
    no "K2 output page: $n_rows row(s) for $n_sinks sink(s), $sink_checked ticked" \
       "reader says '$sink_says', pactl says '$want_sink'"
  fi

  # K2 again, on the labels: a row named by its pactl handle is not a phone UI.
  if s rows | awk -F'\t' '$3 ~ /^alsa_/' | grep -q .; then
    no "K2 a device row is labelled by its pactl handle" \
       "the label is PipeWire's Description; the handle is the value"
  else
    ok "K2 device rows are labelled the way a person reads them"
  fi

  # K3. Every sink has a .monitor source, and it records playback, not a voice.
  s goto sound.input >/dev/null 2>&1 || { s openAt sound.input >/dev/null; }
  sleep 2
  if s rows | awk -F'\t' '$1 ~ /^d/' | grep -q monitor; then
    no "K3 a monitor source is offered as an input device" \
       "it records what is playing, so it is a recording of silence"
  else
    want_src=$(pactl list short sources 2>/dev/null | grep -vc '\.monitor')
    got_src=$(s rows | grep -c .)
    [[ $got_src -eq $want_src ]] \
      && ok "K3 the input page lists $want_src source(s), monitors excluded" \
      || no "K3 input page has $got_src row(s) for $want_src source(s)" \
            "monitors are excluded; nothing else should be"
  fi

  # K6. And neither page is a terminal. That was the whole complaint.
  s goto sound.output >/dev/null 2>&1 || s openAt sound.output >/dev/null
  sleep 2
  first_dev=$(s rows | awk -F'\t' '$2=="choice"{print $1; exit}')
  if [[ -n $first_dev ]]; then
    s dryRun 1 >/dev/null
    s activate "$first_dev" >/dev/null
    launched=$(s lastLaunch)
    s dryRun 0 >/dev/null
    if [[ $(s state) == open && $launched != omarchy-launch-* ]]; then
      ok "K6 selecting a device keeps Settings up and opens no terminal"
    else
      no "K6 state=$(s state) after selecting a device" "it would run: $launched"
    fi
  fi

  # --- L. time zone ---------------------------------------------------------
  s openAt system.time.zone >/dev/null; sleep 2
  n_regions=$(s rows | awk -F'\t' '$2=="nav"' | wc -l)
  (( n_regions >= 10 )) \
    && ok "L1 the time zone page walks $n_regions regions, with no filter field" \
    || no "L1 the time zone page has $n_regions region rows" "the tzdata areas are eleven"

  # L4. UTC is flat in the database, so it is a row here and not a region.
  s rows | awk -F'\t' '$1=="utc" && $2=="choice"' | grep -q . \
    && ok "L4 UTC is a row, not a region to walk into" \
    || no "L4 there is no UTC row on the time zone page" "list-timezones lists it flat"

  s goto system.time.zone.Europe >/dev/null; sleep 3
  want_eu=$(timedatectl list-timezones | grep -c '^Europe/')
  got_eu=$(s rows | grep -c .)
  [[ $got_eu -eq $want_eu ]] \
    && ok "L1 Europe lists $want_eu cities" \
    || no "L1 Europe has $got_eu row(s) for $want_eu zones" "the provider greps one area"

  # L2. The label is the city; the value is the whole zone timedatectl takes.
  berlin=$(s rows | awk -F'\t' '$3=="Berlin"{print $1; exit}')
  if [[ -n $berlin && $(s value "$berlin") != "" ]]; then
    ok "L2 a city row is labelled by its city"
  else
    no "L2 no row on Europe is labelled Berlin" "label: \"city\" keeps the zone as the value"
  fi

  # L3. Ticked where it belongs, and nowhere else.
  zone_now=$(timedatectl show -p Timezone --value)
  eu_checked=$(s rows | awk -F'\t' '$5=="1"' | wc -l)
  case "$zone_now" in
    Europe/*) [[ $eu_checked -eq 1 ]] \
                && ok "L3 the zone in use ($zone_now) is ticked on its region" \
                || no "L3 $eu_checked rows ticked on Europe for $zone_now" "exactly one" ;;
    *)        [[ $eu_checked -eq 0 ]] \
                && ok "L3 nothing is ticked on a region the zone ($zone_now) is not in" \
                || no "L3 $eu_checked rows ticked on Europe with the zone set to $zone_now" \
                      "D2: a reader naming no row ticks nothing" ;;
  esac

  # --- M. plugins -----------------------------------------------------------
  s openAt shell.plugins >/dev/null; sleep 3
  want_pl=$(omarchy-shell shell listPlugins | jq '[.[] | select(.canDisable)] | length')
  got_pl=$(s rows | awk -F'\t' '$2=="switch"' | wc -l)
  [[ $got_pl -eq $want_pl ]] \
    && ok "M1 one switch per plugin the shell can turn off ($want_pl)" \
    || no "M1 $got_pl switch row(s) for $want_pl plugin(s)" "the provider lists canDisable only"

  # M2. Neither bar is a switch. Enabling omarchy.bar costs the phone bar.
  if s rows | awk -F'\t' '$1=="p-omarchy.bar" || $1=="p-moarchy.bar"' | grep -q .; then
    no "M2 a bar is offered as a switch" "canDisable is false for both; flipping one loses the status bar"
  else
    ok "M2 neither bar is offered as a switch"
  fi

  # M3. State on the row, not a read per row.
  if moarchy-plugins rows | jq -e 'all(.[]; (has("read") | not))' >/dev/null \
     && moarchy-plugins rows | jq -e 'all(.[]; .type != "switch" or has("state"))' >/dev/null; then
    ok "M3 the switches carry their state, so the page is one listing not $want_pl forks"
  else
    no "M3 a plugin row carries a read" "one listing already answered for all of them"
  fi

  # M4. A write moves the row, which on a provider page needs the provider re-run.
  pl_row=$(s rows | awk -F'\t' '$2=="switch" && $5=="1"{print $1; exit}')
  if [[ -n $pl_row ]]; then
    pl_id=${pl_row#p-}
    s set "$pl_row" off >/dev/null; sleep 3
    off_row=$(s rows | awk -F'\t' -v r="$pl_row" '$1==r{print $5}')
    off_shell=$(omarchy-shell shell listPlugins | jq -r --arg i "$pl_id" '.[]|select(.id==$i)|.enabled')
    s set "$pl_row" on >/dev/null; sleep 3
    on_row=$(s rows | awk -F'\t' -v r="$pl_row" '$1==r{print $5}')
    if [[ $off_row == 0 && $off_shell == false && $on_row == 1 ]]; then
      ok "M4 a switch moves the plugin and settles on what the shell reports ($pl_id)"
    else
      no "M4 $pl_id: row went $off_row then $on_row, shell said $off_shell when off" \
         "a provider page needs reloadDynamic after a write, not refresh"
    fi
  fi

  # M5/M6. The count, and the three rows that stay bridged.
  s openAt shell >/dev/null; sleep 2
  pl_detail=$(s rows | awk -F'\t' '$1=="plugins"{print $6}')
  [[ $pl_detail =~ ^[0-9]+\ of\ [0-9]+\ on$ ]] \
    && ok "M5 the Plugins row says how many are on ($pl_detail)" \
    || no "M5 the Plugins row reads '$pl_detail'" "expected '<n> of <m> on'"
  s openAt shell.plugins >/dev/null; sleep 3
  if s rows | grep -q '^add	' && s rows | grep -q '^clone	'; then
    ok "M6 add and clone are still there, still bridged"
  else
    no "M6 add or clone went missing from the plugins page" \
       "a URL to type and an editor to open are terminal work, not rows"
  fi

  # --- N. about -------------------------------------------------------------
  s openAt about >/dev/null; sleep 2
  s activate aboutomarchy >/dev/null; sleep 2
  if [[ $(s state) == open && $(s page) == about.omarchy ]]; then
    ok "N1 About Omarchy is a page, and opens no terminal"
  else
    no "N1 About Omarchy left Settings $(s state) on $(s page)" \
       "it was omarchy-launch-about -- fastfetch re-measuring itself in a 47-column window"
  fi
  sleep 2
  n_blank=$(s rows | awk -F'\t' '$6==""' | wc -l)
  [[ $n_blank -eq 0 ]] \
    && ok "N2 every About row has a value ($(s rows | grep -c .) rows)" \
    || no "N2 $n_blank About row(s) have no value" "a field that cannot be read is not a row"
  if s rows | awk -F'\t' '$3=="Omarchy"' | grep -q . && s rows | awk -F'\t' '$3=="moarchy"' | grep -q .; then
    ok "N3 About names both Omarchy and moarchy"
  else
    no "N3 About does not name both versions" "they are different packages here"
  fi


  # --- O. search from the drawer --------------------------------------------
  # The surface is the drawer's and the content is this file's, so the checks
  # live here: settings.md section O owns the contract, the same way section H
  # owns what the shade may not repeat.
  d() { timeout 10 omarchy-shell drawer "$@" 2>/dev/null; }

  # `s` with a budget that fits what these checks make Settings do. An
  # activation from a result is a summon, a page rebuild, a guard batch and
  # sometimes a provider -- and on the first run of this section three checks
  # read back the empty string because five seconds ran out mid-answer. Empty is
  # the one answer that looks like every failure at once: O5 and O9 reported
  # landing "on ", and O7 compared a guard that never arrived against 0 and
  # called itself green.
  so() { timeout 15 omarchy-shell settings "$@" 2>/dev/null; }

  # The drawer imports two files out of the Settings plugin's directory, which
  # is a coupling between two independently-loadable plugins. Checked first and
  # separately, because a missing import makes the whole drawer fail to load --
  # and every check below would then blame the search for a packaging fault.
  o_dir=$(plugin_dir moarchy.drawer)
  o_sdir=$(plugin_dir moarchy.settings)
  o_miss=""
  for o_f in Search.js Guards.js Pages.js; do
    [[ -f "$o_sdir/$o_f" ]] || o_miss="$o_miss $o_f"
  done
  if [[ -n $o_miss ]]; then
    no "O the drawer's imports are missing from $o_sdir:$o_miss" \
       "Drawer.qml imports ../moarchy.settings/{Search,Guards}.js; without them it does not load"
  elif [[ $(dirname "$o_dir") != $(dirname "$o_sdir") ]]; then
    no "O the two plugins are in different directories" \
       "$o_dir and $o_sdir -- a user-dir copy of only one breaks the relative import"
  else
    ok "O the drawer's Settings imports are beside it in $(dirname "$o_dir")"
  fi

  if ! dstate=$(d state) || [[ -z $dstate ]]; then
    no "O1 the drawer's IPC does not answer" \
       "moarchy.drawer is not loaded, so nothing in section O can be checked"
  else
    s close >/dev/null; sleep 1
    d open >/dev/null; sleep 2

    # O1. An empty field is the drawer that was always here. `entries` is
    # moarchy-store's contract (L9), and a settings key is the only kind with a
    # slash in it -- so one showing up there is the concatenation this design
    # exists not to do.
    d type "" >/dev/null; sleep 1
    o_rows=$(d results | grep -c .)
    o_leak=$(d entries | grep -c '/')
    if (( o_rows == 0 && o_leak == 0 )); then
      ok "O1 an empty field shows no settings, and leaks none into entries"
    else
      no "O1 empty field: $o_rows result(s), $o_leak settings id(s) in entries" \
         "results must be empty without a query, and must never join appRows"
    fi

    # O2. Five at most, every column filled. A row with no section is a row you
    # cannot tell apart from the one above it.
    d type screen >/dev/null; sleep 2
    o_n=$(d results | grep -c .)
    o_blank=$(d results | awk -F'\t' 'NF<5 || $1=="" || $3=="" || $4==""' | wc -l)
    if (( o_n >= 1 && o_n <= 5 && o_blank == 0 )); then
      ok "O2 'screen' returns $o_n result(s), all fully labelled"
    else
      no "O2 'screen' returned $o_n row(s), $o_blank of them incomplete" \
         "the cap is five, and a result needs a key, a label and a section"
    fi

    # O3. The index is a walk of the model, so every key must name something
    # Settings can stand on. A key that does not is a result that opens a page
    # and shows nothing -- which is the failure a hand-written second list has.
    o_bad=""
    while IFS=$'\t' read -r o_key _; do
      [[ -n $o_key ]] || continue
      o_pg=${o_key%/*}; o_rw=${o_key##*/}
      s rowsOn "$o_pg" | awk -F'\t' -v r="$o_rw" '$1==r{f=1} END{exit !f}' \
        || o_bad="$o_bad $o_key"
    done < <(d results)
    [[ -z $o_bad ]] \
      && ok "O3 every result names a page and a row that exist" \
      || no "O3 no such row for:$o_bad" "the index and the model disagree"

    # O4. An action row runs and Settings never appears. Under dryRun, so this
    # records the command instead of taking a screenshot and firing a
    # notification -- `lastLaunch` is what proves the row was chosen, and
    # `running` is what proves nothing was left behind: had the surface mapped,
    # it would still be running with a carousel card (K1).
    s dryRun 1 >/dev/null
    d type screenshot >/dev/null; sleep 2
    o_act=$(d activateResult tools/screenshot); sleep 3
    if [[ $o_act == ok && $(s state) == closed && $(s running) == stopped
          && $(s lastLaunch) == "moarchy-capture-screenshot" ]]; then
      ok "O4 Screenshot runs from the drawer and Settings never appears"
    else
      no "O4 activate=$o_act state=$(s state) running=$(s running) launch=$(s lastLaunch)" \
         "expected ok/closed/stopped/moarchy-capture-screenshot -- the quiet path did not stay quiet"
    fi
    s dryRun 0 >/dev/null

    # O13. Update system: a row of ours, running the plain upgrade through
    # upstream's own presentation terminal, claiming no upstream id.
    s dryRun 1 >/dev/null
    s openAt system >/dev/null; sleep 2
    if ! s rows | awk -F'\t' '$1=="update"' | grep -q .; then
      no "O13 there is no 'update' row on the System page" \
         "the row was dropped, and activate on a missing row records nothing"
    else
      s activate update >/dev/null; sleep 1
      [[ $(s lastLaunch) == "omarchy-launch-floating-terminal-with-presentation sudo pacman -Syu" ]] \
        && ok "O13 Update system runs the upgrade in the TUI terminal" \
        || no "O13 lastLaunch was '$(s lastLaunch)'" \
              "expected the presentation wrapper around 'sudo pacman -Syu'"
    fi
    s dryRun 0 >/dev/null
    # 128 = G7's 58 Bridged + 69 Native + 1 Shade, and the two are the same fact
    # counted from opposite ends -- so this must move only when that does. 129
    # until 2026-09-08, when the Show status bar row took trigger.toggle.top-bar
    # to Unsupported with it (docs/settings.md C4a).
    o_cov=$(s coverage | grep -c .)
    [[ $o_cov -eq 128 ]] \
      && ok "O13 coverage is still 128 lines -- Update system claims no id" \
      || no "O13 coverage is $o_cov lines, not 128" \
            "a row with no 'covers' must add nothing; G7's totals are the same number"

    # O5. A nav result lands on the page it points at, not on the page it lives
    # on. Set a reminder is a row on Reminders and a screen of its own.
    d open >/dev/null; sleep 2
    d type "set a reminder" >/dev/null; sleep 2
    d activateResult tools.reminders/new >/dev/null; sleep 3
    o_state=$(so state); o_page=$(so page)
    if [[ $o_state == open && $o_page == tools.reminders.new ]]; then
      ok "O5 Set a reminder opens its own screen"
    else
      no "O5 landed '$o_state' on '$o_page'" \
         "expected open on tools.reminders.new; an empty pair is the read timing out"
    fi

    # O9. The row at the bottom of that same screen needs a duration typed (J8).
    # From a search result it cannot have one, so it must land on the screen
    # that has the field rather than answer nothing at all.
    s close >/dev/null; sleep 1
    d open >/dev/null; sleep 2
    d type "set reminder" >/dev/null; sleep 2
    s dryRun 1 >/dev/null
    o_before=$(so lastLaunch)
    d activateResult tools.reminders.new/custom >/dev/null; sleep 3
    o_state=$(so state); o_page=$(so page); o_after=$(so lastLaunch)
    if [[ $o_state == open && $o_page == tools.reminders.new
          && $o_after == "$o_before" ]]; then
      ok "O9 a row that is not ready opens its screen and runs nothing"
    else
      no "O9 landed '$o_state' on '$o_page', lastLaunch '$o_after'" \
         "expected open on tools.reminders.new with lastLaunch untouched"
    fi
    s dryRun 0 >/dev/null

    # O6. A switch opens the page it lives on and changes nothing. A radio
    # flipped from a search result is a value changed by something that never
    # showed it to you.
    s close >/dev/null; sleep 1
    o_nl_before=$(moarchy-toggle-nightlight --status 2>/dev/null | jq -r .enabled 2>/dev/null)
    d open >/dev/null; sleep 2
    d type "night light" >/dev/null; sleep 2
    d activateResult display/nightlight >/dev/null; sleep 3
    o_nl_after=$(moarchy-toggle-nightlight --status 2>/dev/null | jq -r .enabled 2>/dev/null)
    o_page=$(so page)
    if [[ $o_page == display && $o_nl_after == "$o_nl_before" ]]; then
      ok "O6 a switch result opens Display and leaves night light $o_nl_after"
    else
      no "O6 page='$o_page', night light went $o_nl_before -> $o_nl_after" \
         "a switch must be shown, not flipped"
    fi

    # O7. A guarded row is withheld until its guard says yes. Checked against
    # Settings' own answer for the same guard rather than against a stub: the
    # two run the same `when:` string, so they have to agree.
    s close >/dev/null; sleep 1
    s openAt tools >/dev/null; sleep 3
    o_guard=$(so guards | awk -F'\t' '$1=="record"{print $2}')
    d open >/dev/null; sleep 2
    d type "screen record" >/dev/null; sleep 3
    o_listed=$(d results | grep -c '^tools/record\b')
    o_matched=$(d matches | grep -c '^tools/record\b')
    # The empty string is refused rather than coerced. `[[ 0 -eq "" ]]` is true
    # inside [[ ]], so a `guards` read that timed out used to make this pass by
    # comparing "no result listed" against "no answer at all" -- green for the
    # one reason that proves nothing.
    if [[ ! $o_guard =~ ^[01]$ ]]; then
      no "O7 Settings' guard for 'record' read '$o_guard'" \
         "expected 0 or 1; an empty answer is the read timing out, not a guard saying no"
    elif [[ $o_matched -eq 1 && $o_listed -eq $o_guard ]]; then
      ok "O7 Screen record is matched, and shown only when its guard says so (guard=$o_guard)"
    else
      no "O7 matched=$o_matched listed=$o_listed, Settings' guard says $o_guard" \
         "the index must find it and the guard batch must decide it"
    fi

    # O10. Provider-built rows are not in the index, so the eleven region rows
    # are reachable and the four hundred cities under them are not.
    d type europe >/dev/null; sleep 2
    o_city=$(d matches | grep -c '^system\.time\.zone\.')
    o_region=$(d matches | grep -c '^system\.time\.zone/')
    if (( o_region >= 1 && o_city == 0 )); then
      ok "O10 'europe' finds the region row and none of its cities"
    else
      no "O10 $o_region region row(s), $o_city city row(s)" \
         "a provider builds its rows at page open; none of them may be indexed"
    fi

    # O11. The bottom inset belongs to whatever is last, and with results up
    # that is no longer the grid. Read off the surface, not off the source.
    d type screen >/dev/null; sleep 2
    o_gap=$(d geometry | tr ' ' '\n' | sed -n 's/^gap=//p')
    o_strip=$(d geometry | tr ' ' '\n' | sed -n 's/^strip=//p')
    if [[ -n $o_gap && -n $o_strip ]] && (( o_gap >= o_strip )); then
      ok "O11 the last result rests clear of the home pill (gap=$o_gap strip=$o_strip)"
    else
      no "O11 gap=$o_gap against strip=$o_strip" \
         "the inset moved to the settings section, and geometry must measure it there"
    fi

    # O8. A row that asks a question asks it, rather than acting quietly. Needs
    # a reminder to clear, so it is skipped rather than run on a phone that
    # already has some -- those are the user's.
    if [[ $(moarchy-reminders count 2>/dev/null || echo 0) -eq 0 ]]; then
      omarchy-reminder 9 SelftestO8 >/dev/null 2>&1; sleep 2
      d open >/dev/null; sleep 2
      d type "clear all" >/dev/null; sleep 3
      d activateResult tools.reminders/clear >/dev/null; sleep 3
      o_ask=$(s confirmText)
      o_left=$(moarchy-reminders count 2>/dev/null || echo 0)
      if [[ -n $o_ask && $o_left -gt 0 ]]; then
        ok "O8 Clear all asks first, and the timer is still running"
      else
        no "O8 confirmText='$o_ask', $o_left reminder(s) left" \
           "an armed question must be shown, and must not have acted"
      fi
      s back >/dev/null; sleep 1
      omarchy-reminder clear >/dev/null 2>&1
    else
      printf '  \033[90m%-4s\033[0m   \033[90mO8 skipped: reminders are already set, and they are not ours to clear\033[0m\n' ""
    fi

    # O12. Section H keeps the shade's controls out of this tree; the index
    # inherits that rather than restating it. What would break it is a row that
    # *sets* one, so the check is over `switch` and `choice` -- H1's regex
    # applied flatly catches four rows that are all correct.
    o_h1=$(python3 - "$plug_pages" <<'PY'
import re, sys
src = open(sys.argv[1], encoding="utf-8").read()
bad = []
for m in re.finditer(r'\{\s*id:\s*"', src):
    i = m.start(); depth = 0
    for j in range(i, len(src)):
        if src[j] == '{': depth += 1
        elif src[j] == '}':
            depth -= 1
            if depth == 0: break
    row = src[i:j + 1]
    t = re.search(r'\btype:\s*"(\w+)"', row)
    lab = re.search(r'\blabel:\s*"([^"]*)"', row)
    if not t or not lab or t.group(1) not in ("switch", "choice"):
        continue
    if re.match(r'(wi-?fi|bluetooth|airplane|brightness|volume|silent|torch|rotate)',
                lab.group(1), re.I):
        bad.append(lab.group(1))
print(" ".join(sorted(set(bad))))
PY
)
    [[ -z $o_h1 ]] \
      && ok "O12 no switch or choice in the index sets what the shade owns" \
      || no "O12 searchable rows set shade controls: $o_h1" \
            "section H keeps those in the shade; search must not bring them back"

    d close >/dev/null; s close >/dev/null; sleep 1
  fi
  printf '  \033[90m%-4s\033[0m   \033[90mnot covered here: A3 A5 B5 B7 C5 C7 C8 D3 D4 E2 E5 E6 E7 E8 F1 F2 F3 F4 F5 F6 F7 G4 H1 I4 J11 O4a\033[0m\n' ""
  # A3     needs a real finger or the touch injector
  # B4     is a gesture, and --gestures proves it as K3/K4 with a real swipe
  # A5     needs every reader stubbed slow
  # C5/C7/C8  need a blank, a systemd unit and an sshd flip
  # D3     Zed is absent on a base install; D6/D7 are checked above
  # E2     static: Pages.js against omarchy-menu.jsonc, not a runtime question
  # F3-F7  need PATH stubs that count forks
  # I2/I4  static greps, run at build time
  # J11    the keyboard inset needs a real focus, which needs a real finger
  # O4a    O4's other half: that the capture does not contain a half-drawn
  #        Settings. `state` and `running` prove the surface never mapped, which
  #        is the cause; only a real grim with the shell running proves the
  #        effect, and O4 here runs under dryRun so no capture is taken at all
fi

# --- surfaces: what the strip is drawn over -------------------------------
# docs/gestures.md section I. Opt-in because it opens every overlay in turn and
# writes a capture, and because I5 needs the touch injector and therefore root.
if [[ ${1:-} == "--surfaces" ]]; then
  head_ "surfaces (docs/gestures.md I)"

  # One field out of one `geometry` line. Layer surfaces are invisible to sway's
  # IPC -- `swaymsg -t get_tree` does not list them -- so the surface reporting
  # its own configure is the only measurement available. `h` is the compositor's
  # number; `margin` is only our own property read back.
  g() { omarchy-shell "$1" geometry 2>/dev/null | tr ' ' '\n' | sed -n "s/^$2=//p"; }

  # Read from the compositor, never from the thing under test.
  ws_rect() {
    swaymsg -t get_workspaces | python3 -c 'import json,sys
r = [w["rect"] for w in json.load(sys.stdin) if w["focused"]][0]
print(r["x"], r["y"], r["width"], r["height"])'
  }

  open_()  { omarchy-shell "$1" open  >/dev/null 2>&1; sleep 2; }
  close_() { omarchy-shell "$1" close >/dev/null 2>&1; sleep 1; }

  sheets="drawer settings themes"

  # I2. moarchy.device is the control: same layer, same zero exclusive
  # zone, no margin. The difference between its height and a sheet's is the
  # margin and nothing else.
  #
  # Deliberately NOT asserted against the workspace rect, which has the bar's
  # and the strip's exclusive zones taken out of it while an Ignore surface
  # takes the whole output -- that would fail on arithmetic rather than on
  # behaviour. (It carried a `gaps inner 3` inset as well until docs/windows.md
  # W1; the zones remain, so the reason to avoid it does too.)
  open_ device; control=$(g device h); close_ device
  if [[ -z $control ]]; then
    no "I2 the device control did not report a geometry" \
       "without it every height below is unanchored"
  else
    for s in $sheets; do
      open_ "$s"; h=$(g "$s" h); strip=$(g "$s" strip); close_ "$s"
      want=$(( control + strip ))
      if [[ $h == "$want" ]]; then
        ok "I2 $s is one strip taller than the control ($control + $strip)"
      else
        no "I2 $s is ${h:-?}, wanted $want" \
           "equal to the control ($control) means the negative margin was ignored"
      fi
    done
  fi

  # I4. Content may pass under the pill mid-scroll; none may come to rest there.
  for s in $sheets; do
    open_ "$s"; gap=$(g "$s" gap); strip=$(g "$s" strip); close_ "$s"
    if [[ -n $gap && -n $strip ]] && (( gap >= strip )); then
      ok "I4 $s rests its last row clear of the pill (gap $gap >= $strip)"
    else
      no "I4 $s rests content under the pill (gap ${gap:-?} < ${strip:-?})" \
         "a row that stops under the pill cannot be tapped"
    fi
  done

  # I3. Extending a surface reserves nothing.
  before=$(ws_rect)
  for s in $sheets; do open_ "$s"; close_ "$s"; done
  after=$(ws_rect)
  [[ $before == "$after" ]] \
    && ok "I3 the workspace rect is unchanged by opening every sheet" \
    || no "I3 the workspace rect moved: [$before] -> [$after]" \
          "a sheet started reserving space; the keyboard will fight it"

  # I1. The pixel check, and the one that catches "correct but invisible".
  #
  # Relative, never against a known colour: compare the last row against one a
  # strip above it. That says "the sheet reaches the bottom edge" without
  # resolving what Color.menu.background is for the installed theme, and without
  # assuming the strip is 20 -- Style.space rounds a *scaled* value.
  if ! command -v magick >/dev/null; then
    no "I1 imagemagick is missing" "the pixel check cannot run"
  else
    for s in $sheets; do
      # Open versus closed, NOT against a pixel higher up the same capture.
      # That was the first version and it is unsound: the reference lands on
      # whatever the sheet is drawing there, so on Settings it hit a row card
      # and the check compared card-against-sheet and failed a surface that was
      # in fact reaching the edge. What I1 actually asks is "is this band the
      # sheet, or is it still what is behind" -- which is a question about the
      # difference between the two states, and nothing else.
      shut=$(mktemp -t moa-shut-XXXX).png
      shot=$(mktemp -t moa-shot-XXXX).png
      close_ "$s"
      if grim "$shut" 2>/dev/null; then
        open_ "$s"
        if grim "$shot" 2>/dev/null; then
          lw=$(g "$s" screen | cut -dx -f1)
          pw=$(magick identify -format '%w' "$shot")
          ph=$(magick identify -format '%h' "$shot")
          scale=$(( pw / lw ))
          # x well left of the centred 96-logical pill, y in the last row.
          x=$(( 40 * scale )); y=$(( ph - 2 ))
          was=$(magick "$shut" -format "%[hex:p{$x,$y}]" info:)
          now=$(magick "$shot" -format "%[hex:p{$x,$y}]" info:)
          [[ $was != "$now" ]] \
            && ok "I1 $s paints the bottom row ($was -> $now)" \
            || no "I1 $s leaves the bottom row untouched ($now)" \
                  "the band under the pill is still showing what is behind"
        else
          no "I1 grim captured nothing for $s (open)" "a blanked screen has no frames"
        fi
      else
        no "I1 grim captured nothing for $s (closed)" "a blanked screen has no frames"
      fi
      rm -f "$shut" "$shot"
      close_ "$s"
    done
  fi

  # I5. The drawer must still reflow above the keyboard -- the whole reason its
  # exclusive zone is zero. Needs a tap on the search field, so it needs the
  # injector and root.
  touch_bin="$MOARCHY_BIN/moarchy-touch"
  if [[ -x $touch_bin ]] && sudo -n true 2>/dev/null; then
    open_ drawer
    h_down=$(g drawer h); gap_down=$(g drawer gap)
    # The search pill: below the 26px handle strip, centred.
    lw=$(g drawer screen | cut -dx -f1); scale=$(( 720 / lw ))
    # Two taps, because the injector creates its uinput device on first use and
    # events sent before the compositor has bound it land nowhere.
    osk_up() { [[ $(busctl --user get-property sm.puri.OSK0 /sm/puri/OSK0 \
                      sm.puri.OSK0 Visible 2>/dev/null) == "b true" ]]; }
    for _ in 1 2; do
      sudo -n "$touch_bin" tap $(( 180 * scale )) $(( 74 * scale )) >/dev/null 2>&1
      sleep 3
      osk_up && break
    done
    h_up=$(g drawer h); gap_up=$(g drawer gap)
    if ! osk_up; then
      # An environment that will not raise the keyboard cannot answer I5, and
      # reporting that as an I5 failure teaches you to ignore I5.
      #
      # Measured, and worth knowing before chasing it: a session that has been
      # opening and closing overlays for a while stops re-activating the search
      # field's text input entirely -- the tap lands, the injector is fine (the
      # same one still drives every gesture check), and the keyboard simply
      # never rises. `moarchy-restart-shell` clears it every time. That was the
      # field holding focus across the close and taking it back on the next map
      # (I5c), so a skip here now means I5c below should be read first: it is
      # the same fault, seen from the side that does not need the keyboard.
      printf '  \033[90m%-4s\033[0m   \033[90mI5 skipped: the keyboard would not come up\033[0m\n' ""
    elif [[ -n $h_up && -n $h_down ]] && (( h_up < h_down )) && [[ $gap_up == "$gap_down" ]]; then
      ok "I5 the drawer reflows above the keyboard ($h_down -> $h_up, gap $gap_up held)"
    else
      no "I5 the drawer did not reflow (h $h_down -> ${h_up:-?}, gap $gap_down -> ${gap_up:-?})" \
         "an unchanged height means the keyboard is now covering the grid"
    fi

    # I5c. Deliberately outside the osk_up branch above: a field that will not
    # let go is exactly why the keyboard stops rising, so gating this on the
    # keyboard having risen would skip the check precisely when it fails. The
    # tap is what this needs, and the tap has already happened.
    close_ drawer
    open_ drawer
    focused=$(omarchy-shell drawer searchTarget 2>/dev/null \
                | tr ' ' '\n' | sed -n 's/^focused=//p')
    margin=$(g drawer margin); strip=$(g drawer strip)
    if [[ $focused == false && -n $strip && $margin == "-$strip" ]]; then
      ok "I5c the search field lets go on close (margin $margin)"
    else
      no "I5c the drawer re-opened with the field still focused (focused=${focused:-?} margin=${margin:-?}, wanted -${strip:-?})" \
         "the inset stays dropped for the rest of the session and the keyboard stops rising"
    fi
    close_ drawer

    # --- I5d. closing an overlay must not raise the keyboard ---------------
    #
    # The workspace rect and not `Visible`, because the rect is the compositor's
    # own number: the keyboard's exclusive zone shortens it by the panel height,
    # so 674 becomes 474 on this screen the moment the keyboard is up. Measured
    # against `Visible` throughout and the two agreed on every sample here, but
    # only one of them is evidence about what is on screen.
    #
    # An app with a text input focused underneath, and that precondition is the
    # whole check. The keyboard comes back because sway re-activates the window
    # the overlay was covering; with nothing to re-activate there is no handback
    # and this passes on an empty stage -- measured 0 of 4 on a bare home screen
    # against 4 of 4 with an app, which is exactly why the bug read as
    # intermittent for so long.
    osk_set() { busctl --user call sm.puri.OSK0 /sm/puri/OSK0 sm.puri.OSK0 \
                       SetVisible b "$1" >/dev/null 2>&1; }
    ws_h() { swaymsg -t get_workspaces 2>/dev/null \
               | jq -r '.[]|select(.focused)|.rect.height'; }

    setsid foot --app-id=moa-i5d -e sh -c 'while :; do sleep 300; done' \
      >/dev/null 2>&1 </dev/null &
    sleep 4
    swaymsg '[app_id=moa-i5d] focus' >/dev/null 2>&1
    sleep 2

    if [[ -z $(ws_h) ]]; then
      no "I5d could not read the workspace rect" "swaymsg or jq is unavailable"
    else
      i5d_bad=""
      for sheet in drawer settings themes; do
        osk_set false; sleep 2
        i5d_before=$(ws_h)
        open_ "$sheet"
        close_ "$sheet"
        # Sampled over 3s rather than read once, for F3's reason: a single late
        # reading cannot tell "never went up" from "went up and something put it
        # back down", and on a shared phone that second case is real.
        i5d_up=0
        for _ in 1 2 3 4 5 6; do
          sleep 0.5
          [[ $(ws_h) != "$i5d_before" ]] && i5d_up=$(( i5d_up + 1 ))
        done
        (( i5d_up == 0 )) || i5d_bad="$i5d_bad $sheet:$i5d_up/6"
        omarchy-shell "$sheet" close >/dev/null 2>&1
      done
      if [[ -z $i5d_bad ]]; then
        ok "I5d closing the drawer, Settings and the theme picker leaves the keyboard down"
      else
        no "I5d the keyboard came up after closing:$i5d_bad" \
           "an overlay hands the window underneath its text input back; it must put the keyboard away on the way out"
      fi
    fi

    # --- I5e. the inset follows the keyboard, not the field ----------------
    #
    # Forced up with the field deliberately untouched, which is the state I5a's
    # `activeFocus` gate cannot see and I5d reaches on its own. Without the
    # second term the drawer keeps its negative inset and its last row of icons
    # paints over the keyboard's top key row.
    osk_set false; sleep 2
    open_ drawer
    osk_set true; sleep 3
    e_focused=$(omarchy-shell drawer searchTarget 2>/dev/null \
                  | tr ' ' '\n' | sed -n 's/^focused=//p')
    e_margin=$(g drawer margin)
    if ! osk_up; then
      printf '  \033[90m%-4s\033[0m   \033[90mI5e skipped: the keyboard would not come up\033[0m\n' ""
    elif [[ $e_focused == false && -n $e_margin && $e_margin == 0 ]]; then
      ok "I5e the inset lifts for a keyboard the search field did not raise"
    else
      no "I5e focused=${e_focused:-?} margin=${e_margin:-?}, wanted focused=false margin=0" \
         "the sheet's last row is drawn over the keyboard's top key row"
    fi
    close_ drawer
    osk_set false
    swaymsg '[app_id=moa-i5d] kill' >/dev/null 2>&1
  else
    printf '  \033[90m%-4s\033[0m   \033[90mI5 skipped: needs the touch injector and passwordless sudo\033[0m\n' ""
  fi

  printf '  \033[90m%-4s\033[0m   \033[90mnot covered: I6 I7\033[0m\n' ""
  # I6  the pill over a sheet is A7 in --gestures, which already covers it for
  #     the drawer; settings/themes and the keyboard case want a finger.
  # I7  static, over every colors.toml -- a contrast sum, not a device question.
fi

# ---------------------------------------------------------------------------
# --windows: the window area and the launch splash, against docs/windows.md
#
# Opt-in, because it launches real apps and closes them again, and because W4
# turns gaps on for a second on a screen someone may be using.
# ---------------------------------------------------------------------------
if [[ ${1:-} == "--windows" ]]; then
  head_ "windows (docs/windows.md)"

  w_ok() { printf '  \033[90m%-4s\033[0m ' "$1"; shift; ok "$@"; }
  w_no() { printf '  \033[90m%-4s\033[0m ' "$1"; shift; no "$@"; }
  w_skip() { printf '  \033[90m%-4s   %s\033[0m\n' "$1" "$2"; }

  ws_rect() { swaymsg -t get_workspaces | python3 -c 'import json,sys
r=[w["rect"] for w in json.load(sys.stdin) if w["focused"]]
print("%d %d %d %d" % (r[0]["x"], r[0]["y"], r[0]["width"], r[0]["height"]) if r else "")'; }

  out_rect() { swaymsg -t get_outputs | python3 -c 'import json,sys
o=[o["rect"] for o in json.load(sys.stdin) if o.get("active")]
print("%d %d %d %d" % (o[0]["x"], o[0]["y"], o[0]["width"], o[0]["height"]) if o else "")'; }

  # The focused *view*, from sway rather than from the shell, so a check never
  # confirms the thing it is checking.
  focused_rect() { swaymsg -t get_tree | python3 -c '
import json, sys
found = []
def walk(n):
    if n.get("focused") and n.get("pid"): found.append(n["rect"])
    for k in ("nodes", "floating_nodes"):
        for c in n.get(k, []): walk(c)
walk(json.load(sys.stdin))
print("%d %d %d %d" % (found[0]["x"], found[0]["y"], found[0]["width"], found[0]["height"]) if found else "")'; }

  focused_app() { swaymsg -t get_tree | python3 -c '
import json, sys
found = []
def walk(n):
    if n.get("focused") and n.get("app_id"): found.append(n["app_id"])
    for k in ("nodes", "floating_nodes"):
        for c in n.get(k, []): walk(c)
walk(json.load(sys.stdin))
print(found[0] if found else "")'; }

  # Every view con_id on the tree. Diffing this across a launch names the one
  # window this suite created, so the cleanup kills that and nothing else --
  # other sessions have windows on this phone too.
  con_ids() { swaymsg -t get_tree | python3 -c '
import json, sys
out = []
def walk(n):
    if n.get("pid"): out.append(str(n["id"]))
    for k in ("nodes", "floating_nodes"):
        for c in n.get(k, []): walk(c)
walk(json.load(sys.stdin))
print(" ".join(out))'; }

  # Right after a surface maps this GPU can keep the shell busy long enough
  # that omarchy-shell gives up and prints nothing. Empty is "ask again", not
  # "closed" -- the same trap the gesture suite hit.
  splash_state() {
    local out
    for _ in 1 2 3; do
      if out=$(timeout 8 omarchy-shell splash state 2>/dev/null) && [[ -n $out ]]; then
        echo "$out"; return
      fi
      sleep 1
    done
    echo "unknown"
  }

  # --- W1, W2: the window area ---------------------------------------------
  wconf="$MOARCHY_ROOT/default/sway/pinephone.conf"
  if [[ ! -f $wconf ]]; then
    w_no W2 "no pinephone.conf at $wconf" "W2 is about a file that is not there"
  elif ! grep -q '^gaps inner 0' "$wconf"; then
    w_no W2 "pinephone.conf does not set gaps inner 0" \
            "the installed config still insets every app"
  else
    w_ok W2 "pinephone.conf sets gaps inner 0"
  fi

  before_ids=$(con_ids)
  swaymsg exec -- foot --app-id=moa-windows >/dev/null 2>&1
  for _ in $(seq 25); do [[ $(focused_app) == "moa-windows" ]] && break; sleep 1; done

  if [[ $(focused_app) != "moa-windows" ]]; then
    w_no W1 "no window came up" "W1 and W4 cannot be measured without one"
  else
    wr=$(ws_rect); fr=$(focused_rect); orr=$(out_rect)
    read -r wx wy ww wh <<<"$wr"
    read -r _ox _oy ow _oh <<<"$orr"

    # Two halves, and the first one is not optional. `swaymsg -t get_workspaces`
    # reports the workspace rect with the gaps ALREADY SUBTRACTED, so
    # window == workspace is true at gaps 3 exactly as it is at gaps 0 -- this
    # check passed a deliberate `gaps inner all set 3` before the width test was
    # added, which is the whole reason it is here.
    #
    # Width is what catches it: the bar and the strip are full-width surfaces
    # and reserve nothing at the sides, so a workspace narrower than its output
    # is gaps and can be nothing else.
    if [[ -z $wr || -z $fr || -z $orr ]]; then
      w_no W1 "could not read the geometry (window [$fr] workspace [$wr] output [$orr])" \
              "nothing below can be measured"
    elif (( wx != 0 || ww != ow )); then
      w_no W1 "the workspace is ${ww}px of a ${ow}px output, offset ${wx}" \
              "that inset is gaps: wallpaper is showing down both sides of the app"
    elif [[ $fr != "$wr" ]]; then
      w_no W1 "window [$fr], workspace [$wr]" \
              "the window is inset inside its workspace -- a border is taking space"
    else
      w_ok W1 "a lone window fills the width of the output and its workspace ($fr)"
    fi

    # --- W4: the toggle ----------------------------------------------------
    # Inverted from the desktop original, so the FIRST press must add gaps. A
    # toggle that starts by removing what is already gone would pass a
    # "restored" check while having done nothing at all, which is why both
    # halves are asserted -- and why this refuses to run against a session that
    # already has gaps, where there is no zero to add to.
    #
    # Measured as workspace-width-against-output, the same quantity W1 uses,
    # and NOT as the window rect before and after. The window rect carries
    # every exclusive zone on the screen: an earlier version of this check
    # compared absolute rects and went red because the on-screen keyboard came
    # up between two of its reads, which has nothing to do with gaps. Width is
    # untouched by the bar, the strip and the keyboard alike.
    ws_width() { ws_rect | cut -d' ' -f3; }
    ws_x()     { ws_rect | cut -d' ' -f1; }

    if (( wx != 0 )); then
      w_skip W4 "W4 skipped: this session already has gaps (x=$wx), so there is no zero to add to"
    else
      moarchy-window-gaps-toggle >/dev/null 2>&1; sleep 1
      on_x=$(ws_x); on_w=$(ws_width)
      moarchy-window-gaps-toggle >/dev/null 2>&1; sleep 1
      off_x=$(ws_x); off_w=$(ws_width)
      if [[ $on_x == "3" && $on_w == "$(( ow - 6 ))" && $off_x == "0" && $off_w == "$ow" ]]; then
        w_ok W4 "the gaps toggle adds 3 and takes it back (${ow} -> ${on_w} -> ${off_w})"
      elif [[ $on_x == "0" ]]; then
        w_no W4 "the first press changed nothing (workspace still at x=0, ${on_w}px)" \
                "it is still the desktop script: press one removes gaps that are already gone"
      else
        w_no W4 "on [x=$on_x w=$on_w] wanted [x=3 w=$(( ow - 6 ))], off [x=$off_x w=$off_w] wanted [x=0 w=$ow]" \
                "the toggle left the workspace somewhere neither state describes"
      fi
    fi
  fi

  # Kill only what this suite made.
  for id in $(con_ids); do
    [[ " $before_ids " == *" $id "* ]] || swaymsg "[con_id=$id] kill" >/dev/null 2>&1
  done
  sleep 1

  # --- L1, L2, L6, L7: a launch that never arrives -------------------------
  #
  # A desktop id with no application behind it. gtk-launch fails, no toplevel
  # ever appears, and the splash is therefore guaranteed to be up while the
  # next three checks read it -- which a real app is not, because an app that
  # maps in 400ms would fail L1 for being fast. It is also exactly the state L6
  # is about.
  if [[ $(timeout 8 omarchy-shell splash state 2>/dev/null) == "" ]]; then
    w_no L1 "the splash plugin does not answer IPC" \
            "moarchy.splash is not loaded, so nothing below can be read"
  else
    timeout 8 omarchy-shell drawer launch moa-selftest-no-such-app >/dev/null 2>&1
    sleep 1
    st=$(splash_state)
    if [[ $st == "open" ]]; then
      w_ok L1 "the splash is up one second after the launch, not two"
    else
      w_no L1 "the splash reads $st a second after a launch" \
              "either it never showed, or the 2s upstream delay is still in AppLibrary"
    fi

    # The pixels, not the source. A source that resolves to a file Qt cannot
    # decode leaves exactly the blank square L7 is about, and `icon` alone
    # would report it as fine.
    drawn=$(timeout 8 omarchy-shell splash drawn 2>/dev/null)
    case $drawn in
      icon*)     w_ok L7 "an unresolvable app still gets a splash (${drawn##*/})" ;;
      fallback)  w_ok L7 "an unresolvable app falls back to the outline" ;;
      *)         w_no L7 "the splash is drawing ${drawn:-nothing}" \
                        "the surface is up with no pixels on it" ;;
    esac

    geom=$(timeout 8 omarchy-shell splash geometry 2>/dev/null)
    sw=$(ws_rect | cut -d' ' -f3)
    gw=$(echo "$geom" | sed -n 's/.*w=\([0-9]*\).*/\1/p')
    if [[ -n $gw && -n $sw ]] && (( gw > 0 && gw * 2 < sw )); then
      w_ok L2 "the surface is the icon, not the screen (${gw} of ${sw}px)"
    else
      w_no L2 "splash surface w=${gw:-?} against a ${sw:-?}px screen" \
              "a full-screen splash can swallow the pill and the back edge (L3)"
    fi

    # Read off the window, not restated here: sway draws a fullscreen view
    # above the top layer, so on Top the splash is invisible behind any window
    # the user fullscreens ($mod+Shift+f, or an app that asks). pinephone.conf
    # no longer fullscreens TUIs -- that rule is gone, because it hid the
    # keyboard the same way -- but the layer is still the only thing that
    # decides this.
    layer=$(echo "$geom" | sed -n 's/.*layer=\([a-z?]*\).*/\1/p')
    if [[ $layer == "overlay" ]]; then
      w_ok L2a "the surface is on the overlay layer, in front of fullscreen apps"
    else
      w_no L2a "the splash surface is on layer ${layer:-?}" \
               "anything but overlay is hidden by the first fullscreen window it meets"
    fi

    # --- L6: it gives up ---------------------------------------------------
    # Upstream's 15s timeout, which the port patch must leave alone. Polled
    # rather than slept through, so the elapsed time is evidence rather than
    # the absence of a failure.
    t0=$(date +%s); elapsed=""
    for _ in $(seq 25); do
      [[ $(splash_state) == "closed" ]] && { elapsed=$(( $(date +%s) - t0 )); break; }
      sleep 1
    done
    if [[ -n $elapsed ]] && (( elapsed >= 10 && elapsed <= 20 )); then
      w_ok L6 "it gives up after ${elapsed}s and clears the wallpaper"
    elif [[ -n $elapsed ]]; then
      w_no L6 "it gave up after ${elapsed}s, not the 15 upstream sets" \
              "the port patch changed launchTimeout as well as launchDelay"
    else
      w_no L6 "still up 25s after a launch that will never arrive" \
              "launchTimeout is gone: a failed launch now covers the screen until the next one"
    fi
  fi

  # --- L1, L4: a real app --------------------------------------------------
  entries=$(timeout 8 omarchy-shell drawer entries 2>/dev/null)
  target=""
  # Alacritty was second here and is not installed any more (docs/apps.md T1).
  # Dropped rather than left as a candidate that can never match: this list is
  # what decides whether L1/L4 run at all, and a name that is never found makes
  # the skip harder to read, not the check more robust.
  for cand in foot org.gnome.Console org.gnome.Nautilus org.gnome.TextEditor; do
    grep -qx "$cand" <<<"$entries" && { target=$cand; break; }
  done

  if [[ -z $target ]]; then
    w_skip L4 "L1/L4 skipped: none of the expected apps is in the drawer's list"
  else
    before_ids=$(con_ids)
    saw_open=""; saw_icon=""; saw_drawn=""
    timeout 8 omarchy-shell drawer launch "$target" >/dev/null 2>&1
    for _ in $(seq 30); do
      # `drawn` is the sampler rather than `state`, and it is one call rather
      # than two on purpose. It answers the stronger question -- which pixels,
      # not merely whether -- and `state` followed by `drawn` cannot answer it
      # at all: each IPC call is a process spawn, ~0.4s on an A53, and foot
      # maps inside that gap. The second call then reads "down" about a splash
      # the first one had just seen, which is how L9a first failed against a
      # launch that was working.
      if [[ -z $saw_open ]]; then
        d=$(timeout 8 omarchy-shell splash drawn 2>/dev/null)
        if [[ -n $d && $d != "down" ]]; then
          saw_open=1
          saw_drawn=$d
          # Safe to read late: iconSource is a property, and it survives the
          # splash coming down. `drawn` is the one that does not.
          saw_icon=$(timeout 8 omarchy-shell splash icon 2>/dev/null)
        fi
      fi
      [[ $(con_ids) != "$before_ids" ]] && break
      sleep 1
    done

    if [[ $(con_ids) == "$before_ids" ]]; then
      w_no L4 "$target never opened a window" "L4 has nothing to have closed the splash"
    else
      sleep 2
      st=$(splash_state)
      if [[ $st == "closed" ]]; then
        w_ok L4 "the splash goes when $target's window appears"
      else
        w_no L4 "the splash reads $st with the window up" \
                "it will now sit on the app until the 15s timeout"
      fi
      if [[ -n $saw_open ]]; then
        w_ok L1 "$target's launch showed a splash (${saw_icon##*/})"
      else
        w_skip L1 "L1 unproven for $target: it mapped before the first poll"
      fi
    fi

    for id in $(con_ids); do
      [[ " $before_ids " == *" $id "* ]] || swaymsg "[con_id=$id] kill" >/dev/null 2>&1
    done
    sleep 1
  fi

  # --- L5: a .desktop that summons a plugin --------------------------------
  if ! grep -qx "moarchy.device" <<<"$entries"; then
    w_skip L5 "L5 skipped: moarchy.device is not in the drawer's list"
  else
    timeout 8 omarchy-shell drawer launch moarchy.device >/dev/null 2>&1
    for _ in $(seq 10); do
      [[ $(timeout 8 omarchy-shell device state 2>/dev/null) == "open" ]] && break
      sleep 1
    done
    st=$(splash_state)
    dev=$(timeout 8 omarchy-shell device state 2>/dev/null)
    if [[ $dev != "open" ]]; then
      w_no L5 "the Device screen did not open (state ${dev:-?})" \
              "without it there is no plugin summon for L5 to be about"
    elif [[ $st == "closed" ]]; then
      w_ok L5 "a plugin summon takes the splash down without a toplevel"
    else
      w_no L5 "the splash reads $st over the Device screen" \
              "no window will ever appear for it, so it stays for the full 15s"
    fi
    timeout 8 omarchy-shell device close >/dev/null 2>&1
  fi

  # --- L9: the store's Open goes through the shell ---------------------------
  #
  # Two halves, because either alone is green for the wrong reason. That the
  # store calls the IPC says nothing about what the IPC then draws, and a
  # splash that draws correctly for the drawer says nothing about the store --
  # which is a different repo, upgraded on its own, and the one place this can
  # regress without a line of this repo changing.
  store_launcher=$(pacman -Qlq moarchy-store-git 2>/dev/null | grep -m1 '/launcher\.py$')
  if [[ -z $store_launcher || ! -r $store_launcher ]]; then
    w_skip L9 "L9 skipped: moarchy-store is not installed"
  elif grep -q '"drawer", *"launch"' "$store_launcher"; then
    w_ok L9 "the store hands Open to the shell rather than starting the app itself"
  else
    w_no L9 "$store_launcher never calls 'omarchy-shell drawer launch'" \
            "Open starts the entry through Gio again, and nothing answers the tap"
  fi

  # The half of L9 the store depends on: a bare id resolves to the app's own
  # icon. `.desktop`-suffixed it still launches and still shows a splash -- it
  # just shows L7's outline, which is why the store strips the suffix and why
  # L7's "never nothing" is too weak to catch it.
  if [[ -z $target ]]; then
    w_skip L9a "L9a skipped: L1/L4 found no app to launch"
  elif [[ -z $saw_drawn ]]; then
    w_skip L9a "L9a unproven for $target: the splash was never sampled while up"
  elif [[ $saw_drawn == icon\ * ]]; then
    w_ok L9a "a bare id draws $target's own icon (${saw_drawn##*/})"
  else
    w_no L9a "$target's splash drew '$saw_drawn', not its icon" \
            "the store's Open would announce a generic square for every app"
  fi

  printf '  \033[90m%-4s\033[0m   \033[90mnot covered: W3 L3 L8\033[0m\n' ""
  # W3  needs two windows on one workspace, which one-app-per-workspace exists
  #     to prevent; arranging it means turning that off first.
  # L3  the mask. The surface size is asserted (L2) and that is the half that
  #     can be read without a finger; proving touch passes through the square
  #     itself needs the injector and root, like I5.
  # L8  an animation. A screenshot cannot tell a pulse from a still frame.
fi

printf '\n%d passed, %d failed\n' "$pass" "$fail"
(( fail == 0 ))
