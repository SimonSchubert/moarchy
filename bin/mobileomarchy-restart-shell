#!/bin/bash
# Start (or restart) Omarchy 4.x's quickshell shell under Sway.
#
# Upstream's omarchy-restart-shell reaches for HYPRLAND_INSTANCE_SIGNATURE and a
# $XDG_RUNTIME_DIR/hypr directory, neither of which exists here.
#
# SWAYSOCK is the critical bit: without it Quickshell.I3 cannot connect and the
# bar renders but never populates -- workspaces, focus and events all stay dead.

: "${OMARCHY_PATH:=$HOME/.local/share/omarchy}"
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export OMARCHY_PATH XDG_RUNTIME_DIR

[[ -f $OMARCHY_PATH/shell/shell.qml ]] || {
  echo "No Omarchy shell at $OMARCHY_PATH/shell" >&2; exit 1; }

# The shell shells out to omarchy-* helpers by bare name -- the bar's own logo
# runs `omarchy-shell shell toggle omarchy.menu` -- so both bin dirs have to be
# on PATH. In a normal session they already are, inherited from the login shell;
# put them on explicitly so a restart from somewhere else (an ssh session, a
# cron job) does not start a shell whose every button silently does nothing.
export PATH="$HOME/.local/bin:$(dirname "$(readlink -f "$0")"):$OMARCHY_PATH/bin:$PATH"
export SWAYSOCK="${SWAYSOCK:-$(ls "$XDG_RUNTIME_DIR"/sway-ipc.* 2>/dev/null | head -1)}"
[[ -n $SWAYSOCK ]] || echo "warning: no SWAYSOCK; the bar will not populate" >&2

# And WAYLAND_DISPLAY, for the same reason and with a worse failure. A session
# shell inherits it; an ssh session does not, and Qt then falls through to the
# xcb platform plugin, fails to reach a display, and aborts before a single line
# of QML is read:
#
#   FATAL: This application failed to start because no Qt platform plugin
#          could be initialized.
#
# Which reads exactly like a broken shell rather than a missing variable, and
# leaves the phone with no bar at all until someone restarts it from a terminal
# on the device.
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-$(basename "$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9] 2>/dev/null | head -1)" 2>/dev/null)}"
[[ -n $WAYLAND_DISPLAY ]] || echo "warning: no WAYLAND_DISPLAY; the shell will not start" >&2

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/mobileomarchy/shell-off"
pkill -x quickshell 2>/dev/null
[[ -f $STATE ]] && exit 0

# Keep the shell's own output. Quickshell reports a plugin that failed to load
# with a single console.warn and then carries on -- a broken bar plugin falls
# back to omarchy.bar and a broken overlay simply never appears, both without a
# word on screen. Sent to /dev/null that warning was the only diagnosis there is
# and it was being thrown away, which is how you end up bisecting QML by
# screenshot. Truncated per start, so the log is always this session's.
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/mobileomarchy/shell.log"
mkdir -p "$(dirname "$LOG")"

QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1 \
  setsid quickshell -n -p "$OMARCHY_PATH/shell" >"$LOG" 2>&1 &
