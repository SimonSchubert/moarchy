From d066270b6ac40d8d53c447bae43faa0e20fcb4e8 Mon Sep 17 00:00:00 2001
From: Tim auf der Landwehr <tadl-git@taufderl.de>
Date: Sat, 10 Oct 2026 15:09:21 +0200
Subject: [PATCH] drm/msm/mdss: quiesce the bootloader's display before
 resetting MDSS

A bootloader that shows a splash leaves the MDSS running when Linux
probes it, with a video-mode INTF scanning out of DDR. msm_mdss_init()
then asserts the MDSS core reset in that state. On the Fairphone 4
(SM7225) this hangs the whole SoC on roughly one boot in six: the write
that asserts DISP_CC_MDSS_CORE_BCR never returns, nothing more is
logged, and the watchdog drops the phone into the Qualcomm ramdump. The
reset itself is needed: without it the panel never comes up (DSI
command DMA times out).

Neither half alone is enough: stopping the scanout, the assert still
hung with the INTF verifiably idle; gating the clocks under the live
scanout, it hung on the first reboot. What made it reliable is both, in
this order:

 - enable the MDSS clocks so the DPU registers are reachable,
 - disable every INTF timing engine that a CTL reports active, and wait
   for the disable to latch at a frame boundary,
 - gate the MDP core and AXI clocks again, so nothing can be in flight
   when the reset is asserted.

Only interfaces that a CTL reports active are touched: an active
interface is clocked, an unused one may not be safe to access. That
needs the active-CTL register, so the DPU part is limited to DPU 5.0+.

Tested on the Fairphone 4: 20 of 20 boots clean with this change (and
30 of 30 with a variant that also disabled the DSI host), where the
unmodified kernel crashed on 7 of 44 boots, the scanout stop alone on 2
of 25, and the clock gating alone on its first reboot.

Signed-off-by: Tim auf der Landwehr <tadl-git@taufderl.de>
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c | 99 +++++++++++++++++++++++++
 drivers/gpu/drm/msm/msm_kms.h           |  6 ++
 drivers/gpu/drm/msm/msm_mdss.c          | 20 ++++-
 3 files changed, 121 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
index da3556eb6ecc..89a1a39d693e 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -11,6 +11,7 @@
 
 #include <linux/debugfs.h>
 #include <linux/dma-buf.h>
+#include <linux/of_address.h>
 #include <linux/of_irq.h>
 #include <linux/pm_opp.h>
 
@@ -1518,6 +1519,104 @@ static const struct of_device_id dpu_dt_match[] = {
 };
 MODULE_DEVICE_TABLE(of, dpu_dt_match);
 
+/* Register offsets, as in dpu_hw_intf.c and dpu_hw_ctl.c */
+#define DPU_INTF_TIMING_ENGINE_EN	0x000
+#define DPU_INTF_FRAME_COUNT		0x0ac
+#define DPU_CTL_INTF_ACTIVE		0x0f4
+
+/**
+ * dpu_quiesce_bootloader_scanout() - stop timing engines left on by firmware
+ * @mdss_dev: the MDSS device whose DPU child is to be quiesced
+ *
+ * A bootloader showing a splash leaves a video-mode interface scanning out a
+ * framebuffer, so the MDP keeps fetching from DDR. Asserting the MDSS core
+ * reset while such a fetch is in flight can wedge the interconnect and hang
+ * the whole SoC. Disable the running timing engines first and wait for the
+ * disable to latch at a frame boundary (as the video encoder's own disable
+ * path does), so the reset lands on an idle MDP.
+ *
+ * Only interfaces a CTL reports active are touched: an active interface is
+ * clocked, while an unused one (e.g. DP with its link clocks off) may not be
+ * safe to access at all. That needs the active-CTL register, DPU 5.0+.
+ *
+ * The caller must have the MDSS clocks enabled.
+ */
+void dpu_quiesce_bootloader_scanout(struct device *mdss_dev)
+{
+	const struct of_device_id *match = NULL;
+	const struct dpu_mdss_cfg *cfg;
+	struct device_node *np;
+	void __iomem *mmio;
+	u32 active = 0, fc_before[INTF_MAX] = {};
+	bool running[INTF_MAX] = {};
+	bool stopped = false;
+	int i, idx;
+
+	for_each_available_child_of_node(mdss_dev->of_node, np) {
+		match = of_match_node(dpu_dt_match, np);
+		if (match)
+			break;
+	}
+	if (!match)
+		return;
+
+	cfg = match->data;
+	if (cfg->mdss_ver->core_major_ver < 5) {
+		of_node_put(np);
+		return;
+	}
+
+	idx = of_property_match_string(np, "reg-names", "mdp");
+	mmio = of_iomap(np, idx < 0 ? 0 : idx);
+	of_node_put(np);
+	if (!mmio)
+		return;
+
+	for (i = 0; i < cfg->ctl_count; i++)
+		active |= readl_relaxed(mmio + cfg->ctl[i].base + DPU_CTL_INTF_ACTIVE);
+
+	for (i = 0; i < cfg->intf_count; i++) {
+		const struct dpu_intf_cfg *ic = &cfg->intf[i];
+		void __iomem *intf = mmio + ic->base;
+		int n = ic->id - INTF_0;
+
+		if (n < 0 || n >= INTF_MAX || !(active & BIT(n)))
+			continue;
+		if (!(readl_relaxed(intf + DPU_INTF_TIMING_ENGINE_EN) & BIT(0)))
+			continue;
+		running[n] = true;
+		fc_before[n] = readl_relaxed(intf + DPU_INTF_FRAME_COUNT);
+		writel_relaxed(0, intf + DPU_INTF_TIMING_ENGINE_EN);
+		stopped = true;
+	}
+
+	if (stopped) {
+		/*
+		 * Post the disables before waiting; two frames at 30 Hz, as the
+		 * disable latches at the next vsync.
+		 */
+		wmb();
+		msleep(70);
+		for (i = 0; i < cfg->intf_count; i++) {
+			const struct dpu_intf_cfg *ic = &cfg->intf[i];
+			void __iomem *intf = mmio + ic->base;
+			int n = ic->id - INTF_0;
+			u32 fc1, fc2;
+
+			if (n < 0 || n >= INTF_MAX || !running[n])
+				continue;
+			fc1 = readl_relaxed(intf + DPU_INTF_FRAME_COUNT);
+			msleep(20);
+			fc2 = readl_relaxed(intf + DPU_INTF_FRAME_COUNT);
+			dev_dbg(mdss_dev, "stopped bootloader scanout on %s (frame count %u -> %u, %s)\n",
+				ic->name, fc_before[n], fc2,
+				fc1 == fc2 ? "idle" : "STILL RUNNING");
+		}
+	}
+
+	iounmap(mmio);
+}
+
 static struct platform_driver dpu_driver = {
 	.probe = dpu_dev_probe,
 	.remove = dpu_dev_remove,
diff --git a/drivers/gpu/drm/msm/msm_kms.h b/drivers/gpu/drm/msm/msm_kms.h
index f25b31e502d2..abd41a2d22ee 100644
--- a/drivers/gpu/drm/msm/msm_kms.h
+++ b/drivers/gpu/drm/msm/msm_kms.h
@@ -240,4 +240,10 @@ static inline void msm_drm_kms_uninit(struct device *dev)
 
 #endif
 
+#ifdef CONFIG_DRM_MSM_DPU
+void dpu_quiesce_bootloader_scanout(struct device *mdss_dev);
+#else
+static inline void dpu_quiesce_bootloader_scanout(struct device *mdss_dev) {}
+#endif
+
 #endif /* __MSM_KMS_H__ */
diff --git a/drivers/gpu/drm/msm/msm_mdss.c b/drivers/gpu/drm/msm/msm_mdss.c
index 9087c4b290db..51f83503fc9f 100644
--- a/drivers/gpu/drm/msm/msm_mdss.c
+++ b/drivers/gpu/drm/msm/msm_mdss.c
@@ -369,10 +369,6 @@ static struct msm_mdss *msm_mdss_init(struct platform_device *pdev, bool is_mdp5
 	int ret;
 	int irq;
 
-	ret = msm_mdss_reset(&pdev->dev);
-	if (ret)
-		return ERR_PTR(ret);
-
 	msm_mdss = devm_kzalloc(&pdev->dev, sizeof(*msm_mdss), GFP_KERNEL);
 	if (!msm_mdss)
 		return ERR_PTR(-ENOMEM);
@@ -408,6 +404,22 @@ static struct msm_mdss *msm_mdss_init(struct platform_device *pdev, bool is_mdp5
 	msm_mdss->num_clocks = ret;
 	msm_mdss->is_mdp5 = is_mdp5;
 
+	/*
+	 * The bootloader may leave the MDSS scanning out a splash. Asserting
+	 * the core reset in that state can hang the SoC, so first stop the
+	 * timing engines (clocks on, to reach the registers), then gate the
+	 * core and bus clocks so nothing is in flight, and only then reset.
+	 */
+	ret = clk_bulk_prepare_enable(msm_mdss->num_clocks, msm_mdss->clocks);
+	if (ret)
+		return ERR_PTR(ret);
+	if (!is_mdp5)
+		dpu_quiesce_bootloader_scanout(&pdev->dev);
+	clk_bulk_disable_unprepare(msm_mdss->num_clocks, msm_mdss->clocks);
+	ret = msm_mdss_reset(&pdev->dev);
+	if (ret)
+		return ERR_PTR(ret);
+
 	msm_mdss->dev = &pdev->dev;
 
 	irq = platform_get_irq(pdev, 0);
-- 
2.55.0

