# Built aarch64 packages, produced by docker/Dockerfile.builder
# Arch Linux ARM's makepkg.conf does not use PKGEXT=.pkg.tar.zst -- match any
packages/*.pkg.tar.*

# Downloaded images
*.img
*.img.xz

# Python bytecode cache (bin/moarchy-one-app-per-workspace)
__pycache__/

# Built disk images
images/

# Image builder package cache
.cache/

# Built repository, uploaded to the `repo` release rather than committed.
# The whole reason for choosing Releases over Pages was to keep ~120 MB of
# binaries out of git history.
repo/dist/

# What a package build vouched for -- names, hashes, and the commit it came
# from. Untracked and ignored on purpose: it describes a local build directory,
# and scripts/build-image.sh refuses a tree with untracked files in it.
packages/.build-manifest
