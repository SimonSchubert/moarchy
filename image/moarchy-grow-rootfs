#!/bin/bash
# Expand the rootfs to fill the storage it was flashed onto, once.
#
#   moarchy-grow-rootfs [partition]
#
# The optional argument exists so this can be tested against a loop device
# instead of only ever running for the first time on someone's phone. With no
# argument it does what the unit does: grow whatever / is mounted from.
#
# Two devices, two different jobs (docs/devices.md D22):
#
#   PinePhone   the image is dd'd to a card whose size is unknown until it is
#               in a phone, so the PARTITION has to grow and the filesystem
#               follows it. The GPT being rewritten is one we wrote.
#
#   Pixel 3a    the rootfs is flashed to `userdata`, a partition the vendor
#               sized, inside a GPT full of partitions the bootloader needs.
#               Only the FILESYSTEM grows. Running sfdisk here would rewrite a
#               vendor partition table on a device with no recovery image and
#               no removable storage -- the one irreversible thing this project
#               could do to a phone.
set -euo pipefail

# Which of the two, from the installed device package. Not a probe: "is it safe
# to rewrite this device's partition table" is a policy about the hardware, not
# a fact discoverable from it. §4.1's bar for a key, met.
#
# The default is `filesystem`, the SAFE branch, and that direction is
# deliberate. A device package that forgets this key, or a rootfs where
# device.conf is somehow missing, gets a phone that wastes storage -- not one
# whose partition table was rewritten on a guess.
grow=filesystem
if [ -r /usr/share/moarchy/device/device.conf ]; then
  # shellcheck disable=SC1091
  . /usr/share/moarchy/device/device.conf
  grow=${DEVICE_GROW:-filesystem}
fi

root_src=${1:-$(findmnt -no SOURCE /)}    # e.g. /dev/mmcblk0p2
[ -n "$root_src" ] || exit 0

if [ "$grow" = partition ]; then
  disk=$(lsblk -no PKNAME "$root_src")    # e.g. mmcblk0
  [ -n "$disk" ] || exit 0
  part=${root_src##*p}

  # ",+" means "same start, grow to the end of the free space". --force because
  # sfdisk warns about rewriting a table it did not create.
  echo ", +" | sfdisk --no-reread --force -N "$part" "/dev/$disk" >/dev/null 2>&1 || true
  partprobe "/dev/$disk" >/dev/null 2>&1 || true
fi

# Both paths end here. On the filesystem-only path this is the whole job: the
# partition is already the size the vendor made it and the ext4 inside it is
# whatever the image build sized to contents plus slack.
resize2fs "$root_src" >/dev/null 2>&1 || true
