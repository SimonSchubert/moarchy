# The Google Pixel 3a (sargo), and the only place in the project that names it
# (docs/devices.md D1, D2).
#
# The second device, and the one the abstraction was built for. Everything
# here is either a dependency or a hardware value; not a line of shell, not a
# QML file, not a keybinding. If something device-shaped cannot be expressed in
# this package, the boundary is in the wrong place and devices.md §4 is the
# file to argue with.
#
# What is NOT here, and deliberately:
#
#   The boot image. A device package describes a running system; getting that
#   system onto flash is image/boot/android-bootimg.sh's job (D9). The two are
#   separate because the rootfs is device-independent (D8) and only the last
#   step is not.
#
#   Telephony. sargo's modem needs q6voiced and hexagonrpcd, neither of which
#   is packaged for Arch. DEVICE_SERVICES is empty and device.conf says so
#   rather than naming a unit that is not there -- moarchy-firstboot would warn
#   on every first boot for a feature nobody has built yet.

. "$startdir/../../scripts/manifest.sh"
_ver=$(manifest_get moarchy version) || return 1

pkgname=moarchy-device-sargo
pkgver=$_ver
# 2: gained a qbootctl dependency and the unit that marks the boot slot
# successful. The contents changed while pkgver did not, and pkgver comes from
# manifest.toml -- so without this bump docker/build-packages.sh keeps
# yesterday's file (it compares pkgver-pkgrel against PKGDEST) and a phone in
# the field sees no upgrade to take.
# 3: gained moarchy-qcom-modem, which is what gives this phone Wi-Fi (D27).
# 4: gained bootmac, which is what gives this phone Bluetooth (D28).
# 5: gained the ALSA use-case profile, which is what gives this phone audio
#    once Global_cal.acdb gives it a sound card at all (D29).
# 6: gained q6voiced and the PCM numbers it needs, without which a call
#    terminates the moment it is dialled (D32).
# 7: gained the camera colour profiles (D30), named as megapixels asks.
# 1 for 0.3.0: pkgver moved, and 0.3.0-1 is newer than the 0.2.2-7 the
# 20260915 image carries. Nothing in the package changed for it.
# 2: gained the speaker loudness stage -- swh-plugins, the tuning the filter
#    graph reads, and the symlink that enables moarchy-loudness.service (D34).
#    Never built under that number; it ships as 0.5.0-1, below.
#
# 1 for 0.5.0: pkgver moved, and 0.5.0-1 is newer than the 0.4.0-1 [moarchy]
# serves, so the loudness stage reaches a phone holding it rather than waiting
# on a pkgrel nobody published.
pkgrel=1
pkgdesc="Google Pixel 3a (sargo) hardware support for moarchy"
arch=('any')
url='https://github.com/SimonSchubert/moarchy'
license=('MIT')

# One device package at a time, enforced by pacman rather than by care (D4).
provides=('moarchy-device')
conflicts=('moarchy-device')

# linux-firmware-qcom carries qcom/a630_sqe.fw and qcom/a630_gmu.bin, the free
# Adreno microcode the GPU needs to come up at all.
#
# The SUBPACKAGE, and that is the whole point of this entry. Arch splits
# linux-firmware per vendor, and plain `linux-firmware` pulls in amd, amdgpu,
# atheros, broadcom, cirrus, intel, mediatek, nvidia, other, radeon, realtek,
# ti and whence -- every vendor except the one this phone is built on. The
# image had all thirteen and no qcom directory beyond what our own firmware
# package put there.
#
# What that cost: moarchy booted to a login on 2026-09-14 and sway died with
#   MESA: error: get_param:235: get-param failed: -6 (No such device or address)
#   [wlr] Failed to initialize EGL -> [sway/server.c:270] Failed to create renderer
# A phone that boots, autologins, and has no display server. The earlier
# `[drm:adreno_request_fw] *ERROR* failed to load qcom/a630_sqe.fw` seen under
# postmarketOS was the same missing file and was misread at the time as merely
# an artifact of their minimal initramfs.
#
# firmware-moarchy-sargo carries the proprietary half: the a615_zap shader the
# Adreno needs on top of that free microcode, plus adsp, cdsp, ipa_fws, venus,
# wlanmdsp and -- since 0.2.2-2 -- mba and modem. That is every path the device
# tree names, with nothing held back.
#
# moarchy-qcom-modem is Wi-Fi, which is not what its name suggests and is the
# reason that package's header is as long as it is. The short version: WCN3990's
# Wi-Fi firmware runs on the modem DSP, nothing in the kernel boots that DSP
# (`rproc->auto_boot = false`), and `rmtfs -s` is what does. Without this
# dependency the phone has a bound ath10k_snoc, a present board file, and no
# wlan0 -- which reads like a driver problem and is a missing daemon.
#
# linux-firmware-atheros is NOT named here and that is deliberate: `linux-firmware`
# already pulls it in (it is one of the thirteen vendor subpackages, unlike
# qcom), and it carries both ath10k/WCN3990/hw1.0/board-2.bin for Wi-Fi and
# qca/crbtfw21.tlv + qca/crnv21.bin for Bluetooth. Verified with `pacman -Fx`
# against the real database rather than read off the upstream git tree, which
# is the mistake that cost this device its GPU twice.
#
# bootmac is Bluetooth, for the same shape of reason moarchy-qcom-modem is
# Wi-Fi: WCN3990's controller has no BD address Linux can see, and bluez does
# not list an adapter that has none. hci0 exists, the firmware downloads, the
# daemon runs, and `bluetoothctl` says "No default controller available".
# Measured on the handset, and measured fixed (D28).
#
# alsa-ucm-conf-moarchy-sdm670 is the second half of audio. The first half is
# Global_cal.acdb in firmware-moarchy-sargo, without which qcom-q6core will not
# probe and there is no sound card at all; this is what makes the card, once it
# exists, appear to PipeWire as an earpiece, a speaker and a microphone rather
# than as nothing. Arch's alsa-ucm-conf has sdm845 and sc7180 and no sdm670.
#
# q6voiced is the third audio piece and the one that is a phone CALL rather
# than sound in general. The ADSP exposes VoiceMMode1 -- card 0, device 4 here
# -- and something must hold it open for the duration of a call. Nothing did,
# and a dial went `unknown -> terminated` at once.
#
# q6voiced.conf below is why those numbers live in this package: they are a
# hardware value (§4), and q6voiced's own unit is written to be skipped on a
# device that ships no config rather than to fail.
#
# swh-plugins is the speaker loudness stage, and it is here for the same reason
# the ALSA profile is: it is the difference between a phone that makes a sound
# and a phone somebody can hear. With every gain in the chain at its ceiling,
# music still reached these speakers at -17 dBFS RMS, because music's peaks are
# 15-20 dB above its average and the driver only ever sees the peaks. The SC4
# compressor and the fast lookahead limiter out of this package close that gap;
# loudness.conf below is the tuning, and moarchy (not this package) ships the
# unit that runs it. Measured: -10.8 dBFS RMS, peaks pinned at -0.5, nothing
# clipped (D34).
#
# qbootctl is what stops this phone bricking itself. An A/B bootloader counts
# down a retry counter on every handoff and marks the slot unbootable at zero
# unless the OS calls back; measured here as slot-retry-count:a:0 and
# slot-unbootable:a:yes, in which state the bootloader boots NOTHING -- a
# postmarketOS image that had worked an hour before failed the same way ours
# did (D26).
depends=(
  'linux-moarchy-sdm670'
  'linux-firmware'
  'linux-firmware-qcom'
  'firmware-moarchy-sargo'
  'moarchy-qcom-modem'
  'bootmac'
  'alsa-ucm-conf-moarchy-sdm670'
  'q6voiced'
  'qbootctl'
  'swh-plugins'
)

source=('sway.conf' 'device.conf' 'qbootctl-mark-successful.service' 'q6voiced.conf'
        'make-dcp.py' 'loudness.conf')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

# The camera colour profiles are GENERATED, not committed. make-dcp.py's header
# says why: a .dcp is a small TIFF whose payload is nine numbers twice over, and
# committing it as a binary would make the one thing worth reviewing the one
# thing nobody can read in a diff.
build() {
  python3 "$srcdir/make-dcp.py" "$srcdir/rear.dcp" "$srcdir/front.dcp"
}

package() {
  install -Dm644 "$srcdir/sway.conf"   "$pkgdir/usr/share/moarchy/device/sway.conf"
  install -Dm644 "$srcdir/device.conf" "$pkgdir/usr/share/moarchy/device/device.conf"

  printf 'codename=sargo\n' > "$srcdir/build-info"
  install -Dm644 "$srcdir/build-info" "$pkgdir/usr/share/moarchy/device/build-info"

  # Shipped ENABLED, by the symlink systemctl would create, rather than left to
  # moarchy-firstboot and DEVICE_SERVICES like the PinePhone's modem daemon.
  #
  # The difference is what failure costs. A modem that does not come up is a
  # phone with no calls; a slot that is never marked is a phone that stops
  # booting three reboots later, needing a computer with fastboot to revive.
  # DEVICE_SERVICES runs once, on the first boot, from a script that can fail
  # -- this must be true from the moment the package is installed, including in
  # an image that never completes a first boot.
  # Camera colour, by the names megapixels looks up: <compatible>,<camera>.dcp,
  # where <compatible> is the device tree's first compatible string and
  # <camera> is the libmegapixels section name VERBATIM.
  #
  # Both read off the device: /proc/device-tree/compatible gives
  # google,b4s4-sdm670, and a fixed megapixels says
  #
  #   No calibration found Front
  #
  # naming the capital-F section name it actually looks for. The PinePhone's
  # own profiles are lowercase and had suggested otherwise -- they are
  # evidently misnamed too, and inferring from them cost a round trip.
  #
  # Needs pkgbuilds/megapixels: Arch's 2.1.0 cannot find these wherever they
  # are put (devices.md D30).
  install -Dm644 "$srcdir/rear.dcp" \
    "$pkgdir/usr/share/megapixels/config/google,b4s4-sdm670,Rear.dcp"
  install -Dm644 "$srcdir/front.dcp" \
    "$pkgdir/usr/share/megapixels/config/google,b4s4-sdm670,Front.dcp"

  # The speaker tuning, read by moarchy-loudness.service through PipeWire's
  # own filter-chain.conf.d lookup. /usr/share rather than /etc because it is a
  # package's opinion and not an administrator's, and rather than ~/.config
  # because it has to be true for a user who has never logged in.
  install -Dm644 "$srcdir/loudness.conf" \
    "$pkgdir/usr/share/pipewire/filter-chain.conf.d/99-moarchy-loudness.conf"

  # Enabled here, like q6voiced above and for the same reason: moarchy ships
  # the unit for every device, and only a device that ships a filter graph has
  # anything for it to do.
  install -d "$pkgdir/usr/lib/systemd/user/pipewire.service.wants"
  ln -s ../moarchy-loudness.service \
    "$pkgdir/usr/lib/systemd/user/pipewire.service.wants/moarchy-loudness.service"

  # The voice PCM, read by q6voiced's unit as an EnvironmentFile. Device 4 is
  # VoiceMMode1 on this card -- confirmed against /proc/asound/pcm on the
  # handset rather than copied on faith.
  install -Dm644 "$srcdir/q6voiced.conf" "$pkgdir/usr/share/q6voiced/q6voiced.conf"

  # Enabled here rather than in q6voiced, for the same reason the config is
  # here: that package has no idea whether this device has a voice PCM, and a
  # unit enabled on a device with no config would sit there condition-skipped
  # on every boot of every other phone.
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../q6voiced.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/q6voiced.service"

  install -Dm644 "$srcdir/qbootctl-mark-successful.service" \
    "$pkgdir/usr/lib/systemd/system/qbootctl-mark-successful.service"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../qbootctl-mark-successful.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/qbootctl-mark-successful.service"
}
