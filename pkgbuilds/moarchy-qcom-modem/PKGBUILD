# The Qualcomm modem-side userspace -- and on SDM670, the thing Wi-Fi runs on.
#
# WHY A PHONE WITH NO TELEPHONY NEEDS A MODEM STACK:
#
# WCN3990's Wi-Fi firmware does not run on the Wi-Fi chip. `wlanmdsp.mbn`
# executes on the modem DSP as a protection domain, and `ath10k_snoc` talks to
# it over QMI. So the driver binding, the board file being present and the
# regulators coming up are all necessary and none of them is sufficient: if the
# modem DSP is not running, the WLAN service never appears on QRTR and the
# driver waits forever with nothing in dmesg that says "modem".
#
# Nothing in the kernel starts that DSP. `qcom_q6v5_mss.c` sets
# `rproc->auto_boot = false`, so the remoteproc sits there until userspace
# writes "start" to its `state` file -- and the thing that does that is rmtfs,
# whose `-s` flag runs `rproc_init()` (rmtfs's own rproc.c, hunting the
# `-mss-pil` modalias). The daemon named for the remote *filesystem* service is
# also the ignition, which is not something the name tells you.
#
# The three, and what each is actually for:
#
#   qrtr       libqrtr.so, the QMI/QRTR client library the other two link.
#              We ship the LIBRARY and not the qrtr-ns daemon -- net/qrtr's
#              Makefile is `qrtr-y := af_qrtr.o ns.o`, so the name service is
#              in the kernel and a second one in userspace would fight it.
#              Built -Dqrtr-ns=disabled so it cannot be started by accident.
#   rmtfs      Serves the modem its EFS partitions, and starts the DSP (-s).
#   tqftpserv  TFTP over QRTR; the modem reads files from the host through it.
#
# --- pd-mapper is NOT here, and that is the interesting one -----------------
#
# The protection-domain mapper answers "where does service X live", and
# ath10k's WLAN domain (msm/modem/wlan_pd) is one of the answers -- so it looks
# exactly like a thing this package must carry. It is not, because this kernel
# already is one: `drivers/soc/qcom/qcom_pd_mapper.c`, CONFIG_QCOM_PD_MAPPER=m
# in our config, with a compiled-in `sdm670_domains[]` table that includes
# `mpss_wlan_pd` and matches on `qcom,sdm670` -- which is sargo's second
# compatible. It is an auxiliary driver bound to `qcom_common.pd-mapper`, an
# aux device that `pdm_notify_prepare()` creates every time a remoteproc is
# started, so it loads itself as part of bringing the DSP up.
#
# Running linux-msm/pd-mapper beside it would put a SECOND server for
# `tms/servreg` on QRTR -- the same mistake as running qrtr-ns next to the
# kernel's name service, on the exact lookup that decides whether Wi-Fi comes
# up. Alpine does not package pd-mapper at all any more, for this reason.
#
# The kernel says so itself when it cannot help: "PDM: no support for the
# platform, userspace daemon might be required." A device whose SoC is not in
# that table is the case for adding this back, and nothing else is.
#
# --- Why one package for three upstreams ------------------------------------
#
# This is the one place this repo bends its own "an upstream gets a package
# under its own name" rule (qbootctl is the model), and the reason is the build
# system rather than taste. rmtfs and tqftpserv link libqrtr, and
# docker/build-packages.sh builds every in-repo package with --nodeps: the
# packages it produces are never installed into the builder, so there is no
# point at which a built `qrtr` package could be there for a `rmtfs` package to
# link against. One recipe that stages qrtr and builds the rest against it
# needs no new concept in the build system at all.
#
# The three upstream versions are NOT hidden by this: they are pinned
# separately in manifest.toml and restated in provides(), so `pacman -Si` names
# each one. The package's own pkgver is moarchy's, like every other in-repo
# package.
#
# Not device-scoped, though only sargo pulls it in today: nothing here is
# sargo-specific, and any other Qualcomm handset is the same shape
# (devices.md D0, D27).

. "$startdir/../../scripts/manifest.sh"
_ver=$(manifest_get moarchy version) || return 1

_qrtr_url=$(manifest_get qrtr url)   || return 1
_qrtr_ref=$(manifest_get qrtr ref)   || return 1
_qrtr_ver=$(manifest_get qrtr version) || return 1

_rmtfs_url=$(manifest_get rmtfs url) || return 1
_rmtfs_ref=$(manifest_get rmtfs ref) || return 1
_rmtfs_ver=$(manifest_get rmtfs version) || return 1

_tqf_url=$(manifest_get tqftpserv url) || return 1
_tqf_ref=$(manifest_get tqftpserv ref) || return 1
_tqf_ver=$(manifest_get tqftpserv version) || return 1

pkgname=moarchy-qcom-modem
pkgver=$_ver
pkgrel=1
pkgdesc="Qualcomm modem-side userspace: qrtr, rmtfs, tqftpserv"
arch=('aarch64')
url='https://github.com/linux-msm'
license=('BSD-3-Clause')

# glibc for pthreads, systemd-libs for libudev (rmtfs), zstd for tqftpserv's
# decompressor. No liblzma: that was pd-mapper's, and pd-mapper is not here.
depends=('glibc' 'systemd-libs' 'zstd')
makedepends=('meson' 'ninja' 'pkgconf' 'gcc' 'make')

# The upstream versions, said out loud. This package installs the files those
# names would, so a future Arch or AUR package of any of them is a clean swap
# rather than a file conflict discovered at install time.
provides=("qrtr=$_qrtr_ver" "rmtfs=$_rmtfs_ver" "tqftpserv=$_tqf_ver")
conflicts=('qrtr' 'rmtfs' 'tqftpserv')

# Tags, verified by checksum rather than trusted (structure.md P10). A tag can
# be moved by whoever owns the repo; the checksum is the only thing that
# notices when it is.
source=("qrtr-$_qrtr_ver.tar.gz::$_qrtr_url/archive/refs/tags/$_qrtr_ref.tar.gz"
        "rmtfs-$_rmtfs_ver.tar.gz::$_rmtfs_url/archive/refs/tags/$_rmtfs_ref.tar.gz"
        "tqftpserv-$_tqf_ver.tar.gz::$_tqf_url/archive/refs/tags/$_tqf_ref.tar.gz")
sha256sums=('7a82bf80246fe71287b13c66c0466208822e8337fcd4aaf302eee6c5fcb48a52'
            '4b6c398806a1046e2256a685d592833de0f37b7245b8adc4797e1791f0e117ee'
            'a3850c34e48f23b7bc360d70f1e91700de2f8c60af003eda93e14182f8cf6af1')

build() {
  # --- qrtr first, into a staging tree the other two build against ----------
  #
  # -Dsystemd-service=disabled keeps qrtr-ns.service out of the package. The
  # binary is already excluded by -Dqrtr-ns=disabled; this stops a unit for a
  # binary that is not there from shipping alongside it.
  arch-meson "qrtr-$_qrtr_ver" build-qrtr \
    -Dqrtr-ns=disabled \
    -Dsystemd-service=disabled
  meson compile -C build-qrtr
  DESTDIR="$srcdir/stage" meson install -C build-qrtr --no-rebuild

  # pkg-config against that staging tree by rewriting the one .pc file, NOT by
  # setting PKG_CONFIG_SYSROOT_DIR. The sysroot applies to every .pc pkg-config
  # resolves, so it would also rewrite libzstd's -I and -L to point inside a
  # prefix that has no zstd in it -- and tqftpserv would fail to find a
  # dependency that is installed and correct.
  install -d "$srcdir/pc"
  sed "s|^prefix=.*|prefix=$srcdir/stage/usr|" \
    "$srcdir/stage/usr/lib/pkgconfig/qrtr.pc" > "$srcdir/pc/qrtr.pc"
  export PKG_CONFIG_PATH="$srcdir/pc"

  # rmtfs's Makefile build gets these through the ENVIRONMENT, never as
  # `make CFLAGS=...`. Its makefile says `LDFLAGS += -lqrtr -ludev -lpthread`,
  # and a variable set on make's command line overrides a makefile's `+=` outright
  # -- which drops -lqrtr and fails the link with an undefined-reference wall
  # that says nothing about the flag that caused it.
  export CFLAGS="$CFLAGS -I$srcdir/stage/usr/include"
  export LDFLAGS="$LDFLAGS -L$srcdir/stage/usr/lib"

  make -C "rmtfs-$_rmtfs_ver"

  # -Dsystemd-unit-prefix explicitly, rather than letting meson ask systemd.pc
  # where units go. The builder has systemd-libs and need not have systemd, and
  # tqftpserv's meson.build leaves systemd_system_unit_dir UNDEFINED when both
  # branches miss -- which is a meson error about an unknown variable, three
  # lines from anything that mentions systemd.
  arch-meson "tqftpserv-$_tqf_ver" build-tqftpserv \
    -Dsystemd-unit-prefix=/usr/lib/systemd/system
  meson compile -C build-tqftpserv

  # What is provable without a phone, and worth proving: that the binaries
  # exist, are for the phone rather than the builder, and that the two
  # daemons are linked against libqrtr rather than having quietly built without
  # it. Asserted here and NOT in check(), because docker/build-packages.sh
  # builds with --nocheck: a check() in this repo never runs, and a test that
  # cannot fail is worse than no test (qbootctl says the same).
  local b
  for b in "$srcdir/stage/usr/bin/qrtr-cfg" \
           "$srcdir/rmtfs-$_rmtfs_ver/rmtfs" \
           "$srcdir/build-tqftpserv/tqftpserv"; do
    [ -f "$b" ] || { echo "!! $b was not built"; return 1; }
    readelf -h "$b" | grep -q 'AArch64' ||
      { echo "!! $b is not an AArch64 binary"; return 1; }
  done
  for b in "$srcdir/rmtfs-$_rmtfs_ver/rmtfs" \
           "$srcdir/build-tqftpserv/tqftpserv"; do
    readelf -d "$b" | grep -q 'libqrtr\.so' ||
      { echo "!! $(basename "$b") is not linked against libqrtr"; return 1; }
  done
}

package() {
  DESTDIR="$pkgdir" meson install -C build-qrtr      --no-rebuild
  DESTDIR="$pkgdir" meson install -C build-tqftpserv --no-rebuild

  # prefix on the command line is right here and wrong in build(): these
  # makefiles use it only for install paths and for the sed that turns
  # *.service.in into *.service, so the unit that ships names /usr/bin/rmtfs
  # rather than /usr/local/bin/rmtfs -- a unit that installs cleanly and fails
  # at every boot with status=203/EXEC.
  make -C "rmtfs-$_rmtfs_ver" DESTDIR="$pkgdir" prefix=/usr install

  # Shipped ENABLED, by the symlink `systemctl enable` would write, for the
  # same reason moarchy-device-sargo ships qbootctl's unit enabled: installing
  # this package IS the decision to run these, there is nothing to configure
  # first, and the alternative (moarchy-firstboot and DEVICE_SERVICES) runs
  # once, from a script that can fail, on a boot an image may never complete.
  #
  # rmtfs.service carries ConditionPathExists=/dev/qcom_rmtfs_mem1 and upstream
  # also ships a udev rule that pokes it when the node appears. The number is
  # not a guess: the kernel names the node after the DT's qcom,client-id
  # (`dev_set_name(... "qcom_rmtfs_mem%d", client_id)`), and
  # sdm670-google-common.dtsi sets client-id 1. Get that wrong and the unit is
  # enabled, correct, and silently skipped forever.
  #
  # rmtfs-dir.service is installed by upstream's `make install` and is left
  # DISABLED on purpose. It is the other storage backend (-o <dir> instead of
  # -P), which on this phone would hand the modem an empty directory in place
  # of its real EFS partitions: a radio that comes up uncalibrated rather than
  # one that does not come up. Two units for one daemon is a footgun, so only
  # one of them is wanted by anything.
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  local u
  for u in rmtfs.service tqftpserv.service; do
    [ -f "$pkgdir/usr/lib/systemd/system/$u" ] ||
      { echo "!! $u was not installed -- nothing would start"; return 1; }
    ln -s "../$u" "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/$u"
  done

  install -Dm644 "$srcdir/qrtr-$_qrtr_ver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.qrtr"
  install -Dm644 "$srcdir/rmtfs-$_rmtfs_ver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.rmtfs"
  install -Dm644 "$srcdir/tqftpserv-$_tqf_ver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.tqftpserv"
}
