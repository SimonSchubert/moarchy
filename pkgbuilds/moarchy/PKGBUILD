# The phone layer itself: bin/, default/ and config/, and nothing else
# (docs/structure.md P1).
#
# `pacman -Ql moarchy` lists no path under /home. Almost nothing is copied into
# $HOME at all -- each thing the old installer wrote there has a system path
# that the reader already checks:
#
#   ~/.config/sway/config            -> sway -c /usr/share/moarchy/config/sway/config
#   ~/.config/omarchy/plugins/       -> /usr/share/moarchy/plugins  (PluginRegistry, patched)
#   ~/.config/omarchy/themed/*.tpl   -> /usr/share/omarchy/default/themed
#   ~/.config/omarchy/shell.json     -> omarchy-config's defaults, patched
#   ~/.config/fontconfig/conf.d/     -> /etc/fonts/conf.d
#   ~/.config/systemd/user/          -> /usr/lib/systemd/user, /etc/systemd/user
#   ~/.bash_profile exec sway        -> /etc/profile.d (same file as the PATH)
#
# What is left needs a running user or a live system, and runs once from
# moarchy-firstboot.service and moarchy-user-setup.service (P8).

. "$startdir/../../scripts/manifest.sh"
_ver=$(manifest_get moarchy version) || return 1
_repo="$startdir/../.."

pkgname=moarchy
pkgver=$_ver
# 1 -- and what that covers is recorded in packages/.build-manifest, not here.
#
# An earlier version of this comment enumerated the commits the bump carried.
# That was wrong within the hour: it named two, a third landed the same evening
# touching default/ and bin/ without coming near this file, and the list was
# stale while reading as authoritative. Several sessions commit to this repo,
# and a comment cannot track them.
#
# What holds instead: pkgrel moves when the package's CONTENT has changed since
# the last artifact that was PUBLISHED, and .build-manifest's commit= says which
# tree a given artifact was built from. An unpublished artifact can simply be
# rebuilt from a newer HEAD under the same version -- no device holds it, so
# nothing is hidden from anything. Rebuild before publishing, and read commit=
# to know what you have.
#
# The reason this matters keeps recurring and is worth keeping. The polkit rule
# and the dropped fullscreen rule were content changes with no version change
# behind them, and pacman compares versions, not contents -- so a phone in the
# field would not have seen either. An image installs fresh and hides that
# completely; only a device already running the old package can tell you. Same
# trap manifest.toml records for the keyboard.
# Back to 1 at a pkgver bump, and the paragraphs above are why that is safe
# rather than a reset that loses something. It went back to 1 for 0.2.0 the
# same way, off 0.1.1.
#
# 1 for 0.2.2, and this is the quiet case: the line does not move at all.
# 0.2.1 shipped as -1 and nothing took a 2 during the cycle, so there is no
# reset here and nothing a reset could walk past. 0.2.2-1 is newer than the
# 0.2.1-1 the [moarchy] repo publishes and than every number before it, so
# pacman offers it to every phone whatever it holds.
#
# What has changed inside the package since that published 0.2.1-1 is the theme
# picker, and it is content rather than metadata: moarchy.themes spawned
# omarchy-theme-set at $OMARCHY_PATH/bin, a directory omarchy-config does not
# create, so the header sat on "Applying..." forever and no theme was ever
# applied. default/ is copied wholesale into this package, so that fix ships
# here -- which is exactly the case the paragraphs above say a version has to
# move for. The pkgver is what moves for it.
#
# 2, and the paragraph above is why: 0.2.2-1 stopped being an unpublished
# artifact. The [moarchy] repo publishes it now -- `moarchy.db` names
# moarchy-0.2.2-1 -- so a phone in the field holds these exact bytes, and this
# build has different ones: bin/omarchy-theme-set-gnome, the two GTK templates
# it points at, the web app entries and the schema override (docs/style.md
# I1a/I5, docs/apps.md B1-B4), and the shade and back-edge changes in the
# plugins (docs/shade.md S24-S27, gestures.md G10b). Under an unchanged version
# pacman would compare 0.2.2-1 to 0.2.2-1 and offer nothing, and every one of
# those would sit in a package nobody ever receives.
#
# 3, and it is the paragraph about "PUBLISHED" above collecting on its own
# terms. 0.2.2-2 was unpublished for most of 2026-09-13 -- the [moarchy] repo
# still serves 0.2.2-1 -- so it was rebuilt from a newer HEAD four times under
# one version, which those paragraphs explicitly allow because "no device holds
# it". The 20260913 image ended that: the card was flashed, and the phone is
# holding these exact bytes. The premise is false now, so the waiver is spent.
#
# What this build has that 0.2.2-2 does not: bin/omarchy-default-editor and
# bin/omarchy-launch-editor, two new shadows that make GNOME Text Editor the
# default editor now that neovim has left the set (moarchy-meta, docs/apps.md);
# omarchy-launch-config-editor routed through the second of them; the editor
# rows in moarchy.settings; and moarchy-user-setup seeding the choice and the
# text/* handlers on first boot. A phone holding 0.2.2-2 has neovim, no
# gnome-text-editor default, and both upstream scripts falling back to a binary
# that its next upgrade removes -- so this is precisely the case the rule is
# for.
# 4: bin/moarchy-sim and the moarchy.sim plugin. Both are shipped by this
# package, and pkgver comes from manifest.toml -- without the bump the builder
# keeps the existing artifact and the new screen reaches no phone.
# 5: 73-moarchy-torch.rules, which is the whole reason the Torch tile appears
#    on a device that has a flash LED (docs/shade.md S10a). A phone holding
#    0.2.2-4 shows three tiles and nothing anywhere says why, so this is a
#    bump a field upgrade has to carry.
# 6: bin/moarchy-launch-files opens the Files plugin. $mod+f is the binding,
#    and without this bump a phone holding 0.2.2-5 still walks nautilus /
#    thunar / a TUI and never the app the image now ships.
# 7: grok's wrapper pins 1.0.25. 1.0.30's linux-aarch64 TUI executes
#    sha512su0 and SIGILLs on this SoC; a phone holding 0.2.2-6 writes
#    omarchy-mise-install's unversioned wrapper and upgrades to it on
#    every tap (docs/settings.md P13).
# 8 was never built under that number; it ships as 0.3.0-1, below.
#    The editor is the Text Editor plugin now. omarchy-launch-editor and
#    omarchy-default-editor fall back to moarchy-editor, moarchy-user-setup
#    seeds it and points text/* at its hidden desktop entry, and Settings
#    offers it first. Without the bump the builder keeps the 0.2.2-7 artifact,
#    and an image without gnome-text-editor would carry scripts that fall back
#    to it -- every "edit this", git commit included, asking for a binary the
#    image does not have.
#    The same unbuilt release stops shipping calls-daemon.service and
#    sm.puri.Chatty-daemon.service, and their default.target.wants links: the
#    Phone and Messages plugins replace gnome-calls and chatty, and those two
#    units exist only to start daemons the image no longer has.
#
# 1 for 0.3.0. pkgver moved, and 0.3.0-1 is newer than every 0.2.2-N above,
# including the -7 the 20260915 images carry, so going back to 1 hides nothing
# from a phone holding any of them.
# 2 was never built under that number; it ships as 0.4.0-1, below.
#    Mobile data. The gsm connection profile and bin/moarchy-data are both
#    files this package ships, so a phone holding 0.3.0-1 has a modem that
#    registers, carries calls and SMS, and cannot raise a data bearer at all --
#    with nothing on screen to say why, because the tile is absent without the
#    script (docs/devices.md D33, docs/shade.md S29).
#
# 1 for 0.4.0. pkgver moved, and 0.4.0-1 is newer than the 0.3.0-1 [moarchy]
# serves today, so mobile data reaches a phone holding it -- as does the rest
# of what this build has over that one: the overview plugin on the right edge,
# two apps on one workspace, and moarchy-selftest's checks for both.
# 4: ships moarchy-loudness.service, the generic half of the speaker loudness
# stage. The tuning that unit reads is a hardware value and lives in the device
# package, which is also what enables it (devices.md D34).
#    2, 3 and 4 were all built and none was ever published: [moarchy] serves
#    0.4.0-1, so everything they carry reaches a phone as 0.5.0-1 instead.
#
# 1 for 0.5.0. pkgver moved, and 0.5.0-1 is newer than the 0.4.0-1 [moarchy]
# serves today, so nothing the four bumps above added is hidden from a phone
# holding it: the loudness unit, the volume panel and moarchy-volume behind it,
# moarchy-trigger and the four configurable gestures, the overview's bin, and
# the drawer's launch hop reading occupancy from focus rather than from sway's
# workspace representation.
#
# 2: the PinePhone is gone. This package carries no hardware, so what actually
#    moved is comment-level in bin/ and one rationale in moarchy.settings --
#    but 0.5.0-1 IS published, so a build at 0.5.0-1 is skipped by
#    docker/build-packages.sh and the tree would ship yesterday's bytes while
#    reporting success. The bump is what makes the build happen.
pkgrel=2
pkgdesc="Omarchy's look, keybindings and theming on a phone, under Sway"
arch=('any')
url='https://github.com/SimonSchubert/moarchy'
license=('MIT')
# The last three are new here, and they are a fix rather than an addition. Each
# has always been a dependency of this package and none of them was declared:
#
#   foot          bin/moarchy-launch-tui execs it by name -- it is the terminal
#                 every TUI, and omarchy-launch-floating-terminal-with-
#                 presentation, opens in.
#   polkit-gnome  default/sway/autostart.conf execs
#                 polkit-gnome-authentication-agent-1.
#   upower        moarchy.bar's battery is `import Quickshell.Services.UPower`,
#                 which talks to upowerd over DBus. No grep for a binary name
#                 finds this one, which is why it survived longest.
#
# Nothing noticed because moarchy-meta lists foot and polkit-gnome too, and on a
# phone built from moarchy-meta that is indistinguishable from being declared
# here. upower is not even in moarchy-meta: it is on the phone only as a
# transitive dependency of KWeather.
#
# The drawer's uninstall (docs/gestures.md L12) is what made the difference
# visible. It refuses to remove a package another package needs, and treats
# moarchy-meta -- a depends line with no files, which every app on the phone is
# under -- as the record of the set rather than as a need. Measured on the
# device against all 34 entries the drawer lists, before this line changed:
#
#   foot      "Removes 2 packages" -- the terminal, offered for removal
#   kweather  "Removes 40 packages", upower among them, because `pacman -Rs`
#             takes dependencies nothing else needs and nothing else declared
#             it -- so removing the weather app takes the battery indicator
#
# So the protection is metadata being right rather than a second list of what
# matters (docs/structure.md P5). grim is in the same position --
# bin/moarchy-capture-screenshot execs it -- and is left out here only because it
# ships no .desktop file and cannot be reached from the drawer; it is worth
# declaring on its own merits. A browser is deliberately NOT in this list:
# bin/moarchy-launch-browser is a fallback chain over four of them and says so.
# feedbackd is here for its GROUP, not for its daemon: 73-moarchy-torch.rules
# chgrps the flash LED to `feedbackd`, and that group is created by feedbackd's
# sysusers file. Without the package the chgrp fails, udev shrugs, and the
# Torch tile is missing with nothing saying why -- exactly the failure the rule
# exists to end. It arrives anyway through megapixels; naming it here is what
# makes that a fact rather than a coincidence. The Phone and Messages plugins
# ring through its fbcli as well, and gnome-calls, which used to be the second
# thing pulling it in, has left the set.
depends=('bash' 'sway' 'hyprland' 'omarchy-config' 'foot' 'polkit-gnome' 'upower' 'feedbackd')
source=()

package() {
  # --- bin/ -- NOT /usr/bin ------------------------------------------------
  # 19 of these names are also upstream Omarchy's, and two packages cannot own
  # the same path. /etc/profile.d/zz-moarchy.sh puts this directory ahead of
  # /usr/bin, which is the same shadowing the old installer arranged in
  # ~/.profile with MOARCHY_PATH/bin before OMARCHY_PATH/bin.
  install -d "$pkgdir/usr/lib/moarchy/bin"
  for f in "$_repo"/bin/*; do
    [ -f "$f" ] && install -Dm755 "$f" "$pkgdir/usr/lib/moarchy/bin/$(basename "$f")"
  done

  # --- default/ and config/ ------------------------------------------------
  # The sway .conf fragments are included by absolute path from
  # /etc/sway/config, so they have to be here rather than in $HOME.
  install -d "$pkgdir/usr/share/moarchy"
  cp -a "$_repo/default" "$pkgdir/usr/share/moarchy/default"
  cp -a "$_repo/config"  "$pkgdir/usr/share/moarchy/config"
  # Subdirectories of default/ that are installed to their real homes below
  # rather than shipped twice.
  rm -rf "$pkgdir/usr/share/moarchy/default/etc" \
         "$pkgdir/usr/share/moarchy/default/systemd" \
         "$pkgdir/usr/share/moarchy/default/fontconfig" \
         "$pkgdir/usr/share/moarchy/default/omarchy" \
         "$pkgdir/usr/share/moarchy/default/themed" \
         "$pkgdir/usr/share/moarchy/default/pacman-hooks" \
         "$pkgdir/usr/share/moarchy/default/polkit" \
         "$pkgdir/usr/share/moarchy/default/udev" \
         "$pkgdir/usr/share/moarchy/default/NetworkManager" \
         "$pkgdir/usr/share/moarchy/default/applications" \
         "$pkgdir/usr/share/moarchy/default/glib-schemas" \
         "$pkgdir/usr/share/moarchy/default/agents"

  # --- the coding-agent tile icons ------------------------------------------
  # Not in an icon theme, and that is the point. moarchy-agent writes the
  # drawer tile with `Icon=` set to one of these ABSOLUTE paths, because
  # AppLibrary.iconSource() returns a file URL for anything starting with "/"
  # and never consults the theme -- the same reason moarchy.device's entry does
  # it, given at length in moarchy.device/icon.svg.
  #
  # It is not a preference here so much as the only thing that works: no agent
  # has an icon in Adwaita, breeze or hicolor, so before these the tile was
  # `system-run`, a stock glyph the grid already draws for two other apps.
  #
  # One per agent moarchy-agent knows, plus setup.svg -- the tile a phone draws
  # before any agent is picked. moarchy-selftest asserts that correspondence in
  # both directions, and asserts setup.svg separately, because an agent with no
  # icon falls back to `system-run` and an icon with no agent is dead weight
  # nothing will notice.
  # `install -d` then a plain copy, not `install -Dm644 <glob> <dir>/`: -D takes
  # a single SOURCE and a DEST, and needs -t to accept several. It silently does
  # the wrong thing with a glob rather than failing.
  install -d "$pkgdir/usr/share/moarchy/agents"
  install -m644 "$_repo"/default/agents/*.svg "$pkgdir/usr/share/moarchy/agents/"

  # --- the shell plugins ---------------------------------------------------
  # PluginRegistry scans this directory before ~/.config/omarchy/plugins, so a
  # user copy of the same id still wins. Every directory in
  # default/omarchy/plugins/ -- they used to be copied into every home and are
  # upgraded now by upgrading the package. Deliberately not counted here: the
  # count moves and a number in a comment does not.
  #
  # Not every directory under it is a plugin. moarchy.common carries no
  # manifest.json and is imported by relative path from the ones that are
  # (docs/refactor.md E1, E8); the registry's scan skips it because the scan
  # is keyed on the manifest, which is verified on the device rather than
  # assumed. It ships with the rest because `cp -a` takes the tree, and it has
  # to: a plugin whose import target did not ship would fail to load.
  install -d "$pkgdir/usr/share/moarchy/plugins"
  cp -a "$_repo"/default/omarchy/plugins/. "$pkgdir/usr/share/moarchy/plugins/"

  # A plugin that ships a .desktop wants to be launchable like an app: the
  # drawer lists desktop entries, not plugins. Moved out of the plugin
  # directory rather than copied, so the shell does not also scan it there.
  install -d "$pkgdir/usr/share/applications"
  find "$pkgdir/usr/share/moarchy/plugins" -name '*.desktop' -type f |
    while read -r entry; do
      install -Dm644 "$entry" "$pkgdir/usr/share/applications/$(basename "$entry")"
      rm -f "$entry"
    done

  # --- the web apps ---------------------------------------------------------
  # Two of upstream's own entries, each with the StartupWMClass upstream has no
  # reason to carry and this phone cannot do without (docs/apps.md B2-B3).
  # /usr/share/applications rather than a copy into every home, for the same
  # reason as everything else here: upgrading the package upgrades the phone.
  # The artwork they name comes from pkgbuilds/omarchy-config, which is where
  # the tree it lives in is vendored.
  install -m644 "$_repo"/default/applications/*.desktop \
    "$pkgdir/usr/share/applications/"

  # The mobile user agent (B4). /usr/share/glib-2.0/schemas because an override
  # is compiled together with the schema it overrides, and Epiphany's is there;
  # pacman's glib2 hook recompiles the directory, so this needs no hook of ours.
  install -Dm644 "$_repo/default/glib-schemas/99-moarchy.gschema.override" \
    "$pkgdir/usr/share/glib-2.0/schemas/99-moarchy.gschema.override"

  # --- the theme templates -------------------------------------------------
  # omarchy-theme-set-templates globs the user directory and then
  # $OMARCHY_PATH/default/themed, so dropping them there themes Sway and every
  # GTK app from the theme's own colors.toml with nothing copied into a home
  # and nothing patched upstream (docs/style.md I1a).
  #
  # sway.conf.tpl is the one /etc/sway/config includes; gtk.css.tpl and
  # gtk3.css.tpl are read through the two symlinks omarchy-theme-set-gnome
  # makes. A glob rather than three named lines: the directory is the list.
  install -d "$pkgdir/usr/share/omarchy/default/themed"
  install -m644 "$_repo"/default/themed/*.tpl \
    "$pkgdir/usr/share/omarchy/default/themed/"

  # The documented default for ~/.config/omarchy/ui.toml. Not copied into a
  # home (P1): missing is the same values, and the first write from
  # moarchy-ui or the theme switcher creates the user file.
  install -Dm644 "$_repo/default/omarchy/ui.toml" \
    "$pkgdir/usr/share/moarchy/ui.toml"

  # --- /etc ----------------------------------------------------------------
  install -Dm644 "$_repo/default/etc/profile.d/zz-moarchy.sh" \
    "$pkgdir/etc/profile.d/zz-moarchy.sh"
  install -Dm644 "$_repo/default/etc/systemd/logind.conf.d/10-power-key.conf" \
    "$pkgdir/etc/systemd/logind.conf.d/10-power-key.conf"

  # Lift Regular to SemiBold for the UI font, system-wide. The shell has 336
  # Text sites across upstream and our plugins, none of which inherit a weight,
  # so there is no one place in QML to set this -- and doing it in fontconfig
  # brings every GTK and Qt app along, which is the point.
  install -Dm644 "$_repo/default/fontconfig/50-moarchy-weight.conf" \
    "$pkgdir/etc/fonts/conf.d/50-moarchy-weight.conf"

  install -Dm644 "$_repo/default/pacman-hooks/50-moarchy-shell-reload.hook" \
    "$pkgdir/usr/share/libalpm/hooks/50-moarchy-shell-reload.hook"

  # The Hyprland reload guard, both halves. Upstream ships an equivalent pair
  # under its own default/libalpm/hooks/, but they name `omarchy-settings` --
  # a package that does not exist here -- so they never fire and are never
  # installed. The hooks themselves say what they prevent.
  install -Dm644 "$_repo/default/pacman-hooks/10-moarchy-hyprland-reload-pause.hook" \
    "$pkgdir/usr/share/libalpm/hooks/10-moarchy-hyprland-reload-pause.hook"
  install -Dm644 "$_repo/default/pacman-hooks/90-moarchy-hyprland-reload-resume.hook" \
    "$pkgdir/usr/share/libalpm/hooks/90-moarchy-hyprland-reload-resume.hook"

  # The image locks the account password, so the store's pkexec action could
  # never be authenticated and the store could install nothing. /usr/share, not
  # /etc: this is a package's rule and /etc/polkit-1/rules.d stays free for the
  # user to override it. Harmless if moarchy-store is not installed -- polkit
  # matches on the action id, which then simply never appears.
  install -Dm644 "$_repo/default/polkit/49-moarchy-store.rules" \
    "$pkgdir/usr/share/polkit-1/rules.d/49-moarchy-store.rules"

  # The torch tile's permission. 73 so it runs after feedbackd's 72, which
  # tries to do this and cannot on Arch -- the rule's own header has the whole
  # story, and docs/shade.md S10a is the criterion. /usr/lib, not /etc, for the
  # same reason as the polkit rule above: this is the package's, and the
  # override path stays free.
  install -Dm644 "$_repo/default/udev/73-moarchy-torch.rules" \
    "$pkgdir/usr/lib/udev/rules.d/73-moarchy-torch.rules"

  # Mobile data, which is one file and no script. A NetworkManager profile has
  # a system path of its own, and P8's rule is that a thing with a system path
  # belongs in a package rather than in moarchy-firstboot. /usr/lib for the
  # same reason as the two rules above, plus one of its own: image/verify.sh
  # counts the profiles in /etc to catch a baked-in credential, and this has
  # none to bake. docs/devices.md D33 is the criterion.
  #
  # 0600, and not out of caution about a secret -- there is no secret in it.
  # NetworkManager's keyfile reader refuses any profile the group or the world
  # can read, wherever it lives, with one journal line nobody is watching:
  # "File permissions (100644) are insecure". The profile is then simply absent
  # from `nmcli c show` and the phone has no mobile data. Measured on sargo
  # 2026-09-17, where this file's first install shipped 0644 and did nothing.
  install -Dm600 "$_repo/default/NetworkManager/system-connections/moarchy-mobile-data.nmconnection" \
    "$pkgdir/usr/lib/NetworkManager/system-connections/moarchy-mobile-data.nmconnection"

  # --- systemd -------------------------------------------------------------
  install -Dm644 "$_repo/default/systemd/system/moarchy-firstboot.service" \
    "$pkgdir/usr/lib/systemd/system/moarchy-firstboot.service"
  install -Dm644 "$_repo/default/systemd/system/moarchy-led-perms.service" \
    "$pkgdir/usr/lib/systemd/system/moarchy-led-perms.service"
  install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../moarchy-firstboot.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/moarchy-firstboot.service"
  ln -s ../moarchy-led-perms.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/moarchy-led-perms.service"

  install -Dm644 "$_repo/default/systemd/user/moarchy-user-setup.service" \
    "$pkgdir/usr/lib/systemd/user/moarchy-user-setup.service"

  # Installed, NOT enabled. It is WantedBy=pipewire.service, and the symlink
  # that pulls it in belongs to whichever device package ships a filter-chain
  # fragment for it to run -- the same split as q6voiced, and for the same
  # reason: a unit enabled on a phone with nothing to run would be a
  # condition-skipped line in every boot of every other device.
  install -Dm644 "$_repo/default/systemd/user/moarchy-loudness.service" \
    "$pkgdir/usr/lib/systemd/user/moarchy-loudness.service"
  install -Dm644 "$_repo/default/systemd/moarchy-session.target" \
    "$pkgdir/usr/lib/systemd/user/moarchy-session.target"

  # No calls-daemon.service or sm.puri.Chatty-daemon.service. Until 2026-09-16
  # this installed same-named replacements for both into /etc/systemd/user,
  # because gnome-calls and chatty shipped them with
  # `Requisite=gnome-session-initialized.target` and under sway that target
  # never exists (an empty Requisite= in a drop-in does not clear it). The
  # Phone and Messages plugins replaced both apps, and the shell that keeps
  # them loaded is the daemon now.
  install -d "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../moarchy-user-setup.service \
    "$pkgdir/usr/lib/systemd/user/default.target.wants/moarchy-user-setup.service"
}
