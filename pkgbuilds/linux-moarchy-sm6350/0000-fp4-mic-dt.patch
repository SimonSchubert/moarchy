 &q6asmdai {
+	/*
+	 * Two front ends, split by direction.
+	 *
+	 * q6asm-dais builds its DAI list from these child nodes -- there is no
+	 * default set -- so a dai-link naming MULTIMEDIA2 without a dai@1 here
+	 * fails the whole card with "MultiMedia2: error getting cpu dai name".
+	 *
+	 * Splitting them rather than declaring one full-duplex front end is the
+	 * point: with a single front end, playback and capture contend for one
+	 * q6asm session and the second opener is refused with "Audio Client
+	 * already active", so the microphone and the speaker cannot be used at
+	 * once. Giving each direction its own front end also makes the ALSA
+	 * device list unambiguous -- aplay -l shows only MultiMedia1, arecord -l
+	 * only MultiMedia2 -- so nothing has to be told which to pick.
+	 */
 	dai@0 {
 		reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
+		direction = <Q6ASM_DAI_RX>;
+	};
+
+	dai@1 {
+		reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
+		direction = <Q6ASM_DAI_TX>;
 	};
 };
 
