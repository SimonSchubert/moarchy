+	/*
+	 * A second front end, for capture.
+	 *
+	 * With only MultiMedia1 declared, the card exposes exactly one PCM and
+	 * `aplay -l` and `arecord -l` both name it. Playback and capture then
+	 * contend for a single q6asm session, and whichever opens second is
+	 * refused:
+	 *
+	 *   q6asm-dai: Audio Client already active
+	 *   q6asm-dai: q6asm_dai_prepare: q6asm_open_write failed
+	 *   ASoC error (-22): at snd_soc_pcm_component_prepare()
+	 *
+	 * which on a phone means the microphone and the speaker cannot be used
+	 * at the same time -- no call audio, and a recorder that fails if
+	 * anything played recently. A second front end gives capture its own
+	 * session. q6routing already carries the mixers for MultiMedia1..8, so
+	 * nothing else has to change to reach it.
+	 */
+	mm2-dai-link {
+		link-name = "MultiMedia2";
+
+		cpu {
+			sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
