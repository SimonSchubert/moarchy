# The PinePhone's hardware, and the only place in the project that names it
# (docs/devices.md D1, D2).
#
# Everything that is true of a Pine64 PinePhone and false of some other phone
# belongs here: the kernel and u-boot it boots, the modem daemon it runs, and
# the output scale its 720x1440 panel wants. Everything else -- the shell, the
# keybindings, the theme, every line of QML -- is in `moarchy` and knows
# nothing about which device it is on.
#
# This package exists before there is a second device, on purpose (D7). An
# abstraction with one implementation is a guess; moving the PinePhone onto it
# first means the Pixel 3a tests the boundary rather than inventing it, and any
# behaviour change shows up on hardware we already have in hand.
#
# The version tracks the project rather than the hardware, which is the same
# call `moarchy` and `moarchy-meta` make and for the same reason: sway.conf is
# project content that evolves with the UI, and a package whose content changes
# under a frozen version is one pacman will never offer to a phone in the
# field. Bumping with the project costs a 2 KB download and cannot go wrong in
# the direction that matters.

. "$startdir/../../scripts/manifest.sh"
_ver=$(manifest_get moarchy version) || return 1

pkgname=moarchy-device-pinephone
pkgver=$_ver
# 2: parted. 0.3.0-1 is published and on a phone, and without partprobe the
# first-boot grow does not grow anything (see depends).
#
# 1 for 0.4.0: pkgver moved, and 0.4.0-1 is newer than the 0.3.0-2 that carries
# parted, so nothing 2 fixed is hidden from a phone holding it. The package
# itself is unchanged.
pkgrel=1
pkgdesc="Pine64 PinePhone hardware support for moarchy"
arch=('any')
url='https://github.com/SimonSchubert/moarchy'
license=('MIT')

# Exactly one device package may be installed, and pacman is what enforces it
# (D4). Providing and conflicting with the same virtual name is the standard
# idiom for a mutually-exclusive set -- pacman does not count a package as
# conflicting with itself, so this reads as "one of these, not two".
#
# `moarchy-meta` depends on the virtual name and never on this one, so the
# package set stays device-independent (D5). A rootfs built with no device
# package is then an unsatisfied dependency at pacstrap time, which is a build
# failure, rather than a phone that boots to a shell with the wrong scale.
provides=('moarchy-device')
conflicts=('moarchy-device')

# The device stack, moved here out of image/build.sh's pacstrap line (D2).
#
# device-pine64-pinephone is DanctNIX's device meta package and pulls the lot:
# danctnix-tweaks, linux-megi, uboot-pinephone, linux-firmware-realtek,
# anx7688-firmware, ov5640-firmware, eg25-manager, plus the brightness and
# proximity udev rules and the suspend hook. Depending on it rather than on its
# contents means a device fix from DanctNIX arrives without an edit here.
#
# Hand-picking that list was a mistake caught before it shipped once already --
# `linux-megi uboot-pinephone danctnix-tweaks` looked like the device stack and
# left out linux-firmware-realtek, which is the wifi. The comment survives the
# move because the trap does.
depends=(
  'device-pine64-pinephone'
  'danctnix-usb-tethering'
  # partprobe, for moarchy-grow-rootfs. This is the one device whose
  # device.conf says DEVICE_GROW=partition, and that path rewrites the GPT
  # with `sfdisk --no-reread` and then needs partprobe to tell the kernel the
  # partition is bigger. Without it resize2fs sees the old size and the
  # filesystem stays what the image made it: 5.9 G on a 64 G card, 116 M free,
  # on the 0.2.2 image, and the stamp still written so it never tries again.
  # image/Dockerfile has parted, which is why image/verify passed.
  'parted'
)

source=('sway.conf' 'device.conf')
sha256sums=('SKIP' 'SKIP')

package() {
  # A fixed path, which is the whole mechanism (D6). config/sway/config
  # includes /usr/share/moarchy/device/sway.conf by absolute path and does not
  # know or care which device package put it there.
  #
  # It also makes the boundary a build error rather than a decision: two
  # packages cannot own one path, so `moarchy` shipping a device file again
  # would fail the install instead of quietly winning or losing.
  install -Dm644 "$srcdir/sway.conf"   "$pkgdir/usr/share/moarchy/device/sway.conf"
  install -Dm644 "$srcdir/device.conf" "$pkgdir/usr/share/moarchy/device/device.conf"

  # So a running phone can say what it thinks it is, next to the build-info the
  # image already writes for what commit it is. `moarchy-about` and a bug report
  # both want this, and `pacman -Qo` is a clumsy way to ask.
  printf 'codename=pinephone\n' > "$srcdir/build-info"
  install -Dm644 "$srcdir/build-info" "$pkgdir/usr/share/moarchy/device/build-info"
}
