#!/usr/bin/env python3
"""Keep the Android bars hidden, whatever launched the app.

`waydroid app launch` rewrites policy_control on every launch -- to
immersive.status=* while multi_windows is false -- and the drawer's generated
desktop entries are exactly `waydroid app launch <pkg>`. So a setting applied by
hand survives until the next icon tap and no further.

multi_windows=true makes waydroid choose immersive.full=* itself, but it also
puts Android into freeform windowing: apps become small floating windows with
Android titlebars, which is wrong on a 360px phone.

So: stay in single-window mode and re-assert the setting when a Waydroid window
appears. Event-driven off sway's IPC, not polled -- one `waydroid shell` call
(~1.15s) per launch, in the background, where it costs nothing.
"""
import json, subprocess

SKIP = {"waydroid.InputMethod"}

def assert_immersive():
    subprocess.run(
        ["sudo", "waydroid", "shell", "--", "settings", "put", "global",
         "policy_control", "immersive.full=*"],
        capture_output=True, timeout=30)

p = subprocess.Popen(["swaymsg", "-t", "subscribe", "-m", '["window"]'],
                     stdout=subprocess.PIPE, text=True)
for line in p.stdout:
    try:
        ev = json.loads(line)
    except ValueError:
        continue
    if ev.get("change") != "new":
        continue
    app = (ev.get("container") or {}).get("app_id") or ""
    if app.startswith("waydroid.") and app not in SKIP:
        try:
            assert_immersive()
        except Exception:
            pass
