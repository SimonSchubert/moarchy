# Waydroid, configured for a phone.
#
# This package is configuration and two small programs. It carries no Android
# code, no images, and nothing Google or anyone else wrote -- docs/android.md
# D2 is why, and it is a licensing answer rather than a technical one.
#
# It is deliberately NOT in moarchy-meta's depends (docs/android.md AC 1).
# Installing it commits a phone to an LXC container sharing the RAM and the
# GPU, and `waydroid init` still has to fetch an image. That is a choice a user
# makes, not one an image makes for them.
#
# What is NOT here, and deliberately:
#
#   The system images. Waydroid reads /usr/share/waydroid-extra/images and
#   skips the download entirely when system.img and vendor.img are there
#   (docs/android.md AC 3), which is the right mechanism -- but it adds 2.4 GB
#   to a published artifact and D1 is not settled.
#
#   Preinstalled Android apps. Spotify, YouTube and the Play Store are other
#   people's proprietary binaries. Shipping them in an image this project
#   publishes is redistribution, and no amount of packaging makes it not be.
#
#   A packaged sway drop-in. The window rule cannot be a constant -- it is
#   computed from the panel, the scale, the bar, the strip and Android's own
#   inset resources (AC 10) -- so moarchy-waydroid-setup generates it into
#   ~/.config/sway/config.d/ on the device instead.
#
#   An immersive watcher. moarchy-waydroid-immersive existed until 2026-09-18
#   and forced policy_control=immersive.full=* on every sway window::new. That
#   is now measurably the wrong thing twice over: immersive is what destroys
#   the insets an app pads its content against, and a watcher cannot fix the
#   layout of a window that already exists. moarchy-android-launch asserts the
#   value BEFORE the activity starts instead -- docs/android.md AC 11.

. "$startdir/../../scripts/manifest.sh"
_ver=$(manifest_get moarchy version) || return 1

pkgname=moarchy-waydroid
pkgver=$_ver
pkgrel=2
pkgdesc="Android apps on moarchy: Waydroid configured for a phone screen"
arch=('any')
url='https://github.com/SimonSchubert/moarchy'
license=('MIT')

# waydroid pulls lxc, python-gbinder, nftables, dnsmasq, gtk3, python-dbus and
# pulse-native-provider, all of which resolve from ALARM extra. Nothing here is
# built from source (docs/android.md AC 2).
#
# python is named explicitly because moarchy-waydroid-setup does its geometry
# arithmetic in python3, not because waydroid happens to need it. glib2 for
# gdbus, which moarchy-android-launch uses to unfreeze the container: a DBus
# round trip rather than a python interpreter start-up on every app launch.
# libdrm for modetest, which is how the panel's physical size is read: it is
# the only source on the device, and the density depends on it (AC 13).
depends=('waydroid' 'python' 'sway' 'glib2' 'libdrm')

install=moarchy-waydroid.install

source=('moarchy-waydroid-setup'
        'moarchy-android-launch')
sha256sums=('SKIP' 'SKIP')

package() {
  # /usr/lib/moarchy/bin is the project's own bin dir and is NOT on PATH,
  # which is deliberate: these are called by the drawer and by the user through
  # an absolute path, not typed.
  install -Dm755 "$srcdir/moarchy-waydroid-setup" \
    "$pkgdir/usr/lib/moarchy/bin/moarchy-waydroid-setup"
  install -Dm755 "$srcdir/moarchy-android-launch" \
    "$pkgdir/usr/lib/moarchy/bin/moarchy-android-launch"
}
