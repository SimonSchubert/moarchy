#!/usr/bin/env bash
# Launch an Android app so that it actually GETS Android's insets.
#
# This replaces `waydroid app launch`, and replacing it is the whole point:
# that command writes policy_control=immersive.status=* at or before the
# window's FIRST LAYOUT (tools/actions/app_manager.py:78-85), which sets the
# status bar inset to a zero-height frame -- and the inset is what an app pads
# its own content against. Without it the app's first line of content draws
# behind moarchy's bar.
#
# docs/android.md AC 11 records the three orderings that were measured before
# this script existed. Two of them do not work:
#
#   set null* AFTER the launch      the inset comes back and the app never
#                                   re-flows -- a window already laid out stays
#                                   laid out
#   set null* BEFORE the launch     the rewrite still wins the race to layout
#   never call `waydroid app launch` works
#
# So there is no watcher that can fix this after the fact, which is why
# moarchy-waydroid-immersive was deleted rather than amended.
#
# moarchy.app-drawer calls this directly for any waydroid.<pkg> entry. The
# generated .desktop files are deliberately left alone: waydroid's user_manager
# rewrites them on every session start, so anything patched into them converges
# rather than holds (docs/android.md §7).
set -euo pipefail

pkg=${1:-}
[ -n "$pkg" ] || { echo "usage: moarchy-android-launch <android package>" >&2; exit 2; }

# An Android package name, and nothing that can carry shell syntax into the
# `sh -c` below. The argument arrives from a .desktop id, which is not a
# trusted string just because we generated the launcher that reads it.
[[ "$pkg" =~ ^[A-Za-z0-9_][A-Za-z0-9_.]*$ ]] || {
  echo "moarchy-android-launch: not an android package name: $pkg" >&2; exit 2; }

command -v waydroid >/dev/null || {
  echo "moarchy-android-launch: waydroid is not installed" >&2; exit 1; }

# `suspend_action: freeze` leaves the container FROZEN between uses. An attach
# works while frozen -- measured, 1.07s -- but the app would not run, so
# unfreeze it the way upstream's launcher does.
#
# Over gdbus rather than through `waydroid`, because that is one DBus round
# trip against a python interpreter start-up on an A53.
gdbus call --system \
  --dest id.waydro.Container \
  --object-path /ContainerManager \
  --method id.waydro.ContainerManager.Unfreeze >/dev/null 2>&1 || true

# Single-window mode shows whichever surface `waydroid.active_apps` names, and
# `waydroid app launch` is normally what sets it. Without this a cold app gets
# **no Wayland window at all** -- measured, and it presents as a launch that
# silently did nothing while `topResumedActivity` says the app is up.
#
# NOT under sudo: `waydroid prop` resolves the session bus of the calling user,
# and root has no session ([[sudo-drops-moarchy-bin]]'s family of trap).
waydroid prop set waydroid.active_apps "$pkg" >/dev/null 2>&1 || true

# ONE attach for everything Android-side. Each `waydroid shell` costs ~1.1s on
# this hardware and all of `waydroid app launch` costs ~0.9s to window, so
# three attaches would be a launch the phone visibly lost.
#
# Two of the four things it does are re-asserted on every launch rather than set
# once, because the container throws them away on its own schedule.
# send-disable-flag lasts until SystemUI restarts, and it is the only thing
# stopping Android's own clock and icons drawing through the bar, which is
# transparent over an Android window (AC 6, AC 12). The gesture-handle override
# does not survive a `waydroid session stop` at all: a fabricated RRO lives in
# the container's /data/resource-cache, which a boot clears, so after a session
# restart the .frro file is gone, `cmd overlay list` no longer names it and the
# resource reads 2.0dip again -- measured 2026-09-18, all three.
# Every Android app on moarchy is started from here, so this is the one place
# that can hold it, and it is why moarchy-waydroid-setup does not try: that
# script's own last line tells the operator to stop the session.
#
# What the override buys is the strip going transparent over an Android app
# (AC 12). Android draws its gesture handle INSIDE the app surface, on the same
# rows as our own pill, and `NavigationHandle.onDraw` fills a round rect of
# height `2 * navigation_handle_radius` -- so a radius of zero draws nothing,
# and nothing else in SystemUI reads that dimension. LineageOS's nohint overlay
# is the obvious candidate and is the wrong one: its idmap maps
# `navigation_bar_height`, so it deletes the INSET, which is the thing the app
# pads its content against (`cmd overlay dump
# org.lineageos.overlay.customization.navbar.nohint`).
#
# Fabricated, so there is no APK and no Android code in this project -- and
# fabricated overlays live in /data/resource-cache, which the container clears
# on boot, which is why this is here and not in the setup script.
#
# Guarded, because re-registering it makes SystemUI re-inflate the navigation
# bar: a flicker per launch for nothing, and on the cold path a restart this
# waits out.
#
# The disable flags are asserted last for the same reason they are asserted at
# all: the restart above would take them with it.
#
# No force-stop first, deliberately. It would give a correct layout every time
# and kill playback on every tap. The cost is that an app already running with
# suppressed insets -- launched some other way -- keeps them until it is
# stopped once.
sudo waydroid shell -- sh -c '
  settings put global policy_control "null*"
  cmd overlay list | grep -q "\[x\] com.android.shell:moarchy_nohandle" || {
    cmd overlay fabricate --target com.android.systemui --name moarchy_nohandle \
      com.android.systemui:dimen/navigation_handle_radius 0x05 0x0
    cmd overlay enable --user 0 com.android.shell:moarchy_nohandle

    # Registering it is not enough: SystemUI reads the radius when it inflates
    # the navigation bar, and a freshly booted one inflates BEFORE it notices an
    # overlay that appeared a second ago -- measured, handle back on screen 20s
    # after a launch that had just enabled it. Restarting SystemUI makes it
    # deterministic, and this is the first launch of a session, which is already
    # the slow one.
    old=$(pidof com.android.systemui)
    kill $old 2>/dev/null
    i=0
    while [ "$i" -lt 60 ]; do
      new=$(pidof com.android.systemui)
      [ -n "$new" ] && [ "$new" != "$old" ] && break
      i=$((i + 1)); sleep 0.25
    done
    # And then for its navigation bar to exist again, because that inset is what
    # the app about to start lays itself out against. Waiting for the process is
    # not waiting for the window (AC 11: only the first layout counts).
    i=0
    while [ "$i" -lt 60 ]; do
      dumpsys window -a 2>/dev/null | grep -q ITYPE_NAVIGATION_BAR && break
      i=$((i + 1)); sleep 0.5
    done
  }
  cmd statusbar send-disable-flag clock system-icons notification-icons
  act=$(cmd package resolve-activity --brief '"$pkg"' | tail -1 | tr -d "\r")
  [ -n "$act" ] || exit 1
  am start -n "$act"
' >/dev/null 2>&1
