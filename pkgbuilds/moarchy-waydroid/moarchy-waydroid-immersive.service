[Unit]
Description=Keep the Android navigation and status bars hidden
Documentation=https://github.com/SimonSchubert/moarchy/blob/main/docs/android.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Restart rather than give up: swaymsg's subscription dies with the compositor,
# and a session restart must not leave the bars permanently visible.
ExecStart=/usr/lib/moarchy/bin/moarchy-waydroid-immersive
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
