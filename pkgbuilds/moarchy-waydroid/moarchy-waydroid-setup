#!/usr/bin/env bash
# Configure Waydroid to behave like a phone rather than a desktop.
#
# Run once after `waydroid init`, and again if the output geometry, the scale,
# the bar or the strip ever changes. Everything here is either a persist
# property or a generated sway snippet, so it survives session restarts and
# reboots.
#
# docs/android.md AC 5, AC 6 and AC 10 are what this satisfies.
set -euo pipefail

die() { echo "moarchy-waydroid-setup: $*" >&2; exit 1; }

_base_prop=/var/lib/waydroid/waydroid_base.prop

command -v waydroid >/dev/null || die "waydroid is not installed"
[ -n "${SWAYSOCK:-}" ] || SWAYSOCK=$(ls /run/user/"$(id -u)"/sway-ipc.*.sock 2>/dev/null | head -1)
[ -n "$SWAYSOCK" ] || die "no sway socket; run this inside the session"
export SWAYSOCK

state=$(waydroid status 2>/dev/null | awk -F'\t' '/^Container:/{print $2}')
[ -n "$state" ] || die "no waydroid session; run 'waydroid session start' first"

# multi_windows=false is not a default we inherit, it is a decision.
#
# true would hide both Android bars for free -- `waydroid app launch` picks
# immersive.full=* instead of immersive.status=* when it is set. It also puts
# Android into FREEFORM WINDOWING: apps become small floating windows with
# Android's own titlebar, and the input method becomes a separate toplevel that
# sway tiles like an app. Both are wrong on a 360px phone.
waydroid prop set persist.waydroid.multi_windows false

# ---------------------------------------------------------------------------
# The density, before anything that measures dp (AC 13)
# ---------------------------------------------------------------------------
# Waydroid's hwcomposer computes `lcd_density = 180 * scale` in
# finished_calibrating() and only when ro.sf.lcd_density is unset, which on a
# scale-3 phone is 540. That is not this panel: 1080x2220 in 62x127mm is 444
# ppi, so 540 makes every Android app 23% too large AND tells Android the
# screen is 320dp wide when it is 393dp -- narrow enough that apps pick
# small-screen layouts. Spotify drew a one-column shortcut grid at 540 and its
# normal two-column one at 440.
#
# The panel's physical size comes from the DRM connector rather than a constant,
# for the same reason as everything else here (AC 10). sway does not expose it
# -- get_outputs has no mm anywhere -- and this device tree has no width-mm, so
# modetest is the source.
# The panel's pixel size is the output rect times the scale; its physical size
# comes from the DRM connector. Neither is a constant here, for the same reason
# as the geometry below (AC 10).
_px=$(swaymsg -t get_outputs | python3 -c '
import json, sys
o = [x for x in json.load(sys.stdin) if x.get("active")]
if not o:
    sys.exit("no active output")
r, sc = o[0]["rect"], float(o[0].get("scale") or 1)
print(int(round(r["width"] * sc)), int(round(r["height"] * sc)))
') || die "could not read the output"
read -r _px_w _px_h <<<"$_px"

# sway does not expose the panel's physical size -- get_outputs has no mm
# anywhere -- and this device tree carries no width-mm, so the DRM connector
# via modetest is the only source on the device.
_diag_mm=$({ modetest -c 2>/dev/null || true; } | python3 -c '
import math, re, sys
for line in sys.stdin:
    f = line.split()
    # id encoder status name size(mm) modes encoders
    if len(f) >= 6 and f[2] == "connected" and re.match(r"^\d+x\d+$", f[4]):
        w, h = (int(v) for v in f[4].split("x"))
        if w and h:
            print(int(round(math.hypot(w, h))))
        break
')

if [ -n "${_diag_mm:-}" ] && [ "${_diag_mm:-0}" -gt 0 ]; then
  # Rounded to the nearest 10 so it reads like a device density rather than a
  # measurement: 444 becomes 440, which is what a stock Pixel 3a ships and what
  # Android's own resource buckets are written around.
  _want=$(python3 -c "
import math
print(int(round(math.hypot($_px_w, $_px_h) / ($_diag_mm / 25.4) / 10.0)) * 10)")
  _have=$(sudo waydroid shell -- getprop ro.sf.lcd_density 2>/dev/null | tr -d '\r')
  if [ "${_have:-0}" != "$_want" ]; then
    echo "panel ${_px_w}x${_px_h} in ${_diag_mm}mm -> density $_want (container has ${_have:-unset})"
    if sudo grep -q '^ro.sf.lcd_density=' "$_base_prop" 2>/dev/null; then
      sudo sed -i "s/^ro.sf.lcd_density=.*/ro.sf.lcd_density=$_want/" "$_base_prop"
    else
      echo "ro.sf.lcd_density=$_want" | sudo tee -a "$_base_prop" >/dev/null
    fi
    cat <<MSG

Density written, and this script stops here on purpose. It is read at container
boot, and every inset below is measured in dp -- so computing the geometry now
would compute it against the density being replaced:

    waydroid session stop
    waydroid session start          # in the phone's session
    $0

MSG
    exit 0
  fi
else
  echo "warning: could not read the panel size from modetest; leaving the density alone" >&2
fi

# The insets have to be readable, and `immersive.status=*` -- whatever the last
# `waydroid app launch` left behind -- reports the status bar as a zero-height
# frame. Clear it before measuring, or the arithmetic below silently computes
# an overhang of zero.
sudo waydroid shell -- settings put global policy_control "null*" >/dev/null 2>&1 \
  || die "could not reach the container; is it running?"

# ---------------------------------------------------------------------------
# The geometry, computed on the device (AC 10)
# ---------------------------------------------------------------------------
# Nothing below is a constant, and that is the criterion rather than tidiness:
# the numbers depend on the panel, the scale, this bar's height, this strip's
# height AND Android's own inset resources, and four of those six have already
# changed once in this project's life.
#
# Layer surfaces are invisible to sway's IPC -- `get_tree` does not list them --
# so the bar and the strip are read off the WORKSPACE rect, which is the output
# minus whatever each of them reserves. That is also why this cannot be asked
# of the plugins: it has to work with the shell restarting underneath it.
#
# Android's insets come from the container in physical pixels; dividing by the
# output scale puts them in the logical pixels sway and the props both speak.
# Right after a session start SystemUI has not registered its inset sources yet
# and the status bar reads as a zero-height frame. The guard in the python below
# turns that into a clean failure rather than a silently wrong number -- it fired
# on the first real run of this script -- but the operator should not have to
# re-run for a race, so wait for it.
_status_inset() {
  sudo waydroid shell -- dumpsys window -a 2>/dev/null | python3 -c '
import re, sys
for line in sys.stdin:
    m = re.search(r"type=ITYPE_STATUS_BAR frame=\[\d+,(\d+)\]\[\d+,(\d+)\]", line)
    if m:
        print(int(m.group(2)) - int(m.group(1)))
        break
else:
    print(0)
'
}
for _i in $(seq 1 10); do
  [ "$(_status_inset)" -gt 0 ] && break
  [ "$_i" = 1 ] && echo "waiting for SystemUI to publish its insets..."
  sleep 3
done

_geom=$(
  {
    swaymsg -t get_outputs
    echo "---"
    swaymsg -t get_workspaces
    echo "---"
    sudo waydroid shell -- dumpsys window -a 2>/dev/null \
      | grep -oE "type=ITYPE_(STATUS_BAR|NAVIGATION_BAR) frame=\[[0-9,]+\]\[[0-9,]+\]" \
      | sort -u
  } | python3 -c '
import json, re, sys

blocks = sys.stdin.read().split("\n---\n")
if len(blocks) != 3:
    sys.exit("could not read the geometry")

outs = [o for o in json.loads(blocks[0]) if o.get("active")]
if not outs:
    sys.exit("no active output")
out = outs[0]
W, H = out["rect"]["width"], out["rect"]["height"]
scale = float(out.get("scale") or 1)

wss = json.loads(blocks[1])
cur = [w for w in wss if w.get("focused")] or wss
if not cur:
    sys.exit("no workspace")
ws = cur[0]["rect"]

# What the bar and the strip reserve, in logical pixels.
bar = ws["y"]
strip = H - bar - ws["height"]

# Android reports each inset as a frame in physical pixels.
insets = {}
for line in blocks[2].strip().splitlines():
    m = re.match(r"type=ITYPE_(\w+) frame=\[(\d+),(\d+)\]\[(\d+),(\d+)\]", line.strip())
    if m:
        insets[m.group(1)] = int(m.group(5)) - int(m.group(3))
st = insets.get("STATUS_BAR", 0) / scale
nav = insets.get("NAVIGATION_BAR", 0) / scale
if st <= 0:
    sys.exit("android reports no status bar inset; is policy_control still immersive?")

# Overhang each screen edge by however much Android asks for beyond what our
# own chrome occupies, so the inset BOUNDARIES land on the bar and the strip
# rather than inside the app.
y = round(bar - st)
h = round(H + (st - bar) + (nav - strip))
print(f"{W} {h} {y} {H} {bar} {strip} {st:.2f} {nav:.2f}")
'
) || die "could not compute the geometry"

read -r _w _h _y _out_h _bar _strip _st _nav <<<"$_geom"
[ "${_w:-0}" -gt 0 ] && [ "${_h:-0}" -gt 0 ] || die "could not compute the geometry"

echo "output ${_w}x${_out_h}, bar ${_bar}, strip ${_strip}, android insets ${_st}/${_nav} logical"
echo "pinning the Android display to ${_w}x${_h} logical at y=${_y}"

# The Android display size is LATCHED AT CALIBRATION and never follows a later
# resize: xdg_toplevel_handle_configure() only records req_width/req_height, and
# the sole caller of choose_width_height() is finished_calibrating(), which runs
# once per session. Whatever the window happened to be at that moment is what
# Android believes forever -- which shows up as an app rendering into the top
# corner with a black band below it. So pin it.
#
# The values are LOGICAL pixels: waydroid multiplies by display_scale itself,
# and passing physical 1080x2238 yields 3240x6714.
waydroid prop set persist.waydroid.width "$_w"
waydroid prop set persist.waydroid.height "$_h"

# ---------------------------------------------------------------------------
# The sway half, generated because the numbers are
# ---------------------------------------------------------------------------
# Floating, not fullscreen: sway v1.12 orders its scene
# tiling -> floating -> shell_top -> fullscreen -> shell_overlay, so a
# fullscreen window draws OVER the bar while a floating one sits under both it
# and the strip.
#
# `move absolute position` and not `move position`: the latter is
# workspace-relative, so it lands below the bar instead of at the output origin,
# and a clamp makes the wrong form look right exactly once.
_conf="$HOME/.config/sway/config.d/90-moarchy-waydroid.conf"
mkdir -p "$(dirname "$_conf")"
cat > "$_conf" <<CONF
# GENERATED by moarchy-waydroid-setup. Do not edit: it is overwritten, and the
# numbers are computed from this device (docs/android.md AC 10).
#
# Gives an Android toplevel the whole output plus an overhang at each edge, so
# the app draws behind the bar and the strip while Android pads its own content
# with the insets it reports. Paired with persist.waydroid.height=${_h}: the two
# must agree or Android renders into a window of the wrong size and clips.
for_window [app_id="^waydroid\\."] floating enable, border none, resize set width ${_w} px height ${_h} px, move absolute position 0 ${_y}
CONF
echo "wrote $_conf"
swaymsg reload >/dev/null || die "sway reload failed"

# The image leaves ro.hardware.audio.primary unset, so Android loads
# audio.primary.default.so -- a stub that accepts audio and discards it --
# rather than audio.primary.waydroid.so, which talks to the host's PulseAudio
# over the bind-mounted socket.
#
# NOTE: this is correct but it is not usually why a phone is silent. Android's
# own STREAM_MUSIC starts at 5 of 15 on a fresh container, which presents as a
# live, uncorked, full-volume host stream carrying nothing. Check
# `dumpsys audio | grep -A6 STREAM_MUSIC` before suspecting the path.
if [ -f "$_base_prop" ] && ! grep -q '^ro.hardware.audio.primary=' "$_base_prop"; then
  echo "ro.hardware.audio.primary=waydroid" | sudo tee -a "$_base_prop" >/dev/null
  echo "set the audio HAL; restart the session for it to take"
fi

echo "done -- run 'waydroid session stop' for the display size to take effect"
