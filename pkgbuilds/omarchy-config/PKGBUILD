# Upstream Omarchy's configuration and theme layer, ported to Sway at BUILD
# time (docs/structure.md P2-P4).
#
# The port used to run on the phone: install/port-4x.sh, 442 lines of sed and
# python rewriting the vendored QML in place. It is port-4x.patch now. A patch
# that no longer applies fails the build and names the hunk; a sed pass against
# a moved upstream matches nothing and ships a shell that still imports
# Quickshell.Hyprland, which is a failure this project has paid for before.
#
# The patch was generated by running the old script against a pristine checkout
# and diffing, then verified by applying it with `patch -p1` and proving the
# result is byte-identical to what the script produced. Every bump since is
# regenerated the same way and held to the same test: it must apply with no
# offset and no fuzz, so a moved upstream fails the build instead of landing a
# hunk somewhere it was never aimed at. prepare() is what enforces that half --
# `--fuzz=0` alone does not, and docs/upstream.md records the measurement that
# showed it does not.
#
# It is 10 files, 264 insertions, 33 deletions -- small enough that
# omarchy-config stays a package with a patch rather than becoming a fork
# (docs/structure.md Q4).
#
# shell/shell.qml joined the list at v4.0.3, which sandboxed installed
# third-party plugins behind a capability-scoped PluginShellApi. Our own phone
# UI is scanned as third-party (PluginRegistry, below) so that a ~/.config copy
# can still shadow the packaged one, and the scoped surface has no
# panelLoaders, no openPanelIds and no cross-plugin summon -- which is most of
# what moarchy.gestures is. The hunk trusts the `moarchy.` namespace and leaves
# the sandbox in force for everything else.
#
# No git clone in build(): the source is a tarball with a checksum (P10).

# The pin lives in manifest.toml and nowhere else (V1). makepkg exports
# $startdir, so the reader is reachable from here.
. "$startdir/../../scripts/manifest.sh"
_ref=$(manifest_get omarchy ref)   || return 1
_url=$(manifest_get omarchy url)   || return 1
_ver=$(manifest_get omarchy version) || return 1

pkgname=omarchy-config
pkgver=${_ver#v}
# 2, and the reason is the one the moarchy PKGBUILD sets out at length: pacman
# compares versions, not contents, and the [moarchy] repo already publishes
# 4.0.3-1. This build is the same upstream ref with different bytes -- a second
# patch (the notification-popups opt-out the shade needs, docs/shade.md S24)
# and the web app artwork installed into an icon theme (docs/apps.md B3) -- so
# without this line every phone in the field would keep the package it has and
# neither would ever arrive.
pkgrel=2
pkgdesc="Omarchy's configuration and theme layer, ported to Sway"
arch=('any')
url="$_url"
license=('MIT')
# quickshell runs the shell; the rest are what the bin/ scripts shell out to.
depends=('quickshell' 'bash')
source=("omarchy-$_ref.tar.gz::$_url/archive/$_ref.tar.gz"
        'port-4x.patch'
        'notification-popups-bar-opt-out.patch')
sha256sums=('25f8c87b89c97aef352ddae02d61902ad9d1a3a07ad44efec0e1436f1c65a5e5'
            '20e8e569ca0f966cf29da2ac41335be7e8f64dcd6db94f2bc6180fbe5bfbd06d'
            '8ab33f7810b721c82f0bea5a0b7756868274f61d59bae4639c028012c9a87160')

# Two patches, and they are different kinds of thing.
#
# port-4x.patch is the Sway port: it exists because this hardware cannot run
# Hyprland, it will never go upstream, and it is the reason this package is not
# just upstream's tree.
#
# notification-popups-bar-opt-out.patch is a hook, and it is MEANT to go
# upstream and be deleted here once it lands. A bar that shows notifications
# itself -- a phone's pull-down shade (docs/shade.md S24) -- declares
# `notificationPopups: false` and gets none; a bar that says nothing keeps its
# toasts, so desktop Omarchy is unchanged by it. It is byte-identical to the
# copy the sibling project carries, which is what keeps one patch rather than
# two drifting ones.
#
# Both must apply with no fuzz and no offset, and the two guards after them are
# what makes that true. `--fuzz=0` was carrying the whole claim until
# 2026-09-13 and it never could: it bounds FUZZ -- how many context lines may
# mismatch -- and says nothing about OFFSET. A hunk that lands 48 lines from
# where it was aimed is reported on stdout and exits 0, which in a build log is
# indistinguishable from success.
#
# Measured that day against upstream's `quattro` branch, 363 commits past the
# pin, in this container's own GNU patch 2.8: four hunks landed at offsets of
# +19, +48, -15 and -15, the build succeeded, and the shell it produced still
# had `import Quickshell.Hyprland` in shell/plugins/background/Background.qml --
# a file that did not exist at the pin, so no hunk was ever aimed at it. That is
# the failure the move from install/port-4x.sh to a patch was supposed to end,
# surviving in a second form. docs/upstream.md is the full account; §A is these
# six lines.
prepare() {
  cd "omarchy-$_ref"
  patch -p1 --fuzz=0 < "$srcdir/port-4x.patch"
  patch -p1 --fuzz=0 < "$srcdir/notification-popups-bar-opt-out.patch"

  # A1/A3. GNU patch's --backup-if-mismatch is on by default and writes a
  # .orig for exactly the files that did not apply cleanly, so the signal for
  # "landed at an offset" already exists and was merely unread. Reading it also
  # keeps .orig and .rej out of the package, which package()'s `cp -a shell`
  # would otherwise sweep up.
  local stray
  stray=$(find . \( -name '*.orig' -o -name '*.rej' \) -print)
  if [ -n "$stray" ]; then
    echo "==> ERROR: a hunk did not apply cleanly; upstream has moved under it:" >&2
    echo "$stray" >&2
    echo "==> Regenerate the patch against $_ver rather than shipping this." >&2
    return 1
  fi

  # A2. The assertion a patch structurally cannot make: a patch only knows the
  # files it names, and completeness of the port is a property of the whole
  # tree. A new upstream file that imports Quickshell.Hyprland gets past every
  # hunk in port-4x.patch without touching one of them.
  #
  # A grep rather than a parse, deliberately: qmllint is not on PATH under its
  # own name, and an offscreen quickshell dies at the bar before it reaches
  # most of this tree. The import is the thing that fails to resolve, so the
  # import is the thing to look for.
  if grep -rqE 'Quickshell\.Hyprland|\bHyprland\.' shell/; then
    echo "==> ERROR: the Sway port is incomplete -- Hyprland survives in:" >&2
    grep -rlE 'Quickshell\.Hyprland|\bHyprland\.' shell/ >&2
    echo "==> Port these files and add them to port-4x.patch." >&2
    return 1
  fi
}

package() {
  cd "omarchy-$_ref"

  # /usr/share/omarchy is the path upstream hardcodes -- three scripts and
  # their acceptance test all say OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}".
  # The old installer's ~/.local/share/omarchy was an artefact of vendoring a
  # git checkout into $HOME, and it is one of the paths P1 forbids.
  install -d "$pkgdir/usr/share/omarchy"

  # What the running shell needs. test/, docs/ and agents/ are development
  # material and stay out.
  #
  # install/ is IN, despite reading like upstream's x86_64 installer. A dozen
  # runtime omarchy-* scripts source things out of it -- omarchy-install-browser
  # and omarchy-theme-set-browser both need install/helpers/browser-policy.sh,
  # and omarchy-apply-hardware and omarchy-apply-system export
  # OMARCHY_INSTALL=$OMARCHY_PATH/install. Leaving it out made every
  # omarchy-theme-set print
  #   /usr/bin/omarchy-theme-set-browser: line 6:
  #   /usr/share/omarchy/install/helpers/browser-policy.sh: No such file
  # It is 348 KB, so the saving was never worth the breakage.
  for d in shell config default themes applications migrations install; do
    [ -d "$d" ] && cp -a "$d" "$pkgdir/usr/share/omarchy/"
  done
  for f in version icon.png icon.txt logo.svg logo.txt LICENSE; do
    [ -f "$f" ] && install -Dm644 "$f" "$pkgdir/usr/share/omarchy/$f"
  done

  # --- the web app artwork, into an icon theme ------------------------------
  # applications/*.desktop name their icons the themed way -- `x`, `youtube`,
  # `omarchy-discord` -- and the artwork sits beside them in
  # applications/icons, which no icon theme reads. On a desktop install
  # omarchy-webapp-install is what puts a downloaded icon into one; nothing
  # ever put THESE anywhere, so upstream's own entries have always resolved to
  # a generic glyph (docs/apps.md B3).
  #
  # hicolor/256x256/apps whatever the file measures, which is upstream's own
  # choice in omarchy-webapp-install, and the name transform is its
  # safe_icon_name: lowercase, runs of non-alphanumerics to single dashes. That
  # is what makes `Disk Usage.png` the icon called `disk-usage`.
  #
  # All of them, not just the two entries moarchy ships: an entry copied from
  # /usr/share/omarchy/applications by hand, or installed the upstream way,
  # then finds its icon with nothing further to do.
  if [ -d applications/icons ]; then
    icon_dir="$pkgdir/usr/share/icons/hicolor/256x256/apps"
    install -d "$icon_dir"
    for f in applications/icons/*.png; do
      [ -f "$f" ] || continue
      icon_name=$(basename "$f" .png | tr '[:upper:]' '[:lower:]' |
        sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')
      [ -n "$icon_name" ] || continue
      install -m644 "$f" "$icon_dir/$icon_name.png"
    done
  fi

  # bin/ goes to /usr/bin, which is where upstream's own package puts it and
  # what its sudoers.d entries name by absolute path. moarchy's Sway
  # counterparts deliberately do NOT land here -- they would collide on 19
  # names -- they ship to /usr/lib/moarchy/bin and shadow these by PATH order,
  # which is exactly what the old installer arranged with MOARCHY_PATH/bin
  # ahead of OMARCHY_PATH/bin.
  install -d "$pkgdir/usr/bin"
  for f in bin/*; do
    [ -f "$f" ] && install -Dm755 "$f" "$pkgdir/usr/bin/$(basename "$f")"
  done

  # OMARCHY_PATH for every login shell. Upstream's own file, verbatim: it
  # sources default/bash/env-bootstrap, which is their single source of truth
  # for the variable.
  install -Dm644 etc/profile.d/omarchy.sh "$pkgdir/etc/profile.d/omarchy.sh"

  # The privileged half of theme application. Without this, every
  # omarchy-theme-set printed
  #   Error accessing /usr/bin/omarchy-theme-set-browser-policy
  # because the sudoers entry names an absolute path and we shipped a checkout
  # rather than a package (docs/build-log.md, known-bad). Packaging is what
  # fixes it; it is listed there as harmless-but-noisy.
  install -Dm440 etc/sudoers.d/omarchy-theme-browser \
    "$pkgdir/etc/sudoers.d/omarchy-theme-browser"

  # Omarchy's icon font. The bar's logo glyph (\ue900) comes from it, and
  # without it that glyph renders as tofu. /usr/share/fonts is where fontconfig
  # already looks, so nothing has to copy it into ~/.local/share/fonts.
  if [ -f default/fonts/omarchy/omarchy.ttf ]; then
    install -Dm644 default/fonts/omarchy/omarchy.ttf \
      "$pkgdir/usr/share/fonts/omarchy/omarchy.ttf"
  fi
}
