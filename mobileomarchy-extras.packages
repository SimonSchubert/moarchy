# Optional extras -- NOT installed by install.sh.
#
# All verified available for aarch64, but each is heavy for an Allwinner A64
# with 2-3 GB of RAM. Install what you actually want:
#
#   sudo pacman -S --needed $(grep -v '^#' mobileomarchy-extras.packages | grep -v '^$')

chromium          # usable, but it is the heaviest thing you can run on this SoC
nautilus          # GUI file manager; mobileomarchy-launch-files picks it up automatically
mpv
imv
signal-desktop
kdenlive
libreoffice-fresh
gpu-screen-recorder

# (squeekboard moved to the base set -- it is the on-screen keyboard now, and
# measured to raise and retract correctly under Sway.)

# Needed only by bin/mobileomarchy-touch, which synthesises touchscreen input
# through /dev/uinput so bin/mobileomarchy-selftest --gestures can drive the
# gesture drawer without a finger. Not needed to run the phone, only to test it.
python-evdev
